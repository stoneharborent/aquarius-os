      "--dur-med",
      "--ease-out",
      "--font-body",
      "--font-display",
      "--font-mono",
      "--fs-body",
      "--fs-caption",
      "--fs-display",
      "--fs-heading",
      "--fs-hero",
      "--fs-mono",
      "--fs-small",
