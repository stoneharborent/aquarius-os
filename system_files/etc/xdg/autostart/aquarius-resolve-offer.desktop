[Desktop Entry]
Type=Application
Version=1.0
Name=AquariusOS DaVinci Resolve offer
Comment=Asks once, on the first login, whether to set up DaVinci Resolve
Exec=/usr/libexec/aquarius-resolve-offer
TryExec=/usr/libexec/aquarius-resolve-offer
Icon=applications-multimedia
Terminal=false
NoDisplay=true
OnlyShowIn=KDE;
X-KDE-autostart-phase=2
