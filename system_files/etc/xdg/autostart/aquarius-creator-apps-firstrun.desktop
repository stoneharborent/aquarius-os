[Desktop Entry]
Type=Application
Version=1.0
Name=Aquarius Apps (first login)
Comment=Offers the creator apps, once, the first time you log in
Exec=/usr/libexec/aquarius-creator-apps --first-run
TryExec=/usr/libexec/aquarius-creator-apps
Icon=aquarius-logo
Terminal=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=10
