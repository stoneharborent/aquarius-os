# ==============================================================================
# AquariusOS — set the login screen's size before the login screen appears
# ==============================================================================
# Plain English: this is the note that tells the machine "just before you show
# the login screen, run the little script that stops it being too big on a
# handheld." The script itself, with the whole explanation of why the login
# screen gets it wrong in the first place, is
# /usr/libexec/aquarius-greeter-scale — read that one first.
#
# WHY IT HAS TO BE BEFORE THE LOGIN SCREEN
#   The file it writes is read once, by the login screen, as it starts. Written a
#   moment too late and it does nothing until the next restart. There is no way
#   to arrange this after the fact.
#
# WHY THAT IS SAFE HERE, WHEN WE TOOK THE SAME LINE OUT OF THE DRIVE MOUNTER
#   Because of what the two scripts do, not where they sit. On the handheld image
#   the login screen shares this moment with bazzite-autologin.service, which
#   decides whether the machine starts in Game Mode — so anything standing here
#   had better be small, fast, and incapable of hanging. The drive mounter was
#   none of those: it walks every disk in the machine and is allowed five
#   minutes. This script reads two tiny files and copies a third. It is given ten
#   seconds and gives up if it cannot manage that.
#   The full story of that mistake: docs/game-mode-regression.md
#
# TO SEE WHAT IT DID
#   systemctl status aquarius-greeter-scale
#   journalctl -u aquarius-greeter-scale
# ==============================================================================

[Unit]
Description=Set the login screen's display scale (AquariusOS)
Documentation=https://github.com/stoneharborent/aquarius-os/blob/main/docs/login-screen-scaling.md

# The file has to exist before the login screen reads it. Nothing else about the
# machine cares about this service at all.
Before=display-manager.service

# ⚠️ Deliberately NOT Requires= or Wants= on anything. If this service fails,
# the only consequence is a login screen that is the wrong size — which is
# exactly the situation without it. It must never be able to stop a boot.

[Service]
Type=oneshot

# Ask first: does this machine even have the problem? On a desktop PC the answer
# is no and the unit is recorded as SKIPPED rather than failed, so nothing turns
# red on a machine that is working perfectly.
#   Source: systemd.service(5), ExecCondition= — "if an exit code other than 0
#   or 255 is returned ... the remaining commands are skipped and the unit is
#   *not* marked as failed."
ExecCondition=/usr/libexec/aquarius-greeter-scale --check-device

ExecStart=/usr/libexec/aquarius-greeter-scale

# Stay "active" after finishing, so `systemctl status` reads as a tidy green
# "active (exited)" rather than looking like something died.
RemainAfterExit=yes

# Ten seconds is an enormous amount of time for "copy one small file". The limit
# is here so that this can never, under any circumstance, become the reason a
# machine sits on a black screen.
TimeoutStartSec=10

[Install]
WantedBy=multi-user.target
