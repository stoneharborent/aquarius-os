# ==============================================================================
# AquariusOS — fetch the creator apps the first time this machine is online
# ==============================================================================
# PLAIN ENGLISH
#
# The operating system ships a shopping list of apps
# (/usr/share/flatpak/preinstall.d/). Somebody has to actually go and get them.
# On AquariusOS that somebody is this service.
#
# ------------------------------------------------------------------------------
# WHY WE SHIP THIS AT ALL — Fedora does not
# ------------------------------------------------------------------------------
# This was checked rather than assumed, and the answer surprised us.
#
# `flatpak preinstall` is Flatpak's own built-in command for exactly this job,
# and `/usr/share/flatpak/preinstall.d/` is Flatpak's own folder. Both are real,
# both are documented (`man flatpak-preinstall`), and Fedora 44's flatpak
# package (1.18.2) creates that folder for us.
#
# But Fedora's flatpak package ships NO SERVICE THAT EVER RUNS THE COMMAND.
# Read its spec file: it installs flatpak-system-helper.service,
# flatpak-portal.service, flatpak-add-fedora-repos.service — and nothing that
# runs `flatpak preinstall`. On Fedora Workstation the app store does it. This
# image has two sessions, one of which is our own desktop with no app store
# running in the background, so waiting for somebody else to do it would mean a
# machine that never installs the apps it advertises.
#
# So AquariusOS supplies the one missing piece: the trigger. Everything else —
# the file format, the reading of it, the installing, and the rule that a
# removed app stays removed — is Flatpak's, not ours. We did not invent a
# mechanism; we started the one that was already there.
#
# It is a "oneshot": it runs, it finishes, it stays finished. It is not a
# background process eating memory forever.
#
# ------------------------------------------------------------------------------
# ⚠️ THIS SERVICE IS NOT SWITCHED ON, AND THAT IS DELIBERATE (2026-09-04)
# ------------------------------------------------------------------------------
# It used to start by itself at the first boot and fetch all sixteen apps
# whether or not anybody wanted them. It no longer does. There is no
# [Install] section below, so nothing enables it and nothing starts it on its
# own — it exists to be started BY HAND, or by `aq apps install --all`.
#
# WHY. Downloading roughly ten gigabytes of other people's software to a
# machine before its owner has said yes is a decision that belongs to the
# person, not to us. What replaces it is the app chooser: a window at the first
# login that shows what AquariusOS suggests, with the everyday ones already
# ticked, and installs exactly what is left ticked.
#
# The apps themselves have not changed and neither has the shopping list. What
# changed is who presses go.
# ==============================================================================

[Unit]
Description=Install the AquariusOS creator apps (Flatpaks)
Documentation=man:flatpak-preinstall(1)
Documentation=https://github.com/stoneharborent/aquarius-os/blob/main/docs/restart/creator-apps.md

# Downloading apps needs the internet, so wait for it. On a machine that is
# never connected this service simply keeps deferring — it never breaks a boot
# and it never blocks a login.
Wants=network-online.target
After=network-online.target

# The flatpak system helper is what actually performs a system-wide install.
After=flatpak-system-helper.service

# Nothing to do on a system without Flatpak.
ConditionPathExists=/usr/bin/flatpak

StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/libexec/aquarius-flatpak-preinstall

# It is only ever started by somebody asking for it, and somebody who asked is
# somebody waiting for an answer. So a failure is reported and left alone
# rather than retried quietly in the background: the person can read what went
# wrong and run it again. (While this started itself at boot it retried every
# two minutes, which was right for "this laptop has not met any Wi-Fi yet" and
# is wrong now.)
Restart=no

# Downloading several gigabytes over a slow connection must never be killed
# half way by a stopwatch.
TimeoutStartSec=infinity

# Be a good neighbour. This runs while somebody is trying to use their new
# computer, so it takes the processor and the disk only when nothing else
# wants them.
Nice=10
IOSchedulingClass=idle

# There is deliberately NO [Install] section. See the note at the top: nothing
# starts this on its own any more. `systemctl enable` on this unit will say
# "the unit files have no installation config", and that is the correct answer,
# not a fault.
