# ==============================================================================
# AquariusOS — install the creator Flatpaks the first time we are online
# ==============================================================================
# Plain English: the OS ships a shopping list of apps
# (/usr/share/flatpak/preinstall.d/). Somebody has to actually go and fetch
# them. On AquariusOS that somebody is this service.
#
# Why we need our own instead of using something Bazzite already has: Bazzite
# puts its default apps on the machine during INSTALLATION, from the USB stick.
# Our installer does not do that (it keeps the ISO small), and that route also
# does nothing for a machine that was switched over to AquariusOS from another
# image. Doing it here, on the running system, covers both cases with one
# mechanism. Bazzite's own bazzite-flatpak-manager.service is left alone — it
# does a different job (app permissions), and we run after it so we never race.
#
# It is a "oneshot": it runs, finishes, and stays finished. It is not a
# background process.
# ==============================================================================

[Unit]
Description=Install the AquariusOS creator apps (Flatpaks)
Documentation=man:flatpak-preinstall(1)
Documentation=https://github.com/stoneharborent/aquarius-os/blob/main/docs/creator-apps.md

# Downloading apps needs the internet, so wait for it. On a machine that is
# never connected this service simply keeps deferring — it never breaks a boot.
Wants=network-online.target
After=network-online.target

# Bazzite's own Flatpak housekeeping enables the Flathub app store. Running
# after it means Flathub is already switched on by the time we ask for anything.
After=bazzite-flatpak-manager.service

# Nothing to do on a system without Flatpak.
ConditionPathExists=/usr/bin/flatpak

# If it fails (usually: no internet yet), retry forever rather than giving up
# after five goes, which is systemd's default and is wrong for "wait until this
# laptop meets some Wi-Fi".
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/libexec/aquarius-flatpak-preinstall
Restart=on-failure
RestartSec=120

# Downloading several hundred megabytes over a slow connection must never be
# killed half way by a stopwatch.
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
