# =============================================================================
# aquarius-game-tidy.service — make "Log Out" mean "Log Out" again
# =============================================================================
# WHAT THIS IS FOR, IN PLAIN ENGLISH
#
# Switching between the desktop and Game Mode works by telling the login screen
# "log this person straight back in, one second after you appear" — otherwise
# every switch would stop at a password box, and you cannot type a password on
# a game controller.
#
# That setting does not switch itself off when the switch has finished. So
# without this service, once you had used Game Mode even once, choosing Log Out
# from the desktop menu would log you straight back in again — and Log Out would
# look broken for the rest of the day.
#
# So: when a DESKTOP session starts, on a computer whose boot setting is
# `desktop` (which is every AquariusOS desktop image), this takes that automatic
# login back off. The switch has landed; it is not needed any more.
#
# On a machine set to start IN Game Mode it does nothing, because there the
# automatic login is the whole point.
#
# It runs /usr/libexec/os-session-select --tidy, which decides all of that and
# never fails loudly: the worst case is that the automatic login stays on until
# the next restart, and nothing is broken.
#
# ⚠️ Switched on from /usr, like every AquariusOS service — see the long note in
# build_files/aq-lib.sh about why `systemctl enable` is not used on this kind of
# operating system.
#
# ⚠️ ConditionUser= — NOT FOR THE LOGIN SCREEN ITSELF. The login screen is a
# GNOME Shell too, and it reaches graphical-session.target like any desktop.
# Without these lines it would run this service the moment it appeared, see
# "GNOME", and try to take the password-free login off — in the middle of the
# very switch that login exists for, which would put the password box straight
# back.
#
# TWO lines are needed, and several ConditionUser= lines are ANDed together:
#
#   !@system         keeps out every ordinary service account (user number
#                    below 1000). That was the whole answer up to GDM 49,
#                    when the login screen ran as a real account called `gdm`.
#
#   !gdm-greeter     keeps out the login screen on GDM 50 and later, which is
#                    where this went wrong on 2026-09-19. GDM 50 runs the
#                    greeter as a systemd DYNAMIC user called `gdm-greeter`,
#                    with a home folder under /run/gdm and a user number
#                    handed out from the 61184–65519 range — which is NOT
#                    @system, so the line above does not catch it. The greeter
#                    really did start this service, twelve seconds after every
#                    logout, and only failed because pkexec refused it:
#
#                        pkexec[16481]: gdm-greeter: The value for the SHELL
#                        variable was not found in the /etc/shells file
#                        [USER=root] [COMMAND=/usr/libexec/aquarius-session-root
#                        switch-login off]
#
#                    "It fails, so it is fine" is not a design — and after the
#                    GDM 50 login fix it would no longer have failed.
#
# There is a second belt inside os-session-select --tidy itself, which refuses
# to run for a caller whose user number is outside the ordinary range, whose
# home folder is under /run/gdm, or whose desktop calls itself a Greeter.
# =============================================================================
[Unit]
Description=Take the Game Mode automatic login back off once the desktop is up
Documentation=https://github.com/stoneharborent/aquarius-os/blob/main/docs/restart/game-mode.md
After=graphical-session.target
PartOf=graphical-session.target
ConditionPathExists=/usr/libexec/os-session-select
ConditionUser=!@system
ConditionUser=!gdm-greeter

[Service]
Type=oneshot
ExecStart=/usr/libexec/os-session-select --tidy
RemainAfterExit=no
SuccessExitStatus=0 1

[Install]
WantedBy=graphical-session.target
