# ==============================================================================
# AquariusOS — drive icons on the desktop (and no app icons on it)
# ==============================================================================
# Plain English: this is the note that tells the machine "once somebody has
# logged in and their desktop is up, start the little drive-icon program and
# leave it running." The program itself, with all the reasoning written into it,
# is /usr/libexec/aquarius-desktop-volumes.
#
# ⚠️ THIS IS A *USER* SERVICE, and that is the whole point of it.
#   System services (the ones in /usr/lib/systemd/system/) run once for the
#   machine, as root, before anybody logs in. That is the wrong shape here,
#   because the thing being changed is a person's own Desktop folder — and two
#   people logged into the same machine have two different desktops.
#
#   A user service runs once per logged-in person, as that person, with access
#   to their home folder and their desktop's notifications. So it lives in
#   /usr/lib/systemd/user/ instead.
#
# WHY THIS REACHES ACCOUNTS THAT ALREADY EXIST
#   This is the part that matters, and it is why the service exists at all
#   rather than the work being done by the desktop layout script. The layout
#   script that builds the AquariusOS top bar and dock only ever runs for a
#   BRAND NEW account — KDE will not rearrange a desktop somebody already has.
#   Anything shipped that way would reach Royce's next fresh install and nobody
#   else.
#
#   A user service does not work like that. The build script switches it on with
#   `systemctl --global enable`, which registers it for every account on the
#   machine — the ones that exist today and the ones made tomorrow — and an OS
#   update refreshes it like any other file in /usr. Nothing is copied into
#   anybody's home folder and nothing has to be clicked once.
#
# TO SEE WHAT IT IS DOING
#   systemctl --user status aquarius-desktop-volumes
#   journalctl --user -u aquarius-desktop-volumes
#
# TO TURN IT OFF FOR YOURSELF (it is a default, not a rule)
#   Either switch the behaviour off in ~/.config/aquarius-desktop.conf — see the
#   program's own comments — or stop the service outright:
#     systemctl --user mask --now aquarius-desktop-volumes
# ==============================================================================

[Unit]
Description=Show mounted drives on the desktop (AquariusOS)
Documentation=https://github.com/stoneharborent/aquarius-os/blob/main/docs/drives-and-desktop-icons.md

# graphical-session.target is systemd's name for "this person's desktop is now
# running". Two lines, doing two different jobs:
#   After=    do not start until the desktop is up, so there is something to put
#             icons on and something listening for notifications.
#   PartOf=   stop again when the desktop goes away. This is also what keeps it
#             out of sessions that have no desktop at all — an SSH login never
#             reaches graphical-session.target, so this never starts there.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/libexec/aquarius-desktop-volumes

# If it ever falls over, start it again after ten seconds. Losing your drive
# icons because of one bad moment would be a silly way to fail.
Restart=on-failure
RestartSec=10

# This is a housekeeping program, not something you are waiting on. Let it have
# the leftovers of the processor and the disk, so it can never be the reason
# something you are actually doing feels slow.
Nice=10
IOSchedulingClass=idle

# A little belt-and-braces. These three say "this program may never gain more
# power than it started with", and they are the ones that work reliably in a
# USER service — the heavier sandboxing options (ProtectSystem, PrivateTmp and
# friends) need privileges a user's own systemd does not always have, and a
# service that refuses to start because of a hardening line it could not apply
# would be a worse outcome than a slightly less locked-down housekeeping script.
#
# ⚠️ Do not add ProtectSystem=strict here. It makes the WHOLE filesystem
# read-only, the home folder included, and writing to the Desktop folder is the
# one thing this program exists to do.
NoNewPrivileges=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes

[Install]
WantedBy=graphical-session.target
