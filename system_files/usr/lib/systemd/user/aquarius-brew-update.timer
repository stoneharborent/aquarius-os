# ==============================================================================
# AquariusOS — ask about once a week for Homebrew's latest catalogue
# ==============================================================================
# PLAIN ENGLISH
#
# This is the part that WAITS. It does nothing itself: it asks systemd to start
# aquarius-brew-update.service about once a week, and that service is what runs
# `brew update`.
#
# WHY THE TIMES ARE THE WAY THEY ARE
#
#   OnStartupSec=30min    Not at login. The first half hour after somebody sits
#                         down is the half hour they are opening a project and
#                         the machine is busiest, and refreshing a list of
#                         software nobody has asked for yet is the least urgent
#                         thing on this computer.
#   OnUnitActiveSec=1w    Then once a week. Homebrew's catalogue changes every
#                         day, but nothing goes wrong from being seven days
#                         behind — `brew install` refreshes on its own when it
#                         needs to. Weekly is enough to make the common case
#                         fast without spending anybody's data on it.
#   RandomizedDelaySec=1h A different moment on every machine. Homebrew's
#                         servers should not see every AquariusOS in the world
#                         knock at the same second.
#   Persistent=true       A machine that was switched off when the week rolled
#                         over does the missed refresh shortly after it comes
#                         back, rather than waiting another full week.
#
# ⚠️ IT IS SWITCHED ON FROM /usr, NOT FROM /etc. The "wants" link lives at
# /usr/lib/systemd/user/timers.target.wants/, which is replaced whole by every
# operating-system update. A link in /etc can be deleted by a local `disable`,
# and this kind of operating system then preserves that deletion forever — the
# timer would be off on that one machine for good, and no image could switch it
# back on. Royce hit exactly that on the bench. The long version is in
# build_files/aq-lib.sh next to aq_unit_is_on_from_usr.
#
# THE HONEST COST OF THAT: `systemctl --user disable` will not turn this off,
# because there is nothing in /etc to remove. This does:
#
#     systemctl --user mask aquarius-brew-update.timer
#
# and it needs no password, because it is your own session.
# ==============================================================================

[Unit]
Description=Ask about once a week for Homebrew's latest catalogue
Documentation=https://github.com/stoneharborent/aquarius-os/blob/main/docs/restart/homebrew.md
Wants=network-online.target

[Timer]
OnStartupSec=30min
OnUnitActiveSec=1w
RandomizedDelaySec=1h
Persistent=true
Unit=aquarius-brew-update.service

[Install]
WantedBy=timers.target
