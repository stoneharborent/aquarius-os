# =============================================================================
# aquarius-automount — mount external drives automatically, started at login
# =============================================================================
# WHAT THIS IS
#
# A USER service: it belongs to one logged-in person, starts when they log in,
# stops when they log out, and runs as them with no special powers. That is the
# right shape, because mounting a drive you plugged in is a personal thing and
# it needs no administrator — the polkit rule at
# /usr/share/polkit-1/rules.d/49-aquarius-udisks.rules lets the person at the
# screen do it with no password.
#
# It runs in BOTH desktops. The link that switches it on lives at
#   /usr/lib/systemd/user/graphical-session.target.wants/aquarius-automount.service
# and graphical-session.target is reached by GNOME and by the Aquarius (labwc)
# session alike, so one link covers both. The program itself is the same either
# way — it talks to udisks2, which does not care which desktop is drawing.
#
# -----------------------------------------------------------------------------
# HOW TO CONTROL IT BY HAND
# -----------------------------------------------------------------------------
#   systemctl --user status aquarius-automount    is it running?
#   systemctl --user restart aquarius-automount   restart it
#   systemctl --user mask --now aquarius-automount turn it off for you (see below)
#   systemctl --user unmask aquarius-automount     undo that
#   journalctl --user -u aquarius-automount -b     what it has mounted this login
#
# -----------------------------------------------------------------------------
# WHY THERE IS NO "ENABLE" STEP, AND HOW YOU REALLY TURN IT OFF
# -----------------------------------------------------------------------------
# AquariusOS ships this switched ON, by a link inside the read-only half of the
# system (the .wants link above). That is what makes it true on every machine
# from the first boot, rather than relying on an install-time step in /etc that
# an update could lose. The full reasoning is in aq-lib.sh, next to
# aq_unit_is_on_from_usr.
#
# The cost of that choice, written down because it surprises people:
# `systemctl --user disable` has nothing in /etc to remove, so it does not turn
# this off. `systemctl --user mask --now aquarius-automount` does — that writes
# to /etc and wins. udisks2 still lets you mount by hand from the dock or Files
# afterwards; you just lose the "mounts by itself when you plug it in" part.
# =============================================================================

[Unit]
Description=Aquarius — mount external drives automatically when you plug them in
Documentation=file:///usr/libexec/aquarius-automount

# If the graphical session ends, this ends with it. There is no reason to keep
# watching for drives once the person has logged out.
PartOf=graphical-session.target
After=graphical-session.target

# -----------------------------------------------------------------------------
# THE LOGIN SCREEN MUST NOT RUN THIS.
# -----------------------------------------------------------------------------
# The .wants link lives in /usr/lib/systemd/user, which applies to every account
# that gets a graphical session — and the login screen (the `gdm` account) is
# one of those. Auto-mounting a person's USB stick at the login screen, before
# anybody has logged in, is not something anybody asked for and not something we
# want the login account doing. `!@system` means "not a system account", so this
# runs for people and not for the machine's own plumbing. This mirrors the same
# line on aquarius-keys.service, added for the same reason on 2026-09-03.
ConditionUser=!@system

# It is allowed to retry forever (see Restart= below), so the rate limiter that
# would otherwise stop it is switched off.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/libexec/aquarius-automount

# The system bus, or udisks2, can be a second or two behind a fresh login. A
# watcher that tries once, finds no bus, and gives up would leave you with no
# auto-mounting for the whole session. So it retries, quietly, until it can
# connect. The program exits 75 ("try again later") when the bus is not there
# yet, which is a retry; a clean exit 0 (from --once, never from the service)
# is not restarted.
Restart=on-failure
RestartSec=2
SuccessExitStatus=0

[Install]
WantedBy=graphical-session.target
