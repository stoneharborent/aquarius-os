#!/usr/bin/bash
# =============================================================================
# os-session-select — the hinge the whole Game Mode switch turns on
# =============================================================================
# WHAT THIS IS, IN PLAIN ENGLISH
#
# AquariusOS can show you two completely different faces:
#
#   * THE DESKTOP — GNOME or KDE Plasma, windows, Files, Resolve. What you work
#     in.
#   * GAME MODE — Steam owning the whole screen, driven with a controller from
#     the sofa. The same thing a Steam Deck shows.
#
# This little program is what moves you between them. It does not do the moving
# itself: it writes down where you want to go next, and then the session you are
# in ends. The login screen reads what was written down and takes you there.
#
# ⚠️ EVERY SWITCH IS A FULL LOGOUT. Not a pause, not a background desktop — your
# desktop session really closes, and unsaved work really is lost. That is not a
# shortcut we took; it is how Game Mode works on every Linux that has it,
# because the graphics card cannot sanely be shared by two of these at once (on
# NVIDIA, trying it freezes the machine — the bench proved that on 2026-09-17).
# So every button that leads here warns first.
#
# WHO CALLS IT
#   * Steam, from its power menu → "Switch to Desktop". Steam runs
#     `steamos-session-select desktop`, a script that comes with the Game Mode
#     package, and the only thing that script does is look for THIS file and
#     `exec` it — hand over to it completely. That is the hook we are filling
#     in, and it means that on the way back ENDING THE SESSION IS OUR JOB TOO
#     (the note above aq_end_game_session says what happened when it was not).
#   * Our own "Game Mode" icon in the app grid, and `aq game`. There
#     the caller ends the desktop itself after we return.
#
# WHAT IT ACTUALLY WRITES
#   1. Which session the login screen should start for you next time
#      (`Session=` in your account's file under /var/lib/AccountsService/users).
#   2. A password-free login for that one switch, so it does not stop to ask
#      for a password — you cannot type a password with a game controller.
#      Since GDM 50 that means TWO settings written together, the timed login
#      and the automatic one; the long reason is in the `switch-login` job of
#      /usr/libexec/aquarius-session-root.
#   3. Which DESKTOP you came from, so that "Switch to Desktop" puts you back in
#      GNOME if you were in GNOME and in Plasma if you were in Plasma. That one
#      is remembered in your own home folder, because it is yours:
#          ~/.local/state/aquarius/desktop-session
#
# Steps 1 and 2 need an administrator, so they are handed to
# /usr/libexec/aquarius-session-root through pkexec. On this computer, for the
# person at the screen, that happens with no password box (see that program's
# header for exactly who is allowed and why).
#
# Plain-language guide: docs/restart/game-mode.md
# =============================================================================

set -uo pipefail

AQ_ROOT_HELPER="/usr/libexec/aquarius-session-root"
AQ_GAME_SESSION="gamescope-session-steam"
AQ_STATE_DIR="${XDG_STATE_HOME:-${HOME:-/tmp}/.local/state}/aquarius"
AQ_REMEMBERED="${AQ_STATE_DIR}/desktop-session"
AQ_FLAG_FILE="/etc/aquarius/login-mode"

# ⚠️ EVERYTHING SAID HERE ALSO GOES TO THE JOURNAL. This runs while the screen
# is being taken away — from a desktop that is closing, or from inside Steam,
# where there is no terminal at all. On 2026-09-19 a switch went wrong and the
# only record of what this program had decided was in nobody's hands. Now it is
# in `journalctl -t os-session-select`.
say() {
    echo "os-session-select: $*"
    logger -t os-session-select -- "$*" 2> /dev/null || true
}
die() {
    echo "os-session-select: $*" >&2
    logger -t os-session-select -p user.err -- "ERROR: $*" 2> /dev/null || true
    exit 1
}

[ "$(id -u)" != "0" ] || die "do not run this as root. Run it as yourself; it asks for what it needs."
[ -x "${AQ_ROOT_HELPER}" ] || die "${AQ_ROOT_HELPER} is missing from this copy of AquariusOS. That is a fault in the operating system."

# -----------------------------------------------------------------------------
# Which desktop am I in right now?
# -----------------------------------------------------------------------------
# Answers with the name of a session file this image ships — `gnome` or
# `plasma` — or nothing at all if we are not in a desktop (which is the case
# when Steam calls this from inside Game Mode).
#
# The desktop announces itself in XDG_CURRENT_DESKTOP ("GNOME" or "KDE"). When
# that is empty — a systemd user service only sees what the desktop pushed into
# it — we ask what is actually running, the same way aquarius-keys-run does.
aq_current_desktop() {
    local d="${XDG_CURRENT_DESKTOP:-}"
    if [ -z "${d}" ] && command -v systemctl > /dev/null 2>&1; then
        d="$(systemctl --user show-environment 2> /dev/null | sed -n 's/^XDG_CURRENT_DESKTOP=//p' | tail -n 1)"
    fi
    case "${d}" in
        *[Gg][Nn][Oo][Mm][Ee]*)
            # The same trap as in aquarius-keys-run: the user's systemd manager
            # remembers the LAST desktop it was told about within a boot, so a
            # person who used GNOME this morning and Plasma now can still have
            # the word GNOME sitting there. Ask what is running.
            if pgrep -x gnome-shell > /dev/null 2>&1; then
                echo gnome
            elif pgrep -x kwin_wayland > /dev/null 2>&1; then
                echo plasma
            else
                echo gnome
            fi
            ;;
        *[Kk][Dd][Ee]* | *[Pp][Ll][Aa][Ss][Mm][Aa]*) echo plasma ;;
        *[Gg][Aa][Mm][Ee][Ss][Cc][Oo][Pp][Ee]*) echo "" ;;
        *)
            if pgrep -x gnome-shell > /dev/null 2>&1; then
                echo gnome
            elif pgrep -x kwin_wayland > /dev/null 2>&1; then
                echo plasma
            else
                echo ""
            fi
            ;;
    esac
}

# -----------------------------------------------------------------------------
# Which desktop should "Switch to Desktop" take me back to?
# -----------------------------------------------------------------------------
# The one we wrote down on the way into Game Mode. If there is nothing written
# down — a machine that booted straight into Game Mode and has never been to a
# desktop — the answer is GNOME, which every AquariusOS image has.
aq_remembered_desktop() {
    local d=""
    [ -r "${AQ_REMEMBERED}" ] && d="$(tr -d '[:space:]' < "${AQ_REMEMBERED}")"
    case "${d}" in
        gnome | plasma) echo "${d}" ;;
        *) echo gnome ;;
    esac
}

aq_remember_desktop() {
    local d="$1"
    [ -n "${d}" ] || return 0
    mkdir -p "${AQ_STATE_DIR}" 2> /dev/null || return 0
    printf '%s\n' "${d}" > "${AQ_REMEMBERED}" 2> /dev/null \
        && say "remembered that you came from ${d}; Switch to Desktop will bring you back here."
}

# -----------------------------------------------------------------------------
# What does a cold boot do on this machine?
# -----------------------------------------------------------------------------
aq_boot_mode() {
    local m="desktop"
    if [ -r "${AQ_FLAG_FILE}" ]; then
        m="$(sed -n 's/^[[:space:]]*mode[[:space:]]*=[[:space:]]*\([a-z]*\).*/\1/p' "${AQ_FLAG_FILE}" | tail -n 1)"
    fi
    case "${m}" in
        game) echo game ;;
        *) echo desktop ;;
    esac
}

# -----------------------------------------------------------------------------
# --tidy — make "Log Out" mean "Log Out" again
# -----------------------------------------------------------------------------
# ⚠️ THE PROBLEM THIS SOLVES, BECAUSE IT IS NOT OBVIOUS.
#
# The switch works by telling the login screen "log this person straight back
# in". That setting stays switched on after the switch has finished. So if you
# then choose Log Out from the desktop menu — a normal thing to do, nothing to
# do with games — the login screen would log you straight back in, and Log Out
# would look broken.
#
# So when a DESKTOP session starts on a computer whose cold-boot setting is
# `desktop` (which is every AquariusOS desktop image), that automatic login is
# taken back off. The switch has landed; it is not needed any more.
#
# This runs from a small service at every login (aquarius-game-tidy.service).
# On a machine set to boot INTO Game Mode, nothing is taken off, because there
# the automatic login is the point.
# ⚠️ AND IT MUST NEVER RUN FOR THE LOGIN SCREEN. This is the second half of
# the 2026-09-19 fix; the first half is the two ConditionUser= lines in
# aquarius-game-tidy.service. GDM 50 runs the login screen as a systemd
# DYNAMIC user called `gdm-greeter`, whose user number comes from the
# 61184–65519 range — so it is not caught by "no system accounts", and the
# greeter really was starting this twelve seconds after every logout. If it
# ever succeeded it would take the password-free login off in the middle of
# the switch that login exists for, and the password box would come straight
# back. So this asks three questions, any one of which is a flat no:
#
#   * is the caller's user number outside the ordinary range for a person
#     (1000–59999)? Dynamic users are above it; service accounts are below it.
#   * is the caller's home folder under /run/gdm? That is where GDM puts the
#     greeter's throwaway home.
#   * does the desktop call itself a Greeter? GDM's own login screen says
#     "GNOME-Greeter:GNOME".
#
# It exits 0, because there is nothing wrong: this simply is not that
# service's business. The one line it prints is in the journal for the day
# somebody wonders why nothing happened.
aq_not_a_person() {
    local uid
    uid="$(id -u 2> /dev/null)"
    case "${uid}" in
        "" | *[!0-9]*) return 1 ;;
    esac
    [ "${uid}" -ge 1000 ] && [ "${uid}" -le 59999 ] || return 0
    case "${HOME:-}" in
        /run/gdm | /run/gdm/*) return 0 ;;
    esac
    case "${XDG_CURRENT_DESKTOP:-}" in
        *[Gg][Rr][Ee][Ee][Tt][Ee][Rr]*) return 0 ;;
    esac
    return 1
}

aq_tidy() {
    if aq_not_a_person; then
        say "this is the login screen (or another account that is not a person's), so there is nothing to tidy."
        exit 0
    fi
    if [ "$(aq_boot_mode)" = "game" ]; then
        say "this computer is set to start in Game Mode, so the automatic login stays switched on."
        exit 0
    fi
    if [ -z "$(aq_current_desktop)" ]; then
        say "this is not a desktop session, so nothing to tidy."
        exit 0
    fi
    # Non-interactive on purpose: at login there is nobody watching a password
    # box, and if polkit says no, nothing bad happens — the automatic login just
    # stays on until the next restart.
    if pkexec --disable-internal-agent "${AQ_ROOT_HELPER}" switch-login off; then
        say "the login screen will ask who you are again, so Log Out behaves normally."
    else
        say "NOTE: could not switch the automatic login back off. Log Out may log"
        say "you straight back in until this computer is restarted. Nothing is broken."
    fi
    exit 0
}

# -----------------------------------------------------------------------------
# Ending Game Mode, when it is Game Mode that called us
# -----------------------------------------------------------------------------
# ⚠️ THE 2026-09-19 BUG, AND WHY THIS EXISTS.
#
# "Switch to Desktop" in Steam's power menu sat on its "Switching to Desktop…"
# card for ever, and the machine had to be rebooted. The reason is in Steam's
# own script: `steamos-session-select` looks for this file and does
#
#     exec /usr/libexec/os-session-select desktop
#
# `exec` — it REPLACES ITSELF with us. Nothing runs after we return. The only
# other line in that script, `steam -shutdown`, is what runs when this file is
# NOT there; the moment we exist, ending the session is our job, and this
# program used to write two settings and stop. Steam waited for a session end
# that nobody had asked for.
#
# On the desktop side this was never a problem: aquarius-game-mode logs the
# desktop out itself after calling us. So the two directions are made to match:
# whoever is on the far side of a switch, the switch ends the session it was
# called from.
#
# HOW GAME MODE ENDS. `steam -shutdown` asks the running Steam to quit, the
# same thing Steam's own script would have done. When Steam exits, the session
# script (gamescope-session-plus) closes gamescope and returns, the systemd
# unit behind the session stops, and the session is over — the login screen
# then reads what we wrote and brings the desktop back. If Steam is not there
# to ask, the unit is stopped directly; if even that fails, logind ends the
# session, which is blunt but always works.
aq_end_game_session() {
    if command -v steam > /dev/null 2>&1 && pgrep -x steam > /dev/null 2>&1; then
        say "asking Steam to close, which ends Game Mode."
        if steam -shutdown > /dev/null 2>&1; then
            return 0
        fi
        say "Steam did not take the request; stopping the session directly."
    fi
    if command -v systemctl > /dev/null 2>&1 \
        && systemctl --user is-active --quiet gamescope-session-plus@steam.service 2> /dev/null; then
        say "stopping the Game Mode session unit."
        systemctl --user stop --no-block gamescope-session-plus@steam.service && return 0
    fi
    if command -v loginctl > /dev/null 2>&1; then
        say "ending this session through logind."
        loginctl terminate-session "${XDG_SESSION_ID:-self}" && return 0
    fi
    say "WARNING: could not end Game Mode from here. Hold the power button, or"
    say "press Ctrl+Alt+F3 for a text login and run: loginctl terminate-user ${USER}"
    return 1
}

# =============================================================================
# Here we go
# =============================================================================
aq_target="${1:-gamescope}"
[ "${aq_target}" = "--tidy" ] && aq_tidy

# Where am I calling from? Empty means "not a desktop" — inside Game Mode.
aq_from="$(aq_current_desktop)"

# -----------------------------------------------------------------------------
# ⚠️ THE WORD `plasma` FROM STEAM IS NOT A CHOICE. (Bench 3, 2026-09-20.)
# -----------------------------------------------------------------------------
# This is the trap that cost us a bench run, and it looks like a feature.
#
# Steam's power menu has ONE button out of Game Mode: "Switch to Desktop". It
# does not ask you which desktop. But the SteamOS script it runs was written
# for a computer where the desktop is always KDE Plasma, so the word it passes
# down to us is hard-coded — it is always one of:
#
#     desktop   plasma   plasma-wayland-persistent   plasma-x11-persistent
#
# In SteamOS's vocabulary `plasma` IS the word for "the desktop". It is not the
# user picking Plasma over GNOME; the user was never asked.
#
# This program used to take the word literally whenever the named session file
# existed — and on AquariusOS BOTH desktops ship, so `plasma.desktop` always
# exists. The result: Switch to Desktop always landed in Plasma, no matter
# which desktop you had left. Royce hit it on 2026-09-20 with GNOME remembered:
#
#     steam[12934]: os-session-select: asked for 'plasma' from 'Game Mode'; next session: plasma
#
# and Plasma then failed to light any screen on his NVIDIA + AMD-iGPU machine,
# so the bug arrived as a black monitor rather than as "wrong desktop".
#
# SO: EVERY WORD STEAM CAN PASS MEANS "THE DESKTOP I CAME FROM". There is no
# literal-name branch here any more, deliberately, and there must not be one
# added back — the memory in ~/.local/state/aquarius/desktop-session is the
# only thing that decides, with GNOME as the fallback when there is nothing
# written down. Nothing in AquariusOS asks this program for a desktop by name:
# `aq game` and the app-grid launcher only ever go the other way, into Game
# Mode (`/usr/libexec/aquarius-game-mode` calls us with `gamescope`). If a
# by-name switch is ever wanted for a person, give it a spelling Steam cannot
# produce — a `--to gnome` / `--to plasma` flag — never a bare word.
# -----------------------------------------------------------------------------
case "${aq_target}" in
    gamescope | game)
        aq_session="${AQ_GAME_SESSION}"
        aq_remember_desktop "${aq_from}"
        ;;
    desktop | plasma | plasma-wayland-persistent | plasma-x11-persistent | gnome)
        # All five words mean the same thing: take me back to my desktop.
        aq_session="$(aq_remembered_desktop)"
        ;;
    *)
        die "'${aq_target}' is not a session this computer knows. The answers are 'gamescope' and 'desktop'."
        ;;
esac

say "asked for '${aq_target}' from '${aq_from:-Game Mode}'; next session: ${aq_session}"

# -----------------------------------------------------------------------------
# The two root jobs
# -----------------------------------------------------------------------------
# ⚠️ ORDER MATTERS. The session has to be written down BEFORE the automatic
# login is switched on, because the automatic login is what reads it.
if ! pkexec --disable-internal-agent "${AQ_ROOT_HELPER}" set-session "${USER}" "${aq_session}"; then
    die "could not tell the login screen which session to start. Nothing has been changed."
fi

# ⚠️ WHAT HAPPENS IF THE PASSWORD-FREE LOGIN CANNOT BE SWITCHED ON depends on
# which way we are going, and the difference is deliberate.
#
#   * FROM A DESKTOP, this is fatal. The person is at a keyboard, nothing has
#     been closed yet, and the message can be read. Going ahead would close
#     every window and then stop at a password box — which is exactly what
#     happened on 2026-09-19, when this was a warning printed to a terminal
#     that was about to disappear.
#   * FROM GAME MODE, it is a warning and we go on. The alternative to "type
#     your password once" is "stay stuck in Steam", and that is worse.
if ! pkexec --disable-internal-agent "${AQ_ROOT_HELPER}" switch-login on "${USER}"; then
    if [ -n "${aq_from}" ]; then
        # Put the session back the way it was, so a half-done switch does not
        # quietly change what the login screen offers next time.
        pkexec --disable-internal-agent "${AQ_ROOT_HELPER}" set-session "${USER}" "${aq_from}" > /dev/null 2>&1 || true
        die "could not switch on the password-free login, so the switch would have stopped at a password box. Nothing has been closed. The reason is in: journalctl -t aquarius-session-root -t polkitd"
    fi
    say "WARNING: could not switch the automatic login on. The switch will still"
    say "work — you will be asked for your password once at the login screen."
fi

# -----------------------------------------------------------------------------
# And make the login screen read what we just wrote
# -----------------------------------------------------------------------------
# ⚠️ WHY THIS HAPPENS NOW AND NOT AFTER THE SESSION ENDS. GDM reads
# /etc/gdm/custom.conf when it is told to, not continuously. On Nobara — the one
# distribution that does this switch with GDM, and the source of this whole
# mechanism — the reload happens in a script that runs as the session is torn
# down. AquariusOS does it here instead, one moment earlier, because that is the
# last point at which OUR code is running before the session goes.
#
# Reloading while the session is still alive is safe — reload does not touch
# running sessions, it only re-reads settings (a SIGHUP, which GDM answers by
# re-reading custom.conf; that is in GDM's own main.c) — and by the time the
# login screen next appears, which is a second or two from now, it has the new
# ones.
pkexec --disable-internal-agent "${AQ_ROOT_HELPER}" reload-gdm || true

# -----------------------------------------------------------------------------
# Now end the session, if we are the one who has to
# -----------------------------------------------------------------------------
# From a desktop: not us. aquarius-game-mode called us and logs the desktop
# out itself, in the desktop's own language, once we return. From Game Mode:
# us — see aq_end_game_session for why.
if [ -z "${aq_from}" ]; then
    case "${aq_session}" in
        "${AQ_GAME_SESSION}")
            say "already in Game Mode and asked for Game Mode; nothing to end."
            ;;
        *)
            say "done. Ending Game Mode; the login screen will take you to ${aq_session}."
            aq_end_game_session
            ;;
    esac
    exit 0
fi

say "done. This session is about to end, and the login screen will take you to ${aq_session}."
