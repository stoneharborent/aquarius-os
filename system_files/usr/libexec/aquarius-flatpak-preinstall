#!/usr/bin/bash
# ==============================================================================
# AquariusOS — install the creator apps, and tell the person what is happening
# ==============================================================================
# PLAIN ENGLISH
#
# Read the shopping list the operating system ships
# (/usr/share/flatpak/preinstall.d/), install anything on it that is not here
# yet, grant the handful of extra permissions creator apps need, and say so on
# screen while it happens.
#
# ------------------------------------------------------------------------------
# WHO RUNS THIS, AND WHEN — read this before assuming it runs at boot
# ------------------------------------------------------------------------------
# It has four ways in, and only one of them happens on its own:
#
#   --catalog          the app list with names and descriptions, for the
#                      chooser window at first login. Reads only.
#   --list             the same list, IDs alone. Reads only.
#   --overrides-only   ONLY the extra permissions, none of the installing. This
#                      is the one that happens by itself, at every boot, run by
#                      aquarius-flatpak-overrides.service.
#   (no arguments)     install EVERYTHING on the list. Needs root. Run by hand,
#                      by `aq apps install --all`, or by starting
#                      aquarius-flatpak-preinstall.service — which is shipped
#                      deliberately NOT switched on, because ten gigabytes of
#                      other people's software is not ours to decide on. The
#                      chooser asks; this is the "give me the lot" path.
#
# ------------------------------------------------------------------------------
# THE FOUR RULES THIS SCRIPT FOLLOWS, IN ORDER OF IMPORTANCE
# ------------------------------------------------------------------------------
#   1. NEVER PUT BACK SOMETHING THE PERSON REMOVED. This is why the installing
#      is done by `flatpak preinstall` and not by a loop of our own: Flatpak
#      records that you uninstalled a preinstalled app and never offers it
#      again. A loop of `flatpak install` commands would cheerfully undo your
#      decision at every boot, and that is the behaviour this script exists to
#      avoid, not to have.
#   2. NEVER OVERWRITE A PERMISSION SOMEBODY SET THEMSELVES. The overrides we
#      ship are copied in only where no file exists yet.
#   3. NEVER WEDGE A BOOT. Every failure path ends in "try again later". It
#      never blocks a login and it never stops the machine starting.
#   4. BE HONEST ON SCREEN. It says what it is doing, how far along it is, and
#      what did not work, by name.
#
# ------------------------------------------------------------------------------
# HOW THE PROGRESS REPORT WORKS, AND WHY IT IS BUILT THIS WAY
# ------------------------------------------------------------------------------
# `flatpak preinstall` is one long command. It prints its own progress, but
# reading that output and turning it into a number would mean depending on the
# exact wording of another project's console messages — which changes without
# warning and would break silently.
#
# So we do not read its output at all. We start it, and then every twenty
# seconds we ASK THE SYSTEM a question it can always answer honestly: how many
# of the apps on the list are installed right now? That is `flatpak list`, and
# it is true regardless of what any message says. The notification counts up
# from that.
#
# This is the same rule the build scripts follow — trust content, never
# appearances.
# ==============================================================================

set -uo pipefail

LIST_DIRS=(/usr/share/flatpak/preinstall.d /etc/flatpak/preinstall.d)
CATALOG_FILE="/usr/share/aquarius/apps/catalog.ini"
OVERRIDE_SRC="/usr/share/aquarius/flatpak-overrides"
OVERRIDE_DST="/var/lib/flatpak/overrides"
STATE_DIR="/etc/aquarius"
STAMP_FILE="${STATE_DIR}/flatpak-preinstall-done"
LOG_TAG="AquariusOS creator apps:"

# Bump this by hand to make every machine do the whole thing again even though
# the script itself has not changed. The hash underneath means ordinary edits
# already cause a re-run on their own, so this is rarely needed.
VER=1
VER="${VER}-$(tr -d '[:space:]' < "$0" | sha256sum | cut -d ' ' -f 1)"

say() { echo "${LOG_TAG} $*"; }

# ------------------------------------------------------------------------------
# notify — put a sentence on the screen of everybody logged in
# ------------------------------------------------------------------------------
# This runs as root, and root has no desktop. A notification belongs to a
# person's session, so we go and find each logged-in person's message bus and
# send it there, as them.
#
# /run/user/<number>/bus is that bus, and it exists exactly while somebody is
# logged in. Nobody logged in yet (the very first boot often gets here before
# the login screen) means no notification, which is correct: there is nobody to
# read it, and the final one at the end will land.
#
# The "synchronous" hint is what makes the count REPLACE the previous line
# instead of stacking seventeen notifications down the side of the screen.
# Notification servers that do not know the hint simply ignore it.
notify() {          # notify <tag> <summary> <body>
    local tag="$1" summary="$2" body="$3" bus uid user
    command -v notify-send > /dev/null 2>&1 || return 0
    for bus in /run/user/*/bus; do
        [ -S "${bus}" ] || continue
        uid="${bus#/run/user/}"
        uid="${uid%/bus}"
        user="$(id -nu "${uid}" 2> /dev/null)" || continue
        [ -n "${user}" ] || continue
        runuser -u "${user}" -- env \
            DBUS_SESSION_BUS_ADDRESS="unix:path=${bus}" \
            notify-send \
            --app-name="AquariusOS" \
            --icon=aquarius-logo \
            --hint=string:x-canonical-private-synchronous:"${tag}" \
            "${summary}" "${body}" > /dev/null 2>&1 || true
    done
}

# ------------------------------------------------------------------------------
# wanted_ids — the app IDs on the shopping list
# ------------------------------------------------------------------------------
# Used only for counting and reporting. The installing is Flatpak's job, not
# this function's. A block looks like:
#
#     [Flatpak Preinstall com.obsproject.Studio]
#     Branch=stable
#
# and a block carrying Install=false is one somebody switched off, so it is not
# counted. A file in /etc wins over the same block in /usr by being read second.
#
# ⚠️ WHY THE FILE LIST IS BUILT UP BY HAND AND NOT JUST HANDED TO awk AS A
#    PATTERN. This function used to end with:
#
#        awk '…' /usr/share/flatpak/preinstall.d/*.preinstall \
#                /etc/flatpak/preinstall.d/*.preinstall
#
#    /etc/flatpak/preinstall.d/ is empty on a fresh machine — nobody has
#    changed anything yet — and when a pattern like that matches nothing, the
#    shell hands the pattern over UNCHANGED, as if it were a filename. awk is
#    then asked to read a file called "*.preinstall", cannot, and gives up on
#    the spot — before it has printed a single answer. The result was a list of
#    zero apps on every new machine, and the message "the shopping list is
#    empty" when the list was sitting right there with sixteen apps in it.
#    (Found on the bench, 2026-09-04.)
#
#    So: look at each candidate first, keep only the ones that really exist and
#    can be read, and give awk exactly those. No file, no awk run, no confusion
#    between "there is nothing to install" and "the reading went wrong".
# wanted_entries prints one line per app: the ID, a tab, and its branch (the
# version line it lives on — "stable" for almost everything). Everything else
# in this file, and the chooser window, is built on top of this one reading.
wanted_entries() {
    local d f
    local -a files=()
    for d in "${LIST_DIRS[@]}"; do
        for f in "${d}"/*.preinstall; do
            # -r is both tests at once: a pattern that matched nothing is not a
            # readable file, and neither is one we are not allowed to open.
            [ -r "${f}" ] && files+=("${f}")
        done
    done
    [ "${#files[@]}" -gt 0 ] || return 0
    awk '
        /^\[Flatpak Preinstall / {
            id = $3; sub(/\]$/, "", id); cur = id; want[id] = 1; next
        }
        /^[[:space:]]*Install[[:space:]]*=/ {
            v = tolower($0); sub(/.*=[[:space:]]*/, "", v); gsub(/[[:space:]]/, "", v)
            if (cur != "" && (v == "false" || v == "0" || v == "no")) delete want[cur]
        }
        /^[[:space:]]*Branch[[:space:]]*=/ {
            v = $0; sub(/.*=[[:space:]]*/, "", v); gsub(/[[:space:]]/, "", v)
            if (cur != "") branch[cur] = v
        }
        /^[[:space:]]*IsRuntime[[:space:]]*=/ {
            v = tolower($0); sub(/.*=[[:space:]]*/, "", v); gsub(/[[:space:]]/, "", v)
            if (cur != "" && (v == "true" || v == "1" || v == "yes")) runtime[cur] = 1
        }
        END {
            for (id in want)
                printf "%s\t%s\t%s\n", id,
                    (branch[id] == "" ? "stable" : branch[id]),
                    (runtime[id] ? "yes" : "no")
        }
    ' "${files[@]}" | sort -u
}

wanted_ids() { wanted_entries | cut -f 1; }

# ------------------------------------------------------------------------------
# catalog — the shopping list, with the human words added
# ------------------------------------------------------------------------------
# WHY THE HUMAN WORDS LIVE IN A SEPARATE FILE. A window that offers somebody a
# choice of apps needs a name, a sentence, and a category for each one. None of
# those are things a .preinstall file has a place for: that format is Flatpak's,
# and it has exactly three keys (Install, Branch, IsRuntime).
#
# We could have written extra keys into it anyway and relied on Flatpak's
# parser ignoring what it does not recognise — which it very probably would,
# today. We did not, for one reason: THAT FILE IS THE WHOLE FEATURE. If a
# future Flatpak ever gets stricter, the cost of being wrong is not a missing
# label in a window, it is a machine that installs no creator apps at all. So
# Flatpak's file stays exactly Flatpak's, and our words go beside it, in
# /usr/share/aquarius/apps/catalog.ini.
#
# The two files must agree, and the build enforces it: every app on the
# shopping list has to have an entry here, and every entry here has to be on
# the shopping list. Neither can drift without the build failing.
#
# ------------------------------------------------------------------------------
# THE OUTPUT OF `--catalog` IS A CONTRACT. Other programs read it — the app
# chooser window is written against it. One line per app, fields separated by a
# single TAB, always eight of them, always in this order:
#
#   1  id            com.obsproject.Studio
#   2  name          OBS Studio
#   3  description   one sentence, no tabs
#   4  category      Video | Audio | Design | Streaming | Utilities
#   5  recommended:  recommended:yes or recommended:no
#   6  runtime:      runtime:yes or runtime:no
#   7  requires:     requires:<app id>, or requires:- when nothing
#   8  branch:       branch:stable (or whatever the list says)
#
# Fields 5-8 carry their own name as a prefix so that a reader can check it is
# reading what it thinks it is reading, and so an extra field added later
# cannot be mistaken for one of these.
#
# "runtime:yes" means IT IS NOT AN APPLICATION — it is a plug-in or a system
# piece. A chooser must NOT show those as things to tick: they arrive with the
# app named in "requires:". Of the sixteen entries, eleven are apps a person
# picks and five are plug-ins that follow OBS Studio.
# ------------------------------------------------------------------------------
catalog() {
    local entries
    entries="$(wanted_entries)"
    # Silence here would be read by a chooser window as "there are no apps",
    # which is never true on an image that ships a list. Say what is wrong.
    if [ -z "${entries}" ]; then
        say "ERROR — the shipped app list could not be read; this is a bug in AquariusOS, not something you did" >&2
        return 1
    fi
    if [ ! -r "${CATALOG_FILE}" ]; then
        say "ERROR — ${CATALOG_FILE} is missing from this copy of AquariusOS; this is a bug in AquariusOS, not something you did" >&2
        return 1
    fi
    printf '%s\n' "${entries}" | awk -v cat="${CATALOG_FILE}" '
        BEGIN {
            FS = "\t"
            while ((getline line < cat) > 0) {
                if (line ~ /^[[:space:]]*[#;]/) continue
                if (line ~ /^[[:space:]]*\[/) {
                    cur = line
                    sub(/^[[:space:]]*\[/, "", cur); sub(/\][[:space:]]*$/, "", cur)
                    continue
                }
                if (cur == "" || index(line, "=") == 0) continue
                k = substr(line, 1, index(line, "=") - 1)
                v = substr(line, index(line, "=") + 1)
                gsub(/^[[:space:]]+/, "", k); gsub(/[[:space:]]+$/, "", k)
                gsub(/^[[:space:]]+/, "", v); gsub(/[[:space:]]+$/, "", v)
                gsub(/\t/, " ", v)
                val[cur, k] = v
            }
            close(cat)
        }
        {
            id = $1; br = $2; rt = $3
            name = val[id, "Name"]
            if (name == "") {
                printf "no catalog entry for %s\n", id > "/dev/stderr"
                bad = 1
                next
            }
            desc = val[id, "Description"]
            category = val[id, "Category"]
            rec = (tolower(val[id, "Recommended"]) == "true") ? "yes" : "no"
            req = val[id, "Requires"]
            if (req == "") req = "-"
            printf "%s\t%s\t%s\t%s\trecommended:%s\truntime:%s\trequires:%s\tbranch:%s\n",
                id, name, desc, category, rec, rt, req, br
        }
        END { if (bad) exit 3 }
    '
}

# Is there a shopping list in the image at all? Used to tell "this image ships
# no list" apart from "this image ships a list we failed to read", which are
# very different faults.
shipped_list_exists() {
    local f
    for f in /usr/share/flatpak/preinstall.d/*.preinstall; do
        [ -r "${f}" ] && return 0
    done
    return 1
}

# How many of those are installed right now, system-wide. Asked of the system,
# never remembered.
count_installed() {         # count_installed <id> <id> ...
    local have n=0 id
    have="$(flatpak list --system --columns=application 2> /dev/null || true)"
    for id in "$@"; do
        printf '%s\n' "${have}" | grep -qx "${id}" && n=$((n + 1))
    done
    printf '%s\n' "${n}"
}

# ------------------------------------------------------------------------------
# copy_overrides — the extra permissions creator apps need
# ------------------------------------------------------------------------------
# Flatpak reads system-wide permission overrides from ONE place and it is not
# in the image: /var/lib/flatpak/overrides/. On AquariusOS /var belongs to the
# machine rather than to the operating system, so anything written there during
# a build is thrown away at first boot. The files therefore ship read-only in
# the image and are copied here, on the machine.
#
# ⚠️ A FILE THAT ALREADY EXISTS IS NEVER TOUCHED. If you have ever run
# `flatpak override` or changed permissions in Flatseal, that file is yours and
# it stays yours through every system update.
#
# ⚠️ THIS MUST NOT DEPEND ON THE APPS BEING INSTALLED BY US. Since 2026-09-04
#    the apps arrive when a person picks them in the chooser, not from this
#    script — but the permissions still have to be in place, or OBS cannot see
#    a camera or a capture card and there is no message saying why. So this is
#    also run on its own, at every boot, by
#    aquarius-flatpak-overrides.service, through --overrides-only. Writing a
#    file that is already there is not an error and not a change, so running it
#    every boot costs nothing.
#
# The full explanation of what each one grants and why:
#   /usr/share/aquarius/flatpak-overrides/README.md
copy_overrides() {
    local src name
    [ -d "${OVERRIDE_SRC}" ] || return 0
    say "granting the extra permissions creator apps need"
    mkdir -p "${OVERRIDE_DST}"
    for src in "${OVERRIDE_SRC}"/*; do
        [ -f "${src}" ] || continue
        name="$(basename "${src}")"
        case "${name}" in
            README.md | *.md) continue ;;
        esac
        if [ -e "${OVERRIDE_DST}/${name}" ]; then
            say "  ${name}: a permission file already exists here — leaving yours alone"
            continue
        fi
        if install -m 0644 "${src}" "${OVERRIDE_DST}/${name}"; then
            say "  ${name}: granted"
        else
            say "  ${name}: could not be written (will be tried again)"
        fi
    done
}

# ==============================================================================
# 0. Asking it a question instead of setting it to work
# ==============================================================================
# `--list` prints the app IDs it would install, one per line, and stops. It
# changes nothing and needs no special powers, so anybody can run it and the
# build can run it too — which is the point: the fault this guards against was
# a reading fault, and the only honest way to catch a reading fault is to make
# the build read the real file with the real code and count the answers.
#
# `--dry-run` is the same thing under the name people reach for first.
case "${1:-}" in
    --list | --dry-run)
        wanted_ids
        exit 0
        ;;
    --catalog)
        catalog
        exit $?
        ;;
    --overrides-only)
        # Just the permissions, none of the installing. This is what
        # aquarius-flatpak-overrides.service runs at every boot.
        copy_overrides
        exit 0
        ;;
    -h | --help)
        say "usage: $0 [--list | --catalog | --overrides-only]"
        say "  no arguments   install every app on the list (needs root)"
        say "  --list         print the app IDs on the list, one per line, and stop"
        say "  --catalog      print the list with names and descriptions, and stop"
        say "  --overrides-only  only put the creator apps' extra permissions in place"
        exit 0
        ;;
esac

# ==============================================================================
# 1. Have we already finished, with this exact version of this script?
# ==============================================================================
if [ -r "${STAMP_FILE}" ] && [ "$(cat "${STAMP_FILE}")" = "${VER}" ]; then
    say "already done. Nothing to do."
    exit 0
fi

say "checking the list..."

# ==============================================================================
# 2. Read the list — and treat an empty answer as a fault, never as an answer
# ==============================================================================
# AquariusOS always ships a shopping list. So "there is nothing to install" is
# not a thing that can honestly happen here: it means the reading went wrong.
#
# THE OLD BEHAVIOUR, AND WHY IT WAS THE WORST POSSIBLE ONE. This used to shrug,
# say "nothing to install", and write the done-stamp — which is a promise never
# to look again. One bad reading on first boot therefore meant a machine that
# silently never got its creator apps, for good, with a cheerful message in the
# log saying everything was fine. (Bench, 2026-09-04.)
#
# Now it says so loudly, tells the person it is our bug and not theirs, leaves
# NO stamp, and exits non-zero so that systemd tries again and the machine
# shows up in `systemctl --failed` instead of looking healthy.
mapfile -t WANTED < <(wanted_ids)
TOTAL="${#WANTED[@]}"

if [ "${TOTAL}" -eq 0 ]; then
    if shipped_list_exists; then
        say "ERROR — the shipped list at /usr/share/flatpak/preinstall.d/ could not be read; this is a bug in AquariusOS, not something you did"
    else
        say "ERROR — this copy of AquariusOS ships no app list at /usr/share/flatpak/preinstall.d/ at all; this is a bug in AquariusOS, not something you did"
    fi
    say "no stamp is being written, so it will try again — and you can install"
    say "them yourself at any time with:  sudo flatpak preinstall -y --system"
    notify aq-apps "AquariusOS could not read its own app list" \
        "This is a fault in AquariusOS, not something you did. Your creator apps have not been installed. You can install them yourself in a terminal with: sudo flatpak preinstall -y --system"
    exit 1
fi

# ==============================================================================
# 3. Make sure the app store is switched on
# ==============================================================================
# The image ships Flathub's description at /usr/share/flatpak/remotes.d/ and
# Flatpak reads that folder by itself. Doing it again here is harmless
# (--if-not-exists) and means this still works if that ever changes. A failure
# on either line is not worth stopping for — the install below will report the
# real problem in plain words.
if [ -r /usr/share/flatpak/remotes.d/flathub.flatpakrepo ]; then
    flatpak remote-add --if-not-exists --system flathub \
        /usr/share/flatpak/remotes.d/flathub.flatpakrepo || :
else
    flatpak remote-add --if-not-exists --system flathub \
        https://dl.flathub.org/repo/flathub.flatpakrepo || :
fi
flatpak remote-modify --system --enable flathub || :

# ==============================================================================
# 4. Install, and count out loud while it happens
# ==============================================================================
BEFORE="$(count_installed "${WANTED[@]}")"
say "${TOTAL} apps on the list, ${BEFORE} already here."

if [ "${BEFORE}" -lt "${TOTAL}" ]; then
    notify aq-apps "Setting up your creator apps" \
        "AquariusOS is downloading ${TOTAL} apps in the background. You can carry on using the computer — this takes about ten to twenty minutes on a normal connection."
fi

# ------------------------------------------------------------------------------
# THE INSTALL ITSELF — Flatpak's own command, started in the background so this
# script can keep reporting while it works.
# ------------------------------------------------------------------------------
INSTALL_OK=0
if flatpak preinstall --help > /dev/null 2>&1; then
    say "using 'flatpak preinstall' (Flatpak's own mechanism)."
    flatpak preinstall -y --system --noninteractive &
    FLATPAK_PID=$!

    # Count up while it runs. Twenty seconds is often enough to see one more
    # app land and cheap enough to be free.
    while kill -0 "${FLATPAK_PID}" 2> /dev/null; do
        sleep 20
        kill -0 "${FLATPAK_PID}" 2> /dev/null || break
        NOW="$(count_installed "${WANTED[@]}")"
        if [ "${NOW}" -lt "${TOTAL}" ]; then
            notify aq-apps "Setting up your creator apps" \
                "${NOW} of ${TOTAL} installed. Still working — you can carry on using the computer."
        fi
    done

    if wait "${FLATPAK_PID}"; then
        INSTALL_OK=1
    else
        say "'flatpak preinstall' did not finish cleanly. What did and did not"
        say "arrive is reported below, and it will try again at the next start-up."
    fi
else
    # Should be impossible on Fedora 44 (flatpak 1.18) — kept because "the
    # command is missing" is a much nicer thing to survive than to debug.
    #
    # ⚠️ THIS PATH CANNOT HONOUR RULE 1. It has no way to know that you
    # uninstalled something on purpose, so it would put it back. That is why it
    # only ever runs when the proper command is absent entirely, never when the
    # proper command merely failed.
    say "WARNING — this Flatpak has no 'preinstall' command. Falling back to"
    say "installing app by app. This fallback cannot tell an app you removed on"
    say "purpose from one that was never installed."
    have="$(flatpak list --system --columns=application 2> /dev/null || true)"
    for id in "${WANTED[@]}"; do
        printf '%s\n' "${have}" | grep -qx "${id}" && continue
        say "  installing ${id}"
        flatpak install -y --system --noninteractive flathub "${id}" || \
            say "  COULD NOT INSTALL ${id} — will try again at the next start-up"
    done
    INSTALL_OK=1
fi

# ==============================================================================
# 5. The extra permissions creator apps need
# ==============================================================================
# Flatpak reads system-wide permission overrides from ONE place and it is not
# in the image: /var/lib/flatpak/overrides/. On AquariusOS /var belongs to the
# machine rather than to the operating system, so anything written there during
# a build is thrown away at first boot. The files therefore ship read-only in
# the image and are copied here, once, on the machine.
#
# ⚠️ A FILE THAT ALREADY EXISTS IS NEVER TOUCHED. If you have ever run
# `flatpak override` or changed permissions in Flatseal, that file is yours and
# it stays yours through every system update.
#
# The full explanation of what each one grants and why:
#   /usr/share/aquarius/flatpak-overrides/README.md
copy_overrides

# ==============================================================================
# 6. What happened, in one sentence
# ==============================================================================
# Three outcomes, and the exit code is how we ask systemd for the retry we want:
#
#   everything arrived   write the stamp, exit 0. Done forever.
#   some did not         exit 0 WITHOUT the stamp. No stamp means we run again
#                        at the next start-up, so a temporarily broken app gets
#                        another go tomorrow instead of being hammered every
#                        two minutes all day.
#   nothing arrived      exit 1 — which almost always means "no internet yet",
#                        and a non-zero exit is what makes systemd try again
#                        shortly.
AFTER="$(count_installed "${WANTED[@]}")"
MISSING=()
have="$(flatpak list --system --columns=application 2> /dev/null || true)"
for id in "${WANTED[@]}"; do
    printf '%s\n' "${have}" | grep -qx "${id}" || MISSING+=("${id}")
done

say "${AFTER} of ${TOTAL} apps are installed."

if [ "${#MISSING[@]}" -eq 0 ]; then
    mkdir -p "${STATE_DIR}"
    printf '%s\n' "${VER}" > "${STAMP_FILE}"
    [ "${BEFORE}" -lt "${TOTAL}" ] && notify aq-apps "Your creator apps are ready" \
        "All ${TOTAL} apps are installed. You will find them in the app grid."
    say "all present. Done."
    exit 0
fi

say "still missing: ${MISSING[*]}"

if [ "${AFTER}" -gt "${BEFORE}" ] || [ "${INSTALL_OK}" -eq 1 ]; then
    notify aq-apps "Most of your creator apps are ready" \
        "${AFTER} of ${TOTAL} installed. These could not be fetched this time and will be tried again automatically: ${MISSING[*]}"
    say "they will be tried again the next time this computer starts."
    exit 0
fi

notify aq-apps "Your creator apps are not installed yet" \
    "AquariusOS could not reach the app store — usually that just means this computer is not online yet. It will keep trying."
say "nothing could be installed — probably no internet yet. This will be retried automatically."
exit 1
