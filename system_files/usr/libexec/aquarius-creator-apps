            clamp = Adw.Clamp(maximum_size=620)
            clamp.set_child(box)
            scroller = Gtk.ScrolledWindow(vexpand=True)
            scroller.set_child(clamp)
            return scroller

        # -- page 3: done --------------------------------------------------
