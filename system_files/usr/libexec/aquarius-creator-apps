        # -- running the installer -----------------------------------------
        def _on_install_clicked(self, _button):
            chosen = [card.entry.app_id for card in self.cards.values() if card.chosen]
            self.start_install(resolve_install_set(self.entries, chosen))

        def _on_retry_clicked(self, _button):
            self.start_install(self.plan)

        def _on_retry_failed(self, _button):
            still = [e for e in self.plan if e.app_id in self.failures]
            if still:
                self.start_install(still)

        def start_install(self, plan):
            if not plan:
                return
            self.plan = plan
            self.failures = {}
            self.cancelled = False
            self.log.clear()
            self.bar.set_fraction(0.0)
            self.details.set_expanded(False)
            self.cancel_button.set_visible(True)
            self.cancel_button.set_sensitive(True)
            self.cancel_button.set_label("Cancel")
            self.copy_button.set_visible(False)
            self.retry_button.set_visible(False)
            self.working_close.set_visible(False)
            self.working_title.set_label("Installing your apps")
            self.working_blurb.set_label(
                "They arrive one at a time. You can leave this and come back — "
                "nothing is lost if you do."
            )
            self.footer.set_visible(False)

            for row in list(self.step_rows.values()):
                self.steps_group.remove(row)
            self.step_rows = {}
            for entry in plan:
                # Plug-ins are shown, but as what they are: a line under the app
                # rather than a thing somebody chose. Hiding them here would
                # make the progress bar move for reasons nobody could see.
                title = entry.name if not entry.runtime else "  " + entry.name
                row = StepRow(title)
                self.steps_group.add(row)
                self.step_rows[entry.app_id] = row

            self.header_title.set_subtitle("Installing")
            self.stack.set_visible_child_name("working")
            self._start_process(plan)

        def _start_process(self, plan):
            runtime_dir = GLib.get_user_runtime_dir() or GLib.get_tmp_dir()
            self.cancel_file = os.path.join(runtime_dir, "aquarius-creator-apps.cancel")
            try:
                if os.path.exists(self.cancel_file):
                    os.unlink(self.cancel_file)
            except OSError:
                pass

            argv = []
            if not DRY_RUN:
                # pkexec is the one and only place this feature asks for a
                # password, and it asks once for the whole run.
                argv.append("pkexec")
            argv += [INSTALLER, "--progress-fd", "2", "--cancel-file", self.cancel_file]
            if DRY_RUN:
                argv.append("--dry-run")
            argv += [entry.ref for entry in plan]

            self._append_log("$ %s\n" % " ".join(argv))
            try:
                self.proc = subprocess.Popen(
                    argv,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    start_new_session=True,
                    text=True,
                    errors="replace",
                    bufsize=1,
                )
            except OSError as exc:
                self._show_failure("The installer could not be started: %s" % exc)
                return

            threading.Thread(target=self._read_log, daemon=True).start()
            threading.Thread(target=self._read_progress, daemon=True).start()
            threading.Thread(target=self._wait_for_exit, daemon=True).start()

        def _read_log(self):
            for line in self.proc.stdout:
                GLib.idle_add(self._append_log, line)
            try:
                self.proc.stdout.close()
            except OSError:
                pass

        def _read_progress(self):
            for line in self.proc.stderr:
                GLib.idle_add(self._handle_progress, line.rstrip("\n"))
            try:
                self.proc.stderr.close()
            except OSError:
                pass

        def _wait_for_exit(self):
            code = self.proc.wait()
            GLib.idle_add(self._process_exited, code)

        # -- reacting ------------------------------------------------------
        def _handle_progress(self, line):
            # Anything unrecognised is dropped on purpose, so that a line added
            # to the script one day cannot break an older window. Unrecognised
            # lines still reach Details, because they came in on the same
            # channel and a person debugging deserves all of it.
            head, _, rest = line.partition(" ")
            if head == "STEP":
                index, _, _name = rest.partition(" ")
                position, _, total = index.partition("/")
                try:
                    n, total_n = int(position), int(total)
                except ValueError:
                    return GLib.SOURCE_REMOVE
                self.header_title.set_subtitle("App %d of %d" % (n, total_n))
                for i, entry in enumerate(self.plan, start=1):
                    row = self.step_rows.get(entry.app_id)
                    if row is None:
                        continue
                    if i == n:
                        row.set_state(ACTIVE)
                    elif i > n:
                        row.set_state(PENDING)
                return GLib.SOURCE_REMOVE

            if head == "PERCENT":
                try:
                    self.bar.set_fraction(min(100, max(0, int(rest))) / 100.0)
                except ValueError:
                    pass
                return GLib.SOURCE_REMOVE

            if head == "OK":
                row = self.step_rows.get(rest.strip())
                if row is not None:
                    row.set_state(DONE)
                return GLib.SOURCE_REMOVE

            if head == "FAILED":
                app_id, _, why = rest.partition(" ")
                row = self.step_rows.get(app_id)
                if row is not None:
                    row.set_state(FAILED)
                    row.set_subtitle(why)
                    row.set_subtitle_lines(0)
                self.failures[app_id] = why
                # A failure is the one thing worth showing without being asked.
                self.details.set_expanded(True)
                return GLib.SOURCE_REMOVE

            if head == "CANCELLED":
                self.cancelled = True
                return GLib.SOURCE_REMOVE

            if head == "FAIL":
                self._show_failure(rest.strip())
                return GLib.SOURCE_REMOVE

            if head == "DONE":
                return GLib.SOURCE_REMOVE

            self._append_log(line + "\n")
            return GLib.SOURCE_REMOVE

        def _process_exited(self, code):
            self.proc = None
            self.cancel_button.set_visible(False)
            self.refresh_installed()

            # pkexec's own codes, which are not the installer's. 126 is "you
            # said no, or nothing asked you"; 127 is "the asking itself failed".
            # Both need a different sentence from "an app would not install".
            if code in (126, 127) and not self.failures:
                # ⚠️ TELLING THE TWO APART MATTERS, AND THIS IS THE 2026-09-04
                # BENCH FAULT. "You said no" and "nothing was able to ask you"
                # look identical from here, and the second one is not something
                # a person can fix by pressing Try again — it is a fault in the
                # session, and saying "enter your password when asked" to
                # somebody who was never asked is the worst kind of wrong.
                #
                # pkexec says which it was, in the log we already have: with no
                # authentication agent registered it falls back to asking in a
                # terminal, finds there is no terminal behind a window, and
                # complains about /dev/tty.
                log = self.log.text()
                if "authentication agent" in log or "/dev/tty" in log:
                    self._show_failure(
                        "Nothing in this desktop session was able to ask you "
                        "for your password, so nothing was installed. That is "
                        "a fault in AquariusOS, not something you did.\n\n"
                        "Two ways round it: log out and back in (the part that "
                        "asks for passwords starts with the session, so a fresh "
                        "login often fixes it), or log into GNOME at the login "
                        "screen and install from there. Either way, the apps "
                        "are still waiting in Aquarius Apps."
                    )
                    return GLib.SOURCE_REMOVE
                self._show_failure(
                    "AquariusOS was not given permission to install apps for "
                    "this computer, so nothing was installed. Press Try again "
                    "and enter your password when asked."
                )
                return GLib.SOURCE_REMOVE

            if self.cancelled:
                self._show_done(cancelled=True)
                return GLib.SOURCE_REMOVE

            self._show_done(cancelled=False)
            return GLib.SOURCE_REMOVE

        def _show_done(self, cancelled):
            arrived = [e for e in self.plan if e.app_id not in self.failures]
            apps_arrived = [e for e in arrived if not e.runtime]

            if self.failures:
                names = [
                    e.name for e in self.plan if e.app_id in self.failures
                ]
                self.done_page.set_icon_name("dialog-warning-symbolic")
                self.done_page.set_title(
                    "%d of %d installed." % (len(arrived), len(self.plan))
                )
                self.done_page.set_description(
                    "These did not: " + ", ".join(names) + "."
                )
                self.done_detail.set_label(
                    "Nothing is broken and nothing is half-installed. Try them "
                    "again now, or later from Aquarius Apps."
                )
                self.done_detail.set_visible(True)
                self.done_retry.set_visible(True)
            elif cancelled:
                self.done_page.set_icon_name("emblem-ok-symbolic")
                self.done_page.set_title("Stopped, as you asked.")
                self.done_page.set_description(
                    "%d of %d were installed before it stopped. The rest are "
                    "waiting for you in Aquarius Apps."
                    % (len(arrived), len(self.plan))
                )
                self.done_detail.set_visible(False)
                self.done_retry.set_visible(False)
            else:
                self.done_page.set_icon_name("emblem-ok-symbolic")
                self.done_page.set_title("All set.")
                self.done_page.set_description(
                    "%d app%s installed and waiting in your apps."
                    % (len(apps_arrived), "" if len(apps_arrived) == 1 else "s")
                )
                self.done_detail.set_visible(False)
                self.done_retry.set_visible(False)

            if apps_arrived:
                self.first_app = apps_arrived[0]
                self.done_open.set_label("Open %s" % self.first_app.name)
                self.done_open.set_visible(True)
            else:
                self.first_app = None
                self.done_open.set_visible(False)

            self.header_title.set_subtitle("")
            self.stack.set_visible_child_name("done")

        def _show_failure(self, message):
            self.working_title.set_label("That did not work")
            self.working_blurb.set_label(message)
            self.bar.set_fraction(0.0)
            self.cancel_button.set_visible(False)
            self.copy_button.set_visible(True)
            self.retry_button.set_visible(True)
            self.working_close.set_visible(True)
            self.details.set_expanded(True)
            self.stack.set_visible_child_name("working")
            self.header_title.set_subtitle("")

        def _on_open_first(self, _button):
            if self.first_app is None:
                return
            try:
                subprocess.Popen(
                    ["flatpak", "run", self.first_app.app_id], start_new_session=True
                )
            except OSError:
                return
            self.close()

        def _on_cancel_clicked(self, _button):
            # Cancel is a note, not a knife — see the long comment in
            # aquarius-creator-apps-install. The button says so as soon as it is
            # pressed, so that "why is it still going?" never has to be asked.
            self.cancelled = True
            try:
                if self.cancel_file:
                    with open(self.cancel_file, "w", encoding="utf-8") as handle:
                        handle.write("stop\n")
            except OSError:
                pass
            self.cancel_button.set_sensitive(False)
            self.cancel_button.set_label("Stopping…")
            self.working_blurb.set_label(
                "Stopping. The app downloading right now will finish first — "
                "stopping in the middle is how you get a broken one."
            )

        # -- the log -------------------------------------------------------
        def _append_log(self, text):
            # One line into the shared Details log. Called from GLib.idle_add by
            # the threads reading the installer, hence the SOURCE_REMOVE.
            return self.log.append(text)

        # -- window plumbing -----------------------------------------------
        def _on_key(self, _controller, keyval, _keycode, _state):
            if keyval == Gdk.KEY_Escape and self.proc is None:
                self.close()
                return True
            return False

        def _on_close_request(self, _window):
            # Closing mid-install does NOT stop the install. It cannot: the
            # installing is being done by a program running as an administrator,
            # which this window is not allowed to kill — and abandoning a
            # half-written app would be worse than letting it finish. It carries
            # on and finishes; the apps simply appear.
            return False

    class ChooserApp(Adw.Application):
        def __init__(self, entries, warning):
            super().__init__(
                application_id=APP_ID, flags=Gio.ApplicationFlags.NON_UNIQUE
            )
            self.entries = entries
            self.warning = warning

        def do_activate(self):
            window = self.props.active_window
            if window is None:
                window = ChooserWindow(self, self.entries, self.warning)
            window.present()
            if first_run:
                write_stamp()

    # ----------------------------------------------------------------------
    if first_run and os.path.exists(stamp_path):
        # Already offered to this person once. Silence is the correct behaviour:
        # this is the login autostart, and a window that reappears every morning
        # is a window people learn to close without reading.
        return 0

    entries, _skipped, error = read_catalog(None)
    if error:
        # There is no honest window to draw without a list. Say so where a
        # person will see it — a desktop notification — and leave.
        print("aquarius-creator-apps: %s" % error, file=sys.stderr)
        try:
            subprocess.Popen(
                [
                    "notify-send",
                    "--app-name=Aquarius Apps",
                    "AquariusOS could not read its own list of apps",
                    error,
                ]
            )
        except OSError:
            pass
        return 1

    GLib.set_prgname(APP_ID)
    GLib.set_application_name("Aquarius Apps")
    app = ChooserApp(entries, None)
    return app.run([sys.argv[0]])


DRY_RUN = False


def main(argv):
    global DRY_RUN
    dry_run = False
    first_run = False
    catalog_from = None
    selection = None

    args = list(argv[1:])
    while args:
        arg = args.pop(0)
        if arg == "--dry-run":
            dry_run = True
        elif arg == "--first-run":
            first_run = True
        elif arg == "--catalog-from":
            catalog_from = args.pop(0) if args else None
        elif arg.startswith("--catalog-from="):
            catalog_from = arg.split("=", 1)[1]
        elif arg == "--select":
            selection = (args.pop(0) if args else "").split(",")
        elif arg.startswith("--select="):
            selection = arg.split("=", 1)[1].split(",")
        elif arg in ("-h", "--help"):
            print(
                "aquarius-creator-apps — the Aquarius Apps window\n"
                "\n"
                "    aquarius-creator-apps [--first-run]\n"
                "    aquarius-creator-apps --dry-run [--catalog-from FILE] [--select id,id]\n"
                "\n"
                "    --first-run        open only if this account has not been\n"
                "                       offered the apps before (used at login)\n"
                "    --dry-run          print what it read and what it would do,\n"
                "                       open no window, install nothing\n"
                "    --catalog-from F   read the app list from F instead of from\n"
                "                       the system, for testing the reading\n"
                "    --select a,b       pretend those apps were ticked\n"
                "\n"
                "The list of apps comes from %s --catalog." % CATALOG_CLI
            )
            return 0
        else:
            print(
                "aquarius-creator-apps: I do not understand '%s'." % arg,
                file=sys.stderr,
            )
            return 2

    if catalog_from or selection is not None:
        # These only make sense as a rehearsal, and quietly opening a real
        # window with a test file behind it would be a trap.
        dry_run = True

    if dry_run and not first_run:
        return rehearse(catalog_from, selection)

    DRY_RUN = dry_run
    return run_window(first_run)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
