#!/usr/bin/python3
# =============================================================================
# aquarius-installer — "Aquarius Installer", the one window that installs anything
# =============================================================================
# PLAIN ENGLISH
#
# Download something. Double-click it. This window opens, tells you what it is
# and where it is going to go, and you press Install. Then the icon is in your
# apps. That is the whole idea, and it is the same three seconds whatever the
# file was — an .rpm, a .deb, an AppImage, a .flatpakref, a tarball with a
# program inside it.
#
# It is also where you go to see what you have, take something away again, and
# update everything at once. And it has a search bar, so "I want OBS" does not
# need a website first.
#
# ⚠️ THE PERSON NEVER CHOOSES THE ROUTE. A sorter looks at the file and picks
#    the right one of a handful of ways to land it. All the deciding lives in
#    /usr/lib/aquarius/python/aquarius_installer.py, which has no window in it
#    and which `aq apps` calls too — so the terminal and this window can never
#    disagree about what a file is or where an app went.
#
# -----------------------------------------------------------------------------
# WHAT IT WILL NOT DO, AND SAYS SO
# -----------------------------------------------------------------------------
#   * It never changes the operating system. /usr is read-only here and updates
#     replace the whole image, which is exactly why updates always work. A
#     package that wants to be part of the system is refused, with the reason.
#   * It never runs a package's own install scripts. On any other Linux those
#     run as an administrator on your computer. Here they are not even read.
#   * It never runs `sudo`. The only password it can ever ask for is the
#     desktop's own prompt, once, for a Flatpak that goes to the whole computer.
#   * It never converts one kind of package into another. A `.deb` and an `.rpm`
#     are the same act here: open it, check it runs, put it in your apps.
#
# -----------------------------------------------------------------------------
# HOW TO RUN IT WITHOUT A SCREEN — which is how the build checks it
# -----------------------------------------------------------------------------
#     aquarius-installer --sort FILE       say what it is; change nothing
#     aquarius-installer --install FILE    install it, printing progress
#     aquarius-installer --list            what is on this computer
#     aquarius-installer --remove ID       take one away
#     aquarius-installer --updates         what has something newer
#     aquarius-installer --update-all      update everything that can be
#     aquarius-installer --search TERM     the three groups, as text
#     aquarius-installer --dry-run         a full rehearsal in a throwaway home
#
# ⚠️ aquarius_ui IS IMPORTED LATE, INSIDE run_window(), AND THAT IS LOAD-BEARING.
#    Importing it pulls GTK in, and every mode above has to work in a build
#    container with no screen. The chooser next door does the same thing for the
#    same reason and the build depends on it staying true.
# =============================================================================

import os
import selectors
import sys
import tarfile
import tempfile
import threading

sys.path.insert(0, "/usr/lib/aquarius/python")
import aquarius_installer as core  # noqa: E402

APP_ID = "org.aquariusos.Installer"
TITLE = "Aquarius Installer"

# The chooser next door, which is the first-login face of the same catalogue.
CHOOSER = "/usr/libexec/aquarius-creator-apps"
RESOLVE_SETUP = "/usr/libexec/aquarius-resolve-installer"

DRY_RUN = False


# =============================================================================
# THE FOUR PIECES THAT HAVE NO SCREEN IN THEM
# =============================================================================
# ⚠️ THEY LIVE OUT HERE ON PURPOSE. Everything below this line is ordinary
#    Python with no GTK anywhere in it, which means a test can run every one of
#    them on a machine with no desktop at all. Each one exists because of a
#    specific way the window misbehaved before 2026-09-13, and each one is the
#    part that was actually wrong.


def read_both_pipes(proc, on_stdout, on_stderr):
    """Read a helper's two pipes at the same time, and give back its exit code.

    ⚠️ READING ONE TO THE END AND THEN THE OTHER IS A DEADLOCK WAITING TO
    HAPPEN, and it was also plainly wrong: the helper is asked to report its
    progress on the second pipe, so every progress row sat unread until the
    whole job had finished and the bar jumped from nothing to done. Worse, a
    pipe nobody is reading fills up and stops the program writing to it — the
    helper would simply stand still for ever. So both are watched together.
    """
    pipes = selectors.DefaultSelector()
    leftovers = {}
    for handle, deliver in ((proc.stdout, on_stdout), (proc.stderr, on_stderr)):
        if handle is not None:
            pipes.register(handle, selectors.EVENT_READ, deliver)
            leftovers[handle] = ""
    try:
        while pipes.get_map():
            for key, _mask in pipes.select(timeout=0.25):
                handle = key.fileobj
                chunk = handle.readline()
                if not chunk:
                    if leftovers[handle]:
                        key.data(leftovers[handle])
                        leftovers[handle] = ""
                    pipes.unregister(handle)
                    handle.close()
                    continue
                if chunk.endswith("\n"):
                    key.data(leftovers[handle] + chunk)
                    leftovers[handle] = ""
                else:
                    leftovers[handle] += chunk
    finally:
        pipes.close()
    return proc.wait()


class LatestOnly:
    """Do a slow read in a thread, and throw away every answer but the newest.

    ⚠️ THE SEARCH BAR USED TO FREEZE THE WHOLE WINDOW, because asking the app
    store what has an update — a question that is allowed to take a minute and a
    half — happened on the drawing thread on every single keystroke. Typing
    "obs" stopped the window three times. The work goes in a thread now, and
    because somebody typing fast starts several, only the answer to the most
    recent question is ever used.
    """

    def __init__(self, work):
        self._work = work
        self._serial = 0
        self._lock = threading.Lock()

    def start(self, question, deliver):
        with self._lock:
            self._serial += 1
            mine = self._serial
        def run():
            try:
                answer = self._work(question)
            except Exception:              # noqa: BLE001 — a slow read may fail
                return
            with self._lock:
                if mine != self._serial:
                    return                 # somebody has typed since; drop it
            deliver(question, answer)
        threading.Thread(target=run, daemon=True).start()
        return mine


class UpdateCache:
    """What has an update, asked in the background and remembered.

    Asked once when the window opens and again after anything is installed,
    removed or updated. Every draw of the list reads this and nothing else.
    """

    def __init__(self, read):
        self._read = read
        self.ids = []

    def start(self, deliver=None):
        def run():
            try:
                found = list(self._read())
            except Exception:              # noqa: BLE001 — no store, no updates
                found = []
            self.ids = found
            if deliver:
                deliver(found)
        thread = threading.Thread(target=run, daemon=True)
        thread.start()
        return thread


def launch_argv(entry_path="", app_id=""):
    """How to start the thing that was just installed, or [] if we cannot.

    ⚠️ THE OPEN BUTTON USED TO DO NOTHING AT ALL, QUITE OFTEN. It looked for an
    installed app whose name matched the name guessed from the file, and when
    the app called itself something else — which is normal — it found nothing
    and silently gave up. The part that wrote the menu entry knows exactly where
    it is, so that is what gets pressed.
    """
    if entry_path and os.path.isfile(entry_path):
        return ["gio", "launch", entry_path]
    if app_id:
        return ["flatpak", "run", app_id]
    return []


def done_words(ok, outcome, cancelled=False):
    """The title, and whether Open belongs on the page. One place, so the
    Stopped page can never be overwritten by a late answer from the worker.

    ⚠️ A CANCELLED INSTALL MUST NEVER LAND ON "All set." The worker thread is
    somewhere in the middle when Cancel is pressed and it reports back a moment
    later; before 2026-09-13 that late report yanked the person onto the done
    page for an install they had already stopped.
    """
    if cancelled or outcome == "cancelled":
        return "Stopped.", False, False
    if ok and outcome == "handoff":
        return "Continue in Bottles", False, True
    if ok:
        return "All set.", True, True
    return "That did not work.", False, False


# =============================================================================
# THE WINDOW
# =============================================================================
def run_window(open_files):
    import gi

    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    from gi.repository import Adw, Gdk, Gio, GLib, Gtk  # noqa: E402

    sys.path.insert(0, "/usr/lib/aquarius/python")
    import aquarius_ui

    hero = aquarius_ui.hero
    ACTIVE, DONE, FAILED, PENDING = (aquarius_ui.ACTIVE, aquarius_ui.DONE,
                                     aquarius_ui.FAILED, aquarius_ui.PENDING)

    class InstallerWindow(Adw.ApplicationWindow):
        def __init__(self, app, files):
            super().__init__(application=app)
            self.verdict = None
            self.step_rows = {}
            self.pending = list(files)
            self.updating_row = None

            # What Cancel presses on. A file for the helper (it watches for one
            # appearing), a flag for the work this window does itself.
            self.cancel_event = None
            self.cancel_file = ""
            self.cancel_requested = False
            # What Open presses. Written down by whatever did the installing.
            self.open_entry = ""
            self.open_app_id = ""
            # The two slow reads, both kept off the drawing thread.
            self.updates = UpdateCache(core.flatpak_updates)
            self.flathub_finder = LatestOnly(core.flathub_search)
            self.flathub_cache = {}
            self.search_timer = 0

            self.set_title(TITLE)
            self.set_default_size(900, 760)

            self.stack = Gtk.Stack(
                transition_type=Gtk.StackTransitionType.CROSSFADE,
                transition_duration=180,
                vexpand=True,
            )
            self.stack.add_named(self._build_browse_page(), "browse")
            self.stack.add_named(self._build_file_page(), "file")
            self.stack.add_named(self._build_working_page(), "working")
            self.stack.add_named(self._build_done_page(), "done")

            header = Adw.HeaderBar()
            self.header_title = Adw.WindowTitle(title=TITLE, subtitle="")
            header.set_title_widget(self.header_title)
            self.toolbar = Adw.ToolbarView()
            self.toolbar.add_top_bar(header)
            self.toolbar.set_content(self.stack)
            self.set_content(self.toolbar)

            # ⚠️ DRAG-AND-DROP IS THE SAME ACT AS DOUBLE-CLICK, and it has to
            # be, because half the people who try this will drag the file onto
            # the window rather than go back to the folder.
            drop = Gtk.DropTarget.new(Gdk.FileList, Gdk.DragAction.COPY)
            drop.connect("drop", self._on_drop)
            self.add_controller(drop)

            keys = Gtk.EventControllerKey()
            keys.connect("key-pressed", self._on_key)
            self.add_controller(keys)

            self.refresh()
            self.check_for_updates()
            if self.pending:
                self.take_file(self.pending.pop(0))

        # -- the two slow reads, always in a thread -------------------------
        def check_for_updates(self):
            """Ask the app store what has an update. Once at open, and again
            after anything is installed, removed or updated — never per key."""
            self.updates.start(
                lambda ids: GLib.idle_add(self._updates_arrived, ids))

        def _updates_arrived(self, _ids):
            if self.stack.get_visible_child_name() == "browse":
                self.refresh()
            return GLib.SOURCE_REMOVE

        def _on_search_changed(self, _entry):
            # The two instant groups redraw on every keystroke; Flathub is asked
            # a quarter of a second after somebody stops typing.
            self.refresh()
            if self.search_timer:
                GLib.source_remove(self.search_timer)
            self.search_timer = GLib.timeout_add(250, self._ask_flathub)

        def _ask_flathub(self):
            self.search_timer = 0
            term = self.search.get_text().strip().lower()
            if term and term not in self.flathub_cache:
                self.flathub_finder.start(
                    term,
                    lambda asked, hits: GLib.idle_add(self._flathub_arrived,
                                                      asked, hits))
            return GLib.SOURCE_REMOVE

        def _flathub_arrived(self, term, hits):
            self.flathub_cache[term] = hits
            if self.search.get_text().strip().lower() == term:
                self.refresh()
            return GLib.SOURCE_REMOVE

        # -- page 1: search and what is here --------------------------------
        def _build_browse_page(self):
            mark, title, blurb = hero(
                TITLE,
                "Drop anything you have downloaded onto this window and it "
                "will be installed. Or search for something new.")

            self.search = Gtk.SearchEntry()
            self.search.set_placeholder_text(
                "Search for an app, or paste a link")
            self.search.set_hexpand(True)
            self.search.connect("search-changed", self._on_search_changed)
            self.search.connect("activate", self._on_search_activate)

            self.update_all_button = aquarius_ui.pill_button("Update All")
            self.update_all_button.connect("clicked", self._on_update_all)
            self.update_all_button.set_visible(False)

            bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            bar.append(self.search)
            bar.append(self.update_all_button)

            self.resolve_button = aquarius_ui.pill_button("Install DaVinci Resolve")
            self.resolve_button.connect("clicked", self._on_resolve_setup)
            resolve_actions = aquarius_ui.button_row([self.resolve_button])

            self.here_group = Adw.PreferencesGroup(title="On this computer")
            self.suggest_group = Adw.PreferencesGroup(
                title="%s suggests" % core.OS_NAME)
            self.flathub_group = Adw.PreferencesGroup(title="On Flathub")
            self.nothing = aquarius_ui.body_label(core.NOTHING_FOUND)
            self.nothing.set_visible(False)

            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
            for widget in (mark, title, blurb, bar, resolve_actions, self.here_group,
                           self.suggest_group, self.flathub_group, self.nothing):
                box.append(widget)
            clamp = Adw.Clamp(maximum_size=720)
            clamp.set_child(box)
            box.set_margin_top(24)
            box.set_margin_bottom(24)
            box.set_margin_start(18)
            box.set_margin_end(18)
            scroller = Gtk.ScrolledWindow(vexpand=True)
            scroller.set_child(clamp)
            return scroller

        def _on_resolve_setup(self, _button):
            # Resolve has its own guided container setup. Opening that window
            # leaves its download choice and final Install click to the person.
            import subprocess

            try:
                subprocess.Popen([RESOLVE_SETUP], start_new_session=True)
            except OSError:
                dialog = Adw.AlertDialog(
                    heading="DaVinci Resolve setup could not open",
                    body="Try again after restarting. If this keeps happening, "
                         "the Resolve setup tool needs repair.")
                dialog.add_response("close", "Close")
                dialog.present(self)

        # -- page 2: one file, about to be installed ------------------------
        def _build_file_page(self):
            self.file_mark, self.file_title, self.file_blurb = hero("", "")
            self.file_group = Adw.PreferencesGroup()
            self.file_note = aquarius_ui.body_label("", centre=False)
            self.file_note.set_xalign(0.0)

            self.install_button = aquarius_ui.pill_button("Install",
                                                          suggested=True)
            self.install_button.connect("clicked", self._on_install)
            back = aquarius_ui.pill_button("Not now")
            back.connect("clicked", lambda _b: self.show_browse())

            self.file_buttons = aquarius_ui.button_row(
                [back, self.install_button])
            return aquarius_ui.page([self.file_mark, self.file_title,
                                     self.file_blurb, self.file_group,
                                     self.file_note, self.file_buttons])

        # -- page 3: it is happening ----------------------------------------
        def _build_working_page(self):
            mark, self.working_title, self.working_blurb = hero(
                "Installing", "This takes a moment.")
            self.working_status = aquarius_ui.status_glyph()
            self.working_status.set_visible(False)
            heading = aquarius_ui.heading_row(self.working_status,
                                              self.working_title)

            self.bar = Gtk.ProgressBar()
            self.bar.set_show_text(False)
            self.steps = Adw.PreferencesGroup()
            self.details = aquarius_ui.LogPane()
            copy = aquarius_ui.copy_button("Copy", lambda: self.details.text())
            self.cancel_button = aquarius_ui.pill_button("Cancel")
            self.cancel_button.connect("clicked", self._on_cancel)

            return aquarius_ui.page([mark, heading, self.working_blurb,
                                     self.bar, self.steps, self.details.widget,
                                     aquarius_ui.button_row([copy,
                                                             self.cancel_button])])

        # -- page 4: how it went --------------------------------------------
        def _build_done_page(self):
            mark, self.done_title, self.done_blurb = hero("", "")
            self.done_status = aquarius_ui.status_glyph()
            heading = aquarius_ui.heading_row(self.done_status, self.done_title)
            self.open_button = aquarius_ui.pill_button("Open", suggested=True)
            self.open_button.connect("clicked", self._on_open)
            close = aquarius_ui.pill_button("Done")
            close.connect("clicked", lambda _b: self.show_browse())
            self.done_details = aquarius_ui.LogPane()
            return aquarius_ui.page([mark, heading, self.done_blurb,
                                     self.done_details.widget,
                                     aquarius_ui.button_row([close,
                                                             self.open_button])])

        # -- moving between them --------------------------------------------
        def show_browse(self):
            self.header_title.set_subtitle("")
            self.stack.set_visible_child_name("browse")
            self.refresh()
            if self.pending:
                self.take_file(self.pending.pop(0))

        # -- the list, and the three groups ---------------------------------
        def refresh(self):
            term = self.search.get_text().strip()
            # ⚠️ NOTHING SLOW MAY HAPPEN IN HERE. This runs on the drawing
            # thread, on every keystroke. The two instant groups are read
            # straight off this computer; the Flathub group and the update list
            # are whatever the two background readers have brought back so far.
            found = core.search(term, flathub=False)
            found["flathub"] = [
                hit for hit in self.flathub_cache.get(term.strip().lower(), [])
                if hit["id"] not in {row.id for row in found["here"]}
                and hit["id"] not in {e["id"] for e in found["suggested"]}]
            updates = set(self.updates.ids)

            clear_group(self.here_group)
            for row in found["here"]:
                group_add(self.here_group,
                          self._installed_row(row, row.id in updates))
            self.here_group.set_visible(bool(found["here"]))

            clear_group(self.suggest_group)
            for entry in found["suggested"][:12 if term else 0]:
                group_add(self.suggest_group, self._catalog_row(entry))
            self.suggest_group.set_visible(bool(term)
                                           and bool(found["suggested"]))

            clear_group(self.flathub_group)
            for hit in found["flathub"][:12]:
                group_add(self.flathub_group, self._flathub_row(hit))
            self.flathub_group.set_visible(bool(found["flathub"]))

            self.nothing.set_visible(
                bool(term) and not (found["here"] or found["suggested"]
                                    or found["flathub"]))

            self.update_all_button.set_visible(bool(updates))
            if updates:
                self.update_all_button.set_label("Update All (%d)" % len(updates))

        def _installed_row(self, row, has_update=False):
            subtitle = row.version or ""
            if row.note:
                subtitle = (subtitle + " · " + row.note).strip(" ·")
            elif row.route != core.ROUTE_FLATPAK:
                # No feed to check, so the honest thing is to say what to do
                # instead. Dropping a newer file on this window IS the update:
                # the app lands in the same place under a new version, and the
                # settings are never touched.
                subtitle = (subtitle + " · drop the new file on this window "
                            "to update").strip(" ·")
            widget = Adw.ActionRow(title=row.name or row.id)
            widget.set_subtitle(subtitle)
            widget.set_subtitle_lines(0)
            # Aquarius Writer and Firefox are part of the operating system, so
            # this window has nothing to offer about them — and says so in the
            # row rather than leaving them out, because "why is it not in the
            # list?" is a worse question than a row that explains itself.
            # ⚠️ ONLY "part of AquariusOS" ROWS HAVE NO BUTTONS (2026-09-13).
            # A row that "updates with AquariusOS" is a home-folder app the OS
            # offers again — the terminal has always removed it, so the window
            # offers Remove too. The two surfaces agree or one of them is lying.
            if not row.removable:
                return widget
            if has_update:
                update = Gtk.Button(label="Update")
                update.set_valign(Gtk.Align.CENTER)
                update.add_css_class("suggested-action")
                update.connect("clicked", lambda _b, r=row: self._on_update(r))
                widget.add_suffix(update)
            remove = Gtk.Button(label="Remove")
            remove.set_valign(Gtk.Align.CENTER)
            remove.add_css_class("destructive-action")
            remove.connect("clicked", lambda _b, r=row: self._on_remove(r))
            widget.add_suffix(remove)
            return widget

        def _catalog_row(self, entry):
            widget = Adw.ActionRow(title=entry["name"])
            widget.set_subtitle(entry["description"])
            widget.set_subtitle_lines(0)
            button = Gtk.Button(label="Install")
            button.set_valign(Gtk.Align.CENTER)
            button.add_css_class("suggested-action")
            button.connect("clicked",
                           lambda _b, e=entry: self._install_flatpak(
                               ["%s//%s" % (e["id"], e["branch"])], e["name"]))
            widget.add_suffix(button)
            return widget

        def _flathub_row(self, hit):
            widget = Adw.ActionRow(title=hit["name"])
            widget.set_subtitle(hit["description"])
            widget.set_subtitle_lines(0)
            button = Gtk.Button(label="Install")
            button.set_valign(Gtk.Align.CENTER)
            button.add_css_class("suggested-action")
            button.connect("clicked",
                           lambda _b, h=hit: self._install_flatpak([h["id"]],
                                                                   h["name"]))
            widget.add_suffix(button)
            return widget

        # -- a file arrives --------------------------------------------------
        def _on_drop(self, _target, value, _x, _y):
            files = [f.get_path() for f in value.get_files() if f.get_path()]
            if not files:
                return False
            self.pending = files[1:]
            self.take_file(files[0])
            return True

        def take_file(self, path):
            self.verdict = core.sort_path(path)
            verdict = self.verdict
            self.file_title.set_label(verdict.name)
            self.install_button.set_label("Continue in Bottles" if verdict.route == core.ROUTE_WINDOWS else "Install")

            if not verdict.can_install:
                self.file_blurb.set_label(verdict.message)
                clear_group(self.file_group)
                self.install_button.set_visible(False)
                if verdict.flathub_hint:
                    self.file_note.set_label(
                        "Looking for \"%s\" on Flathub…" % verdict.flathub_hint)
                    self.search.set_text(verdict.flathub_hint)
                else:
                    self.file_note.set_label("")
            else:
                self.file_blurb.set_label(verdict.where)
                self.install_button.set_visible(True)
                clear_group(self.file_group)
                group_add(self.file_group,
                          fact("Version", verdict.version or "not stated"))
                group_add(self.file_group,
                          fact("Publisher", verdict.publisher or "not stated"))
                group_add(self.file_group,
                          fact("Signature", signature_words(verdict.signature)))
                group_add(self.file_group,
                          fact("File", os.path.basename(verdict.path)))
                self.file_note.set_label(
                    "AquariusOS has not checked this Windows file's signature. "
                    "Continue only if you trust its source. " + core.WINDOWS_NEXT
                    if verdict.route == core.ROUTE_WINDOWS else signature_note(verdict.signature))
            self.stack.set_visible_child_name("file")

        # -- installing ------------------------------------------------------
        def _on_install(self, _button):
            verdict = self.verdict
            if verdict is None:
                return
            if verdict.route == core.ROUTE_FLATPAK:
                self._install_flatpak([verdict.path], verdict.name,
                                      app_id=verdict.app_id)
                return
            if verdict.route == core.ROUTE_WINDOWS:
                self._start_working(verdict.name, core.WINDOWS_STEPS)
                self.working_title.set_label("Preparing Windows setup")
                threading.Thread(target=self._install_thread, daemon=True).start()
                return
            self._start_working(verdict.name, ["Opening it",
                                               "Checking what it would change",
                                               "Checking it runs here",
                                               "Working out what it is called",
                                               "Putting it into your apps",
                                               "Checking it is really there"])
            threading.Thread(target=self._install_thread, daemon=True).start()

        def _install_thread(self):
            progress = core.Progress(
                on_line=lambda line: GLib.idle_add(self._progress, line),
                on_log=lambda text: GLib.idle_add(self.details.append, text))
            result = core.install(self.verdict, progress,
                                  cancel=self.cancel_event)
            self.open_entry = result.entry_path
            GLib.idle_add(self._finished, result.ok, result.message, result.outcome)

        def _install_flatpak(self, refs, name, app_id=""):
            """The one route with a password, and it is asked once, by the desktop."""
            self._start_working(name, [name])
            # The id to press Open on later. A reference file names the app
            # inside it; a row or a search hit is already the id.
            self.open_app_id = app_id or (refs[0].split("//")[0]
                                          if refs and not os.path.exists(refs[0])
                                          else "")
            argv = core.flatpak_argv("install-file" if refs and
                                     os.path.exists(refs[0]) else "install",
                                     refs, progress_fd=2,
                                     cancel_file=self.cancel_file,
                                     dry_run=DRY_RUN)
            threading.Thread(target=self._helper_thread, args=(argv, name),
                             daemon=True).start()

        def _helper_thread(self, argv, name, after=None, verb="install"):
            import subprocess

            self.details.append("$ %s\n" % " ".join(argv))
            try:
                proc = subprocess.Popen(argv, stdout=subprocess.PIPE,
                                        stderr=subprocess.PIPE, text=True,
                                        errors="replace", bufsize=1,
                                        start_new_session=True)
            except OSError as exc:
                GLib.idle_add(self._finished, False,
                              "The part that installs apps for the whole "
                              "computer could not be started.")
                GLib.idle_add(self.details.append, str(exc) + "\n")
                return
            # ⚠️ BOTH PIPES AT ONCE. Progress arrives on the second one, so
            # draining the first to the end first meant no row ever moved until
            # the job was over — and could stop the helper dead.
            code = read_both_pipes(
                proc,
                lambda line: GLib.idle_add(self.details.append, line),
                lambda line: GLib.idle_add(self._progress, line.rstrip("\n")))
            if self.cancel_requested:
                GLib.idle_add(self._finished, False, core.SAY["cancelled"],
                              "cancelled")
                return
            # ⚠️ 126 AND 127 FROM pkexec ARE NOT THE INSTALLER'S CODES. They mean
            # "you said no" and "nothing was able to ask you", and the second one
            # is not something a person can fix by pressing Try again.
            if code in (126, 127):
                GLib.idle_add(self._finished, False,
                              "%s was not given permission to do that."
                              % core.OS_NAME)
                return
            if after:
                after(code == 0)
            if verb == "remove":
                GLib.idle_add(self._finished, code == 0,
                              "%s has been removed." % name if code == 0
                              else "%s could not be removed." % name)
                return
            GLib.idle_add(self._finished, code == 0,
                          "%s is installed." % name if code == 0
                          else "%s did not install." % name)

        def _start_working(self, name, steps):
            # A fresh flag and a fresh file for every job, so a Cancel pressed
            # on the last one can never stop this one.
            self.cancel_requested = False
            self.cancel_event = threading.Event()
            self.cancel_file = os.path.join(
                tempfile.gettempdir(),
                "aquarius-installer-stop-%d-%d" % (os.getpid(), id(self)))
            try:
                os.remove(self.cancel_file)
            except OSError:
                pass
            self.open_entry = ""
            self.open_app_id = ""
            self.cancel_button.set_label("Cancel")
            self.cancel_button.set_sensitive(True)
            self.header_title.set_subtitle(name)
            self.working_title.set_label("Installing %s" % name)
            self.working_status.set_visible(False)
            self.bar.set_fraction(0.0)
            self.details.clear()
            clear_group(self.steps)
            self.step_rows = {}
            for index, text in enumerate(steps, start=1):
                row = aquarius_ui.StepRow(text)
                self.step_rows[index] = row
                group_add(self.steps, row)
            self.stack.set_visible_child_name("working")

        def _progress(self, line):
            head, _, rest = line.partition(" ")
            if head == "STEP":
                index, _, _text = rest.partition(" ")
                position, _, _total = index.partition("/")
                try:
                    number = int(position)
                except ValueError:
                    return GLib.SOURCE_REMOVE
                for key, row in self.step_rows.items():
                    if key < number:
                        row.set_state(DONE)
                    elif key == number:
                        row.set_state(ACTIVE)
                    else:
                        row.set_state(PENDING)
            elif head == "PERCENT":
                try:
                    self.bar.set_fraction(int(rest) / 100.0)
                except ValueError:
                    pass
            elif head in ("OK", "HANDOFF"):
                for row in self.step_rows.values():
                    if row.state == ACTIVE:
                        row.set_state(DONE)
            elif head in ("FAILED", "FAIL"):
                for row in self.step_rows.values():
                    if row.state == ACTIVE:
                        row.set_state(FAILED)
                aquarius_ui.set_status_glyph(self.working_status, ok=False)
                self.working_status.set_visible(True)
                self.details.set_expanded(True)
            elif head == "DONE":
                pass
            else:
                self.details.append(line + "\n")
            return GLib.SOURCE_REMOVE

        def _on_cancel(self, _button):
            """Really stop it, and stay here until the worker says it has.

            ⚠️ THIS BUTTON USED TO DO NOTHING BUT CHANGE THE PAGE. The install
            carried on behind it and then dragged the person to the done page
            for something they had stopped. Now it raises the flag the worker
            watches, touches the file the app helper watches, and waits.
            """
            if self.cancel_requested:
                return
            self.cancel_requested = True
            if self.cancel_event is not None:
                self.cancel_event.set()
            if self.cancel_file:
                try:
                    with open(self.cancel_file, "w"):
                        pass
                except OSError:
                    pass
            self.cancel_button.set_label("Stopping…")
            self.cancel_button.set_sensitive(False)
            self.working_blurb.set_label("Stopping. This takes a moment.")

        def _finished(self, ok, message, outcome="installed"):
            title, show_open, was_good = done_words(ok, outcome,
                                                    self.cancel_requested)
            if self.cancel_requested:
                ok, message = False, core.SAY["cancelled"]
            self.done_title.set_label(title)
            self.done_blurb.set_label(message)
            aquarius_ui.set_status_glyph(self.done_status, ok=was_good)
            self.open_button.set_visible(show_open)
            self.done_details.clear()
            for line in self.details.lines:
                self.done_details.append(line)
            self.done_details.set_expanded(not was_good)
            self.stack.set_visible_child_name("done")
            self.cancel_event = None
            self.cancel_file = ""
            # Whatever just happened may have changed what has an update.
            self.check_for_updates()
            self.refresh()
            return GLib.SOURCE_REMOVE

        def _on_open(self, _button):
            """Start exactly the thing that was installed, or say why not."""
            import subprocess

            argv = launch_argv(self.open_entry, self.open_app_id)
            if argv:
                try:
                    subprocess.Popen(argv, start_new_session=True)
                except OSError as exc:
                    self.details.append(str(exc) + "\n")
                    argv = []
            if not argv:
                dialog = Adw.AlertDialog(
                    heading="That app would not open",
                    body="It is installed and it is in your apps — try it from "
                         "there. If it still will not open, install it again.")
                dialog.add_response("close", "Close")
                dialog.present(self)
                return
            self.show_browse()

        # -- removing --------------------------------------------------------
        def _on_remove(self, row):
            if row.route == core.ROUTE_FLATPAK:
                # ⚠️ THE TICK BOX IS REAL FOR THESE NOW (2026-09-13). It used to
                # be drawn, ticked and ignored. An app from Flathub keeps
                # everything it remembers in one folder, so its size can be
                # shown in the label exactly as a home-folder app's is.
                self._confirm_remove(row, core.flatpak_removal_plan(row.id))
                return
            if row.managed:
                self._confirm_remove(row, None)
                return
            self._confirm_remove(row, core.removal_plan(row.id))

        def _confirm_remove(self, row, plan):
            dialog = Adw.MessageDialog(transient_for=self, modal=True)
            dialog.set_heading("Remove %s?" % (row.name or row.id))
            freed = core.human_size(plan["app_bytes"]) \
                if plan and plan["app_bytes"] else ""
            dialog.set_body(
                "This frees %s. The things you made with it are not touched."
                % freed if freed else
                "The things you made with it are not touched.")

            tick = Gtk.CheckButton(label="Also delete its settings and data")
            if plan and plan["data_bytes"]:
                tick.set_label("Also delete its settings and data (%s)"
                               % core.human_size(plan["data_bytes"]))
            tick.set_active(False)
            dialog.set_extra_child(tick)

            dialog.add_response("no", "Keep it")
            dialog.add_response("yes", "Remove")
            dialog.set_response_appearance("yes",
                                           Adw.ResponseAppearance.DESTRUCTIVE)
            dialog.connect("response", self._removed, row, tick)
            dialog.present()

        def _removed(self, _dialog, response, row, tick):
            if response != "yes":
                return
            with_data = tick.get_active()
            self._start_working(row.name or row.id, ["Removing %s"
                                                     % (row.name or row.id)])
            threading.Thread(target=self._remove_thread,
                             args=(row, with_data), daemon=True).start()

        def _remove_thread(self, row, with_data):
            progress = core.Progress(
                on_line=lambda line: GLib.idle_add(self._progress, line),
                on_log=lambda text: GLib.idle_add(self.details.append, text))
            if row.route == core.ROUTE_FLATPAK:
                argv = core.flatpak_argv("uninstall", [row.id], progress_fd=2,
                                         cancel_file=self.cancel_file,
                                         dry_run=DRY_RUN)

                def then(ok):
                    # Only after the app itself has really gone, and only if the
                    # box was ticked. The things the person MADE are not here.
                    if ok and with_data:
                        core.remove_flatpak_data(row.id)

                self._helper_thread(argv, row.name or row.id, after=then,
                                    verb="remove")
                return
            if row.managed:
                result = core.remove_managed_app(row.id, progress)
            else:
                result = core.remove(row.id, with_data, progress)
            GLib.idle_add(self._finished, result.ok, result.message, result.outcome)

        # -- updating --------------------------------------------------------
        def _on_update(self, row):
            """One row's Update. The same helper, the same one prompt."""
            if row.route != core.ROUTE_FLATPAK:
                return
            self._start_working(row.name or row.id, [row.id])
            argv = core.flatpak_argv("update", [row.id], progress_fd=2,
                                     cancel_file=self.cancel_file,
                                     dry_run=DRY_RUN)
            threading.Thread(target=self._helper_thread,
                             args=(argv, row.name or row.id),
                             daemon=True).start()

        def _on_update_all(self, _button):
            ids = list(self.updates.ids)
            if not ids:
                return
            self._start_working("Updates", ids)
            argv = core.flatpak_argv("update", ids, progress_fd=2,
                                     cancel_file=self.cancel_file,
                                     dry_run=DRY_RUN)
            threading.Thread(target=self._helper_thread,
                             args=(argv, "%d apps" % len(ids)),
                             daemon=True).start()

        # -- odds and ends ---------------------------------------------------
        def _on_search_activate(self, entry):
            text = entry.get_text().strip()
            if not core.looks_like_link(text):
                return
            app_id = core.flathub_page_id(text)
            if app_id:
                self._install_flatpak([app_id], app_id)
                return
            self._start_working("Downloading", ["Downloading"])
            threading.Thread(target=self._download_thread, args=(text,),
                             daemon=True).start()

        def _download_thread(self, url):
            progress = core.Progress(
                on_line=lambda line: GLib.idle_add(self._progress, line),
                on_log=lambda text: GLib.idle_add(self.details.append, text))
            path = core.download(url, progress)
            if not path:
                GLib.idle_add(self._finished, False,
                              "That link could not be downloaded.")
                return
            GLib.idle_add(self.take_file, path)

        def _on_key(self, _controller, keyval, _keycode, _state):
            if keyval == Gdk.KEY_Escape:
                if self.stack.get_visible_child_name() == "browse":
                    self.close()
                else:
                    self.show_browse()
                return True
            return False

    class InstallerApp(Adw.Application):
        def __init__(self, files):
            super().__init__(application_id=APP_ID,
                             flags=Gio.ApplicationFlags.NON_UNIQUE)
            self.files = files

        def do_activate(self):
            window = InstallerWindow(self, self.files)
            window.present()

    def clear_group(group):
        """Take every row back out of a group.

        ⚠️ Adw.PreferencesGroup HAS NO "EMPTY YOURSELF", and it must be emptied
        on every keystroke in the search bar. So each group remembers the rows
        it was given and hands them back one at a time. Reaching into its
        internal children instead is how a list ends up with a stale row nobody
        can explain.
        """
        for row in list(getattr(group, "aquarius_rows", [])):
            group.remove(row)
        group.aquarius_rows = []

    def group_add(group, row):
        group.add(row)
        rows = list(getattr(group, "aquarius_rows", []))
        rows.append(row)
        group.aquarius_rows = rows

    def fact(title, value):
        row = Adw.ActionRow(title=title)
        row.set_subtitle(value)
        row.set_subtitle_lines(0)
        return row

    GLib.set_prgname(APP_ID)
    GLib.set_application_name(TITLE)
    return InstallerApp(open_files).run([sys.argv[0]])


# -----------------------------------------------------------------------------
# The signature, in words — shown, never a nag
# -----------------------------------------------------------------------------
# ⚠️ AN UNSIGNED FILE IS NEVER BLOCKED (Royce, 2026-09-08). Most good software on
#    the internet is unsigned, so blocking it would be a promise we cannot keep
#    dressed up as safety. The window says what it knows, once, in plain words.
def signature_words(state):
    return {"signed": "Signed by its publisher",
            "unsigned": "Not signed",
            "unknown": "Not stated"}.get(state, "Not stated")


def signature_note(state):
    if state == "signed":
        return ""
    return ("This file is not signed, which is normal for software downloaded "
            "straight from its maker. Install it if you trust where it came "
            "from.")


# =============================================================================
# THE SAME JOBS WITH NO SCREEN
# =============================================================================
def printer(prefix=""):
    return core.Progress(on_line=lambda line: print(prefix + line),
                         on_log=lambda text: print(text.rstrip("\n")))


def do_sort(path):
    verdict = core.sort_path(path)
    print("kind: %s" % verdict.kind)
    print("route: %s" % verdict.route)
    print("name: %s" % verdict.name)
    print("version: %s" % verdict.version)
    print("publisher: %s" % verdict.publisher)
    print("signature: %s" % verdict.signature)
    print("can install: %s" % ("yes" if verdict.can_install else "no"))
    if verdict.where:
        print("where: %s" % verdict.where)
    if verdict.message:
        print("why not: %s" % verdict.message)
    if verdict.flathub_hint:
        print("look for: %s" % verdict.flathub_hint)
    return 0 if verdict.can_install else 1


def do_install(path):
    verdict = core.sort_path(path)
    if verdict.route == core.ROUTE_FLATPAK:
        import subprocess

        argv = core.flatpak_argv(
            "install-file" if os.path.exists(verdict.path) else "install",
            [verdict.path], progress_fd=2)
        return subprocess.call(argv)
    if not verdict.can_install:
        print(verdict.message)
        return 1
    result = core.install(verdict, printer())
    print(result.message)
    return 0 if result.ok else 1


def do_list():
    rows = core.installed_rows()
    if not rows:
        print("Nothing has been installed with %s yet." % TITLE)
        return 0
    for row in rows:
        print("  %-11s %-34s %s%s" % (row.route, row.id, row.version,
                                      "  (%s)" % row.note if row.note else ""))
    print()
    print("  To take one away:  aq apps remove <the middle column>")
    return 0


def do_remove(app_id, with_data):
    row = next((r for r in core.installed_rows() if r.id == app_id), None)
    if row is not None and row.route == core.ROUTE_FLATPAK:
        import subprocess

        code = subprocess.call(core.flatpak_argv("uninstall", [app_id],
                                                 progress_fd=2))
        # ⚠️ THE TICK BOX, AS A WORD, AND IT NOW DOES SOMETHING. An app from
        # Flathub keeps everything it remembers in one folder named after it.
        # The things a person MADE with the app are not in there.
        if code == 0 and with_data:
            freed = core.remove_flatpak_data(app_id)
            print("Its settings are gone too. %s freed." % core.human_size(freed))
        return code
    if row is not None and row.managed:
        result = core.remove_managed_app(app_id, printer())
        print(result.message)
        return 0 if result.ok else 1
    result = core.remove(app_id, with_data, printer())
    print(result.message)
    return 0 if result.ok else 1


def do_updates():
    plan = core.update_plan()
    count = len(plan["flatpak"])
    print("%d app%s from Flathub %s an update."
          % (count, "" if count == 1 else "s", "has" if count == 1 else "have"))
    for app_id in plan["flatpak"]:
        print("  %s" % app_id)
    for row in plan["home"]:
        print("  %s — drop the new file on the %s window to update it."
              % (row.name or row.id, TITLE))
    for row in plan["os"]:
        print("  %s — %s." % (row.name or row.id, row.note))
    return 0


def do_update_all():
    import subprocess

    ids = core.flatpak_updates()
    if not ids:
        print("Everything is up to date.")
        return 0
    print("Updating %d app(s). You will be asked for your password once."
          % len(ids))
    return subprocess.call(core.flatpak_argv("update", ids, progress_fd=2))


def do_search(term):
    found = core.search(term)
    print("On this computer: %d" % len(found["here"]))
    for row in found["here"]:
        print("  %-34s %s" % (row.id, row.name))
    print("%s suggests: %d" % (core.OS_NAME, len(found["suggested"])))
    for entry in found["suggested"]:
        print("  %-34s %s" % (entry["id"], entry["name"]))
    print("On Flathub: %d" % len(found["flathub"]))
    for hit in found["flathub"]:
        print("  %-34s %s" % (hit["id"], hit["name"]))
    if not (found["here"] or found["suggested"] or found["flathub"]):
        print(core.NOTHING_FOUND)
    return 0


# =============================================================================
# THE REHEARSAL — every step, really run, inside a throwaway home folder
# =============================================================================
# ⚠️ IT IS NOT A SERIES OF `print`s, AND THAT IS THE POINT. A rehearsal that only
#    says what it WOULD do proves nothing about the code that does it — that is
#    the exact fault this repository has been bitten by twice (a build that never
#    ran its own reader against its own file). So this one really unpacks a real
#    archive, really refuses a package that wants the operating system, really
#    writes a menu entry, really reads it back, and really removes it — into a
#    temporary folder that is deleted on the way out.
def make_payload(root, name="testapp", with_os_bits=False, want_library=""):
    """A tiny app-shaped tree: a program, a menu entry and an icon."""
    binary = os.path.join(root, "opt", name, name)
    os.makedirs(os.path.dirname(binary), exist_ok=True)
    with open(binary, "w") as handle:
        handle.write("#!/bin/sh\necho %s\n" % name)
    os.chmod(binary, 0o755)

    entry = os.path.join(root, "usr", "share", "applications",
                         "%s.desktop" % name)
    os.makedirs(os.path.dirname(entry), exist_ok=True)
    with open(entry, "w") as handle:
        handle.write("[Desktop Entry]\nType=Application\nName=Test App\n"
                     "Exec=/opt/%s/%s %%U\nIcon=%s\nTerminal=false\n"
                     "StartupWMClass=TestApp\nCategories=Utility;\n"
                     "Path=/opt/%s/\n" % (name, name, name, name))

    icon = os.path.join(root, "usr", "share", "icons", "hicolor", "64x64",
                        "apps", "%s.png" % name)
    os.makedirs(os.path.dirname(icon), exist_ok=True)
    with open(icon, "wb") as handle:
        handle.write(b"\x89PNG\r\n\x1a\n" + b"\x00" * 8 +
                     (64).to_bytes(4, "big") + (64).to_bytes(4, "big"))

    if with_os_bits:
        unit = os.path.join(root, "usr", "lib", "systemd", "system",
                            "%s.service" % name)
        os.makedirs(os.path.dirname(unit), exist_ok=True)
        with open(unit, "w") as handle:
            handle.write("[Unit]\nDescription=nope\n")
    if want_library:
        # An ELF header and nothing else: enough for the ldd pass to find it.
        broken = os.path.join(root, "opt", name, "lib%s.so" % want_library)
        with open(broken, "wb") as handle:
            handle.write(b"\x7fELF" + b"\x00" * 60)
    return root


def make_tarball(path, builder):
    work = tempfile.mkdtemp(prefix="aquarius-rehearsal-src-")
    try:
        builder(work)
        with tarfile.open(path, "w:gz") as archive:
            for name in sorted(os.listdir(work)):
                archive.add(os.path.join(work, name), arcname=name)
    finally:
        import shutil

        shutil.rmtree(work, ignore_errors=True)
    return path


def rehearse():
    import shutil

    passed = 0
    failed = 0

    def check(condition, what):
        nonlocal passed, failed
        if condition:
            passed += 1
            print("  OK   %s" % what)
        else:
            failed += 1
            print("  FAIL %s" % what)

    fake_home = tempfile.mkdtemp(prefix="aquarius-rehearsal-home-")
    real_home = os.environ.get("HOME")
    os.environ["HOME"] = fake_home
    # ⚠️ THE ONE PLACE THE "NEVER AS AN ADMINISTRATOR" RULE IS LIFTED, and the
    # reason is written out beside the flag itself: the image build runs as root
    # in a container, so refusing root here would mean this code is never
    # checked anywhere. The home folder above is one this function made and
    # deletes; nothing outside it is reachable.
    core.REHEARSAL = True
    print("REHEARSAL — nothing on this computer is changed.")
    print("Everything below really happens, inside %s, which is deleted at the"
          % fake_home)
    print("end. Only the downloading is stood in for.")
    print()

    try:
        work = tempfile.mkdtemp(prefix="aquarius-rehearsal-", dir=fake_home)

        # --- the sorter, on every ending it knows -------------------------
        print("=== the sorter ===")
        for ending, want_route in ((".AppImage", core.ROUTE_APPIMAGE),
                                   (".rpm", core.ROUTE_PACKAGE),
                                   (".deb", core.ROUTE_PACKAGE),
                                   (".tar.gz", core.ROUTE_ARCHIVE),
                                   (".zip", core.ROUTE_ARCHIVE),
                                   (".flatpakref", core.ROUTE_FLATPAK),
                                   (".run", core.ROUTE_REFUSE),
                                   (".snap", core.ROUTE_REFUSE),
                                   (".exe", core.ROUTE_WINDOWS),
                                   (".msi", core.ROUTE_WINDOWS),
                                   (".dmg", core.ROUTE_REFUSE)):
            sample = os.path.join(work, "thing" + ending)
            with open(sample, "w") as handle:
                handle.write("x")
            verdict = core.sort_path(sample)
            check(verdict.route == want_route,
                  "%-12s goes to the %s route" % (ending, want_route))
            print("       sorted: %s" % verdict.route)

        for ending, word in ((".snap", "Flathub"),
                             (".dmg", "Mac"), (".run", "installer program")):
            sample = os.path.join(work, "thing" + ending)
            verdict = core.sort_path(sample)
            check(word.lower() in verdict.message.lower(),
                  "%-12s is refused in words a person can act on" % ending)

        # --- Route A, all the way through ----------------------------------
        print()
        print("=== a self-contained app, installed for real ===")
        tarball = make_tarball(os.path.join(work, "testapp-1.2.3.tar.gz"),
                               lambda root: make_payload(root))
        verdict = core.sort_path(tarball)
        result = core.install(verdict, printer("       "))
        check(result.ok, "it installed")
        record = result.record
        check(record is not None and os.path.isfile(record.entry_path),
              "it wrote a menu entry")
        if record:
            values = core.read_entry(record.entry_path)
            check(values.get("Name") == "Test App",
                  "the entry carries the app's own name")
            check(values.get("StartupWMClass") == "TestApp",
                  "and its window class, read out of the app itself")
            check("Path" not in values,
                  "and the Path= naming a folder this computer lacks was dropped")
            check(values.get("Exec", "").startswith(record.install_path),
                  "and Exec points at where the app really landed")
            check(bool(values.get("Icon")), "and it has an icon")
            check(os.path.isfile(core.Record.load(record.id).path()),
                  "the registry wrote its note")

        # --- and away again -------------------------------------------------
        print()
        print("=== and away again ===")
        if record:
            plan = core.removal_plan(record.id)
            check(plan is not None and plan["app_bytes"] > 0,
                  "Remove can say how much space it frees")
            gone = core.remove(record.id, with_data=False)
            check(gone.ok, "it removed")
            check(not os.path.exists(record.entry_path),
                  "the menu entry is gone")
            check(not os.path.isdir(record.install_path),
                  "and so is the app")

        # --- the two honest stops -------------------------------------------
        print()
        print("=== the two honest stops ===")
        os_ball = make_tarball(os.path.join(work, "systemthing-1.0.tar.gz"),
                               lambda root: make_payload(root, "systemthing",
                                                         with_os_bits=True))
        stopped = core.install(core.sort_path(os_ball), printer("       "))
        check(not stopped.ok, "a package that wants the operating system is refused")
        check("operating system" in stopped.message,
              "and the reason says so in plain words")

        print()
        print("checks passed: %d" % passed)
        print("checks failed: %d" % failed)
        return 0 if failed == 0 else 1
    finally:
        core.REHEARSAL = False
        if real_home is None:
            os.environ.pop("HOME", None)
        else:
            os.environ["HOME"] = real_home
        shutil.rmtree(fake_home, ignore_errors=True)


# =============================================================================
# What was asked for
# =============================================================================
USAGE = """aquarius-installer — the window that installs anything

    aquarius-installer [FILE...]      open the window, with FILE ready to install
    aquarius-installer --sort FILE    say what FILE is; change nothing
    aquarius-installer --install FILE install it, with no window
    aquarius-installer --list         what is on this computer
    aquarius-installer --remove ID [--with-data]
    aquarius-installer --updates      what has something newer
    aquarius-installer --update-all   update everything that can be
    aquarius-installer --search TERM  search, as text
    aquarius-installer --dry-run      rehearse everything in a throwaway folder
"""


def main(argv):
    global DRY_RUN
    args = list(argv[1:])
    files = []
    with_data = False
    action = None
    value = None

    while args:
        arg = args.pop(0)
        if arg in ("--sort", "--install", "--remove", "--search"):
            action = arg.lstrip("-")
            value = args.pop(0) if args else None
            if value is None:
                print("aquarius-installer: %s needs something after it." % arg,
                      file=sys.stderr)
                return 2
        elif arg in ("--list", "--updates", "--update-all", "--dry-run"):
            action = arg.lstrip("-")
            if arg == "--dry-run":
                DRY_RUN = True
        elif arg == "--with-data":
            with_data = True
        elif arg in ("-h", "--help"):
            print(USAGE)
            return 0
        elif arg.startswith("-"):
            print("aquarius-installer: I do not understand '%s'." % arg,
                  file=sys.stderr)
            return 2
        else:
            files.append(arg)

    if action == "sort":
        return do_sort(value)
    if action == "install":
        return do_install(value)
    if action == "list":
        return do_list()
    if action == "remove":
        return do_remove(value, with_data)
    if action == "updates":
        return do_updates()
    if action == "update-all":
        return do_update_all()
    if action == "search":
        return do_search(value)
    if action == "dry-run":
        return rehearse()

    return run_window([os.path.abspath(f) for f in files])


if __name__ == "__main__":
    sys.exit(main(sys.argv))
