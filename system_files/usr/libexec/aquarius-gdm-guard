#!/usr/bin/bash
# =============================================================================
# aquarius-gdm-guard — if the login screen does not appear, take away the thing
#                      most likely to be stopping it, and try once more
# =============================================================================
# WHAT THIS IS FOR, IN PLAIN ENGLISH
#
# On 2026-09-05 the bench machine booted to a black screen with a mouse pointer
# on it and nothing else. No login screen. The cause was a display arrangement
# that AquariusOS had helpfully copied to the login screen (see
# aquarius-gdm-display for the whole story). The fix, once someone worked it
# out, was to delete two files and restart the login screen.
#
# AquariusOS no longer makes that copy at all unless somebody switches it on for
# one machine. This program is the net underneath: if a login screen does not
# come up and one of those copies is lying about — left over from an older
# version, or written on purpose by somebody testing — it takes the copy away
# and restarts the login screen once.
#
# -----------------------------------------------------------------------------
# ⚠️ IT DID NOT WORK ON 2026-09-05, AND HERE IS EXACTLY WHY
# -----------------------------------------------------------------------------
# The bench black-screened a SECOND time, on the very image that added this
# guard, and the guard sat there and did nothing. The bug was not in the wiring.
# It was in the question this program asked.
#
# It asked logind: "is there a graphical session on this machine?" — and in a
# black-screen boot the answer is YES. The mouse pointer is drawn by the
# compositor; a pointer on the screen is proof that GNOME's greeter started, is
# alive, and has a session. What went wrong is one step further in: the
# compositor came up and drew nothing. logind cannot see that. It only knows a
# session exists, and it did.
#
# So the guard looked once, twenty seconds in, was told "the login screen is up",
# said "nothing to do" and exited 0 — while Royce was staring at a black screen.
#
# THE LESSON, WRITTEN DOWN SO IT IS NOT RE-LEARNED: a session existing is not the
# same as a login screen appearing, and no program that cannot see the screen can
# tell those two apart with certainty. This one now asks three questions instead
# of one, and is honest below about the case it still cannot see.
#
# -----------------------------------------------------------------------------
# WHEN IT DECIDES SOMETHING IS WRONG — the exact trigger, so it cannot surprise
# -----------------------------------------------------------------------------
# It only looks at all when ALL of these are true:
#
#   1. GDM is the login screen this computer is using       (not greetd, not none)
#   2. at least one of the two copied files actually exists  (there is something
#                                                             to take away)
#   3. it has not already acted once during this boot
#
# It then watches for 45 seconds, sampling, and acts if ANY ONE of these is true
# at the end. Any one, not all — each is independent evidence:
#
#   A. NO GRAPHICAL SESSION AT THE END. Either nothing ever started, or one
#      started and then went away. The plainest failure.
#
#   B. THE GREETER KEEPS RESTARTING. Either gdm.service's restart count went up
#      while we watched, or the graphical session ids changed — a healthy login
#      screen sits in one session and stays there. A greeter crash-looping is
#      what a bad display arrangement usually produces, and it is invisible to
#      question A because at any instant there IS a session.
#
#   C. THE COMPOSITOR SAID IT COULD NOT USE THE DISPLAY ARRANGEMENT. mutter
#      writes a line into the journal when it rejects or fails to apply a stored
#      monitor configuration. That line names our copied file as the problem
#      directly, so it is worth acting on even while a session exists — which is
#      precisely the case that beat the guard on 2026-09-05.
#
# ⚠️ AND THE CASE IT STILL CANNOT SEE. If the compositor comes up, keeps one
# stable session, complains about nothing, and draws a black screen anyway, this
# program has no way to know. It cannot read pixels. THAT is the honest reason
# the copy is switched off by default rather than "the guard has it covered" —
# the guard is a net, not a fix. See docs/restart/login.md.
#
# It does not care whether GDM is "running". GDM restarts itself forever, so
# "running" is true even in the broken case; that is why a systemd OnFailure=
# hook on gdm.service cannot catch this and why this program exists at all.
#
# -----------------------------------------------------------------------------
# WHY IT CANNOT LOOP
# -----------------------------------------------------------------------------
# Three separate reasons, because a repair that fights the machine is worse
# than the fault it repairs:
#
#   * It is a Type=oneshot service ordered After=display-manager.service. It
#     runs ONCE, when the login screen is started at boot. Restarting
#     gdm.service does not start this service again — After= is an ordering
#     rule for startup, not a trigger.
#   * It writes a stamp at /run/aquarius/gdm-guard-acted before it acts, and
#     refuses to act if the stamp is there. /run is emptied at every boot, so
#     the stamp means "already tried, this boot".
#   * It acts exactly once and then exits. There is no retry, no second wait
#     and no timer. If the restart does not help, the fault was not this one,
#     and the right thing is to stop and leave the evidence alone.
#
# -----------------------------------------------------------------------------
# WHAT IT TAKES AWAY, AND WHY THAT IS SAFE
# -----------------------------------------------------------------------------
#   /etc/xdg/monitors.xml               both are COPIES, made by
#   /var/lib/gdm/.config/monitors.xml   /usr/libexec/aquarius-gdm-display
#
# Neither is anybody's own file, neither holds anything that is not also in the
# home folder it was copied from, and losing both costs exactly one thing: the
# login screen goes back to 100%, which is what every stock Fedora machine
# does. Since 2026-09-05 they are NOT re-made afterwards unless somebody has run
# `sudo aq login scale on` — so on a default machine this repair is permanent,
# and that is the intended outcome, not a side effect.
#
# RUNNING IT BY HAND
#   sudo /usr/libexec/aquarius-gdm-guard --status    what it would look at
#   sudo /usr/libexec/aquarius-gdm-guard --now       do the repair immediately
# =============================================================================

set -uo pipefail

# ⚠️ THE TWO PATHS BELOW ARE THE ONLY FILES THIS PROGRAM WILL EVER DELETE, and
# AQ_GDM_GUARD_ROOT exists for ONE reason: so tests/test-gdm-guard.sh can run
# this program for real, against a temporary folder, without being root and
# without touching the machine it runs on. It is never set in normal use, and
# unset every path is exactly what it always was.
AQ_ROOT="${AQ_GDM_GUARD_ROOT:-}"

AQ_SYSTEM_XML="${AQ_ROOT}/etc/xdg/monitors.xml"
AQ_GDM_XML="${AQ_ROOT}/var/lib/gdm/.config/monitors.xml"
AQ_STATE_DIR="${AQ_ROOT}/var/lib/aquarius"
AQ_LOG="${AQ_STATE_DIR}/gdm-display.log"
AQ_STAMP_DIR="/run/aquarius"
[ -n "${AQ_ROOT}" ] && AQ_STAMP_DIR="${AQ_ROOT}/run/aquarius"
AQ_STAMP="${AQ_STAMP_DIR}/gdm-guard-acted"

# How long to give the login screen before deciding it is not coming. 45
# seconds is the number in the header and the number here; if it ever changes,
# it changes in both places and in docs/restart/login.md.
AQ_TOTAL_WAIT="${AQ_GDM_GUARD_TOTAL_WAIT:-45}"
# How long to wait before looking at all. A login screen that has not appeared
# in the first twenty seconds is not necessarily broken — a slow disk, a slow
# graphics driver — so the first look is deliberately late.
AQ_FIRST_LOOK="${AQ_GDM_GUARD_FIRST_LOOK:-20}"
AQ_POLL_EVERY="${AQ_GDM_GUARD_POLL_EVERY:-5}"

# ⚠️ WHAT THE COMPOSITOR SAYS WHEN IT WILL NOT USE OUR FILE. These are mutter's
# own words, and they are the only direct evidence this program can get that the
# copied display arrangement is the problem. They are matched case-insensitively
# against the login screen's journal for this boot.
#
# Being generous here is the right kind of wrong: acting on a message that meant
# something else costs a login-screen restart and a smaller login screen. NOT
# acting costs a computer nobody can get into. That is not a close call.
AQ_MUTTER_COMPLAINTS='failed to apply.*monitor|could not apply.*monitor|monitors config|logical monitors not adjacent|failed to use stored monitor configuration|stored monitor configuration|invalid monitor config'

say() { echo "aquarius-gdm-guard: $*"; }

# -----------------------------------------------------------------------------
# stand_aside "<reason>" — leave, loudly, having changed nothing
# -----------------------------------------------------------------------------
# ⚠️ THIS EXISTS BECAUSE OF 2026-09-05, AND IT IS ABOUT READING THE JOURNAL, NOT
# ABOUT BEHAVIOUR. It changes nothing this program does.
#
# On that night the bench black-screened, and the greeter's journal showed the
# compositor losing Xwayland about sixty seconds in. The first thing anybody
# asked was: "did our own guard restart the login screen, and is that what we are
# looking at?" Answering it meant reading this program's source to work out which
# of six quiet exits it had taken.
#
# So every exit that touches nothing now says so in one line, in the same words,
# with a phrase you can grep for. Next time the question takes one command:
#
#     journalctl -b -u aquarius-gdm-guard.service
#
# and the answer is either "DID NOT TOUCH THE LOGIN SCREEN" or "REPAIRING THE
# LOGIN SCREEN". There is no third possibility and no source-reading.
stand_aside() {
    say "DID NOT TOUCH THE LOGIN SCREEN — $*"
    say "Nothing was deleted and the login screen was not restarted. If you are"
    say "reading this beside a black screen, this program is not the cause of it:"
    say "see docs/restart/login.md, 'Black screen with a cursor at boot'."
    exit 0
}

# Everything this program decides is written down, because the whole point is
# that a person finds out afterwards why their login screen is a different size
# than they left it. The log is best-effort: a full disk must not turn a repair
# into a failure.
note() {
    say "$*"
    mkdir -p "${AQ_STATE_DIR}" 2> /dev/null || true
    printf '%s  aquarius-gdm-guard: %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" \
        >> "${AQ_LOG}" 2> /dev/null || true
}

# -----------------------------------------------------------------------------
# QUESTION A — which graphical sessions are on this machine right now?
# -----------------------------------------------------------------------------
# It answers with the LIST of session ids, not yes-or-no, and that change is the
# 2026-09-05 fix. Yes-or-no could not tell a login screen that came up and
# stayed from one that is crashing and being restarted several times a minute:
# both answer "yes" at every instant. The list can — the ids change.
#
# It is asked this roundabout way — list the session ids, then ask about each
# one — because the COLUMNS of `loginctl list-sessions` have changed between
# systemd versions and the first column has not, while `show-session -p Type
# --value` has meant the same thing for a decade. Parsing the table would be a
# check that quietly stops working at some future Fedora.
#
# Sorted, so that two sessions listed in a different order are not mistaken for
# a session having been replaced.
aq_graphical_session_ids() {
    local session type
    for session in $(loginctl list-sessions --no-legend 2> /dev/null | awk '{print $1}'); do
        type="$(loginctl show-session "${session}" -p Type --value 2> /dev/null)"
        case "${type}" in
            wayland | x11 | mir) echo "${session}" ;;
        esac
    done | sort | tr '\n' ' '
}

# The "gdm" user having a session is the greeter itself. It counts as a session
# too, because on a machine set to log somebody in automatically there is never
# a greeter session at all and the guard must not treat a successful automatic
# login as a failure.
#
# ⚠️ IT IS NOT PROOF OF ANYTHING BEING ON SCREEN. This was half of the check
# that failed on 2026-09-05. It is kept only as a way of saying "something
# started", never as a way of saying "the login screen appeared".
aq_greeter_user_session_exists() {
    local state
    state="$(loginctl show-user gdm -p State --value 2> /dev/null)"
    case "${state}" in
        active | online | opening) return 0 ;;
    esac
    return 1
}

aq_something_is_running() {
    [ -n "$(aq_graphical_session_ids)" ] || aq_greeter_user_session_exists
}

# -----------------------------------------------------------------------------
# QUESTION B — has the login screen restarted while we watched?
# -----------------------------------------------------------------------------
# A healthy greeter starts once. A greeter that cannot draw is killed and
# restarted, over and over, and systemd counts that for us. An empty or
# unreadable answer becomes 0 so that a missing systemctl can never be mistaken
# for a restart.
aq_gdm_restart_count() {
    local n
    n="$(systemctl show gdm.service -p NRestarts --value 2> /dev/null | tr -cd '0-9')"
    printf '%s' "${n:-0}"
}

# -----------------------------------------------------------------------------
# QUESTION C — did the compositor say it could not use our file?
# -----------------------------------------------------------------------------
# The one signal that points straight at the copied display arrangement. It is
# worth acting on even when a session exists, because "a session exists and the
# screen is black" is exactly the shape of the failure that beat this guard.
aq_compositor_rejected_the_display_config() {
    command -v journalctl > /dev/null 2>&1 || return 1
    journalctl -b -u gdm.service --no-pager -n 500 2> /dev/null \
        | grep -Eiq "${AQ_MUTTER_COMPLAINTS}"
}

aq_copies_exist() {
    [ -e "${AQ_SYSTEM_XML}" ] || [ -e "${AQ_GDM_XML}" ]
}

aq_status() {
    # ⚠️ ALL FOUR CONDITIONS, AND THEN THE VERDICT. An earlier version of this
    # printed the four answers and then said "the guard would act" based on the
    # session one alone — which was wrong on any machine where the other three
    # said no, and a status command that overstates what is about to happen is
    # worse than no status command.
    local blockers=0

    echo "Is GDM the login screen in use?"
    if systemctl is-enabled gdm.service > /dev/null 2>&1; then
        echo "  yes"
    else
        echo "  no — this guard does nothing (it only knows how to repair GDM)"
        blockers=$((blockers + 1))
    fi

    echo "Are the copied display arrangements there?"
    if aq_copies_exist; then
        for f in "${AQ_SYSTEM_XML}" "${AQ_GDM_XML}"; do
            if [ -e "${f}" ]; then
                echo "  yes  ${f}"
            else
                echo "  no   ${f}"
            fi
        done
    else
        echo "  no — there is nothing for the guard to take away"
        blockers=$((blockers + 1))
    fi

    echo "Has the guard already acted during this boot?"
    if [ -e "${AQ_STAMP}" ]; then
        echo "  yes  ${AQ_STAMP} — it will not act again until the next boot"
        blockers=$((blockers + 1))
    else
        echo "  no"
    fi

    # ⚠️ THE THREE QUESTIONS, REPORTED SEPARATELY. The old version of this
    # command asked one — "is there a graphical session?" — and that one
    # question is what let a black screen through on 2026-09-05.
    echo
    echo "The three things it watches for (any ONE of them means it acts):"

    local ids
    ids="$(aq_graphical_session_ids)"
    echo "  A. no graphical session at all"
    if [ -n "${ids}" ]; then
        echo "     no — there are sessions: ${ids}"
    elif aq_greeter_user_session_exists; then
        echo "     no — the 'gdm' user has a session, though none is graphical yet"
    else
        echo "     YES — nothing graphical is running"
    fi

    echo "  B. the login screen keeps restarting"
    echo "     gdm.service has restarted $(aq_gdm_restart_count) time(s) this boot."
    echo "     (the guard compares this before and after its 45-second watch, and"
    echo "     also watches whether the session ids change)"

    echo "  C. the compositor said it could not use the display arrangement"
    if aq_compositor_rejected_the_display_config; then
        echo "     YES — the login screen's journal has such a line in it"
    else
        echo "     no — nothing like that in the login screen's journal"
    fi

    echo
    if [ "${blockers}" -eq 0 ]; then
        echo "So: this machine is one the guard would watch. It removes those files"
        echo "and restarts the login screen only if A, B or C is true at the end of"
        echo "its ${AQ_TOTAL_WAIT}-second watch."
    else
        echo "So: the guard would do nothing at all. See the 'no' answers above."
    fi
    echo
    echo "⚠️ It cannot see the screen. A login screen that starts, stays in one"
    echo "session, complains about nothing and draws black is invisible to it."
    echo "That is why the display copy is off by default: aq login scale status"
}

# -----------------------------------------------------------------------------
# The repair itself
# -----------------------------------------------------------------------------
aq_repair() {
    local why="${1:-the login screen did not come up}"

    mkdir -p "${AQ_STAMP_DIR}" 2> /dev/null || true
    : > "${AQ_STAMP}" 2> /dev/null || true

    note "REPAIRING THE LOGIN SCREEN. What was seen: ${why}."
    note "The most likely cause is the display arrangement AquariusOS copied for"
    note "the login screen, so both copies are being removed and the login screen"
    note "restarted once. It will come back at 100%."

    rm -f "${AQ_SYSTEM_XML}" "${AQ_GDM_XML}" 2> /dev/null || true
    note "removed ${AQ_SYSTEM_XML} and ${AQ_GDM_XML}"

    # A few lines of the greeter's own complaint, kept next to the decision, so
    # that the log says what the machine thought was wrong and not only what we
    # did about it. Best-effort: no journal is not a reason to skip the repair.
    if command -v journalctl > /dev/null 2>&1; then
        journalctl -b -u gdm.service -n 15 --no-pager 2> /dev/null \
            | sed 's/^/    /' >> "${AQ_LOG}" 2> /dev/null || true
    fi

    if systemctl restart gdm.service 2> /dev/null; then
        note "the login screen was restarted."
    else
        note "the login screen would not restart. Press Ctrl+Alt+F3 for a text"
        note "login and run: sudo systemctl restart gdm"
    fi

    note "If the login screen is now the wrong size, that is this repair and not"
    note "a fault: run 'sudo aq login scale status' to see what happened."
}

case "${1:-}" in
    -h | --help | help)
        # Print the header comment, however long it is, and stop at the first
        # line that is not a comment. A fixed line range was here first and it
        # spilled the code into the help text the moment the header grew.
        awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
        exit 0
        ;;
    --status)
        aq_status
        exit 0
        ;;
    --now)
        if [ "$(id -u)" -ne 0 ] && [ -z "${AQ_ROOT}" ]; then
            echo "aquarius-gdm-guard: this has to be run as root." >&2
            exit 1
        fi
        aq_repair "somebody asked for the repair by hand (--now)"
        exit 0
        ;;
    "") : ;;
    *)
        echo "aquarius-gdm-guard: '$1' is not something this understands." >&2
        echo "                    Try --help, --status or --now." >&2
        exit 1
        ;;
esac

# =============================================================================
# The watch
# =============================================================================
# Every early exit below is a SUCCESS. This program is a safety net; a safety
# net that reports failures gives a machine a red line in `systemctl status` for
# the rest of its life because nothing went wrong.

if [ -e "${AQ_STAMP}" ]; then
    stand_aside "it already acted once during this boot (${AQ_STAMP})"
fi

# greetd is the other login screen (see `aq login`). This guard knows how to
# repair GDM and nothing else, and quietly standing aside is much better than
# restarting a login screen it does not understand.
if ! systemctl is-enabled gdm.service > /dev/null 2>&1; then
    stand_aside "GDM is not the login screen on this computer, and this guard knows how to repair nothing else"
fi

# If neither copy exists there is nothing this guard could take away, so its
# repair would be a login-screen restart for no reason. A machine where nobody
# has ever set a display scale is in exactly this state.
# ⚠️ THIS IS THE EXIT A DEFAULT AQUARIUSOS MACHINE TAKES, EVERY BOOT, AND IT
# TAKES IT IMMEDIATELY. Since 2026-09-05 the login screen is given no copied
# display arrangement at all, so on a normal machine there is nothing here to
# remove, and this program stops right now — before the 45-second watch, before
# it looks at a single session, and without ever restarting anything.
#
# Say that plainly, because it is the answer to "could the guard have caused
# this?" on any machine that has not run `sudo aq login scale on`. It could not.
# It was already finished.
if ! aq_copies_exist; then
    stand_aside "there is no copied display arrangement to take away, so there is nothing it could repair (this is the normal state of an AquariusOS machine)"
fi

say "watching for the login screen (${AQ_TOTAL_WAIT}s)."

# ⚠️ IT WATCHES THE WHOLE TIME AND DECIDES ONCE, AT THE END. The version that
# failed on 2026-09-05 stopped watching the moment it saw a session — twenty
# seconds in, while the screen was black — and reported success. A login screen
# that is crashing and restarting looks perfectly healthy at any single instant;
# the only way to see it is to keep looking. Forty-five seconds of a oneshot
# service costs nothing: nothing waits for this unit.

# The restart count BEFORE we start. Anything above this by the end means the
# greeter died and was restarted while we were watching.
AQ_RESTARTS_AT_START="$(aq_gdm_restart_count)"

AQ_FIRST_IDS=""   # the first set of graphical sessions we saw, if any
AQ_LAST_IDS=""    # the set we saw at the last look
AQ_IDS_CHANGED=0  # did the set ever change after we first saw one?
AQ_EVER_SAW_ONE=0

aq_look() {
    local ids
    ids="$(aq_graphical_session_ids)"
    AQ_LAST_IDS="${ids}"
    [ -z "${ids}" ] && return 0
    AQ_EVER_SAW_ONE=1
    if [ -z "${AQ_FIRST_IDS}" ]; then
        AQ_FIRST_IDS="${ids}"
    elif [ "${ids}" != "${AQ_FIRST_IDS}" ]; then
        AQ_IDS_CHANGED=1
    fi
}

aq_waited=0
sleep "${AQ_FIRST_LOOK}"
aq_waited="${AQ_FIRST_LOOK}"
aq_look

while [ "${aq_waited}" -lt "${AQ_TOTAL_WAIT}" ]; do
    sleep "${AQ_POLL_EVERY}"
    aq_waited=$((aq_waited + AQ_POLL_EVERY))
    aq_look
done

AQ_RESTARTS_AT_END="$(aq_gdm_restart_count)"

# -----------------------------------------------------------------------------
# The verdict — the three questions from the header, in order of how sure we are
# -----------------------------------------------------------------------------
if aq_compositor_rejected_the_display_config; then
    aq_repair "the login screen's own journal says it could not use the display arrangement"
    exit 0
fi

if [ "${AQ_RESTARTS_AT_END}" -gt "${AQ_RESTARTS_AT_START}" ] 2> /dev/null; then
    aq_repair "the login screen restarted while we watched (${AQ_RESTARTS_AT_START} -> ${AQ_RESTARTS_AT_END}) — a healthy one starts once"
    exit 0
fi

if [ "${AQ_IDS_CHANGED}" -eq 1 ]; then
    aq_repair "the graphical session kept being replaced (${AQ_FIRST_IDS}-> ${AQ_LAST_IDS}) — the login screen is crashing and restarting"
    exit 0
fi

if [ -z "${AQ_LAST_IDS}" ]; then
    # A session that appeared and then went away is the same failure as one that
    # never appeared, and it is worth naming separately because the message is
    # the difference between "it never started" and "it will not stay up".
    if [ "${AQ_EVER_SAW_ONE}" -eq 1 ]; then
        aq_repair "a graphical session appeared and then vanished — the login screen is not staying up"
        exit 0
    fi
    if ! aq_greeter_user_session_exists; then
        aq_repair "no graphical session appeared in ${AQ_TOTAL_WAIT} seconds"
        exit 0
    fi
    # Nothing graphical, but the greeter user is there — an automatic login, or
    # a session type logind names something we do not recognise. Not enough to
    # act on: a needless login-screen restart is its own kind of harm.
    stand_aside "nothing graphical is running, but the 'gdm' user has a session — that is what an automatic login looks like, and restarting it would throw somebody out"
fi

stand_aside "the login screen came up and stayed up in one session (${AQ_LAST_IDS}) for the whole ${AQ_TOTAL_WAIT}-second watch"
