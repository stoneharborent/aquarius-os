#!/usr/bin/bash
# ==============================================================================
# AquariusOS — the guided DaVinci Resolve setup
# ==============================================================================
# Plain English: DaVinci Resolve is a professional video editor made by
# Blackmagic Design. Their licence does not let anyone else hand out the
# installer, so AquariusOS cannot include it. What AquariusOS CAN do is walk you
# through getting it from them and set up everything around it. That is this.
#
# WHY THIS IS A SCRIPT AND NOT A `ujust` RECIPE ANY MORE
# ------------------------------------------------------------------------------
# It used to live entirely inside 96-aquarius-creator.just as a recipe called
# `install-resolve`. On 2026-08-28 a bench test showed why that was a mistake:
# every Universal Blue image, AquariusOS included, already ships a recipe of
# that exact name in /usr/share/ublue-os/just/30-distrobox.just. Because that
# file is imported first, and because `just` silently resolves a duplicate name
# in favour of the EARLIER import, our version could never run. The tester typed
# `ujust install-resolve`, got upstream's, and it failed in the precise way this
# script is written to avoid: it opened Blackmagic's page and immediately said
# "Installer not found" before he had a chance to download anything.
#
# The whole story, and the two ways of winning the name that were considered and
# rejected, are in the header of 96-aquarius-creator.just.
#
# So the walkthrough now lives here, in a file with a name nobody else can have,
# and everything that offers it to a user points straight at this path:
#
#   the first-login tick-box window   /usr/libexec/aquarius-creator-apps-offer
#   the app grid entry                aquarius-install-resolve.desktop
#   the terminal                      `ujust aquarius-resolve`
#
# WHAT THIS DOES, IN ORDER
#   1. Explains itself and asks permission.
#   2. Works out which graphics card you have (NVIDIA needs a different build).
#   3. Makes sure your account may talk to the graphics card.
#   4. Finds Blackmagic's installer — or opens their page AND WAITS for you to
#      download it, checking every few seconds until it appears.
#   5. Builds a small, sealed-off Linux environment that has what Resolve needs.
#   6. Installs Resolve inside that environment.
#
# Nothing about your real system is changed except step 3.
#
# The beginner-facing write-up: docs/creator-apps.md
# ==============================================================================

set -uo pipefail

# ------------------------------------------------------------------------------
# The two rules of this script's voice
# ------------------------------------------------------------------------------
#   1. Say what is about to happen before it happens.
#   2. Never end on an error without saying what to do next.
# ------------------------------------------------------------------------------

echo ""
echo "=================================================================="
echo " Setting up DaVinci Resolve on AquariusOS"
echo "=================================================================="
echo ""
echo "DaVinci Resolve is made by Blackmagic Design. Their licence does not"
echo "allow anyone else to hand out the installer, so AquariusOS cannot"
echo "include it. You download it from them; this script does the rest."
echo ""
echo "What is about to happen, in plain terms:"
echo ""
echo "  1. A web page opens. Fill in Blackmagic's form and download the"
echo "     Linux version. Save it in your Downloads folder."
echo "  2. This script waits — as long as it takes — until it sees the"
echo "     file arrive. You do not have to time anything."
echo "  3. It then builds a small, sealed-off Linux environment on your"
echo "     machine that has everything Resolve needs. Nothing about your"
echo "     actual system is changed."
echo "  4. Resolve is installed inside that environment and appears in"
echo "     your apps like any other program."
echo ""
echo "  ⚠️  ONE THING TO KNOW BEFORE YOU START"
echo "     When the download finishes, DO NOT open or run the installer"
echo "     yourself. On AquariusOS it will not work: Blackmagic's installer"
echo "     expects an ordinary Linux system and will complain about missing"
echo "     packages such as 'zlib'. That is not a fault you can fix, and"
echo "     nothing is broken when it happens — the installer simply has to"
echo "     be run INSIDE the environment this script builds. Just download"
echo "     the file and leave it alone; this script takes it from there."
echo ""
echo "It takes roughly fifteen minutes, nearly all of it downloading."
echo "You can stop at any time with Ctrl+C and nothing will be left broken."
echo ""
read -r -p "Carry on? [y/N] " reply
case "${reply}" in
    [yY]*) ;;
    *) echo "No problem — nothing was changed."; exit 0 ;;
esac

# ------------------------------------------------------------------------------
# The tools we need
# ------------------------------------------------------------------------------
# These all ship with AquariusOS. Checking is a courtesy, so that a missing one
# produces a sentence instead of "command not found".
for tool in podman distrobox lshw; do
    if ! command -v "${tool}" >/dev/null 2>&1; then
        echo ""
        echo "This needs '${tool}', which is missing from this system."
        echo "That should not be possible on AquariusOS — please report it."
        exit 1
    fi
done

# ------------------------------------------------------------------------------
# Which graphics card?
# ------------------------------------------------------------------------------
# NVIDIA cards and everyone else need different builds of the environment.
# NVIDIA uses its own compute libraries; AMD and Intel use OpenCL.
if lshw -c video 2>/dev/null | grep -qi "driver=nvidia"; then
    echo ""
    echo "NVIDIA graphics detected — using the NVIDIA build."
    DBOX_IMAGE="ghcr.io/zelikos/davincibox:latest"
    DBOX_FLAGS="--device nvidia.com/gpu=all"
else
    echo ""
    echo "AMD or Intel graphics detected — using the OpenCL build."
    DBOX_IMAGE="ghcr.io/zelikos/davincibox-opencl:latest"
    DBOX_FLAGS=""
fi

# ------------------------------------------------------------------------------
# Permission to talk to the graphics card
# ------------------------------------------------------------------------------
# Resolve needs your account to be in the 'render' and 'video' groups. Most
# accounts already are; if not, this adds them, and the change only takes effect
# after a restart.
NEEDS_RESTART=0
for grp in render video; do
    if ! id -nG "${USER}" | tr ' ' '\n' | grep -qx "${grp}"; then
        echo "Adding you to the '${grp}' group (Resolve needs it)..."
        sudo usermod -aG "${grp}" "${USER}" || true
        NEEDS_RESTART=1
    fi
done

# ==============================================================================
# FINDING BLACKMAGIC'S INSTALLER
# ==============================================================================
# This section is longer than it looks like it should be, and every line of it
# is there because of something a real person did on 2026-08-28.
#
# WHAT WENT WRONG
#   * The old flow opened Blackmagic's page and then, a moment later, said
#     "Installer not found" and quit. The tester had not downloaded anything
#     yet — of course he hadn't, the page had only just opened. A setup step
#     that opens a download page must WAIT for the download. It now does, for
#     as long as you like, checking every few seconds.
#   * Blackmagic hand out a .zip. He unzipped it, which produced a FOLDER inside
#     Downloads with the .run file inside THAT. Anything that only looks at the
#     top of Downloads misses it. We look one level down as well, and in the
#     home folder, because that is where these things really end up.
#   * Told there was no installer, he ran the .run file himself, on the real
#     system, where it complained about a missing 'zlib' package. That is a dead
#     end on this kind of OS and it is our fault for leading him there. The
#     warning about it is now printed before the download even starts, and again
#     while we wait.
# ==============================================================================

DOWNLOADS="${HOME}/Downloads"
mkdir -p "${DOWNLOADS}"

# WHERE WE LOOK, AND HOW DEEP
#   ${DOWNLOADS} to two levels   Downloads/x.run  AND  Downloads/some-folder/x.run
#                                (unzipping normally produces the second shape)
#   ${HOME} to one level         because some browsers save straight there
#
# A .run file is preferred over a .zip: if somebody has both, the .run is the
# one already unpacked and using it saves a step. Within each kind, the newest
# file wins, which is what "I just downloaded it" means.
find_one() {   # find_one <pattern> ; newest match, or nothing
    {
        find "${DOWNLOADS}" -maxdepth 2 -type f -iname "$1" 2>/dev/null
        find "${HOME}" -maxdepth 1 -type f -iname "$1" 2>/dev/null
    } | sort -u | while IFS= read -r f; do
        printf '%s\t%s\n' "$(stat -c '%Y' "$f" 2>/dev/null || echo 0)" "$f"
    done | sort -rn | head -1 | cut -f2-
}

find_installer() {
    local found
    found="$(find_one 'DaVinci_Resolve*_Linux.run')"
    [ -n "${found}" ] && { printf '%s' "${found}"; return 0; }
    found="$(find_one 'DaVinci_Resolve*Linux*.zip')"
    [ -n "${found}" ] && { printf '%s' "${found}"; return 0; }
    return 1
}

# ------------------------------------------------------------------------------
# Wait for the download
# ------------------------------------------------------------------------------
# Two ways of waiting, because this script is run both from the desktop (where a
# window is the natural thing) and from a plain terminal.
#
# On the desktop: a window that says "I'm waiting" sits on screen while the
# folder is checked every few seconds in the background. Whichever happens first
# wins — the file appearing, or the user pressing Stop. The window is NOT the
# thing that detects the download; it is only there so that Stop exists.
#
# In a terminal: the same check on the same rhythm, with a line of dots.
have_desktop() { [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; }

WAIT_TEXT="AquariusOS is waiting for the DaVinci Resolve download to finish.

Save Blackmagic's Linux download into your Downloads folder. As soon as it
appears there, setup carries on by itself — you do not need to click anything.

Please do NOT open or run the installer yourself. On AquariusOS it will stop
with a complaint about missing packages such as 'zlib'. That is expected, it
breaks nothing, and this setup runs it the correct way for you.

Press Stop only if you have changed your mind."

# The "keep waiting or stop?" window, drawn by whichever tool this desktop has.
#
# ⚠️ WHICHEVER IT IS, IT MUST EXIT 0 FOR "KEEP WAITING" AND NON-ZERO FOR "STOP"
# OR FOR BEING CLOSED. That is the whole contract the loop below reads, and both
# tools honour it: kdialog's --warningyesno is Yes=0/No=1, and zenity's
# --question is OK=0/Cancel=1. The --ok-label / --cancel-label flags only change
# the words on the buttons, not which is which.
#
# Which one is tried first follows the desktop rather than the image, because
# AquariusOS ships in a KDE flavour and a GNOME flavour and this file is the
# same on both. If neither tool is here, this quietly returns 1 and the loop
# simply never shows a window — the terminal it is running in is the interface,
# and it says everything the window would have said.
ask_keep_waiting() {
    case "${XDG_CURRENT_DESKTOP:-}" in
        *GNOME*)
            if command -v zenity >/dev/null 2>&1; then
                zenity --question --title="Waiting for DaVinci Resolve" --width=560 \
                       --ok-label="Keep waiting" --cancel-label="Stop" \
                       --text="${WAIT_TEXT}" >/dev/null 2>&1
                return
            fi
            ;;
    esac
    if command -v kdialog >/dev/null 2>&1; then
        kdialog --title "Waiting for DaVinci Resolve" \
                --yes-label "Keep waiting" --no-label "Stop" \
                --warningyesno "${WAIT_TEXT}" >/dev/null 2>&1
        return
    fi
    if command -v zenity >/dev/null 2>&1; then
        zenity --question --title="Waiting for DaVinci Resolve" --width=560 \
               --ok-label="Keep waiting" --cancel-label="Stop" \
               --text="${WAIT_TEXT}" >/dev/null 2>&1
        return
    fi
    return 1
}

# True if we can draw that window at all — i.e. there is a desktop AND at least
# one of the two tools is installed.
can_ask_keep_waiting() {
    have_desktop || return 1
    command -v kdialog >/dev/null 2>&1 && return 0
    command -v zenity >/dev/null 2>&1 && return 0
    return 1
}

wait_for_installer() {   # sets INSTALLER; returns 1 if the user gave up
    local dlg=""
    echo ""
    echo "Waiting for the download to appear in ${DOWNLOADS}..."
    echo "(Press Ctrl+C at any time to stop. Nothing will be left broken.)"
    echo ""

    if can_ask_keep_waiting; then
        ask_keep_waiting &
        dlg=$!
    fi

    local ticks=0
    while :; do
        if INSTALLER="$(find_installer)"; then
            [ -n "${dlg}" ] && { kill "${dlg}" 2>/dev/null; wait "${dlg}" 2>/dev/null; }
            return 0
        fi

        # Did the user press Stop? The window exits 0 for "Keep waiting" and
        # non-zero for "Stop" or for closing it. "Keep waiting" means exactly
        # that, so we simply put the window back up.
        if [ -n "${dlg}" ] && ! kill -0 "${dlg}" 2>/dev/null; then
            wait "${dlg}" || return 1
            ask_keep_waiting &
            dlg=$!
        fi

        sleep 3
        ticks=$((ticks + 1))
        # A line of dots every three seconds would be noise; a sentence every
        # half a minute is reassurance.
        if [ $((ticks % 10)) -eq 0 ]; then
            echo "  still waiting — nothing in ${DOWNLOADS} yet ($((ticks * 3 / 60)) min)"
        fi
    done
}

INSTALLER="$(find_installer || true)"
if [ -z "${INSTALLER}" ]; then
    echo ""
    echo "------------------------------------------------------------------"
    echo " Now download DaVinci Resolve"
    echo "------------------------------------------------------------------"
    echo "Opening Blackmagic's download page in your browser."
    echo ""
    echo "  * Choose DaVinci Resolve for LINUX. The free version is fine;"
    echo "    if you have bought Studio, that works here too."
    echo "  * Fill in their form — they ask for a name and email."
    echo "  * Save the file into your Downloads folder."
    echo "  * Then LEAVE IT ALONE. Do not open it, do not run it. This"
    echo "    script will notice it and take over."
    echo ""
    xdg-open "https://www.blackmagicdesign.com/products/davinciresolve" >/dev/null 2>&1 &

    if ! wait_for_installer; then
        echo ""
        echo "Stopped at your request. Nothing was changed."
        echo "When you are ready, start again from your apps:"
        echo "    \"Install DaVinci Resolve\""
        echo "or in a terminal:  ujust aquarius-resolve"
        exit 0
    fi
fi

echo ""
echo "Found: ${INSTALLER}"

# ==============================================================================
# UNPACK IT
# ==============================================================================
# Blackmagic hand out a .zip with a .run file inside. The .run file is itself an
# archive, and it knows how to unpack itself.
#
# Three shapes have to work, because all three happen:
#   a .run file                     use it directly
#   a .zip nobody has opened        we unzip it ourselves
#   a .zip the user already opened  handled further up: find_installer prefers
#                                   the .run, wherever in Downloads it landed
# ==============================================================================

WORK="$(mktemp -d -t resolve-setup-XXXXXX)"
trap 'rm -rf "${WORK}"' EXIT
cd "${WORK}" || exit 1

case "${INSTALLER}" in
    *.zip)
        echo "Unzipping (you have not opened it, so we will)..."
        if command -v unzip >/dev/null 2>&1; then
            unzip -q "${INSTALLER}" -d "${WORK}"
        else
            python3 -c 'import sys,zipfile;zipfile.ZipFile(sys.argv[1]).extractall(sys.argv[2])' "${INSTALLER}" "${WORK}"
        fi
        # The .run may be at the top of the zip or inside a folder in it.
        RUNFILE="$(find "${WORK}" -maxdepth 3 -type f -iname '*_Linux.run' | head -1)"
        ;;
    *)
        RUNFILE="${INSTALLER}"
        ;;
esac

if [ -z "${RUNFILE:-}" ] || [ ! -f "${RUNFILE}" ]; then
    echo ""
    echo "Could not find the Linux installer inside ${INSTALLER}."
    echo "It may be a Windows or Mac download by mistake — the Linux one is"
    echo "named something like DaVinci_Resolve_20.0_Linux.zip."
    echo ""
    echo "Delete what you downloaded and start again from your apps:"
    echo "    \"Install DaVinci Resolve\""
    exit 1
fi

echo "Unpacking the installer (this takes a minute)..."
# The .run is copied out of Downloads first. It has to be made executable to
# unpack itself, and changing the permissions of a file sitting in somebody's
# Downloads folder is not ours to do.
cp -f "${RUNFILE}" "${WORK}/resolve-installer.run"
RUNFILE="${WORK}/resolve-installer.run"
chmod +x "${RUNFILE}"
if ! "${RUNFILE}" --appimage-extract >/dev/null 2>&1; then
    echo "The installer would not unpack. It may have downloaded incompletely."
    echo "Delete it from ${DOWNLOADS} and try again."
    exit 1
fi

# ==============================================================================
# BUILD THE SEALED-OFF ENVIRONMENT
# ==============================================================================
# 'distrobox' makes a container that shares your home folder but has its own
# system libraries. davincibox is a well-maintained community image whose whole
# purpose is holding what Resolve needs on Linux.
#
# THIS is the environment the earlier warning is about. Blackmagic's installer
# only works in here; run on the real AquariusOS it stops on missing packages,
# because an atomic OS does not install packages that way.
# ==============================================================================

echo ""
echo "Building the environment Resolve runs in..."
echo "(This downloads roughly 2 GB the first time.)"
if podman container exists davincibox 2>/dev/null; then
    echo "An environment called 'davincibox' already exists — reusing it."
else
    # shellcheck disable=SC2086  # DBOX_FLAGS is deliberately word-split
    if ! distrobox create -i "${DBOX_IMAGE}" ${DBOX_FLAGS} -n davincibox -Y; then
        echo "Could not create the environment. Check your internet connection."
        exit 1
    fi
fi

echo ""
echo "Installing DaVinci Resolve. This is the long part."
if ! distrobox enter davincibox -- setup-davinci "${WORK}/squashfs-root/AppRun" distrobox; then
    echo ""
    echo "The install did not finish. Nothing on your real system was changed."
    echo "You can safely try again from your apps: \"Install DaVinci Resolve\""
    exit 1
fi

# ==============================================================================
# MAKE IT FEEL LIKE PART OF THE COMPUTER
# ==============================================================================
# davincibox has just written app-menu entries into
# ~/.local/share/applications/ that step into the container and run Resolve.
# They work. We point them at our own front door instead, which does the same
# thing plus the handful of things a container cannot know about the desktop
# around it — mainly what your mouse pointer is supposed to look like.
#
# Why this is a rewrite of THEIR file rather than a file of our own: the entries
# are generated at install time from Resolve's own .desktop files, which carry
# the real names, icons and MIME types. Regenerating that ourselves would mean
# owning a copy of somebody else's data forever. Editing one line of Exec= does
# not.
#
# It is written to be safe when it does not match: if the line is not the shape
# we expect, we leave the file exactly as it was and say so. A slightly wrong
# cursor is a far better outcome than a launcher that does not launch.
# ------------------------------------------------------------------------------

echo ""
echo "Tidying up the app-menu entries..."

APPS_DIR="${HOME}/.local/share/applications"
patched=0
skipped=0
for entry in "${APPS_DIR}"/DaVinci*.desktop "${APPS_DIR}"/blackmagicraw*.desktop; do
    [ -f "${entry}" ] || continue
    # Their line looks like:
    #   Exec=distrobox enter -n davincibox -- /usr/bin/run-davinci /opt/resolve/bin/resolve %u
    # We want everything AFTER run-davinci to survive untouched.
    if grep -q '^Exec=.*run-davinci ' "${entry}"; then
        sed -i 's|^Exec=.*run-davinci |Exec=/usr/libexec/aquarius-resolve-launch |' "${entry}"
        patched=$((patched + 1))
    else
        skipped=$((skipped + 1))
    fi
done

if [ "${patched}" -gt 0 ]; then
    echo "  ${patched} entries now use the AquariusOS launcher."
fi
if [ "${skipped}" -gt 0 ]; then
    echo "  ${skipped} entries were left alone — they did not look the way we expected."
    echo "  Resolve will still start; the mouse pointer inside it may look wrong."
fi

# The menu caches what it has seen. Without this the entries can take a login to
# appear or update.
update-desktop-database "${APPS_DIR}" >/dev/null 2>&1 || :

echo ""
echo "=================================================================="
echo " Done. 'DaVinci Resolve' is now in your apps."
echo "=================================================================="
if [ "${NEEDS_RESTART}" -eq 1 ]; then
    echo ""
    echo "One thing left: RESTART THE COMPUTER before opening Resolve."
    echo "Your account was just given permission to use the graphics card,"
    echo "and that only takes effect after a restart."
fi
echo ""
echo "You can delete the file you downloaded — Resolve is installed now."
echo ""
echo "------------------------------------------------------------------"
echo " If Resolve's window is bigger than your screen"
echo "------------------------------------------------------------------"
echo "Resolve sizes its own window, and on a 4K display it sometimes opens"
echo "one larger than the screen — with its edges, and its close and"
echo "minimise buttons, past the edge of the display. It looks like a"
echo "window you cannot move, shrink or get rid of. You can. The desktop"
echo "can drive any window from the keyboard, whether or not you can see"
echo "its edges:"
echo ""
echo "  Hold Meta and DRAG anywhere in the window   move it"
echo "  Hold Meta and RIGHT-DRAG anywhere in it     resize it"
echo "  Alt+F3                                      the window menu"
echo "                                              (Move, Resize, Minimise…)"
echo "  Meta+PageDown                               minimise"
echo "  Meta+PageUp                                 maximise"
echo "  Meta+Backspace                              restore it afterwards"
echo ""
echo "(Meta is the key with the Windows or Command symbol on it. Move and"
echo "Resize have no key of their own — they live in the Alt+F3 menu.)"
echo ""
echo "If it keeps happening, start Resolve once with the interface scaling"
echo "turned off, from a terminal:"
echo ""
echo "    AQUARIUS_RESOLVE_SCALE=1 /usr/libexec/aquarius-resolve-launch"
echo ""
echo "Two things worth knowing about Resolve on Linux:"
echo ""
echo "  * The FREE version cannot open ordinary phone/camera MP4 files."
echo "    That is Blackmagic's licensing, not AquariusOS. The AquariusOS"
echo "    ingest helper converts those files so they import cleanly."
echo "  * Even Resolve STUDIO imports MP4s with SILENT AUDIO on Linux."
echo "    If you own Studio, there is a community plug-in that fixes it:"
echo "        ujust install-resolve-aac-plugin"
echo ""
