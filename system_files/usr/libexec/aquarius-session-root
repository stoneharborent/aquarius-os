#!/usr/bin/bash
# =============================================================================
# aquarius-session-root — the five small root jobs Game Mode needs
# =============================================================================
# WHAT THIS IS, IN PLAIN ENGLISH
#
# Switching between the desktop and Game Mode means changing two things that
# live outside your home folder, and that only an administrator may write:
#
#   1. WHICH SESSION THE LOGIN SCREEN WILL START FOR YOU NEXT TIME.
#      The login screen keeps that for each account in a small file at
#      /var/lib/AccountsService/users/<your name>, in a line that reads
#      `Session=gnome`, `Session=plasma` or `Session=gamescope-session-steam`.
#
#   2. WHETHER THE LOGIN SCREEN LOGS YOU STRAIGHT BACK IN.
#      Every switch is a full logout (that is how Steam's Game Mode works on
#      every Linux that has it). So that you do not have to type your password
#      each time you press "Switch to Desktop", the login screen is told, for
#      this one switch, to log you in by itself after one second. That is the
#      `TimedLogin` block in /etc/gdm/custom.conf — and, since GDM 50, the
#      `AutomaticLogin` block beside it, which GDM now insists on before it
#      will honour a timed login at all. Both are written together by the
#      `switch-login` job below, which explains that rule at length.
#
# This program does nothing else. It is deliberately tiny and deliberately
# suspicious of everything it is handed, because it runs as root on behalf of a
# program that does not.
#
# ⚠️ IT IS NOT MEANT TO BE RUN BY HAND. The friendly front doors are:
#       aq game                 switch to Game Mode now
#       aq game boot on|off     start the computer in Game Mode, or not
#     and the "Game Mode" icon in the app grid.
#
# WHO IS ALLOWED TO ASK
#   /usr/share/polkit-1/actions/org.aquariusos.gamemode.policy describes the
#   job, and /usr/share/polkit-1/rules.d/51-aquarius-game-mode.rules narrows it
#   to one answer: the person sitting at this computer, in the session that owns
#   the screen right now, who is an administrator (the `wheel` group). For them
#   it is allowed with NO PASSWORD — because a password box cannot be typed into
#   from a game controller, and this switch is meant to be pressed from the
#   couch. For everybody else — over SSH, from a switched-away session, from a
#   non-administrator — the answer is a flat no and no box appears at all.
#
# ⚠️ WHY EVERY ARGUMENT IS CHECKED TWICE OVER
#   "No password" means anything that can reach this program as the logged-in
#   person can run it. So it must be impossible to talk it into writing
#   something that is not one of the handful of values it is supposed to write:
#     * the account name must be a real local account with a normal user number
#       (1000 or above) — never root, never a system account;
#     * the session name must be one of the session files this image actually
#       ships in /usr/share/wayland-sessions/;
#     * nothing is ever passed to a shell.
#
# WHAT IT CAN DO
#   aquarius-session-root set-session <account> <session>
#   aquarius-session-root switch-login on <account>   (a switch, while the
#   aquarius-session-root switch-login off             computer is running)
#   aquarius-session-root auto-login on <account>     (the boot-time service only)
#   aquarius-session-root auto-login off
#   aquarius-session-root reload-gdm
#   aquarius-session-root boot-flag desktop|game [<account>]
#
# Plain-language guide to the whole feature: docs/restart/game-mode.md.
# =============================================================================

set -uo pipefail

AQ_ACCOUNTS_DIR="/var/lib/AccountsService/users"
AQ_GDM_CONF="/etc/gdm/custom.conf"
AQ_SESSION_DIR="/usr/share/wayland-sessions"
AQ_FLAG_FILE="/etc/aquarius/login-mode"

say() { echo "aquarius-session-root: $*"; }
die() {
    echo "aquarius-session-root: $*" >&2
    exit 1
}

[ "$(id -u)" = "0" ] || die "this has to be run as root. Use 'aq game' instead."

# -----------------------------------------------------------------------------
# ⚠️ YOU MAY ONLY DO THIS TO YOUR OWN ACCOUNT
# -----------------------------------------------------------------------------
# THE HOLE THIS CLOSES, IN PLAIN ENGLISH. The permission rule for this program
# says yes with NO PASSWORD to any administrator sitting at this computer,
# because a switch to Game Mode has to work with a controller in your hands.
# Without the check below, that same no-password yes would let one
# administrator point SOMEBODY ELSE'S account at a session and switch on an
# automatic login for it — which is a password-free way into another person's
# account, on a machine where they had a password precisely so that could not
# happen. A single-person machine today is a family machine next year.
#
# HOW WE KNOW WHO ASKED. pkexec puts the asking person's user number into the
# environment as PKEXEC_UID before running us. It is set by pkexec itself, not
# by the caller: pkexec builds a clean environment and this is one of the few
# things it puts in it. So if PKEXEC_UID is there, somebody went through polkit
# to get here, and they may only act on themselves.
#
# ⚠️ WHEN IT IS NOT SET, TODAY'S BEHAVIOUR IS KEPT, AND THAT IS NOT A LOOPHOLE.
# PKEXEC_UID is absent in exactly one situation that matters: the boot-time
# service (aquarius-login-mode.service) runs this program as real root, before
# anybody has logged in, to set up the account the machine is configured to log
# in. There is no "asking person" at that point. Reaching that path at all
# already requires being root, and somebody who is root does not need this
# program to do anything.
#
# `boot-flag` is deliberately NOT covered: it is a setting about the COMPUTER
# ("does this machine start in Game Mode?"), not about a person, and an
# administrator is exactly who should be able to change it.
AQ_CALLER_UID="${PKEXEC_UID:-}"

aq_must_be_the_caller() {
    local name="$1" uid
    [ -n "${AQ_CALLER_UID}" ] || return 0   # real root, not through pkexec

    uid="$(getent passwd "${name}" 2> /dev/null | cut -d: -f3)"
    [ -n "${uid}" ] || die "there is no account called '${name}' on this computer."

    if [ "${uid}" != "${AQ_CALLER_UID}" ]; then
        die "you may only change your own account. You asked to change '${name}',
    which is somebody else's. Changing where another person's next login goes,
    and switching on a login that needs no password, is not something this
    computer will do for anybody — see the note in /usr/libexec/aquarius-session-root."
    fi
}

# -----------------------------------------------------------------------------
# aq_check_account <name>
# -----------------------------------------------------------------------------
# A real, ordinary account on this computer, and nothing else. `getent passwd`
# is the machine's own answer to "does this account exist"; the user-number test
# keeps root (0) and every system account (1–999) out.
aq_check_account() {
    local name="${1:-}" line uid
    case "${name}" in
        "" | *[!a-zA-Z0-9._-]*) die "'${name}' is not a name an account can have." ;;
    esac
    line="$(getent passwd "${name}" 2> /dev/null)" || die "there is no account called '${name}' on this computer."
    [ -n "${line}" ] || die "there is no account called '${name}' on this computer."
    uid="$(printf '%s\n' "${line}" | cut -d: -f3)"
    case "${uid}" in
        "" | *[!0-9]*) die "could not read the user number for '${name}'." ;;
    esac
    [ "${uid}" -ge 1000 ] || die "'${name}' is a system account (number ${uid}), not a person. Refusing."
    # "nobody" sits at 65534, above every person; the fake-root test of
    # 2026-09-19 got it past the line above. Nobody is not a person either.
    [ "${uid}" -lt 65534 ] || die "'${name}' (number ${uid}) is not a person's account. Refusing."
}

# -----------------------------------------------------------------------------
# aq_check_session <name>
# -----------------------------------------------------------------------------
# Only a session this image really ships. On AquariusOS that is exactly three:
# gnome, plasma, and gamescope-session-steam (Game Mode). Checking the file is
# on disk rather than checking against a list written here means the answer
# cannot drift away from what the login screen can actually offer.
aq_check_session() {
    local name="${1:-}"
    case "${name}" in
        "" | *[!a-zA-Z0-9._-]*) die "'${name}' is not a name a session can have." ;;
    esac
    [ -r "${AQ_SESSION_DIR}/${name}.desktop" ] \
        || die "this image has no session called '${name}' (${AQ_SESSION_DIR}/${name}.desktop is not there)."
}

# -----------------------------------------------------------------------------
# set-session <account> <session>
# -----------------------------------------------------------------------------
# Write the `Session=` line the login screen reads for that account. The file is
# an ordinary INI file owned by root; if it does not exist yet — which is the
# normal case for an account that has never chosen a desktop — it is created
# with just the one section and the one line in it.
aq_set_session() {
    local account="$1" session="$2" file
    aq_check_account "${account}"
    aq_must_be_the_caller "${account}"
    aq_check_session "${session}"
    file="${AQ_ACCOUNTS_DIR}/${account}"

    mkdir -p "${AQ_ACCOUNTS_DIR}" || die "could not make ${AQ_ACCOUNTS_DIR}."

    if [ -f "${file}" ]; then
        if grep -q '^[[:space:]]*Session[[:space:]]*=' "${file}"; then
            sed -i "s|^[[:space:]]*Session[[:space:]]*=.*|Session=${session}|" "${file}" \
                || die "could not write ${file}."
        elif grep -q '^\[User\]' "${file}"; then
            sed -i "/^\[User\]/a Session=${session}" "${file}" \
                || die "could not write ${file}."
        else
            printf '[User]\nSession=%s\n' "${session}" >> "${file}" \
                || die "could not write ${file}."
        fi
    else
        printf '[User]\nSession=%s\n' "${session}" > "${file}" \
            || die "could not create ${file}."
    fi
    chmod 0644 "${file}" 2> /dev/null || true

    # Trust content, never timestamps: read the line back out of the file.
    if grep -qx "Session=${session}" "${file}"; then
        say "the login screen will next start '${session}' for ${account}."
    else
        die "wrote ${file} but it does not say Session=${session}. Nothing was changed the way it should have been."
    fi
}

# -----------------------------------------------------------------------------
# The three small helpers the two login jobs share
# -----------------------------------------------------------------------------
# ⚠️ WHY THESE EXIST RATHER THAN THE SAME `sed` WRITTEN OUT FOUR TIMES. Both
# jobs below do exactly the same three things to /etc/gdm/custom.conf — take
# the old lines out, put new ones in under [daemon], then read them back — and
# until 2026-09-19 each job carried its own copy of all three. Two copies of a
# thing that must stay identical is one copy too many: the copies drifted, and
# the drift was the bug.

# aq_gdm_drop <sed-expression> — take lines out of custom.conf.
aq_gdm_drop() {
    sed -i "$1" "${AQ_GDM_CONF}" || die "could not edit ${AQ_GDM_CONF}."
}

# aq_gdm_add <line> [<line>...] — put lines in, directly under [daemon].
#
# The lines are added in the order given. sed's `a` command inserts AFTER the
# [daemon] line, so adding them one at a time and in order would reverse them;
# they are joined with the escaped newlines sed wants and added in one go.
# If there is no [daemon] section at all — a custom.conf somebody has emptied —
# one is made at the end of the file.
aq_gdm_add() {
    local joined="" line
    for line in "$@"; do
        if [ -z "${joined}" ]; then joined="${line}"; else joined="${joined}\\n${line}"; fi
    done
    if grep -q '^\[daemon\]' "${AQ_GDM_CONF}"; then
        sed -i "/^\[daemon\]/a ${joined}" "${AQ_GDM_CONF}" \
            || die "could not edit ${AQ_GDM_CONF}."
    else
        {
            echo ""
            echo "[daemon]"
            printf '%b\n' "${joined}"
        } >> "${AQ_GDM_CONF}" || die "could not edit ${AQ_GDM_CONF}."
    fi
}

# aq_gdm_must_say <line> [<line>...] — trust content, never timestamps.
# Reads the finished file and insists every line really is in it.
aq_gdm_must_say() {
    local line
    for line in "$@"; do
        grep -qx "${line}" "${AQ_GDM_CONF}" \
            || die "wrote ${AQ_GDM_CONF} but it does not contain '${line}'. Nothing was changed the way it should have been."
    done
}

# The five lines a switch needs, named once so no job can write four of them.
AQ_TIMED_KILL='/^[[:space:]]*TimedLoginEnable[[:space:]]*=/d; /^[[:space:]]*TimedLoginDelay[[:space:]]*=/d; /^[[:space:]]*TimedLogin[[:space:]]*=/d'
AQ_AUTO_KILL='/^[[:space:]]*AutomaticLoginEnable[[:space:]]*=/d; /^[[:space:]]*AutomaticLogin[[:space:]]*=/d'

# -----------------------------------------------------------------------------
# switch-login on <account>  /  switch-login off
# -----------------------------------------------------------------------------
# THE PASSWORD-FREE LOGIN THAT CARRIES YOU THROUGH ONE SWITCH.
#
# (This job was called `timed-login` until 2026-09-19. It was renamed because
# the name had stopped being true: it now writes the timed login AND the
# automatic one, for the reason below.)
#
# Every switch between the desktop and Game Mode is a full logout, so something
# has to log you back in without asking for a password — you cannot type a
# password on a game controller. GDM has two settings that look like they do
# that, and the whole history of this file is people discovering they are not
# interchangeable:
#
#   TimedLogin*      "after N seconds on the login screen, log this person in."
#                    Fires every time the login screen appears, including after
#                    a logout — which is what a switch is.
#   AutomaticLogin*  "log this person in without showing a login screen at all."
#                    Allowed ONCE in the life of the running GDM, and then spent.
#
# ⚠️ THE GDM 50 RULE, LEARNED ON THE BENCH ON 2026-09-19. Since GDM 50 the
# timed login ALSO needs the automatic-login keys to be set, for the same
# person. The login screen asks the GDM daemon to begin a timed login and the
# daemon checks the AUTOMATIC-login settings before agreeing
# (daemon/gdm-session.c, gdm_session_handle_client_begin_auto_login):
#
#     gdm_settings_direct_get_boolean (GDM_KEY_AUTO_LOGIN_ENABLE, &enabled);
#     gdm_settings_direct_get_string  (GDM_KEY_AUTO_LOGIN_USER, &allowed);
#     if (!enabled || allowed == NULL || g_strcmp0 (allowed, username) != 0) {
#             ... "Autologin not permitted for user %s"
#
# With only the TimedLogin lines written — Nobara's recipe, and ours until
# 2026-09-19 — the greeter's countdown fires, the daemon refuses, and the
# greeter tries again about every two seconds. That is what Royce saw: a
# password box that kept going inactive while he typed. In the journal it
# looks like this, over and over:
#
#     gnome-shell[14056]: Exception in callback for signal: release:
#     Gio.DBusError: GDBus.Error:org.freedesktop.DBus.Error.AccessDenied:
#     Autologin not permitted for user rorobeckley
#
# So a switch writes BOTH blocks — all five lines — and takes all five off
# again. Nothing else changed: the timed login is still the thing that carries
# a switch, and the automatic login is still what carries a cold boot.
#
# ⚠️ AND YES, THE AUTOMATIC LOGIN MAY FIRE INSTEAD. GDM allows its direct
# automatic login once per GDM lifetime, on any seat0 login screen and not only
# the first of a boot (daemon/gdm-manager.c, get_automatic_login_details, and
# the `did_automatic_login` flag beside it). So on a machine that has not used
# its automatic login yet, the first switch lands with no login screen at all;
# every switch after that goes through the greeter's one-second timed login,
# which now succeeds because these keys are present. Both paths land in the
# right session without a password, which is the whole point.
#
# The delay is one second, not zero. Zero is not allowed to mean "instantly" in
# GDM and a zero there has historically meant "never".
aq_switch_login() {
    local action="$1" account="${2:-}"

    [ -f "${AQ_GDM_CONF}" ] || die "${AQ_GDM_CONF} is not there — this computer's login screen is not the one AquariusOS ships."

    case "${action}" in
        on)
            aq_check_account "${account}"
            # Switching on a password-free login is the sharpest thing this
            # program does, so it is bound to the person asking. `off` is not:
            # taking a password-free login away can only ever make the machine
            # ask for a password more often, which is never something to refuse.
            aq_must_be_the_caller "${account}"
            # Remove both blocks first, whatever state the file was in, so this
            # can never end up with two of any line.
            aq_gdm_drop "${AQ_TIMED_KILL}"
            aq_gdm_drop "${AQ_AUTO_KILL}"
            aq_gdm_add \
                "TimedLoginEnable=true" \
                "TimedLoginDelay=1" \
                "TimedLogin=${account}" \
                "AutomaticLoginEnable=true" \
                "AutomaticLogin=${account}"
            aq_gdm_must_say \
                "TimedLoginEnable=true" \
                "TimedLoginDelay=1" \
                "TimedLogin=${account}" \
                "AutomaticLoginEnable=true" \
                "AutomaticLogin=${account}"
            say "the login screen will log ${account} back in by itself, without asking for a password."
            ;;
        off)
            aq_gdm_drop "${AQ_TIMED_KILL}"
            aq_gdm_drop "${AQ_AUTO_KILL}"
            if grep -q '^[[:space:]]*\(TimedLogin\|AutomaticLogin\)' "${AQ_GDM_CONF}"; then
                die "tried to remove the password-free login lines from ${AQ_GDM_CONF} and they are still there."
            fi
            say "the login screen will ask who you are again, the normal way."
            ;;
        *)
            die "'switch-login' takes 'on <account>' or 'off'."
            ;;
    esac
}

# -----------------------------------------------------------------------------
# auto-login on <account>  /  auto-login off
# -----------------------------------------------------------------------------
# ⚠️ THIS ONE IS FOR A COLD BOOT, AND ONLY THE BOOT-TIME SERVICE USES IT.
#
# A machine set to start in Game Mode (`aq game boot on`) has no switch to
# carry: it is switched on and it must arrive in Steam. There is no login
# screen in that story at all, so there is nothing for a timed login to do —
# what GDM honours there is the plain AutomaticLogin block, and that is what
# this writes. (It writes only the automatic block; `switch-login` above writes
# that block AND the timed one, because a switch needs both.)
#
# ⚠️ ONLY THE BOOT-TIME SERVICE CALLS `on`. It runs as real root, before
# anybody has logged in. Through pkexec this is still bound to the person
# asking, the same as switch-login, so it cannot be turned against somebody
# else's account.
aq_auto_login() {
    local action="$1" account="${2:-}"

    [ -f "${AQ_GDM_CONF}" ] || die "${AQ_GDM_CONF} is not there — this computer's login screen is not the one AquariusOS ships."

    case "${action}" in
        on)
            aq_check_account "${account}"
            aq_must_be_the_caller "${account}"
            aq_gdm_drop "${AQ_AUTO_KILL}"
            aq_gdm_add "AutomaticLoginEnable=true" "AutomaticLogin=${account}"
            aq_gdm_must_say "AutomaticLoginEnable=true" "AutomaticLogin=${account}"
            say "at the next boot the login screen will log ${account} in by itself."
            ;;
        off)
            aq_gdm_drop "${AQ_AUTO_KILL}"
            if grep -q '^[[:space:]]*AutomaticLogin' "${AQ_GDM_CONF}"; then
                die "tried to remove the automatic-login lines from ${AQ_GDM_CONF} and they are still there."
            fi
            say "the login screen will ask who you are at boot, the normal way."
            ;;
        *)
            die "'auto-login' takes 'on <account>' or 'off'."
            ;;
    esac
}

# -----------------------------------------------------------------------------
# reload-gdm
# -----------------------------------------------------------------------------
# ⚠️ RELOAD, NEVER RESTART. Restarting the login screen kills every graphical
# session on the machine at once, including the one asking for the restart, and
# on GDM it reliably ends in a black screen rather than a new login screen.
# Reload makes GDM re-read /etc/gdm/custom.conf — which is all we changed —
# without pulling the floor out. This is the same choice Nobara made, with the
# same one-line reason in their script.
aq_reload_gdm() {
    if ! systemctl is-active --quiet gdm.service; then
        say "the login screen is not running, so there is nothing to reload."
        return 0
    fi
    if systemctl reload gdm.service; then
        say "the login screen has re-read its settings."
    else
        # Never fatal. The worst case is that the person types their password
        # once, which is a small annoyance, not a broken machine.
        say "WARNING: could not reload the login screen. The switch will still"
        say "happen; you may be asked for your password once."
    fi
}

# -----------------------------------------------------------------------------
# boot-flag desktop|game [<account>]
# -----------------------------------------------------------------------------
# The one setting that decides what a COLD BOOT does: /etc/aquarius/login-mode.
# `desktop` (what both desktop images ship) means a cold boot is exactly as it
# has always been — the login screen, asking who you are. `game` means this
# computer starts straight into Game Mode, the way a console does.
#
# Switching between desktop and Game Mode while the computer is on NEVER
# touches this file. That is on purpose: how you start the machine and what you
# did last Tuesday evening are different questions.
aq_boot_flag() {
    local mode="$1" account="${2:-}"
    case "${mode}" in
        desktop | game) : ;;
        *) die "'boot-flag' takes 'desktop' or 'game'." ;;
    esac
    [ -z "${account}" ] || aq_check_account "${account}"

    mkdir -p "$(dirname "${AQ_FLAG_FILE}")" || die "could not make $(dirname "${AQ_FLAG_FILE}")."

    {
        echo "# AquariusOS — what this computer does when you switch it on."
        echo "#"
        echo "#   mode=desktop   show the login screen (the normal thing, and the default)"
        echo "#   mode=game      start straight into Game Mode, like a console"
        echo "#"
        echo "# Change it with:  aq game boot on   /   aq game boot off"
        echo "# Read about it in: docs/restart/game-mode.md"
        echo "mode=${mode}"
        # ⚠️ AN `if`, NOT `[ -n ... ] && echo`. A group's exit status is the
        # status of the LAST thing in it. Written the short way, a call with no
        # account name ends on a test that answers "no" — the whole group then
        # reports failure, the `|| die` below fires, and the program says it
        # could not write a file it had just written perfectly. The fake-root
        # test caught exactly that on 2026-09-17.
        if [ -n "${account}" ]; then
            echo "user=${account}"
        fi
    } > "${AQ_FLAG_FILE}" || die "could not write ${AQ_FLAG_FILE}."

    if grep -qx "mode=${mode}" "${AQ_FLAG_FILE}"; then
        if [ "${mode}" = "game" ]; then
            say "this computer will start in Game Mode from the next restart."
        else
            say "this computer will show the login screen when it starts, as normal."
        fi
    else
        die "wrote ${AQ_FLAG_FILE} but it does not say mode=${mode}."
    fi
}

# -----------------------------------------------------------------------------
# Which job?
# -----------------------------------------------------------------------------
case "${1:-}" in
    set-session)
        [ $# -eq 3 ] || die "usage: aquarius-session-root set-session <account> <session>"
        aq_set_session "$2" "$3"
        ;;
    switch-login)
        [ $# -ge 2 ] || die "usage: aquarius-session-root switch-login on <account> | off"
        aq_switch_login "$2" "${3:-}"
        ;;
    timed-login)
        # The old name for switch-login, kept for one release so that an
        # in-flight switch started by the previous image cannot end in a
        # program that does not know the word. It writes exactly what
        # switch-login writes, because they are the same job.
        [ $# -ge 2 ] || die "usage: aquarius-session-root switch-login on <account> | off"
        say "NOTE: 'timed-login' is the old name for 'switch-login'."
        aq_switch_login "$2" "${3:-}"
        ;;
    auto-login)
        [ $# -ge 2 ] || die "usage: aquarius-session-root auto-login on <account> | off"
        aq_auto_login "$2" "${3:-}"
        ;;
    reload-gdm)
        aq_reload_gdm
        ;;
    boot-flag)
        [ $# -ge 2 ] || die "usage: aquarius-session-root boot-flag desktop|game [<account>]"
        aq_boot_flag "$2" "${3:-}"
        ;;
    *)
        die "'${1:-}' is not a job this program knows. It does: set-session, switch-login, auto-login, reload-gdm, boot-flag."
        ;;
esac
