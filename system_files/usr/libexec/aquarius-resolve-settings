#!/usr/bin/python3
"""Small, discoverable display controls for DaVinci Resolve."""
import os
from pathlib import Path
import re
import subprocess
import sys

import gi
gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')
from gi.repository import Adw, Gio, Gtk
sys.path.insert(0, '/usr/lib/aquarius/python')
import aquarius_ui

VALUES = ['', '1', '1.25', '1.5']


def read_scale():
    conf = Path(os.environ.get('XDG_CONFIG_HOME', str(Path.home()/'.config'))) / 'aquarius/resolve.conf'
    try:
        values = re.findall(r'^[ \t]*scale[ \t]*=[ \t]*([^#\n]*)', conf.read_text(), re.M)
        return ''.join(values[-1].split()) if values else ''
    except OSError:
        return ''


class SettingsWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title='DaVinci Resolve Display Settings')
        self.set_default_size(540, 380)
        header = Adw.HeaderBar()
        header.set_title_widget(Adw.WindowTitle(title='DaVinci Resolve', subtitle='Display settings'))
        self.size = Adw.ComboRow(title='Interface size', subtitle='Applies the next time you open Resolve',
                                 model=Gtk.StringList.new(['Auto', '100%', '125%', '150%']))
        current = read_scale()
        # Do not silently replace a custom CLI value just by opening this window.
        self.values = list(VALUES)
        if current not in self.values:
            self.values.append(current)
            self.size.get_model().append('Custom (' + current + '×)')
        self.size.set_selected(self.values.index(current))
        self.saved_selection = self.size.get_selected()
        self.updating = False
        self.size.connect('notify::selected', self.change_size)
        group = Adw.PreferencesGroup(description='Auto follows your display and makes the interface easier to read on a 4K screen.')
        group.add(self.size)
        reset = aquarius_ui.pill_button('Reset window position')
        reset.connect('clicked', self.reset_position)
        self.status = aquarius_ui.body_label('Resolve remembers its last normal window size and position.')
        toolbar = Adw.ToolbarView()
        toolbar.add_top_bar(header)
        toolbar.set_content(aquarius_ui.page([group, reset, self.status], maximum_size=480))
        self.set_content(toolbar)

    def change_size(self, *_):
        if self.updating:
            return
        value = self.values[self.size.get_selected()] or 'auto'
        try:
            result = subprocess.run(['/usr/bin/aq', 'resolve', 'scale', value], capture_output=True, text=True, timeout=5)
            if result.returncode:
                raise OSError(result.stderr.strip() or 'Could not save the interface size.')
            self.saved_selection = self.size.get_selected()
            self.status.set_label('Saved. Close and reopen Resolve when you are ready; your current work stays open.')
        except (OSError, subprocess.TimeoutExpired) as exc:
            self.updating = True
            self.size.set_selected(self.saved_selection)
            self.updating = False
            self.status.set_label('Could not save the interface size: ' + str(exc))

    def reset_position(self, *_):
        try:
            result = subprocess.run(['/usr/libexec/aquarius-resolve-window', '--request-reset'], capture_output=True, text=True, timeout=5)
            if result.returncode:
                raise OSError('The window reset could not be saved. Check that your home folder has free space and allows changes.')
            subprocess.Popen(['/usr/libexec/aquarius-resolve-window'], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            self.status.set_label('Window reset requested. If Resolve is closed, it will open in a safe position next time.')
        except (OSError, subprocess.TimeoutExpired) as exc:
            self.status.set_label('Could not reset the window: ' + str(exc))


if __name__ == '__main__':
    app = Adw.Application(application_id='org.aquariusos.ResolveSettings', flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
    def activate(application):
        window = application.get_active_window() or SettingsWindow(application)
        window.present()
    app.connect('activate', activate)
    app.run(sys.argv)
