#!/usr/bin/python3
# =============================================================================
# aquarius-automount — plug a drive in, it appears; no password ever
# =============================================================================
# PLAIN ENGLISH
#
# On a Mac, when you plug in a USB stick, an SD card, or an external SSD, it
# just appears — you never type a password, and you drag it to the bin (or
# right-click Eject) to put it away safely. That is what a creator expects, and
# it is what this program gives the Aquarius Desktop.
#
# Fedora already ships the machinery that does the actual mounting — a service
# called udisks2 — and it already lets the person sitting at the screen mount
# and unmount a removable drive without a password. What Fedora does NOT do on
# its own is mount a drive the MOMENT you plug it in. GNOME's Files app does it
# while Files is running; our own Aquarius Session has no Files app running in
# the background, so nothing was doing it. This program is that missing piece.
#
# It sits quietly in your logged-in session, watches udisks2 for a drive being
# plugged in (or already plugged in when you logged in), and asks udisks2 to
# mount it. udisks2 mounts it under /run/media/<you>/<label>, exactly where the
# dock and Files look for it.
#
# -----------------------------------------------------------------------------
# WHAT IT WILL AND WILL NOT MOUNT — READ THIS BEFORE CHANGING THE FILTER
# -----------------------------------------------------------------------------
# It mounts a drive ONLY when udisks2 says all three of these are true:
#
#   HintAuto = true    udisks2's own word for "this is the kind of device that
#                      should be auto-mounted" — i.e. a removable/hotplugged
#                      drive, not something built into the machine.
#   HintIgnore = false the drive has not asked to be left alone.
#   HintSystem = false this is NOT a system-internal disk. This is the line
#                      that keeps us away from the disk the operating system
#                      itself lives on.
#
# Those three together are udisks2's blessed way of saying "this is a USB stick
# / SD card / external SSD and not the boot drive". We do NOT invent our own
# idea of removable — we ask udisks2, which knows.
#
# As a second, independent seatbelt, it also refuses to touch any device that
# is already providing one of the critical system mounts (/, /boot, /var,
# /home, and the EFI partition). If a filter change ever let one of those
# through, this catches it before anything is mounted twice. It should never
# fire; it exists so that a mistake is harmless rather than dangerous.
#
# It also skips a drive that is already mounted (nothing to do) and one that is
# still locked (an encrypted drive shows no filesystem until it is unlocked,
# and unlocking asks for the passphrase — that is a deliberate, separate step
# and not ours to automate).
#
# -----------------------------------------------------------------------------
# THE ONE EXCEPTION: A MAC DRIVE (APFS), WHICH WE MOUNT OURSELVES
# -----------------------------------------------------------------------------
# Everything above is udisks2 doing the work and this program only asking. There
# is exactly one kind of drive where that cannot happen: a drive formatted on a
# Mac, which Apple calls APFS.
#
# Linux's kernel cannot read APFS at all, and udisks2 will not mount a
# filesystem the kernel does not have. So for this one type we do the mount
# ourselves, with a program called apfs-fuse that reads the drive in ordinary
# user space and hands its contents to the desktop as a folder. It is READ-ONLY
# and always will be: APFS is undocumented, every Linux program that writes it is
# working from guesswork, and writing is where a lost shoot lives. Reading a Mac
# drive to copy files off it is the honest feature.
#
# When we see one, instead of asking udisks2 to mount it we:
#
#   1. ask `apfsutil` what volumes are inside it (a Mac drive is a container
#      holding one or more volumes — an external drive normally has one; a Mac's
#      internal SSD has five or six, most of them Apple's own machinery);
#   2. skip the machinery volumes (Preboot, Recovery, VM, Update, and the rest —
#      the list is in /usr/lib/aquarius/python/aquarius_apfs.py);
#   3. mount each of the others, READ-ONLY, as the person, at
#      /run/media/<you>/<the volume's name> — exactly where udisks2 would have
#      put it, so the dock and Files see no difference;
#   4. and, if a volume is locked with FileVault, mount NOTHING and put a
#      notification on screen offering to unlock it. Never a silent nothing.
#
# No password is involved anywhere in that, and neither is any privilege. A udev
# rule (/usr/lib/udev/rules.d/70-aquarius-apfs.rules) hands an APFS device to
# whoever is logged in at the screen, in the same standard way Linux hands you
# your own webcam, and apfs-fuse then runs as you. There is no service, no
# `sudo` and no setuid program of ours anywhere in this path.
#
# The whole thing in plain English, including what does NOT work:
# docs/restart/mac-drives.md.
#
# -----------------------------------------------------------------------------
# WHY NO PASSWORD
# -----------------------------------------------------------------------------
# The mount call is made as YOU — this program runs in your own session with no
# special powers. udisks2 asks polkit "is this person allowed?", and the rule
# in /usr/share/polkit-1/rules.d/49-aquarius-udisks.rules answers "yes, for a
# removable drive, for the person actually sitting at this machine". So there is
# no prompt. Unmounting from the dock is the same story in reverse, and the same
# rule covers it. The rule is deliberately narrow: it never grants a
# no-password mount of an internal disk. See that file's own header.
#
# We pass "auth.no_user_interaction = true" on every mount so that, in the one
# case where a mount is NOT allowed without a password, it fails quietly and is
# logged rather than popping a password box at you for a drive you plugged in a
# second ago. Auto-mounting must never interrupt you.
#
# -----------------------------------------------------------------------------
# HOW IT IS RUN
# -----------------------------------------------------------------------------
#   aquarius-automount             watch and mount. This is what the user
#                                  service /usr/lib/systemd/user/
#                                  aquarius-automount.service runs.
#   aquarius-automount --once      mount everything that is plugged in right
#                                  now, then exit. (No watching.)
#   aquarius-automount --dry-run   say what it would do and change NOTHING.
#                                  Designed to run in a build container with no
#                                  udisks2 and no screen — it prints its rules
#                                  and exits 0. This is what CI runs.
#   aquarius-automount --help      this header.
#
# It never runs at the login screen: the service carries ConditionUser=!@system,
# so it starts for people and not for the machine's own login account.
#
# -----------------------------------------------------------------------------
# THE ONE DEPENDENCY
# -----------------------------------------------------------------------------
# python3-gobject (the `gi` module) plus GLib and Gio, which come with it. That
# is the same set the Resolve and welcome windows already need, so nothing new
# is added to the image. It does NOT use GTK — there is no window here — so it
# imports only GLib and Gio, which work with no screen.
#
# Plain-English guide: docs/restart/hardware.md, section "Plugging a drive in —
# and the bug that meant we never did".
# =============================================================================

import os
import subprocess
import sys
import traceback

# -----------------------------------------------------------------------------
# The shared Mac-drive reader
# -----------------------------------------------------------------------------
# /usr/lib/aquarius/python/aquarius_apfs.py knows how to read what `apfsutil`
# prints and which volumes are worth showing a person. It is shared with
# /usr/libexec/aquarius-drive-unlock, because two copies of that parser would be
# two chances to disagree about whether a drive is locked.
#
# The path is worked out RELATIVE TO THIS FILE, which makes it the same
# expression in both places it has to work: in the finished image this file is
# /usr/libexec/aquarius-automount, so "../lib/aquarius/python" is
# /usr/lib/aquarius/python; in the repository it is
# system_files/usr/libexec/aquarius-automount, so the same expression finds
# system_files/usr/lib/aquarius/python. That is what lets the tests run before
# anything is installed.
sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.abspath(__file__)), "..", "lib", "aquarius", "python"))
sys.path.insert(1, "/usr/lib/aquarius/python")
import aquarius_apfs  # noqa: E402

# The bus name and paths udisks2 publishes on. These are stable public API.
UDISKS = "org.freedesktop.UDisks2"
UDISKS_PATH = "/org/freedesktop/UDisks2"
OM_IFACE = "org.freedesktop.DBus.ObjectManager"
PROPS_IFACE = "org.freedesktop.DBus.Properties"
BLOCK_IFACE = "org.freedesktop.UDisks2.Block"
FS_IFACE = "org.freedesktop.UDisks2.Filesystem"

# The mounts we will never, ever put a second mount on top of. udisks2's
# HintSystem should already keep us away from these; this is the seatbelt.
CRITICAL_MOUNTS = ("/", "/boot", "/boot/efi", "/efi", "/var", "/home", "/usr")

# ⚠️ The one filesystem udisks2 cannot mount and we mount ourselves. Read the
# "MAC DRIVE" section of this file's header before touching anything below that
# mentions it.
APFS = "apfs"

# The three programs the Mac-drive path uses. All from Fedora's own packages:
# apfs-fuse and apfsutil come from `apfs-fuse`, fusermount3 from `fuse3`.
FUSERMOUNT = "/usr/bin/fusermount3"

# The window that asks for a FileVault password. Ours; see its own header. It
# sits in the same folder as this program, so the path is worked out from this
# file — /usr/libexec/aquarius-drive-unlock in the finished image, and the copy
# in the repository when the tests run before anything is installed. Same trick,
# same reason, as the sys.path line above.
UNLOCK_HELPER = os.path.join(
    os.path.dirname(os.path.abspath(__file__)), "aquarius-drive-unlock")


def log(message):
    """One line to the session journal, tagged so it is easy to find."""
    print("[automount] %s" % message, flush=True)


# -----------------------------------------------------------------------------
# --dry-run — no bus, no screen, no changes. This is what the build runs.
# -----------------------------------------------------------------------------
# It deliberately does NOT touch D-Bus: a build container has no udisks2 and no
# system bus, and the whole point of --dry-run is that it proves the program
# loads and states its rules on a machine with neither. It still imports gi, to
# prove python3-gobject is really in the image.
def dry_run():
    import gi  # noqa: F401  (imported to prove it is installed)

    print("aquarius-automount --dry-run")
    print("Nothing is mounted or changed. This is the rehearsal the build runs.")
    print("")
    print("What it does when it runs for real:")
    print("  * connects to udisks2 on the system bus")
    print("  * mounts every drive already plugged in, then watches for more")
    print("  * mounts a drive only when udisks2 says it is:")
    print("      HintAuto = true   (a removable/hotplugged drive)")
    print("      HintIgnore = false")
    print("      HintSystem = false  (NOT a system-internal disk)")
    print("  * never mounts a device already backing one of: %s" % ", ".join(CRITICAL_MOUNTS))
    print("  * skips a drive that is already mounted or still locked")
    print("  * mounts as the logged-in user, with no password, because")
    print("    /usr/share/polkit-1/rules.d/49-aquarius-udisks.rules allows it")
    print("    for a removable drive in the active local session")
    print("  * passes auth.no_user_interaction=true so a disallowed mount fails")
    print("    quietly instead of interrupting the person")
    print("")
    print("And the one exception, a Mac drive (APFS), which udisks2 cannot mount:")
    print("  * asks apfsutil which volumes are inside it")
    print("  * skips the volumes that are Apple's own machinery: %s"
          % ", ".join(sorted(aquarius_apfs.SKIP_ROLES)))
    print("  * mounts each of the others READ-ONLY, as this person, with")
    print("    apfs-fuse -o ro,uid=,gid=,subtype=apfs — never allow_other")
    print("  * puts them at /run/media/<user>/<volume name>, exactly where")
    print("    udisks2 puts everything else, so the dock sees no difference")
    print("  * a FileVault-locked volume is NOT mounted and NOT silent: it")
    print("    sends a notification offering to unlock it (%s)" % UNLOCK_HELPER)
    print("  * never stores a password, anywhere, ever")
    print("  * when the drive is unplugged, unmounts with %s -u -z and" % FUSERMOUNT)
    print("    removes the empty folder it made")
    return 0


# -----------------------------------------------------------------------------
# The devices currently backing a critical system mount.
# -----------------------------------------------------------------------------
# Read from /proc/self/mountinfo, which lists every mount and the device node
# behind it. We reduce each such node to its whole-disk name (sda3 -> sda,
# nvme0n1p2 -> nvme0n1) so that no partition of the system disk can be touched.
def critical_disks():
    disks = set()
    for mount in read_mounts():
        if mount["mount_point"] in CRITICAL_MOUNTS and mount["source"].startswith("/dev/"):
            disks.add(_whole_disk(mount["source"]))
    return disks


# The two "where are the drives" helpers live in the shared module, because
# /usr/libexec/aquarius-drive-unlock needs exactly the same answers. They are
# given their old names here so that the rest of this file — and the tests that
# call them — read the way they always did.
read_mounts = aquarius_apfs.read_mounts
media_root = aquarius_apfs.media_root


def _whole_disk(dev_path):
    """/dev/sda3 -> sda ; /dev/nvme0n1p2 -> nvme0n1 ; /dev/mmcblk0p1 -> mmcblk0"""
    name = os.path.basename(dev_path)
    # nvme/mmcblk name their partitions with a trailing 'pN'.
    for stem in ("nvme", "mmcblk", "loop"):
        if name.startswith(stem):
            idx = name.rfind("p")
            if idx > 0 and name[idx + 1:].isdigit():
                return name[:idx]
            return name
    # sd*, vd*, hd* just have trailing digits on the partition.
    return name.rstrip("0123456789")


class AutoMounter:
    def __init__(self, bus):
        self.bus = bus
        # Whole-disk names we must never mount on top of. Read once at start;
        # the system disk does not change under us mid-session.
        self.protected = critical_disks()
        if self.protected:
            log("leaving the system disk(s) alone: %s" % ", ".join(sorted(self.protected)))

        # Who we are. A Mac drive is mounted BY this person, so apfs-fuse is
        # told to present every file as belonging to them — an APFS drive
        # carries a Mac's user numbers, which mean nothing on this computer.
        self.uid = os.getuid()
        self.gid = os.getgid()

        # The Mac-drive mounts THIS program made, so that unplugging the drive
        # takes them away again. Keyed by the udisks2 object path, because that
        # is what udisks2 names when the device disappears.
        #   {object_path: [{"mount_point": ..., "device": ...}, ...]}
        self.apfs_mounts = {}

    # -- running other programs (the two places this program is faked) ------
    #
    # Everything this program runs goes through one of these two, and NOTHING
    # else in the file calls subprocess. That is deliberate: it is the seam the
    # tests replace, so that tests/test-automount-mount.py can hand it a real
    # captured `apfsutil` listing and read back the exact apfs-fuse command line
    # — on a machine with no Mac drive, no FUSE and no root.

    def run(self, argv, timeout=120):
        """Run a program, wait for it, and return (exit code, output, errors).

        Never raises: a missing program is an exit code, not a crash.
        """
        try:
            proc = subprocess.run(
                argv,
                stdin=subprocess.DEVNULL,
                capture_output=True,
                text=True,
                timeout=timeout,
                errors="replace",
            )
        except FileNotFoundError:
            return 127, "", "%s is not installed on this computer" % argv[0]
        except subprocess.SubprocessError as error:
            return 1, "", str(error)
        return proc.returncode, proc.stdout, proc.stderr

    def spawn(self, argv):
        """Start a program and do NOT wait for it.

        Used for exactly one thing: putting the "this Mac drive is locked"
        notification on screen. That helper waits for somebody to press a button,
        which could be an hour — and this program has to stay free to mount the
        next drive somebody plugs in.
        """
        try:
            subprocess.Popen(
                argv,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
            return True
        except (OSError, ValueError) as error:
            log("could not start %s: %s" % (argv[0], error))
            return False

    # -- reading udisks2 ----------------------------------------------------

    def _get_prop(self, object_path, interface, name):
        """One property, or None if the interface/property is not there."""
        from gi.repository import GLib

        try:
            reply = self.bus.call_sync(
                UDISKS,
                object_path,
                PROPS_IFACE,
                "Get",
                GLib.Variant("(ss)", (interface, name)),
                GLib.VariantType("(v)"),
                0,
                5000,
                None,
            )
        except GLib.Error:
            return None
        return reply.unpack()[0]

    def _has_interface(self, object_path, interface):
        from gi.repository import GLib

        try:
            self.bus.call_sync(
                UDISKS,
                object_path,
                PROPS_IFACE,
                "GetAll",
                GLib.Variant("(s)", (interface,)),
                GLib.VariantType("(a{sv})"),
                0,
                5000,
                None,
            )
            return True
        except GLib.Error:
            return False

    # -- the decision -------------------------------------------------------

    def should_mount(self, object_path):
        """True only for a removable drive that is safe and not already up."""
        # It has to be a filesystem at all. A whole disk, or a locked encrypted
        # drive, has no Filesystem interface and there is nothing to mount.
        if not self._has_interface(object_path, FS_IFACE):
            return False

        hint_auto = self._get_prop(object_path, BLOCK_IFACE, "HintAuto")
        hint_ignore = self._get_prop(object_path, BLOCK_IFACE, "HintIgnore")
        hint_system = self._get_prop(object_path, BLOCK_IFACE, "HintSystem")

        # udisks2's own verdict. This is the real filter.
        if not hint_auto:
            return False
        if hint_ignore:
            return False
        if hint_system:
            log("%s is a system device — leaving it alone" % object_path)
            return False

        # Already mounted? MountPoints is a list of NUL-terminated byte
        # strings; a non-empty list means it is up already.
        mount_points = self._get_prop(object_path, FS_IFACE, "MountPoints")
        if mount_points:
            return False

        # The seatbelt: never a device that is part of the system disk.
        device = self._device_node(object_path)
        if device:
            disk = _whole_disk(device)
            if disk in self.protected:
                log("%s (%s) is on the system disk — refusing" % (object_path, device))
                return False

        return True

    def _device_node(self, object_path):
        """The /dev path of a block device, as a plain string, or ''."""
        raw = self._get_prop(object_path, BLOCK_IFACE, "Device")
        if raw is None:
            return ""
        # Device is a byte array ending in a NUL. Turn it back into text.
        try:
            data = bytes(raw)
        except TypeError:
            return ""
        return data.split(b"\x00", 1)[0].decode("utf-8", "replace")

    def id_type(self, object_path):
        """What Linux thinks is on this device: 'exfat', 'ntfs', 'apfs', ''…

        This is udisks2 repeating what blkid worked out when the drive was
        plugged in. It is the ONE thing that sends a drive down the Mac path
        instead of the udisks2 one.
        """
        return str(self._get_prop(object_path, BLOCK_IFACE, "IdType") or "")

    # =======================================================================
    # A MAC DRIVE (APFS) — the one kind we mount ourselves
    # =======================================================================
    # Read the "MAC DRIVE" section of this file's header first. In one line:
    # Linux cannot read APFS, so udisks2 will not mount it, so we run apfs-fuse
    # as the person and put the result exactly where udisks2 would have.

    def apfs_should_mount(self, object_path):
        """The same three udisks2 hints and the same seatbelt as everything else.

        It deliberately does NOT ask whether udisks2 has a Filesystem interface
        for the device, the way should_mount() does. udisks2 publishes one for
        APFS today (it recognises the filesystem even though it cannot mount it)
        but that is its decision to change, and a drive we could read going
        invisible because udisks2 stopped advertising a type it never supported
        would be a silly way to lose the feature.
        """
        hint_auto = self._get_prop(object_path, BLOCK_IFACE, "HintAuto")
        hint_ignore = self._get_prop(object_path, BLOCK_IFACE, "HintIgnore")
        hint_system = self._get_prop(object_path, BLOCK_IFACE, "HintSystem")

        if not hint_auto:
            return False
        if hint_ignore:
            return False
        if hint_system:
            log("%s is a system device — leaving it alone" % object_path)
            return False

        device = self._device_node(object_path)
        if not device:
            return False
        if _whole_disk(device) in self.protected:
            log("%s (%s) is on the system disk — refusing" % (object_path, device))
            return False

        # Already done? Two ways this happens and both are ordinary: the initial
        # sweep can see a drive twice, and a session restarted with the drive
        # still plugged in finds its own earlier mounts still there.
        already = self.apfs_mounted_from(device)
        if already:
            log("%s is already open at %s — nothing to do"
                % (device, ", ".join(already)))
            return False

        return True

    def apfs_mounted_from(self, device):
        """The folders where this device is already mounted by a FUSE program.

        apfs-fuse names the mount after the device it read (it sets fsname to
        the device path), so the machine's own mount table is the truthful
        answer to "is this drive already open?" — truer than anything this
        program could remember, because it survives the program restarting.
        """
        found = []
        for mount in read_mounts():
            if mount["source"] == device and mount["fstype"].startswith("fuse"):
                found.append(mount["mount_point"])
        return found

    def mount_apfs(self, object_path):
        """Open every readable volume on a Mac drive, read-only, as this person."""
        device = self._device_node(object_path) or object_path

        root = media_root()
        if not root:
            log("could not work out where to put %s (no /run/media folder for this account)"
                % device)
            return
        if not os.path.isdir(root):
            # /usr/libexec/aquarius-media-dir makes this at login. If it is not
            # there we can try, and say so plainly if we may not.
            try:
                os.makedirs(root, 0o700)
            except OSError as error:
                log("%s is a Mac drive, but %s does not exist and could not be"
                    " made (%s). aquarius-media-dir should have made it at login."
                    % (device, root, error))
                return

        log("%s is a Mac drive (APFS) — reading what is on it" % device)
        volumes = aquarius_apfs.read_volumes(
            device, run=lambda argv, timeout: self.run(argv, timeout))
        if not volumes:
            log("could not read the volumes on %s. If it is a Mac's built-in disk"
                " from a T2 or Apple-silicon machine, its encryption is in the"
                " Mac's own chip and no other computer can read it." % device)
            return

        wanted = [volume for volume in volumes if volume.should_mount]
        skipped = len(volumes) - len(wanted)
        if skipped:
            log("%s: ignoring %d Apple system volume(s) — nobody's files live there"
                % (device, skipped))
        if not wanted:
            log("%s has nothing on it a person would open" % device)
            return

        for volume in wanted:
            if volume.encrypted:
                self.apfs_locked(device, volume)
                continue
            self.apfs_mount_volume(object_path, device, root, volume)

    def apfs_mount_volume(self, object_path, device, root, volume):
        """One volume: make the folder, run apfs-fuse, say what happened."""
        name = volume.display_name
        target = aquarius_apfs.unique_mount_point(root, name)
        if target is None:
            log("could not find a free folder name for %s in %s" % (name, root))
            return

        try:
            os.mkdir(target, 0o700)
        except OSError as error:
            log("could not make the folder for %s at %s: %s" % (name, target, error))
            return

        # ⚠️ THE COMMAND LINE, AND WHY EACH PIECE OF IT IS THERE.
        #
        #   -v <n>          which volume inside the container. A Mac drive is a
        #                   box with volumes in it; this is which one.
        #   ro              read-only. apfs-fuse adds this itself as well, and we
        #                   say it anyway: it is the promise this whole feature
        #                   makes, and it should not depend on somebody else's
        #                   default staying what it is today.
        #   uid= gid=       present every file as belonging to the person at the
        #                   keyboard. The numbers stored on an APFS drive are a
        #                   Mac's user numbers and mean nothing here; without
        #                   this, a copied folder can arrive unreadable.
        #   subtype=apfs    makes the mount call itself "fuse.apfs" in the
        #                   machine's mount table instead of a bare "fuse".
        #                   That is what `aq drive list`, the Files app and GIO
        #                   read to tell a Mac drive from anything else.
        #
        # ⚠️ AND WHAT IS DELIBERATELY NOT THERE: allow_other. That option would
        # let every account on the computer read the drive, and it needs
        # user_allow_other switching on in /etc/fuse.conf. We need neither: the
        # mount is made by the person, for the person, and their own desktop is
        # the only thing that has to see it. build_files/82-apfs-drives.sh fails
        # the build if this line ever grows one.
        options = "ro,uid=%d,gid=%d,subtype=apfs" % (self.uid, self.gid)
        argv = [aquarius_apfs.APFS_FUSE, "-v", str(volume.index),
                "-o", options, device, target]

        log("mounting %s (%s, Mac drive, read-only)" % (name, device))
        code, _out, err = self.run(argv)
        if code == 0:
            self.apfs_mounts.setdefault(object_path, []).append(
                {"mount_point": target, "device": device})
            log("mounted %s at %s" % (name, target))
            return

        # It failed. Take the empty folder away again — an empty folder in
        # /run/media is a drive tile in the dock that opens onto nothing.
        try:
            os.rmdir(target)
        except OSError:
            pass
        reason = (err or "").strip().splitlines()
        reason = reason[-1] if reason else "apfs-fuse exited with code %d" % code
        log("could not mount %s (%s): %s" % (name, device, reason))

    def apfs_locked(self, device, volume):
        """A FileVault volume: mount nothing, and never be silent about it."""
        name = volume.display_name
        log("%s on %s is locked with FileVault — not mounting it, and asking"
            " whether you want to unlock it" % (name, device))
        if not os.path.exists(UNLOCK_HELPER):
            log("        (%s is missing, so there is nothing to ask with. Run"
                " 'aq drive unlock \"%s\"' in a terminal.)" % (UNLOCK_HELPER, name))
            return
        self.spawn([UNLOCK_HELPER, "--notify", device, str(volume.index), name])

    # -- putting a Mac drive away again -------------------------------------

    def apfs_forget(self, object_path):
        """The drive at this udisks2 object has gone. Take its mounts with it."""
        for entry in self.apfs_mounts.pop(object_path, []):
            self.apfs_unmount(entry["mount_point"])

    def apfs_forget_vanished(self):
        """Net under the above: any mount of ours whose device no longer exists.

        udisks2 usually tells us which object went away, and apfs_forget() deals
        with it. This catches the case where it does not — a controller that
        drops off the bus, a dock unplugged with three drives on it — by asking
        the simplest possible question about each mount we made: is the drive
        still there at all?
        """
        for object_path in list(self.apfs_mounts.keys()):
            keep = []
            for entry in self.apfs_mounts[object_path]:
                if os.path.exists(entry["device"]):
                    keep.append(entry)
                else:
                    log("%s has been unplugged" % entry["device"])
                    self.apfs_unmount(entry["mount_point"])
            if keep:
                self.apfs_mounts[object_path] = keep
            else:
                del self.apfs_mounts[object_path]

    def apfs_unmount(self, mount_point):
        """Close one Mac-drive mount and take its empty folder away.

        `fusermount3 -u -z`: -u is "unmount", -z is "even if something still has
        a file open on it". The -z matters because the usual way this runs is
        somebody pulling the cable out — at which point every open file on that
        drive is already broken and holding the mount open forever helps nobody.
        """
        code, _out, err = self.run([FUSERMOUNT, "-u", "-z", mount_point], timeout=30)
        if code != 0:
            reason = (err or "").strip().splitlines()
            log("could not close %s: %s"
                % (mount_point, reason[-1] if reason else "exit code %d" % code))
        else:
            log("closed %s" % mount_point)
        try:
            os.rmdir(mount_point)
        except OSError:
            # Still busy, or already gone. Neither is worth alarming anybody.
            pass

    # -- doing it -----------------------------------------------------------

    def mount(self, object_path):
        from gi.repository import GLib

        label = self._get_prop(object_path, BLOCK_IFACE, "IdLabel") or "(no label)"
        device = self._device_node(object_path) or object_path

        # ⚠️ A ONE-CHARACTER-CLASS BUG THAT BROKE EVERY MOUNT FOR FIVE DAYS.
        # Read this before touching the two lines below.
        #
        # udisks2's Mount method takes ONE argument, a dictionary of options.
        # In D-Bus terms the whole argument list of a method call is a tuple, so
        # what has to go on the wire is `(a{sv})` — "a tuple containing one
        # dictionary". The obvious way to build that is what this used to say:
        #
        #     options = GLib.Variant("a{sv}", { ... })      # the dictionary
        #     GLib.Variant("(a{sv})", (options,))           # in a tuple
        #
        # and it is wrong. PyGObject's GLib.Variant() builds the WHOLE thing
        # from plain Python values: given the type `(a{sv})` it expects a tuple
        # whose first item is a plain `dict`, and it walks that dict itself. It
        # was handed a GLib.Variant instead, tried to read it as a dict, asked it
        # for key 0 — and a Variant has no key 0. So every single mount died with
        #
        #     File ".../gi/overrides/GLib.py", line 396, in __getitem__
        #     KeyError: 0
        #
        # before it ever reached D-Bus. Nothing on the machine was broken; this
        # program simply could not ask. On the bench (2026-09-08) the two drives
        # sitting in /run/media were mounted by the Files app, not by us, which
        # is why "the drives are there but not in the dock" looked like a dock
        # problem for a day.
        #
        # THE ONE-LINE RULE, so this cannot come back: pass PLAIN PYTHON values
        # to GLib.Variant(). The only place a nested GLib.Variant belongs is as
        # the VALUE inside an `a{sv}` dictionary, because `v` means "a variant"
        # and there is nothing else it could be.
        #
        # tests/test-automount-mount.py exercises this against a fake bus, so the
        # Variant is really constructed by PyGObject. `py_compile` cannot catch
        # it — the old line was perfectly valid Python.
        #
        # No fstype and no path: udisks picks a sensible read/write mount and
        # puts it at /run/media/<user>/<label>. auth.no_user_interaction keeps
        # a disallowed mount quiet instead of popping a password box.
        options = {
            "auth.no_user_interaction": GLib.Variant("b", True),
        }

        # One plain line per attempt. ⚠️ ADDED 2026-09-08 FOR THE SAME REASON:
        # the crash above happened on every plug-in and the journal showed only
        # a Python traceback, which reads as "something is broken" and not as
        # "we tried to mount SHOOT-2026 and could not". A line before and a line
        # after means the journal tells the story either way.
        log("mounting %s (%s)" % (label, device))

        try:
            reply = self.bus.call_sync(
                UDISKS,
                object_path,
                FS_IFACE,
                "Mount",
                GLib.Variant("(a{sv})", (options,)),
                GLib.VariantType("(s)"),
                0,
                120000,
                None,
            )
            where = reply.unpack()[0]
            log("mounted %s at %s" % (label, where))
        except GLib.Error as error:
            # "AlreadyMounted" is a race, not a fault: a drive plugged in during
            # the initial sweep can be seen twice. Everything else is worth a
            # line so a genuinely refused mount is visible in the journal.
            message = error.message or str(error)
            if "AlreadyMounted" in message:
                log("%s was already mounted by something else — nothing to do" % label)
                return
            log("could not mount %s (%s): %s" % (label, device, message))

    def consider(self, object_path):
        # ⚠️ ONE DRIVE MUST NEVER TAKE THE AGENT DOWN, AND MUST NEVER BE SILENT.
        #
        # This is the outermost catch, and it is here because of what a bare
        # exception used to look like from a person's chair. The Variant fault
        # described in mount() raised a KeyError, which is not a GLib.Error and
        # so passed straight through every `except GLib.Error` in this file. It
        # came out as a Python traceback in the session journal — twenty lines of
        # file names and line numbers — and the agent carried on, so nothing was
        # obviously dead and nothing was obviously working either.
        #
        # A drive that cannot be mounted is a fact worth one plain sentence. The
        # traceback still goes to the journal underneath it, for whoever is
        # fixing it; the sentence is for whoever is only trying to find out what
        # happened.
        try:
            # ⚠️ THE FORK IN THE ROAD, AND IT IS ONE LINE. A Mac drive cannot go
            # to udisks2 — udisks2 has no APFS to mount with and would refuse —
            # so it goes down our own path instead. Every other drive on earth
            # goes the way it always did.
            if self.id_type(object_path) == APFS:
                if self.apfs_should_mount(object_path):
                    self.mount_apfs(object_path)
                return
            if self.should_mount(object_path):
                self.mount(object_path)
        except Exception as error:  # noqa: BLE001 — deliberate; see above
            log("could not deal with %s: %s: %s"
                % (object_path, type(error).__name__, error))
            log("        (the full details are below; the drive was not mounted,")
            log("         and this agent is still watching for others)")
            traceback.print_exc()

    # -- the two ways in ----------------------------------------------------

    def sweep(self):
        """Mount everything that is plugged in right now."""
        from gi.repository import GLib

        try:
            reply = self.bus.call_sync(
                UDISKS,
                UDISKS_PATH,
                OM_IFACE,
                "GetManagedObjects",
                None,
                GLib.VariantType("(a{oa{sa{sv}}})"),
                0,
                5000,
                None,
            )
        except GLib.Error as error:
            log("could not ask udisks2 what is plugged in: %s" % (error.message or error))
            return
        objects = reply.unpack()[0]
        for object_path, interfaces in objects.items():
            # ⚠️ WHY THIS LOOKS AT PLAIN BLOCK DEVICES TOO, AND NOT ONLY AT ONES
            # udisks2 CALLS FILESYSTEMS. Because of Mac drives. udisks2 marks a
            # device as a "Filesystem" when it recognises what is on it, and it
            # does recognise APFS today — but it has never been able to MOUNT
            # APFS, and a future udisks2 that stopped advertising a type it
            # cannot use would make every Mac drive quietly invisible to us.
            # consider() asks what the device is before it does anything, so the
            # cost of looking at all of them is one extra question per device.
            if FS_IFACE in interfaces or BLOCK_IFACE in interfaces:
                self.consider(object_path)

    # ⚠️ THE TRAILING *_user_data IS NOT OPTIONAL. Gio's signal_subscribe hands
    # the callback (connection, sender, path, interface, signal, parameters) AND
    # a user_data argument on the end — None here, since we passed none — so a
    # six-argument handler would be called with seven and raise TypeError the
    # first time a drive was plugged in. *_user_data swallows it.
    def _on_interfaces_added(self, _conn, _sender, _path, _iface, _signal, params, *_user_data):
        object_path, interfaces = params.unpack()
        # Same reasoning as in sweep(): a Block interface is enough to look.
        if FS_IFACE in interfaces or BLOCK_IFACE in interfaces:
            self.consider(object_path)

    # ⚠️ THE SAME TRAILING *_user_data RULE AS ABOVE. Gio hands the callback a
    # user_data argument on the end whether we passed one or not.
    def _on_interfaces_removed(self, _conn, _sender, _path, _iface, _signal, params, *_user_data):
        """A drive has gone. If we had a Mac drive open on it, close it."""
        try:
            object_path = params.unpack()[0]
        except (IndexError, TypeError):
            return
        try:
            self.apfs_forget(object_path)
            self.apfs_forget_vanished()
        except Exception as error:  # noqa: BLE001 — same rule as consider()
            log("could not tidy up after %s: %s: %s"
                % (object_path, type(error).__name__, error))
            traceback.print_exc()

    def watch(self):
        """Mount what is here, then keep mounting what turns up."""
        # A drive plugged in when you logged in.
        self.sweep()
        # And every drive plugged in from now on. udisks2 announces a new
        # filesystem by adding the Filesystem interface to a block object.
        self.bus.signal_subscribe(
            UDISKS,
            OM_IFACE,
            "InterfacesAdded",
            UDISKS_PATH,
            None,
            0,
            self._on_interfaces_added,
        )
        # ⚠️ AND THE OTHER HALF, WHICH ONLY MAC DRIVES NEED. Every other drive
        # on this computer is mounted by udisks2, and udisks2 cleans up after
        # itself when one is unplugged. A Mac drive is mounted by US, so nothing
        # but us will ever put it away — and a mount left behind on a drive that
        # has physically gone is a folder in the dock that opens onto an
        # input/output error.
        self.bus.signal_subscribe(
            UDISKS,
            OM_IFACE,
            "InterfacesRemoved",
            UDISKS_PATH,
            None,
            0,
            self._on_interfaces_removed,
        )
        log("watching for drives")


def run(once=False):
    import gi

    gi.require_version("GLib", "2.0")
    gi.require_version("Gio", "2.0")
    from gi.repository import Gio, GLib

    try:
        bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    except GLib.Error as error:
        log("no system bus to talk to udisks2: %s" % (error.message or error))
        # Exit 75 (temp failure): the service is set to retry, and this is
        # exactly the sort of thing that is briefly true at the very start of a
        # session and then fixes itself.
        return 75

    mounter = AutoMounter(bus)

    if once:
        mounter.sweep()
        return 0

    mounter.watch()
    loop = GLib.MainLoop()
    try:
        loop.run()
    except KeyboardInterrupt:
        pass
    return 0


def main(argv):
    once = False
    for arg in argv[1:]:
        if arg == "--dry-run":
            return dry_run()
        if arg == "--once":
            once = True
        elif arg in ("-h", "--help", "help"):
            # Print this file's header, stripped of the leading "# ".
            here = os.path.abspath(__file__)
            with open(here, "r") as handle:
                for line in handle.readlines()[1:120]:
                    if line.startswith("#"):
                        print(line[2:].rstrip() if line.startswith("# ") else line[1:].rstrip())
            return 0
        else:
            print("aquarius-automount: I do not understand '%s'." % arg, file=sys.stderr)
            return 1
    return run(once=once)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
