#!/usr/bin/bash
# =============================================================================
# aquarius-keys-run — start the right keyboard remapper, with the right profile
# =============================================================================
# WHAT THIS IS
#
# This is the small script that the aquarius-keys service runs when you log in.
# It is not meant to be run by hand. It answers three questions and then hands
# over to the remapper:
#
#   1. Mac mode or Windows mode?      — from ~/.config/aquarius/keys.conf
#   2. Which desktop am I in?         — decides WHICH remapper to run
#   3. Is there anything to do?       — a profile with no rules means "no"
#
# The friendly way to change any of this is the `aq keys` command. Try
# `aq keys --help`.
#
# Plain-English guide to the whole feature: docs/restart/aquarius-keys.md in
# the os-image repository.
# =============================================================================

set -uo pipefail

AQ_PROFILE_DIR="/usr/share/aquarius/keys"
AQ_CONF="${XDG_CONFIG_HOME:-${HOME:-/tmp}/.config}/aquarius/keys.conf"

# -----------------------------------------------------------------------------
# say — one line of explanation into the log
# -----------------------------------------------------------------------------
# Everything this script prints ends up in the system journal, which is where
# somebody debugging "my shortcuts stopped working" will look:
#
#     journalctl --user -u aquarius-keys -b
#
# So it is written as sentences, not as codes.
say() { echo "aquarius-keys: $*"; }

# -----------------------------------------------------------------------------
# THE TWO EXIT CODES THAT MEAN "DO NOT TRY AGAIN"
# -----------------------------------------------------------------------------
# The service restarts this script every two seconds, forever, on any failure —
# because at login the keyboards can be busy for a moment and giving up would
# leave a person with no shortcuts and no explanation.
#
# Two situations must NOT retry, because retrying cannot possibly help, and both
# are named in the service file beside RestartPreventExitStatus=:
#
#   64  Nothing to do on purpose (Windows mode has no rules in it).
#   78  The image is broken — something that is part of the operating system is
#       missing.
#
# Any other non-zero exit means "try again in two seconds", which is what we
# want for a keyboard that somebody else is briefly holding.
AQ_EXIT_NOTHING_TO_DO=64
AQ_EXIT_BROKEN=78

# =============================================================================
# 1. MAC MODE OR WINDOWS MODE
# =============================================================================
# The answer lives in one line of one file: `mode=mac` or `mode=windows`.
#
# ⚠️ IF THE FILE IS MISSING, THE ANSWER IS MAC. That is the whole point of the
# feature — Mac shortcuts are the AquariusOS default, so an account that has
# never been told anything gets them. A new account created by the installer
# gets the file from /etc/skel; an account that predates this feature does not,
# and still gets Mac keys, which is correct.
# =============================================================================
AQ_MODE="mac"

if [ -r "${AQ_CONF}" ]; then
    # Read only the mode= line, ignore comments and anything else in the file,
    # take the last one if somebody wrote it twice, and trim spaces.
    conf_mode="$(sed -n 's/^[[:space:]]*mode[[:space:]]*=[[:space:]]*\([a-zA-Z]*\).*/\1/p' "${AQ_CONF}" | tail -n 1)"
    case "${conf_mode}" in
        mac | windows)
            AQ_MODE="${conf_mode}"
            say "mode is '${AQ_MODE}', from ${AQ_CONF}"
            ;;
        "")
            say "${AQ_CONF} has no 'mode=' line in it — using Mac mode."
            ;;
        *)
            say "${AQ_CONF} says mode=${conf_mode}, which is not a mode this"
            say "computer knows about. The only answers are 'mac' and 'windows'."
            say "Using Mac mode. Fix it with:  aq keys mac   or   aq keys windows"
            ;;
    esac
else
    say "no ${AQ_CONF} yet — using Mac mode, which is the AquariusOS default."
fi

AQ_PROFILE="${AQ_PROFILE_DIR}/${AQ_MODE}.yaml"

if [ ! -r "${AQ_PROFILE}" ]; then
    say "ERROR: the profile ${AQ_PROFILE} is missing from this image."
    say "That is a bug in the operating system, not in your settings."
    exit "${AQ_EXIT_BROKEN}"
fi

# =============================================================================
# 2. IS THERE ANYTHING TO DO?
# =============================================================================
# A profile with no rules in it means "leave the keyboard alone" — that is what
# windows.yaml is. In that case we must NOT start the remapper.
#
# This is a safety property and not a shortcut. The remapper works by taking
# exclusive control of the keyboard and re-typing every key through a second,
# invented keyboard. Putting that between a person and their keys for zero
# rules would add a way for typing to break and give nothing back.
#
# The test is simply "does the file contain any list entries" — every rule
# block in a profile begins with `- name:` or `- remap:`.
# =============================================================================
if ! grep -Eq '^[[:space:]]*-[[:space:]]+(name|remap):' "${AQ_PROFILE}"; then
    say "${AQ_MODE} mode has no rules in it, so nothing is being remapped."
    say "Your keyboard behaves exactly as Linux ships it. This is not an error."
    exit "${AQ_EXIT_NOTHING_TO_DO}"
fi

# =============================================================================
# 2b. WAIT UNTIL THERE IS ACTUALLY A DESKTOP TO ATTACH TO
# =============================================================================
# ⚠️ THIS SECTION EXISTS BECAUSE OF THE BENCH TEST, 2026-09-03.
#
# systemd starts this service the moment the graphical session begins. "Begins"
# is earlier than you think: the window manager may not have made its screen
# yet, and the desktop may not have finished telling systemd its own name. A
# remapper that starts into that gap picks the wrong answers and then runs
# happily with them, which is worse than not starting at all.
#
# So: wait, briefly and out loud, for the two things the rest of this script
# depends on. Neither wait is allowed to hang a login — each gives up after
# thirty seconds, says so, and carries on with what it has.

# aq_wait <seconds> <sentence> <command...>
#   Run the command about twice a second until it succeeds. Returns 0 the moment
#   it does, and 1 if the time runs out. Says one line either way, because a
#   silent wait is indistinguishable from a hang.
aq_wait() {
    local limit="$1"; shift
    local what="$1"; shift
    local waited=0
    if "$@" > /dev/null 2>&1; then
        return 0
    fi
    say "waiting for ${what}..."
    while [ "${waited}" -lt "$((limit * 2))" ]; do
        sleep 0.5
        waited=$((waited + 1))
        if "$@" > /dev/null 2>&1; then
            say "${what} is ready (after about $((waited / 2)) seconds)."
            return 0
        fi
    done
    say "WARNING: gave up waiting for ${what} after ${limit} seconds."
    return 1
}

# --- 1. a screen -------------------------------------------------------------
# Every desktop this runs on is a Wayland desktop, and a Wayland desktop has a
# socket in the runtime folder. Its existence is the simplest honest answer to
# "has the desktop drawn anything yet".
aq_have_wayland() {
    [ -n "${WAYLAND_DISPLAY:-}" ] && return 0
    [ -n "${XDG_RUNTIME_DIR:-}" ] || return 1
    local sock
    for sock in "${XDG_RUNTIME_DIR}"/wayland-[0-9]*; do
        case "${sock}" in
            *.lock) continue ;;
        esac
        [ -S "${sock}" ] && return 0
    done
    return 1
}

aq_wait 30 "the desktop's screen" aq_have_wayland || true

# --- 2. the desktop's name ---------------------------------------------------
# XDG_CURRENT_DESKTOP is how the next section decides which of the two
# remappers to run, and getting it wrong means running the GNOME one on labwc,
# where it exits immediately. The desktop pushes the value into systemd's user
# manager when it starts; this service may have been started first.
#
# So if it is not here yet, wait for it — and take it from the user manager,
# which is where the desktop puts it.
aq_desktop_from_systemd() {
    systemctl --user show-environment 2> /dev/null \
        | sed -n 's/^XDG_CURRENT_DESKTOP=//p' | tail -n 1 | grep -q .
}

if [ -z "${XDG_CURRENT_DESKTOP:-}" ] && command -v systemctl > /dev/null 2>&1; then
    aq_wait 30 "the desktop to say what it is called" aq_desktop_from_systemd || true
fi

# =============================================================================
# 3. WHICH DESKTOP, AND THEREFORE WHICH REMAPPER
# =============================================================================
# Some rules only apply in certain apps, so the remapper has to be able to ask
# "which window is focused?". Every desktop answers that differently, so there
# are two copies of the remapper, each built to ask one desktop:
#
#   /usr/bin/xremap-wlroots   for the Aquarius Session (labwc)
#   /usr/bin/xremap-gnome     for GNOME
#
# The desktop announces itself in XDG_CURRENT_DESKTOP. In the Aquarius Session
# that is "aquarius-labwc:aquarius:wlroots"; on GNOME it is "GNOME".
#
# ⚠️ AND SOMETIMES IT IS EMPTY. A systemd user service only sees the variables
# that the desktop pushed into the user's systemd manager when it started, and
# not every desktop remembers to push them. GNOME does. Both halves of the
# Aquarius Session do now too: /usr/bin/aquarius-session pushes
# XDG_CURRENT_DESKTOP before it starts labwc, and this image's labwc autostart
# pushes WAYLAND_DISPLAY once labwc has created one. The aquarius-shell repo's
# own copy of the session gained the same thing on 2026-09-03 (commit 8822088),
# so a session run straight from a clone now behaves the same way.
#
# The three questions below are kept anyway. This service has to work on a
# desktop nobody has written yet, and an empty variable should degrade to a
# sensible guess rather than to a keyboard that silently stops remapping.
#
# So rather than trusting one variable, this asks three questions in order:
# the variable, then systemd's own copy of the environment, then simply
# "which compositor is running right now?".
# =============================================================================
aq_desktop="${XDG_CURRENT_DESKTOP:-}"

if [ -z "${aq_desktop}" ] && command -v systemctl > /dev/null 2>&1; then
    aq_desktop="$(systemctl --user show-environment 2> /dev/null \
        | sed -n 's/^XDG_CURRENT_DESKTOP=//p' | tail -n 1)"
fi

aq_binary=""
case "${aq_desktop}" in
    *[Gg][Nn][Oo][Mm][Ee]*)
        # ⚠️ ONE MORE QUESTION BEFORE TRUSTING THAT.
        #
        # The user manager remembers the last thing it was told, and it is not
        # emptied between logins within one boot. So an account that logged into
        # GNOME earlier and is now in the Aquarius Session can still have the
        # word GNOME sitting in its environment. Believing it would run the
        # GNOME remapper on labwc, where it exits immediately and every shortcut
        # silently stops working.
        #
        # GNOME Shell is the thing that would actually be there. Ask.
        if pgrep -x gnome-shell > /dev/null 2>&1; then
            aq_binary="/usr/bin/xremap-gnome"
            say "desktop is '${aq_desktop}' — using the GNOME build."
        else
            aq_binary="/usr/bin/xremap-wlroots"
            say "the environment says '${aq_desktop}', but GNOME Shell is not"
            say "running — so this is not GNOME. Using the wlroots build, which"
            say "is what the Aquarius Session needs."
        fi
        ;;
    ?*)
        # Anything else that named itself: the Aquarius Session, labwc, niri,
        # sway, wayfire. All of them speak the wlroots way of asking.
        aq_binary="/usr/bin/xremap-wlroots"
        say "desktop is '${aq_desktop}' — using the wlroots build."
        ;;
    *)
        # Nothing said anything. Look at what is actually running.
        if pgrep -x gnome-shell > /dev/null 2>&1; then
            aq_binary="/usr/bin/xremap-gnome"
            say "nothing named the desktop, but GNOME Shell is running — using the GNOME build."
        else
            aq_binary="/usr/bin/xremap-wlroots"
            say "nothing named the desktop and GNOME Shell is not running —"
            say "using the wlroots build, which is what the Aquarius Session needs."
        fi
        ;;
esac

if [ ! -x "${aq_binary}" ]; then
    say "ERROR: ${aq_binary} is missing from this image."
    say "That is a bug in the operating system, not in your settings."
    exit "${AQ_EXIT_BROKEN}"
fi

# =============================================================================
# 3b. MAKE SURE "WHICH APP IS FOCUSED?" CAN ACTUALLY BE ANSWERED
# =============================================================================
# ⚠️ THIS SECTION IS WHY COMMAND-C DOES NOT KILL YOUR RENDER.
#
# The terminal exception in mac.yaml — "in a terminal, Command-C is copy, and
# the physical Control-C is still the interrupt" — only works if the remapper
# can tell that the focused window IS a terminal. If it cannot, that rule never
# fires, and Command-C in a terminal becomes Control-C, which interrupts
# whatever is running.
#
# So both desktops get the one thing they need, here, before anything starts.
# =============================================================================
case "${aq_binary}" in

    */xremap-wlroots)
        # The wlroots way of asking is a question put to the compositor over
        # the Wayland connection, so WAYLAND_DISPLAY has to be set. A systemd
        # user service only inherits variables the desktop pushed into systemd
        # when it started, and the Aquarius Session does not do that yet.
        #
        # Rather than fail, find the socket. There is normally exactly one, in
        # the per-login folder that Wayland puts its sockets in.
        if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -n "${XDG_RUNTIME_DIR:-}" ]; then
            for aq_sock in "${XDG_RUNTIME_DIR}"/wayland-[0-9]*; do
                case "${aq_sock}" in
                    *.lock) continue ;;
                esac
                [ -S "${aq_sock}" ] || continue
                WAYLAND_DISPLAY="$(basename "${aq_sock}")"
                export WAYLAND_DISPLAY
                say "WAYLAND_DISPLAY was not set; found the session's own socket '${WAYLAND_DISPLAY}'."
                break
            done
        fi
        if [ -z "${WAYLAND_DISPLAY:-}" ]; then
            say "WARNING: no Wayland connection was found, so the remapper cannot"
            say "tell which app is focused. The terminal exception will not work."
        fi
        ;;

    */xremap-gnome)
        # GNOME's Wayland desktop does not let any program ask which window is
        # focused — that door is closed for everyone, for security reasons.
        # The remapper's author writes a small GNOME add-on that answers on its
        # behalf; AquariusOS ships it, but GNOME only loads an add-on that the
        # account has switched on.
        #
        # So switch it on, for this account, if it is not already. This touches
        # only this user's own settings — it does not change the image and it
        # does not touch anybody else's desktop — and doing nothing here would
        # mean shipping the terminal exception switched off.
        aq_ext="xremap@k0kubun.com"
        if [ -d "/usr/share/gnome-shell/extensions/${aq_ext}" ] \
            && command -v gnome-extensions > /dev/null 2>&1; then

            # ⚠️ WAIT FOR GNOME SHELL BEFORE ASKING IT FOR ANYTHING.
            #
            # `gnome-extensions enable` is a message to GNOME Shell over the
            # session bus. Sent before GNOME Shell has answered the bus, it
            # fails — and a login is exactly when that race is most likely,
            # because systemd starts this service and GNOME starts its shell at
            # very nearly the same moment.
            #
            # `busctl --user status` asks the bus "is this name being served",
            # which is the cheapest true test. gdbus does the same job on a
            # machine without busctl.
            aq_shell_on_the_bus() {
                if command -v busctl > /dev/null 2>&1; then
                    busctl --user status org.gnome.Shell > /dev/null 2>&1
                elif command -v gdbus > /dev/null 2>&1; then
                    gdbus introspect --session --dest org.gnome.Shell \
                        --object-path /org/gnome/Shell > /dev/null 2>&1
                else
                    # Nothing to ask with. Do not block the login over it.
                    return 0
                fi
            }
            aq_wait 30 "GNOME Shell to be ready" aq_shell_on_the_bus || true

            # `enable` on an add-on that is already on does nothing and reports
            # success, so this is safe to run at every single login.
            if gnome-extensions enable "${aq_ext}" 2> /dev/null; then
                say "the GNOME add-on that reports the focused app is switched on."
                say "(It is called 'Xremap' in the Extensions app. Turning it off there"
                say " stops the app-specific rules, including the terminal exception.)"
            else
                say "WARNING: could not switch on the GNOME add-on '${aq_ext}'."
                say "App-specific rules, including the terminal exception, will not work."
                say "Try:  gnome-extensions enable ${aq_ext}"
            fi

            # Switched on is not the same as loaded and running. GNOME loads an
            # add-on a moment after being told to, and the remapper needs it
            # LOADED before it asks its first question. So wait for the state
            # GNOME reports to become ACTIVE.
            aq_ext_active() {
                gnome-extensions info "${aq_ext}" 2> /dev/null \
                    | grep -qi "State:.*ACTIVE"
            }
            if aq_wait 30 "the GNOME add-on to finish loading" aq_ext_active; then
                :
            else
                say "The app-specific rules — including the terminal exception —"
                say "may not work in this session. Check with:"
                say "    gnome-extensions info ${aq_ext}"
            fi
        else
            say "WARNING: the GNOME add-on '${aq_ext}' is not installed in this image."
            say "App-specific rules, including the terminal exception, will not work."
        fi
        ;;
esac

# =============================================================================
# 4. CAN WE ACTUALLY READ THE KEYBOARD?
# =============================================================================
# The remapper needs two things that ordinary programs do not:
#
#   /dev/input/event*   to see the keys you press
#   /dev/uinput         to invent a keyboard of its own and type the
#                       replacements through it
#
# AquariusOS grants both to whoever is logged in at the screen, through a udev
# rule the image ships (/usr/lib/udev/rules.d/70-aquarius-input.rules). If that
# has not worked, the remapper's own error is fairly cryptic, so we check first
# and say something a person can act on.
#
# This is a warning, not a refusal: it is possible for the check to be wrong
# and the remapper to work anyway, and we would rather try than give up.
# =============================================================================
if [ ! -w /dev/uinput ]; then
    say "WARNING: this account cannot write to /dev/uinput, so remapping will"
    say "probably fail. The usual cause is logging in over SSH or from a second"
    say "seat — the permission is granted to whoever is logged in at the screen."
    say "If you ARE at the screen and this keeps happening, the fallback is to"
    say "join the input group, which grants it permanently:"
    say "    sudo usermod -aG input \$USER      (then log out and back in)"
fi

# =============================================================================
# 5. GO
# =============================================================================
# THE FLAGS, AND WHY EACH ONE IS THERE
#
# --watch=device  notice keyboards plugged in after login and remap them too.
#                 Without this, a keyboard connected after you log in behaves
#                 like a normal PC keyboard and nothing says why.
#
#                 ⚠️ IT DOES NOT RE-TRY A KEYBOARD IT ALREADY FAILED TO TAKE.
#                 That is the 2026-09-03 bug in one line, and it is why the
#                 watcher below exists.
#
# --ignore=xremap  never take hold of a remapper's own invented keyboard.
#                 xremap works by inventing a keyboard of its own and typing
#                 the replacements through it, and that invented keyboard is
#                 called "xremap". If a previous one has not finished going
#                 away, its leftover device is still in the list — and on the
#                 bench it was AUTOMATICALLY SELECTED as the only keyboard
#                 available, while the two real keyboards were refused. Naming
#                 it here means it can never be chosen, whoever left it behind.
#
# --no-window-logging  do not write the name and title of every window you
#                 focus into the system journal. Window titles include document
#                 names, and a permanent record of them is not something an
#                 operating system should keep by default. When you DO need to
#                 know an app's name — to add it to the exclusion list — remove
#                 this flag temporarily, or run
#                     xremap-wlroots --list-windows
#
# The `=` in --watch=device and --ignore=xremap is not a style choice. Both
# options accept a LIST, so written with a space the option would swallow the
# profile file name that follows it as another value.
# =============================================================================
say "starting ${aq_binary} with ${AQ_PROFILE}"

aq_args=(--watch=device --ignore=xremap --no-window-logging "${AQ_PROFILE}")

# =============================================================================
# 6. WATCHING IT TAKE HOLD OF THE KEYBOARDS
# =============================================================================
# ⚠️ THIS WHOLE SECTION EXISTS BECAUSE OF THE BENCH TEST, 2026-09-03, AND IT IS
# THE ACTUAL FIX FOR "IT CAME UP IN WINDOWS MODE".
#
# WHAT HAPPENED
#   A remapper belonging to the LOGIN SCREEN was still holding both of Royce's
#   keyboards when the session's own remapper started. It printed:
#
#     Error: Device or resource busy (os error 16). Another program might have
#     grabbed the device: 'Keyboard K780 Keyboard'
#     ...
#     No device was selected, but --watch is waiting for new devices.
#
#   and then sat there, holding nothing, for eleven minutes. The service was
#   running. `systemctl status` said active. Every shortcut was dead. From the
#   outside it was indistinguishable from Windows mode — which is exactly what
#   Royce reported it as, and he was right to.
#
#   The other remapper let go ten seconds later. Nothing noticed, because
#   --watch only waits for keyboards it has never seen; it does not go back and
#   try again on one it was refused.
#
# WHAT THIS DOES ABOUT IT
#   Reads what the remapper prints, and treats "busy" or "nothing selected" as
#   a failure of the whole run rather than a note in a log. The service then
#   restarts it two seconds later (Restart=always, no give-up limit), and keeps
#   doing that until the keyboards are free — which on the bench would have been
#   the fifth attempt, about ten seconds in, with nobody noticing.
#
#   It also counts what was taken and says so in one clear sentence, so that
#   `aq keys status` can answer "is it actually remapping anything?" instead of
#   only "is the service running?". Those turned out to be different questions.
#
# THE COST, STATED PLAINLY
#   All-or-nothing. If one keyboard out of three is busy, the run fails and
#   retries rather than remapping the other two. That is deliberate: a computer
#   where one of your keyboards has Mac shortcuts and another does not is more
#   confusing than one that is briefly not ready, and the retry makes "briefly"
#   the normal case.

# The pipe the remapper's output comes back through. In the per-login runtime
# folder, which is cleaned up automatically when you log out.
aq_pipe="${XDG_RUNTIME_DIR:-/tmp}/aquarius-keys-output.$$"
rm -f "${aq_pipe}"

if ! mkfifo -m 0600 "${aq_pipe}" 2> /dev/null; then
    # No pipe, no watching. Rather than fail, do the old thing — run the
    # remapper directly — and say that the safety net is not there.
    say "NOTE: could not create ${aq_pipe}, so the grab-failure watcher is off."
    exec "${aq_binary}" "${aq_args[@]}"
fi

"${aq_binary}" "${aq_args[@]}" > "${aq_pipe}" 2>&1 &
aq_child=$!

aq_cleanup() {
    kill "${aq_child}" 2> /dev/null
    rm -f "${aq_pipe}"
}
trap aq_cleanup EXIT INT TERM

exec 3< "${aq_pipe}"

aq_phase=""          # which part of the remapper's output we are reading
aq_count=0           # how many keyboards it chose
aq_names=""          # and what they are called
aq_said_summary=0    # so the summary is printed once, not once per line
aq_problem=""        # empty means all well

aq_summary() {
    [ "${aq_said_summary}" -eq 1 ] && return 0
    aq_said_summary=1
    if [ "${aq_count}" -gt 0 ]; then
        say "remapping ${aq_count} keyboard(s): ${aq_names}"
        say "Mac-style shortcuts are live. Command-C copies."
    fi
}

while true; do
    if IFS= read -r -t 5 -u 3 aq_line; then
        printf '%s\n' "${aq_line}"

        case "${aq_line}" in
            *"Selecting devices from the following list"*)
                aq_phase="listing"
                ;;
            *"Selected"*"since --device options weren't specified"* | *"Selected devices"*)
                aq_phase="chosen"
                ;;
            */dev/input/event*)
                if [ "${aq_phase}" = "chosen" ]; then
                    aq_count=$((aq_count + 1))
                    aq_names="${aq_names}${aq_names:+, }${aq_line#*: }"
                fi
                ;;
        esac

        # NOTE: the summary is NOT printed here, when the list of keyboards
        # ends. It is printed only after five quiet seconds, further down.
        # The reason is in the first run of this watcher on a fake failure: the
        # list of chosen keyboards is printed BEFORE the remapper tries to take
        # hold of them, so announcing "remapping 2 keyboards" at that point is a
        # claim we have not checked. Five seconds of silence afterwards is the
        # cheapest honest proof that the grabs actually succeeded.

        case "${aq_line}" in
            *"resource busy"*)      aq_problem="busy" ;;
            *"No device was selected"*) aq_problem="none" ;;
        esac

        if [ -n "${aq_problem}" ]; then
            break
        fi
    else
        # Nothing for five seconds. Either the remapper is quietly working —
        # which is the normal, happy case — or it has finished and closed the
        # pipe. Say the summary once, then check which.
        aq_summary
        kill -0 "${aq_child}" 2> /dev/null || break
    fi
done

if [ -n "${aq_problem}" ]; then
    kill "${aq_child}" 2> /dev/null
    wait "${aq_child}" 2> /dev/null
    say ""
    if [ "${aq_problem}" = "busy" ]; then
        say "PROBLEM: another program is holding the keyboard, so the shortcuts"
        say "are not working yet. The usual cause is the login screen's own copy"
        say "of the remapper, which lets go a few seconds after you log in."
    else
        say "PROBLEM: no keyboard could be taken hold of, so nothing is being"
        say "remapped and the shortcuts are not working yet."
    fi
    say "Trying again in two seconds. This normally fixes itself; if these lines"
    say "keep repeating, run:  aq keys status"
    exit 1
fi

wait "${aq_child}"
aq_code=$?
say "the remapper stopped (exit ${aq_code})."
exit "${aq_code}"
