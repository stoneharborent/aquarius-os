#!/usr/bin/env bash
# ==============================================================================
# AquariusOS — stop the login screen being too big on a handheld
# ==============================================================================
# THE SYMPTOM
#   On a 7-inch handheld (Royce's ROG Xbox Ally), the login screen comes up
#   enormous and cut off at the edges — you cannot see the whole of it. The
#   DESKTOP, once you are past it, is fine. That combination is the clue.
#
# WHY IT HAPPENS — and it is nobody's bug, which is why it needed finding
#   The login screen on Fedora and Bazzite is not a simple program drawing on the
#   screen. It is a whole little desktop: SDDM starts KWin (the same window
#   manager the real desktop uses) and runs the login box inside it.
#     Source: plasma-workspace ships /usr/lib/sddm/sddm.conf.d/plasma-wayland.conf,
#     whose CompositorCommand is `kwin_wayland --no-global-shortcuts
#     --no-lockscreen --inputmethod plasma-keyboard --locale1`. Fedora enables
#     that (plasma-workspace.spec, -DINSTALL_SDDM_WAYLAND_SESSION=ON) and Bazzite
#     also sets DisplayServer=wayland in its own holo.conf.
#
#   KWin works out how much to magnify a screen from the screen's physical size,
#   which the monitor reports. The rule is in
#   kwin/src/outputconfigurationstore.cpp, chooseScale(), and it has two branches
#   for a built-in screen:
#
#       has a laptop lid switch  -> aim for 125 DPI, never go below 800 px tall
#       no laptop lid switch     -> aim for 150 DPI, never go below 360 px tall
#                                   (the comment there says "phone screens: even
#                                    closer than laptops")
#
#   A handheld has no lid, so it takes the phone branch. A 7-inch 1920x1080 panel
#   is about 155 x 87 mm, which is roughly 315 DPI. 315 / 150 = 2.1, and the
#   phone branch's floor of 360 px is far too low to stop it. So KWin magnifies
#   the login screen by 210%, which leaves it a usable area of about 914 x 514
#   pixels — and the login box does not fit in that. Hence: too big, cut off.
#
#   The desktop escapes this because YOUR account has a file that says what scale
#   to use, so KWin never has to guess. The login screen runs as a different
#   account (`sddm`, whose home is /var/lib/sddm), that account has no such file,
#   and so KWin guesses. Same code, two answers.
#
# THE FIX
#   Give the login screen the same kind of file the desktop has. It is the only
#   mechanism there is: KWin has no setting and no environment variable for
#   screen scale — it reads exactly one file, kwinoutputconfig.json, found
#   through the standard config search path.
#     Source: kwin/src/outputconfigurationstore.cpp, load() —
#     QStandardPaths::locate(QStandardPaths::ConfigLocation,
#                            QStringLiteral("kwinoutputconfig.json"))
#
#   So this script copies our copy of that file into the login screen's own home
#   folder before the login screen starts. That is all it does.
#
# WHY A SCRIPT AND NOT JUST A FILE IN THE IMAGE
#   Two reasons, and the second is the real one.
#   1. /var is not part of the image on this kind of OS. A file baked into
#      /var/lib/sddm would be written once, at install, and never updated again.
#        Source: bootc documentation, filesystem.md — "/var content is unpacked
#        only from the initial image".
#   2. This must only happen on machines that need it. A desktop PC's login
#      screen is perfectly fine and must not be touched. That is a question about
#      the HARDWARE, not about which AquariusOS image is installed, so it is
#      asked of the hardware — see needs_greeter_scale_fix() below.
#
# TURNING IT OFF
#   Create this file and this script does nothing, ever again:
#     sudo mkdir -p /etc/aquarius && sudo touch /etc/aquarius/no-greeter-scale
#
# WHAT IT DID, ON ANY GIVEN BOOT
#   systemctl status aquarius-greeter-scale
#   journalctl -u aquarius-greeter-scale
#
# Beginner-facing write-up: docs/login-screen-scaling.md
# ==============================================================================

set -uo pipefail

# ------------------------------------------------------------------------------
# The paths this script works with.
# ------------------------------------------------------------------------------
# Every one of them can be pointed somewhere else by an environment variable.
# That is not a feature for users — nobody should ever set these — it is what
# lets tests/test-aquarius-greeter-scale.sh build a pretend machine in a
# temporary folder and check the decisions without being root and without an
# Ally on the desk.
# ------------------------------------------------------------------------------

# What the machine calls itself. This is the standard place; Bazzite's own
# hardware scripts read the same file.
DMI_PRODUCT_FILE="${AQUARIUS_DMI_PRODUCT_FILE:-/sys/devices/virtual/dmi/id/product_name}"

# Bazzite's own list of machines whose screens must not be magnified. Asking it
# rather than copying it means every handheld they add, we get for free.
NEEDS_100_SCALE="${AQUARIUS_NEEDS_100_SCALE:-/usr/libexec/hwsupport/needs-100-scale}"

# The login screen's own home folder, and the file we are giving it.
GREETER_HOME="${AQUARIUS_GREETER_HOME:-/var/lib/sddm}"
GREETER_USER="${AQUARIUS_GREETER_USER:-sddm}"
SOURCE_FILE="${AQUARIUS_GREETER_SOURCE:-/usr/share/aquarius/greeter/kwinoutputconfig.json}"

# The off switch.
OFF_SWITCH="${AQUARIUS_GREETER_OFF_SWITCH:-/etc/aquarius/no-greeter-scale}"

log() {
    # `systemctl status aquarius-greeter-scale` shows these.
    printf '%s\n' "$*"
}

# ------------------------------------------------------------------------------
# WHICH MACHINES NEED THIS
# ------------------------------------------------------------------------------
# Two tests, in order of how much we trust them.
#
# 1. BAZZITE'S OWN LIST. /usr/libexec/hwsupport/needs-100-scale answers "does
#    this machine's screen need to be left at 100%?" for every Valve device and a
#    long list of handhelds — ROG Ally RC71L, ROG Ally X RC72LA, the AYANEOs, the
#    ONEXPLAYERs, the Legion Go family and more. Bazzite uses that answer to fix
#    the DESKTOP's scale; we are asking the same question about the same screen,
#    so the same answer is the right one.
#      Source: ublue-os/bazzite,
#      system_files/desktop/shared/usr/libexec/hwsupport/needs-100-scale
#
# 2. THE ROG XBOX ALLY, WHICH IS MISSING FROM THAT LIST. Bazzite knows the device
#    elsewhere — /usr/libexec/hwsupport/steamos-manager-hardware has an explicit
#    `[[ "$PRODUCT_NAME" == "ROG Xbox Ally"* ]]` branch for TDP control — but the
#    scale list has simply never been updated for the newest board, and the older
#    Allys in it are matched through a name-shortening script that does not know
#    about this one either. So we add it, in exactly their idiom: a prefix match
#    on the product name, which covers both RC73XA (Ally X) and RC73YA (the base
#    model Royce owns).
#      Source: same repo, hwsupport/sysid and hwsupport/steamos-manager-hardware
#
# Anything else answers "no" and this script stops. A desktop PC's login screen
# is never touched.
# ------------------------------------------------------------------------------
OUR_EXTRA_DEVICES=(
    "ROG Xbox Ally"
)

needs_greeter_scale_fix() {
    if [ -e "$OFF_SWITCH" ]; then
        log "${OFF_SWITCH} exists, so the login screen is left exactly as it is."
        return 1
    fi

    if [ -x "$NEEDS_100_SCALE" ] && "$NEEDS_100_SCALE" > /dev/null 2>&1; then
        log "This machine is on Bazzite's own do-not-magnify list."
        return 0
    fi

    local product=""
    if [ -r "$DMI_PRODUCT_FILE" ]; then
        product="$(tr -d '\r' < "$DMI_PRODUCT_FILE" | head -n1)"
    fi

    local known
    for known in "${OUR_EXTRA_DEVICES[@]}"; do
        if [ "${product#"$known"}" != "$product" ]; then
            log "This machine is a '${known}', which AquariusOS adds to that list."
            return 0
        fi
    done

    log "This machine ('${product:-unknown}') has an ordinary screen; nothing to do."
    return 1
}

# ------------------------------------------------------------------------------
# DOING IT
# ------------------------------------------------------------------------------
install_greeter_config() {
    local destination_dir="${GREETER_HOME}/.config"
    local destination="${destination_dir}/kwinoutputconfig.json"

    if [ ! -r "$SOURCE_FILE" ]; then
        log "ERROR: ${SOURCE_FILE} is missing, so there is nothing to install."
        return 1
    fi

    if ! mkdir -p "$destination_dir"; then
        log "ERROR: could not create ${destination_dir}."
        return 1
    fi

    # ⚠️ WRITTEN EVERY BOOT, ON PURPOSE, EVEN IF A FILE IS ALREADY THERE.
    # The login screen's KWin WRITES this file itself the first time it runs — it
    # saves the 210% it just guessed. So "leave it alone if it exists" would mean
    # the wrong answer wins on every machine that has already been switched on
    # once, which is every machine that has the problem. Overwriting is the
    # point. The off switch above is how somebody opts out.
    if ! cp -f "$SOURCE_FILE" "$destination"; then
        log "ERROR: could not write ${destination}."
        return 1
    fi
    chmod 0644 "$destination"

    # The login screen runs as its own account and has to be able to read this.
    # `|| true` because a machine without that account is not a machine with a
    # broken login screen — it is a machine with no login screen at all, and
    # failing there would be noise.
    chown -R "${GREETER_USER}:${GREETER_USER}" "$destination_dir" 2> /dev/null \
        || log "note: could not give ${destination_dir} to the '${GREETER_USER}' account."

    log "Login screen set to 100% on the built-in display (${destination})."
    return 0
}

main() {
    case "${1:-}" in
        --check-device)
            # Used by the service file's ExecCondition=, and handy by hand.
            needs_greeter_scale_fix
            return $?
            ;;
        "") ;;
        *)
            log "usage: aquarius-greeter-scale [--check-device]"
            return 2
            ;;
    esac

    if ! needs_greeter_scale_fix; then
        return 0
    fi
    install_greeter_config
}

main "$@"
