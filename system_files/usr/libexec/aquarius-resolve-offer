#!/usr/bin/bash
# ==============================================================================
# AquariusOS — the one-time "want DaVinci Resolve?" question
# ==============================================================================
# Plain English: DaVinci Resolve is the professional colour and editing app most
# creators expect to find on a machine like this. We are not allowed to ship it
# (Blackmagic's licence forbids anyone but Blackmagic handing out the installer),
# so the next best thing is to ASK, once, and then do all the fiddly work for
# whoever says yes.
#
# The rules this follows, which matter more than the feature:
#
#   * It asks ONCE, ever, per user. Whatever the answer, a small file is written
#     and the question is never asked again. There is no nagging.
#   * It never holds up the login. It runs in the background, waits until the
#     desktop has settled, and puts up an ordinary window you can ignore.
#   * Saying "Not now" is not a dead end. "Install DaVinci Resolve" stays in the
#     app grid forever, and `ujust install-resolve` works from any terminal.
#   * A user can switch the whole thing off the normal KDE way, in
#     System Settings -> Autostart, like any other start-up item.
#
# Started by /etc/xdg/autostart/aquarius-resolve-offer.desktop.
# The install itself lives in /usr/share/ublue-os/just/96-aquarius-creator.just.
# ==============================================================================

set -u

STAMP_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/aquarius"
STAMP_FILE="${STAMP_DIR}/resolve-offer-answered"

remember_and_exit() {
    mkdir -p "$STAMP_DIR" 2>/dev/null || :
    printf '%s\n' "$1" >"$STAMP_FILE" 2>/dev/null || :
    exit 0
}

# ---- Already answered? Then we are done, forever. ----------------------------
[ -f "$STAMP_FILE" ] && exit 0

# ---- Never ask inside the USB installer session ------------------------------
# The live session's temporary account is called "liveuser". Anything installed
# there is thrown away when the machine restarts, so asking would be cruel.
[ "$(id -un)" = "liveuser" ] && exit 0

# ---- kdialog is how KDE asks questions from a script --------------------------
# It is part of Plasma, so it is always here. If it somehow isn't, we say
# nothing at all rather than failing in front of the user — and we do NOT write
# the stamp, so the question can still be asked on a later login.
command -v kdialog >/dev/null 2>&1 || exit 0

# ---- Let the desktop finish loading first -------------------------------------
# Popping a dialog while the panel and wallpaper are still appearing feels
# broken. Half a minute is long enough for the desktop to be usable.
sleep 30

# ---- Is Resolve already set up? ----------------------------------------------
# If so, there is nothing to offer. Quietly record that and move on.
if podman container exists davincibox 2>/dev/null; then
    remember_and_exit "already-installed"
fi
if [ -f "$HOME/.local/share/applications/DaVinciResolve.desktop" ]; then
    remember_and_exit "already-installed"
fi

# ---- Ask ----------------------------------------------------------------------
kdialog \
    --title "Set up DaVinci Resolve?" \
    --icon applications-multimedia \
    --yes-label "Yes, set it up" \
    --no-label "Not now" \
    --yesno "AquariusOS can set up DaVinci Resolve, the professional video editing and colour grading app.

Blackmagic does not allow anyone else to hand out their installer, so AquariusOS cannot include it. What it can do is walk you through it: you download the free installer from Blackmagic's website, and AquariusOS does everything else.

It takes about fifteen minutes, most of which is downloading, and you can stop at any point.

You can always do this later: look for \"Install DaVinci Resolve\" in your apps."

answer=$?

if [ "$answer" -ne 0 ]; then
    # "Not now", or the window was closed. Either way: never ask again.
    remember_and_exit "declined"
fi

# ---- Yes: open a real window so the user can see what is happening ------------
# The install asks questions and prints progress, so it needs a terminal window.
# Hiding that behind a spinner would be dishonest and unhelpable-with. Konsole
# is KDE's terminal and is always present; the others are seatbelts.
remember_and_exit_after_launch() {
    mkdir -p "$STAMP_DIR" 2>/dev/null || :
    printf '%s\n' "accepted" >"$STAMP_FILE" 2>/dev/null || :
    exit 0
}

if command -v konsole >/dev/null 2>&1; then
    setsid konsole --noclose -e /usr/bin/ujust install-resolve >/dev/null 2>&1 &
    remember_and_exit_after_launch
fi

if command -v xdg-terminal-exec >/dev/null 2>&1; then
    setsid xdg-terminal-exec /usr/bin/ujust install-resolve >/dev/null 2>&1 &
    remember_and_exit_after_launch
fi

# No terminal we recognise. Tell the truth and point at the app-grid entry,
# which does exactly the same thing.
kdialog --title "Set up DaVinci Resolve" --msgbox \
    "AquariusOS could not open a terminal window automatically.

Open your apps and click \"Install DaVinci Resolve\" to carry on."
remember_and_exit "accepted-no-terminal"
