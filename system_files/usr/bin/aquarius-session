#!/usr/bin/bash
# =============================================================================
# aquarius-session — start the Aquarius Desktop
# =============================================================================
# WHAT THIS IS, IN ONE SENTENCE
#   This is the program the login screen runs when you pick "Aquarius Desktop".
#   It starts a window manager, sets up the environment the rest of the desktop
#   needs, and the window manager starts the Aquarius Shell inside it.
#
# THE SAFETY STORY, WHICH DOES NOT BEND
#   AquariusOS also has GNOME, and GNOME is untouched by everything here. If the
#   Aquarius Desktop fails to start, you land back at the login screen, pick
#   GNOME, and your machine works exactly as it did before. Nothing in this file
#   can take that away from you.
#
# THE THREE THINGS THIS SESSION IS MADE OF
#   1. labwc — the window manager. It draws the title bars, moves windows
#      around, and owns the keyboard shortcuts. Configuration lives in
#      /usr/share/aquarius/labwc/.
#   2. The Aquarius Shell — the bar at the top, the dock, the search palette,
#      the quick settings and the notifications. It is QML, run by Quickshell's
#      `qs` command. The WINDOW MANAGER starts it, not this script, because a
#      bar started before the window manager would have no screen to attach
#      itself to.
#   3. The portals — which we do NOT start. They are started on demand by D-Bus.
#      All this script has to do is make sure the environment they read is
#      correct before anything asks for one. That is the XDG_CURRENT_DESKTOP
#      line below, and it is the single most load-bearing line in this file.
#
# WHEN IT GOES WRONG
#   A failing login session normally gives you a black screen and no
#   explanation. So everything this script prints is also written to a file:
#
#       ~/.local/state/aquarius-session/session.log
#
#   Read that file first. Always. The previous run is kept as session.log.1,
#   which is exactly enough to compare "the time it worked" against "the time
#   it did not".
#
# WHERE THIS FILE CAME FROM
#   The aquarius-shell repository at github.com/stoneharborent/aquarius-shell
#   carries the original, written for installing a session by hand onto a
#   machine without rebuilding it. This is the operating-system copy: same
#   design, same log, same loud failures, but the paths are fixed because in an
#   image-based OS they cannot move, and the niri half is gone because
#   AquariusOS ships labwc (standing decision 2b — labwc 0.20 has HDR and
#   colour management today and niri does not).
#
#   Plain-language walkthrough: /usr/share/doc — or, in the source repository,
#   docs/restart/aquarius-session.md.
# =============================================================================

set -euo pipefail

# -----------------------------------------------------------------------------
# Fixed locations. On an image-based operating system these cannot move, so
# unlike the repository's version there is no searching for them.
# -----------------------------------------------------------------------------
AQ_LABWC_CONFIG_DIR="/usr/share/aquarius/labwc"
AQ_SHELL_DIR="/usr/share/aquarius/shell"
AQ_SESSION_LIB="/usr/libexec/aquarius-session-lib"

# -----------------------------------------------------------------------------
# The log. Everything below this point goes to the terminal AND to the file.
#
# AQ_LOG is EXPORTED on purpose, and it is load-bearing.
#
# The window manager starts the shell, not this script — and a compositor throws
# its children's output away. On the first real boot of this session, on
# 2026-09-02, the shell crashed at start-up and the log contained nothing but
# the compositor's own lines. Not one word from the thing that failed.
#
# The fix is that the autostart file appends the shell's output to THIS file, by
# name. Exporting the variable is what lets it do that without writing a path of
# its own.
# -----------------------------------------------------------------------------
AQ_STATE_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/aquarius-session"
AQ_LOG="${AQ_STATE_DIR}/session.log"
export AQ_LOG

mkdir -p "${AQ_STATE_DIR}"
if [ -f "${AQ_LOG}" ]; then
    mv -f "${AQ_LOG}" "${AQ_LOG}.1"
fi

exec > >(tee -a "${AQ_LOG}") 2>&1

echo "============================================================"
echo "  Aquarius Desktop"
echo "  $(date)"
echo "  log: ${AQ_LOG}"
echo "============================================================"
if [ -r /usr/share/aquarius/shell-build.txt ]; then
    sed 's/^/  /' /usr/share/aquarius/shell-build.txt
fi
if [ -r /usr/share/aquarius/quickshell-build.txt ]; then
    sed 's/^/  /' /usr/share/aquarius/quickshell-build.txt
fi

# -----------------------------------------------------------------------------
# Failing loudly.
#
# `die` prints a heading, the reason, and what to do about it — then stops. It
# is deliberately shouty, because the only person who will ever read it is
# somebody staring at a login screen wondering what happened.
# -----------------------------------------------------------------------------
die() {
    echo ""
    echo "------------------------------------------------------------"
    echo "  THE AQUARIUS DESKTOP COULD NOT START"
    echo "------------------------------------------------------------"
    echo "  ${1}"
    echo ""
    shift
    for aq_line in "$@"; do
        echo "  ${aq_line}"
    done
    echo ""
    echo "  Nothing has been changed on your machine. Log in with GNOME"
    echo "  and everything works as before."
    echo ""
    echo "  This message is also in:"
    echo "    ${AQ_LOG}"
    echo "------------------------------------------------------------"
    exit 1
}

# -----------------------------------------------------------------------------
# The tidying-up half of this session, kept in its own file.
#
# It holds the LIST of variables this script exports, and the clean-up that puts
# the machine back the way it found it when the session ends. One list used in
# both directions, so the two can never disagree — which is the whole reason it
# is a separate file rather than another page of this one.
#
# ⚠️ WHY IT EXISTS: the bench bug of 2026-09-04. Logging out of the Aquarius
# Desktop to go to GNOME bounced off the login screen two or three times before
# GNOME would start, because this session used to walk away and leave its
# settings and its background programs behind for GNOME to trip over. The long
# version of that story is at the top of the file being read here, and it is
# worth reading before changing anything in it.
# -----------------------------------------------------------------------------
if [ -r "${AQ_SESSION_LIB}" ]; then
    # shellcheck source=../libexec/aquarius-session-lib
    . "${AQ_SESSION_LIB}"
else
    die "${AQ_SESSION_LIB} is not in this image." \
        "It holds the list of settings this session uses and the clean-up that" \
        "runs when you log out. Starting without it would leave the machine in" \
        "a state where logging in to GNOME afterwards fails." \
        "" \
        "This is a broken image, not something you did. Log in with GNOME."
fi

# -----------------------------------------------------------------------------
# Is everything here?
#
# These checks happen BEFORE anything is started, so a missing piece is a clear
# sentence rather than a black screen. On AquariusOS every one of these is part
# of the operating system image, so a failure here does not mean "you forgot to
# install something" — it means the image itself is wrong, and that is worth
# saying differently from the way the repository's version says it.
# -----------------------------------------------------------------------------
echo ""
echo "=== Checking the pieces are in the image ==="

aq_missing=""
aq_need() {
    if command -v "$1" > /dev/null 2>&1; then
        echo "  found    $1"
    else
        echo "  MISSING  $1 — $2"
        aq_missing="${aq_missing} $1"
    fi
}

aq_need labwc "the window manager"
aq_need qs "the Quickshell runtime, which draws the bar"

# Deliberately NOT checked here: dbus-daemon. Fedora's session bus is normally
# dbus-broker, and a machine can have a perfectly working bus with no program
# called dbus-daemon anywhere on it. The right question is "is there a bus", not
# "is there a particular program", and that question is asked further down.

if [ -n "${aq_missing}" ]; then
    die "The AquariusOS image is missing:${aq_missing}" \
        "These are built into the operating system, so this is not something" \
        "you can fix by installing a package — the image is wrong." \
        "" \
        "Log in with GNOME, and report which names are listed above."
fi

if [ -d "${AQ_LABWC_CONFIG_DIR}" ]; then
    echo "  found    ${AQ_LABWC_CONFIG_DIR}"
else
    die "The folder ${AQ_LABWC_CONFIG_DIR} is not in this image." \
        "Without it the window manager has no key bindings and no way to start" \
        "anything. This is a broken image, not something you did. Log in with" \
        "GNOME."
fi

# The shell is a DIFFERENT case, and deliberately not fatal.
#
# It lives in its own repository, and a container build has no GitHub account —
# so if that repository is private when the image is built, the image is
# finished without it. Everything else still works: the window manager, the
# wallpaper, the keyboard, screen recording. There is simply no bar.
#
# So this is a note, not a death. The helper that would have started the shell
# puts a dialog on screen explaining it instead, and /usr/share/aquarius/
# shell-build.txt says exactly why.
if [ -s "${AQ_SHELL_DIR}/shell.qml" ]; then
    echo "  found    ${AQ_SHELL_DIR}"
else
    echo "  NOTE     the Aquarius Shell is not in this image — there will be no bar."
    echo "           Why: /usr/share/aquarius/shell-build.txt"
    echo "           The desktop still starts, and a dialog will explain it."
fi

# gdbus is how the shell asks the system whether it prefers a light or a dark
# appearance. Its absence is NOT fatal — the shell simply stays on Ice, its
# light default. Say so rather than failing.
if command -v gdbus > /dev/null 2>&1; then
    echo "  found    gdbus"
else
    echo "  note     gdbus is missing; the shell will stay on the Ice light theme."
fi

# -----------------------------------------------------------------------------
# Does `qs` actually RUN?
#
# THIS CHECK EXISTS BECAUSE OF THE FIRST REAL BOOT, 2026-09-02.
#
# The check above only asks "is there a file called qs". There was. It could not
# start: it had been built against a different version of Qt than the machine
# had, and it died on its first instruction with a symbol lookup error. The
# session came up, ran for eighteen minutes, and there was no bar and no
# explanation, because a program that dies before its first line of output is
# invisible to a check that only looks for its name.
#
# So: run it. `qs --version` loads every Qt library and then prints one line.
#
# On AquariusOS this should now be impossible to fail — Quickshell is COMPILED
# INSIDE the image, against the image's own Qt, precisely so the two can never
# drift apart. The check stays anyway. It costs a tenth of a second and it is
# the difference between a sentence and a black screen.
# -----------------------------------------------------------------------------
echo ""
echo "=== Checking the shell runtime can actually start ==="

if command -v timeout > /dev/null 2>&1; then
    aq_qs_runner=(timeout 10 qs --version)
else
    aq_qs_runner=(qs --version)
fi

aq_qs_status=0
aq_qs_output="$("${aq_qs_runner[@]}" 2>&1)" || aq_qs_status=$?

if [ "${aq_qs_status}" -eq 0 ]; then
    echo "  runs     qs — ${aq_qs_output}"
else
    die "The Quickshell runtime (qs) is installed but cannot start." \
        "Running 'qs --version' failed with exit code ${aq_qs_status} and said:" \
        "" \
        "  ${aq_qs_output}" \
        "" \
        "If that message mentions 'undefined symbol' or 'symbol lookup error'," \
        "something has layered a different build of quickshell on top of the" \
        "one in the image. Undo it:" \
        "" \
        "  rpm-ostree uninstall quickshell" \
        "  systemctl reboot" \
        "" \
        "AquariusOS builds its own quickshell into the image on purpose, and a" \
        "layered one will always be compiled against a different Qt."
fi

# -----------------------------------------------------------------------------
# Is there a session bus and a runtime directory to hang everything off?
# -----------------------------------------------------------------------------
if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
    die "XDG_RUNTIME_DIR is not set." \
        "Wayland, D-Bus and the portals all keep their sockets in that folder," \
        "so nothing can work without it. The login screen normally sets it, so" \
        "seeing this usually means this script was run by hand from somewhere" \
        "unusual rather than from the login screen."
fi

if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ ! -S "${XDG_RUNTIME_DIR}/bus" ]; then
    die "There is no D-Bus session bus." \
        "The portals, the system tray and the notification service are all" \
        "D-Bus services. Without a bus, screen recording and file dialogs" \
        "cannot work at all." \
        "" \
        "If you are starting this by hand from a text console, wrap it:" \
        "  dbus-run-session -- aquarius-session"
fi

# -----------------------------------------------------------------------------
# The environment.
#
# XDG_CURRENT_DESKTOP is the important one and it is worth understanding why.
#
# xdg-desktop-portal decides which back end answers "let me record the screen"
# or "let me open a file" by reading a configuration file whose NAME comes from
# this variable. It splits the value on colons, lowercases each name, and for
# each one looks for <name>-portals.conf.
#
# So "Aquarius:wlroots" makes it look for aquarius-portals.conf first — which is
# the file this image ships at /usr/share/xdg-desktop-portal/. Get this wrong
# and screen recording silently does nothing: no error, no dialog, OBS just
# shows an empty list of screens.
#
# The second name, "wlroots", is not decoration. labwc is built on the wlroots
# library, xdg-desktop-portal-wlr's own metadata lists wlroots in its UseIn
# field, and a good deal of third-party software keys off that word to mean
# "this desktop speaks the wlr-* protocols".
#
# Source, verified: portals.conf(5), xdg-desktop-portal.
# -----------------------------------------------------------------------------
export XDG_SESSION_TYPE="wayland"
export XDG_SESSION_DESKTOP="aquarius"
export XDG_CURRENT_DESKTOP="Aquarius:wlroots"

# Where the shell's QML lives. Everything downstream depends on this one line:
# the autostart file starts the shell with a bare `qs`, and the Super+Space key
# binding reaches the RUNNING shell with a bare `qs ipc call search toggle`.
# Neither of them names a path, because both inherit this.
export QS_CONFIG_PATH="${AQ_SHELL_DIR}"

# Qt applications, including the shell, should talk Wayland directly rather than
# going through XWayland.
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland}"

# Deliberately NOT set: GDK_BACKEND. Setting it globally breaks the screencast
# portal, and there is no upside.

# -----------------------------------------------------------------------------
# WHAT LANGUAGE THIS SESSION SPEAKS
#
# ⚠️ THIS EXISTS BECAUSE OF THE BENCH, 2026-09-03. Running `qs` by hand printed:
#
#     Detected locale "C" with character encoding "ANSI_X3.4-1968",
#     which is not UTF-8. Qt depends on UTF-8 locales ...
#     switched to "C.UTF-8"
#
# WHAT THAT ACTUALLY MEANT
#   Nothing was exporting LANG. The login screen hands a session an environment,
#   and on a bare Fedora bootc image that environment can arrive with no LANG in
#   it at all — at which point every program falls back to the "C" locale, whose
#   character set is 1968-era 7-bit ASCII. Qt noticed and repaired itself, which
#   is why the desktop still worked. GTK does not always say anything at all.
#
#   The symptoms if it is left alone are the quiet kind, and they are the worst
#   kind to debug six months from now: an accented character in a filename drawn
#   as a box in the dock, a notification from an app with an em dash in its name
#   truncated at the dash, a sort order that puts "Ångström" after "Zoe".
#
# WHERE WE LOOK, AND WHY IN THIS ORDER
#   1. ~/.config/locale.conf — your own explicit choice, so it wins. This is the
#      same file systemd's user manager reads, not an invention of ours.
#   2. A UTF-8 LANG we were already given. If the login screen or PAM already
#      set a sensible language, that is the language you picked, and overriding
#      it would be rude. Note the test is "is it UTF-8" — an inherited LANG of
#      "C" or "POSIX" is exactly the bug, so it does NOT count as an answer.
#   3. /etc/locale.conf — the system default. AquariusOS ships one
#      (LANG=en_US.UTF-8, written by build_files/30-session.sh), so on our own
#      image this is where the answer normally comes from.
#   4. C.UTF-8 — the floor. It is not a language, it is "ASCII rules, UTF-8
#      characters", and glibc always has it. Better than "C" in every case.
#
#   Whatever comes out is then CHECKED against `locale -a`. Naming a locale the
#   machine has never generated is as broken as naming none, and it fails the
#   same silent way — so if it is not there we fall back to C.UTF-8 and say so
#   in the log rather than exporting a value that does nothing.
#
# We set LANG and nothing else. LC_ALL would override every LC_* the user has
# deliberately set (a British person who wants US dates, say), and that is not
# ours to do.
# -----------------------------------------------------------------------------
# Read LANG out of a systemd-style NAME=value file. Written as plain bash
# rather than sed, because the value can be quoted and the quoting of a sed
# expression that strips quotes is its own small nightmare. Last LANG= line
# wins, which is how systemd reads these files too.
aq_lang_from_file() {
    local aq_file="$1" aq_line="" aq_value=""

    [ -r "${aq_file}" ] || return 1

    while IFS= read -r aq_line || [ -n "${aq_line}" ]; do
        case "${aq_line}" in
            LANG=*) aq_value="${aq_line#LANG=}" ;;
        esac
    done < "${aq_file}"

    # Drop a trailing comment or anything after a space, then the quotes.
    aq_value="${aq_value%%[[:space:]]*}"
    aq_value="${aq_value%\"}"; aq_value="${aq_value#\"}"
    aq_value="${aq_value%\'}"; aq_value="${aq_value#\'}"

    [ -n "${aq_value}" ] || return 1
    printf '%s\n' "${aq_value}"
}

# Is this a UTF-8 locale? The whole point of the exercise.
aq_is_utf8() {
    case "$1" in
        *.[Uu][Tt][Ff]8 | *.[Uu][Tt][Ff]-8 | *.[Uu][Tt][Ff]_8) return 0 ;;
        *) return 1 ;;
    esac
}

# Has this machine actually generated it? `locale -a` is the list. glibc spells
# the same locale two ways — "en_US.utf8" in that list, "en_US.UTF-8" in a
# config file — so both spellings are tried.
aq_locale_exists() {
    local aq_want="$1" aq_alt="${1%.*}.utf8"
    command -v locale > /dev/null 2>&1 || return 0
    locale -a 2> /dev/null | grep -qix -e "${aq_want}" -e "${aq_alt}"
}

aq_lang=""
aq_lang_why=""

if aq_lang="$(aq_lang_from_file "${XDG_CONFIG_HOME:-${HOME}/.config}/locale.conf")"; then
    aq_lang_why="your own ~/.config/locale.conf"
elif [ -n "${LANG:-}" ] && aq_is_utf8 "${LANG}"; then
    aq_lang="${LANG}"
    aq_lang_why="the login screen"
elif aq_lang="$(aq_lang_from_file /etc/locale.conf)"; then
    aq_lang_why="the system default in /etc/locale.conf"
else
    aq_lang="C.UTF-8"
    aq_lang_why="nothing set one, so this is the safe floor"
fi

# C.UTF-8 is glibc's own built-in and is never absent, so it is not worth
# asking about — and asking would produce a puzzling "the fallback does not
# exist, falling back to it" line in the log the one time it mattered.
if [ "${aq_lang}" != "C.UTF-8" ] && ! aq_locale_exists "${aq_lang}"; then
    echo "  note     the locale ${aq_lang} (${aq_lang_why}) has not been generated here"
    aq_lang="C.UTF-8"
    aq_lang_why="falling back — the one above does not exist on this machine"
fi

# The last line of defence: whatever was decided, it has to be UTF-8. Getting
# here with anything else would reproduce the exact bug this block is for.
if ! aq_is_utf8 "${aq_lang}"; then
    echo "  note     ${aq_lang} (${aq_lang_why}) is not a UTF-8 locale"
    aq_lang="C.UTF-8"
    aq_lang_why="forced — Qt and GTK both need UTF-8"
fi

export LANG="${aq_lang}"
echo "  language ${LANG} (${aq_lang_why})"

# -----------------------------------------------------------------------------
# HOW BIG THE AQUARIUS SHELL DRAWS ITSELF
#
# ⚠️ THIS IS NOT THE SAME THING AS THE SCREEN SCALE, AND THE DIFFERENCE MATTERS.
#
#   The SCREEN SCALE makes everything on the monitor bigger — your browser,
#   DaVinci Resolve, our bar, all of it. It is a property of the monitor, the
#   window manager applies it, and /usr/libexec/aquarius-display-scale sets it
#   from the labwc autostart file a moment from now.
#
#   AQ_UI_SCALE makes ONLY OUR OWN BAR AND DOCK bigger, and touches nothing
#   else. It exists because "the shell reads small" and "the screen is set too
#   small" are two different complaints with two different fixes, and on the
#   bench on 2026-09-03 they arrived together and were easy to confuse.
#
#   It is a design knob. It let Royce try the bar at 1.15, 1.25 and 1.5 on the
#   real machine, in seconds, without an edit, a rebuild, or somebody on a Mac
#   guessing for him.
#
#   ⚠️ HE ANSWERED IT ON 2026-09-03: 1.25 for the shell, 1.5 for the dock. Those
#   numbers are now the shell's OWN token values, so **1 is the approved size**
#   and nobody needs to set this to get it. The knob stays because the question
#   comes back with the next monitor.
#
# Set with `aq display ui 1.25`, which writes ui=1.25 into the file below.
# Absent, unreadable or nonsense means 1, which is the design exactly as drawn.
# The shell clamps it to 0.5–3 as well, so a typo here cannot produce a bar
# taller than the screen.
# -----------------------------------------------------------------------------
AQ_DISPLAY_CONF="${XDG_CONFIG_HOME:-${HOME}/.config}/aquarius/display.conf"
if [ -r "${AQ_DISPLAY_CONF}" ]; then
    AQ_UI_FROM_CONF="$(sed -n 's/^[[:space:]]*ui[[:space:]]*=[[:space:]]*\([0-9.]*\).*/\1/p' \
        "${AQ_DISPLAY_CONF}" | tail -n 1)"
    if [ -n "${AQ_UI_FROM_CONF}" ]; then
        export AQ_UI_SCALE="${AQ_UI_FROM_CONF}"
        echo "  the Aquarius bar and dock will be drawn at ${AQ_UI_SCALE}x (from ${AQ_DISPLAY_CONF})"
    fi
fi

# -----------------------------------------------------------------------------
# Hand the environment to systemd and D-Bus.
#
# Portals, the keyring and the tray are started ON DEMAND, by systemd's user
# manager and by D-Bus — not by this script. They inherit the environment they
# were given when the user session began, which was BEFORE the four exports
# above. Telling them about the new values is this step, and skipping it is a
# classic cause of "the file dialog does not open and nothing is logged".
#
# WAYLAND_DISPLAY does not exist yet — the window manager has not started. The
# autostart file does a second pass once it does.
# -----------------------------------------------------------------------------
aq_push_env() {
    if command -v dbus-update-activation-environment > /dev/null 2>&1; then
        dbus-update-activation-environment --systemd "$@" 2> /dev/null || true
    else
        systemctl --user import-environment "$@" 2> /dev/null || true
    fi
}
#
# ⚠️ THE LIST IS NOT WRITTEN HERE. It is AQ_SESSION_ENV_PUSH, in
# /usr/libexec/aquarius-session-lib, because the SAME list is what gets removed
# again when you log out. Two hand-written lists would eventually disagree, and
# the way that disagreement shows up is a login that bounces off the login
# screen with nothing in any log to explain it. So there is one list, and
# tests/test-session-teardown.sh fails the build if any `export` in this file is
# missing from it.
#
# LANG is in that list for the same reason as the rest: a portal or a tray icon
# started on demand, half an hour into the session, must speak the same language
# and the same character set as the shell that asked for it. (It is also the one
# entry that is deliberately NOT removed at logout — see the comment beside
# AQ_SESSION_ENV_KEEP.)
#
# shellcheck disable=SC2086
aq_push_env ${AQ_SESSION_ENV_PUSH}

echo ""
echo "=== Starting ==="
echo "  window manager: labwc  ($(labwc --version 2>&1 | head -1))"
echo "  shell:          ${AQ_SHELL_DIR}"
echo "  labwc config:   ${AQ_LABWC_CONFIG_DIR}"
echo "  desktop name:   ${XDG_CURRENT_DESKTOP}"
echo "  language:       ${LANG}"
echo ""

# -----------------------------------------------------------------------------
# Hand over to the window manager. It starts the shell itself.
#
# -C points labwc at a configuration DIRECTORY; it reads rc.xml, autostart,
# shutdown and environment from there.
#
# Deliberately NOT using labwc's -S/--session flag, which would shut the whole
# desktop down the moment the command it started exits. That would turn a crash
# of the bar into a logout, and a bar falling over should not log you out.
#
# -----------------------------------------------------------------------------
# ⚠️ WHY THIS IS NO LONGER `exec labwc`. THE 2026-09-04 LOGOUT FIX.
# -----------------------------------------------------------------------------
# It used to be. `exec` replaces this script with the window manager, which is
# tidy — one fewer process — and it was wrong, because it meant there was
# nothing left to run afterwards. The moment labwc ended, this program was
# already gone, and the session's settings and background programs were left
# behind for the next desktop to trip over. That is the whole bug Royce hit:
# log out of Aquarius, pick GNOME, and get bounced back to the login screen two
# or three times before it would let him in.
#
# So the window manager is now run as a CHILD and this script stays alive for
# the second or two it takes to clean up after it. Nothing about the session
# changes; there is simply somebody left to turn the lights off.
#
# THE `trap` IS WHAT MAKES IT RELIABLE. It is armed here, one line before the
# window manager starts, and it fires on EVERY way out of this script — the
# normal Super+Shift+E, a crash of the window manager, or the login screen
# telling the session to end. Not "if we remember to call it at the end", which
# is the version of this that quietly does not run on the path that mattered.
#
# `exit` inside the two signal traps is deliberate: it hands control to the EXIT
# trap, so a session being shut down cleans up the same way as one being left.
# -----------------------------------------------------------------------------
trap 'aq_session_teardown' EXIT
trap 'exit 143' TERM INT HUP

aq_labwc_status=0
labwc -C "${AQ_LABWC_CONFIG_DIR}" || aq_labwc_status=$?

echo ""
echo "=== The Aquarius Desktop has ended (window manager exit code ${aq_labwc_status}) ==="

exit "${aq_labwc_status}"
