#!/usr/bin/bash
# ==============================================================================
# Aquarius Editor — launcher
# ==============================================================================
# Plain English: the real program lives in a folder full of files nobody should
# have to know about. This is the friendly front door: typing `aquarius-editor`
# in a terminal, or clicking the icon in the app grid, both end up here.
#
# The generic work — checking the app is really runnable, keeping a log, and
# putting a real error on screen if it fails — is shared with Aquarius Writer
# and lives in /usr/libexec/aquarius-app-launch. Read that file first; it
# explains why a launcher does any of this at all.
#
# What is left HERE is the part that is true of this app and no other: Aquarius
# Editor is an Electron app, and Electron has one specific way of refusing to
# start that produces no window and no message.
#
# ------------------------------------------------------------------------------
# ⚠️ WHERE THE APP LIVES — CHANGED 2026-09-04
# ------------------------------------------------------------------------------
# It used to be baked into the image at /usr/lib/aquarius/aquarius-editor. It is
# not any more. Aquarius Editor is four gigabytes, and baking it in made every
# download of AquariusOS four gigabytes bigger for everybody, including the
# people who will never open it. It is now the first card in the app chooser —
# ticked when the window opens — and it installs into the person's own home
# folder, which needs no password.
#
# So this launcher looks in ~/.local/lib/aquarius/aquarius-editor instead of in
# /usr/lib/aquarius/aquarius-editor. That folder is deliberately shaped exactly
# like the old one, which is why everything below this line — the update
# overlay, the sandbox handling, the shared launcher — is unchanged.
#
# Aquarius Writer is still baked in. It is about 260 MB, which is not worth
# asking anybody a question about.
# ==============================================================================

set -u

APP_ID="aquarius-editor"

# The folder the app is installed into, which is the person's own, not the
# system's. It mirrors /usr/lib/aquarius exactly — see the long note at the top
# of /usr/libexec/aquarius-appimage-install for why that shape was chosen.
APP_PARENT="${HOME:-}/.local/lib/aquarius"
APPDIR="${APP_PARENT}/${APP_ID}"

# ------------------------------------------------------------------------------
# IS IT INSTALLED AT ALL?
# ------------------------------------------------------------------------------
# The menu entry lives in the person's own applications folder and arrives with
# the app, so in normal life a missing app means a missing icon and this branch
# is never reached. It is reached in exactly two situations, and both deserve a
# sentence rather than a shrug:
#
#   * somebody types `aquarius-editor` in a terminal without having installed it
#   * the app is pinned to the dock — which it is, in both desktops, on purpose,
#     so that the icon appears the moment it is installed — and the desktop lets
#     a pinned entry be clicked before its files are there.
#
# Both get told the same thing, in the same words, in the place they are looking:
# a terminal gets the sentence on the terminal, a click gets a notification.
if [ ! -d "${APPDIR}" ] || [ ! -e "${APPDIR}/AppRun" ]; then
    MSG="Aquarius Editor is not installed on this account yet. Open Aquarius Apps, tick Aquarius Editor and press Install. It is about a four gigabyte download."
    echo "aquarius-editor: ${MSG}" >&2
    echo "aquarius-editor: or, in a terminal:  aq apps install os.aquarius.editor" >&2
    if [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v notify-send > /dev/null 2>&1; then
        notify-send --app-name="Aquarius Editor" --icon=aquarius-logo \
            "Aquarius Editor is not installed yet" "${MSG}" > /dev/null 2>&1 || true
        # And open the window they are being sent to, rather than only naming it.
        if [ -x /usr/libexec/aquarius-creator-apps ]; then
            setsid /usr/libexec/aquarius-creator-apps > /dev/null 2>&1 &
        fi
    fi
    exit 1
fi

# ------------------------------------------------------------------------------
# IS THERE A NEWER COPY IN YOUR HOME FOLDER?
# ------------------------------------------------------------------------------
# AquariusOS keeps /usr read-only, so the copy of Aquarius Editor that ships with
# the operating system can never update itself in place. Instead the app is
# allowed to download a newer copy of itself into your home folder, and this is
# where the OS decides which of the two to start.
#
# All the thinking lives in /usr/libexec/aquarius-app-overlay — read that file
# for the whole arrangement. Four lines here:
#
#   AQ_INSTALL_ROOT   comes back as the folder to start the app from
#   AQ_LAUNCH_NOTES   comes back as plain English about why, for the log file
#
# and it also sets the two environment variables that tell the app it is on an
# OS-managed install and where it may write updates.
#
# ⚠️ THIS HAS TO HAPPEN BEFORE THE SANDBOX CHECK BELOW, and that is not a matter
# of taste. The check looks at a file called chrome-sandbox inside the app, and
# the answer is DIFFERENT for the two copies: the built-in one has that file set
# up by the image build as a root-owned setuid program, and a copy the app
# downloaded into your home folder cannot possibly have that — you are not root
# when you download something. Asking the question about the wrong folder is
# precisely the mistake that makes Electron abort with no window at all.
#
# If the file is missing for any reason we simply carry on with the built-in
# copy: no updates, but the app still starts, which is the important half.
#
# ⚠️ THE SECOND ARGUMENT IS THE 2026-09-04 CHANGE, AND IT IS THE WHOLE OF IT.
# That library was written to compare a copy in a home folder against a copy
# baked into the image, and it takes "the folder the installed apps live in" as
# an argument precisely so its own tests can point it elsewhere. Aquarius Editor
# is no longer in the image, so it is handed the folder the app chooser installs
# into instead. Nothing else about the arrangement changes: the version
# comparison, the "is a downloaded update genuinely newer" rule and the clean-up
# of superseded copies all behave exactly as they did.
AQ_INSTALL_ROOT="$APPDIR"
AQ_LAUNCH_NOTES=""
if [ -r /usr/libexec/aquarius-app-overlay ]; then
    # shellcheck source=../libexec/aquarius-app-overlay
    . /usr/libexec/aquarius-app-overlay
    aq_overlay_prepare "$APP_ID" "$APP_PARENT"
    APPDIR="$AQ_INSTALL_ROOT"
else
    AQ_LAUNCH_NOTES="update overlay: /usr/libexec/aquarius-app-overlay is missing from this system, so no check for a downloaded update was made. Starting the copy built into AquariusOS."
fi

# ------------------------------------------------------------------------------
# THE CHROME SANDBOX — the one thing that makes Electron die in silence
# ------------------------------------------------------------------------------
# Electron is a web browser with an app inside it, so it sandboxes its own
# rendering the way Chrome sandboxes a tab. On Linux it can do that two ways:
#
#   the USER-NAMESPACE sandbox   the modern one. Needs nothing special: the
#                                kernel lets an ordinary program build itself a
#                                tiny private world. AquariusOS has this
#                                switched on, as every ordinary Fedora does.
#   the SETUID sandbox           the old one. Needs a small helper program,
#                                'chrome-sandbox', that is owned by root and
#                                carries the setuid bit (mode 4755).
#
# The trap is in how Electron chooses. If the helper file EXISTS but is not set
# up correctly, Electron does not shrug and use the modern sandbox. It stops
# dead, prints
#
#     The SUID sandbox helper binary was found, but is not configured
#     correctly. Rather than run without sandboxing I'm aborting now.
#
# and exits. Clicked from the app grid there is no terminal for that sentence to
# appear in, so what a person sees is: nothing.
#
# ⚠️ SINCE 2026-09-04 THIS BLOCK FIRES EVERY SINGLE TIME, AND THAT IS EXPECTED.
# The app is no longer baked into the image by a build running as root; it is
# unpacked into your own home folder, by you, and ONLY ROOT CAN MAKE A FILE
# SETUID. So its chrome-sandbox is always an ordinary file, and without these
# lines Aquarius Editor would be a dead icon on every machine.
#
# That costs nothing real. Chromium has preferred the newer user-namespace
# sandbox since 2015 and only consults the setuid helper when user namespaces
# are unavailable, which on this image they are not — an ordinary Fedora kernel
# with unprivileged user namespaces switched on. The app is sandboxed either
# way; only the mechanism differs.
#
# Until this change the same block existed for the copy the app downloads for
# ITSELF into your home folder, which has always had the same limitation. It is
# now simply the normal path rather than the unusual one.
#
# If the helper is not set up correctly we do NOT reach for --no-sandbox, which
# would turn the sandbox off altogether. We pass --disable-setuid-sandbox, which
# tells Electron "do not consider the old mechanism" — and it then uses the
# user-namespace sandbox, which is what a correctly configured system was going
# to use anyway. The app stays sandboxed. Only if user namespaces are ALSO
# unavailable is there a real choice to make, and then we say so in the log and
# start unsandboxed rather than leaving the user with a dead icon.
SANDBOX_HELPER="${APPDIR}/chrome-sandbox"
EXTRA_ARGS=()

if [ -e "$SANDBOX_HELPER" ] && [ ! -u "$SANDBOX_HELPER" ]; then
    # The file is there and the setuid bit is not. Skip the old mechanism.
    if unshare -Ur true 2>/dev/null; then
        EXTRA_ARGS+=(--disable-setuid-sandbox)
        echo "aquarius-editor: chrome-sandbox is not setuid; using the user-namespace sandbox instead." >&2
    else
        EXTRA_ARGS+=(--no-sandbox)
        echo "aquarius-editor: WARNING — no working sandbox on this system. Starting without one." >&2
    fi
fi

# ------------------------------------------------------------------------------
# DRAW SHARPLY ON A SCALED SCREEN
# ------------------------------------------------------------------------------
# By default Electron on Linux talks to the display through XWayland, the
# compatibility layer for older software. XWayland cannot scale by a fraction,
# so on a screen set to 125% or 150% — which every 4K monitor is, and which the
# bench monitor is — the desktop has to enlarge the app's picture afterwards.
# The result is a window that looks very slightly out of focus. Text is where
# you see it.
#
# ELECTRON_OZONE_PLATFORM_HINT=auto tells Electron to speak Wayland directly on
# a Wayland desktop, and to keep using X11 where there is no Wayland to speak
# to. "auto" and not "wayland": forcing Wayland on a machine that is not
# running it gives an app that does not start at all, which is far worse than a
# slightly soft one.
#
# The same value is set for the whole session in
# /usr/lib/environment.d/60-aquarius-electron.conf. It is repeated here because
# that file is read when you LOG IN, and an app started from an SSH session or
# from a terminal that predates the setting would otherwise miss it. Anything
# you export yourself still wins — that is what the :- means.
export ELECTRON_OZONE_PLATFORM_HINT="${ELECTRON_OZONE_PLATFORM_HINT:-auto}"

# ------------------------------------------------------------------------------
# TELL ME EVERYTHING
# ------------------------------------------------------------------------------
# Electron is quiet by default: a graphics driver problem can take the whole app
# down having printed nothing at all. This turns its internal log on and sends
# it to the same place as everything else, which is the log file the shared
# launcher keeps.
#
#     AQUARIUS_DEBUG=1 aquarius-editor
#
# It is not on by default because it is genuinely a lot of output, and because
# nothing should be slower forever on account of a bug we already fixed.
if [ "${AQUARIUS_DEBUG:-0}" = "1" ]; then
    EXTRA_ARGS+=(--enable-logging=stderr --v=1)
fi

# ------------------------------------------------------------------------------
# Everything else is the shared launcher's job.
# ------------------------------------------------------------------------------
# Our flags go before the user's on purpose: Chromium accepts its switches
# anywhere, and this way a file name passed by the desktop ("open this with
# Aquarius Editor") is still the last thing on the line, where it reads
# naturally in the log.
#
# The odd-looking ${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"} is the way to expand an
# array that may be empty while `set -u` is on, without the shell complaining
# about an unset variable.
#
# The two variables handed over are which folder to start (worked out at the top
# of this file) and the plain-English story of that decision, which the shared
# launcher writes into the first few lines of the app's log.
export AQUARIUS_INSTALL_ROOT="$APPDIR"
export AQUARIUS_LAUNCH_NOTES="$AQ_LAUNCH_NOTES"

exec /usr/libexec/aquarius-app-launch "$APP_ID" "Aquarius Editor" \
    ${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"} "$@"
