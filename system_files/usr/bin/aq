#!/usr/bin/bash
# =============================================================================
# aq — the AquariusOS command
# =============================================================================
# WHAT THIS IS
#
# A friendly front door for the settings AquariusOS adds on top of Fedora,
# written so that every message is a sentence rather than a code.
#
# RIGHT NOW IT DOES THREE THINGS: keyboard shortcut style, screen size, and
# making camera files editable.
#
#     aq keys mac        use Mac-style shortcuts (Command-C to copy)
#     aq keys windows    use the normal Linux ones (Control-C to copy)
#     aq keys status     which am I using, and is it working?
#
#     aq display scale 1.25   make everything on the screen 125% size
#     aq display ui 1.15      make the Aquarius bar and dock 115% size
#     aq display auto         forget both, work it out automatically again
#     aq display status       what the screens are set to right now
#
#     aq resolve install      set up DaVinci Resolve
#     aq resolve status       is it installed, and can it see the graphics card
#     aq resolve run          start it
#     aq resolve shell        a terminal inside the environment it runs in
#     aq resolve update       install a newer Resolve over the top
#     aq resolve remove       remove Resolve and that environment
#     aq resolve scale 1.5    how big Resolve's own interface is drawn
#     aq apps list            which creator apps you have
#     aq apps install ID      install one you skipped
#
#     aq ingest FILE…         make camera files editable
#     aq ingest watch on      watch ~/Videos/Ingest and do it automatically
#
# It is deliberately small. FEATURES 005 in the AquariusOS plan describes a
# fuller `aq` — `aq status`, `aq snapshot` — and that is a later job. This is
# the first subcommand of it, built because Aquarius Keys needed a switch and a
# person should not have to edit a file and restart a service by hand.
#
# ⚠️ IF YOU ADD A SUBCOMMAND, ADD IT TO usage() TOO. A command nobody can
# discover is a command nobody uses.
# =============================================================================

set -uo pipefail

AQ_CONF_DIR="${XDG_CONFIG_HOME:-${HOME:-/tmp}/.config}/aquarius"
AQ_CONF="${AQ_CONF_DIR}/keys.conf"
AQ_DISPLAY_CONF="${AQ_CONF_DIR}/display.conf"
AQ_PROFILE_DIR="/usr/share/aquarius/keys"
AQ_SERVICE="aquarius-keys.service"
AQ_DISPLAY_HELPER="/usr/libexec/aquarius-display-scale"

# -----------------------------------------------------------------------------
# usage — printed by `aq`, `aq --help`, and anything it does not understand
# -----------------------------------------------------------------------------
usage() {
    cat << 'EOF'
aq — the AquariusOS command

USAGE
    aq keys mac         Use Mac-style keyboard shortcuts.
                        Copy is Command-C, quit is Command-Q, search is
                        Command-Space. On a PC keyboard, "Command" is the key
                        next to the space bar (the one labelled Alt).

    aq keys windows     Use the normal Linux and Windows shortcuts.
                        Copy is Control-C. Nothing about your keyboard is
                        changed at all.

    aq keys status      Say which style is switched on, whether it is actually
                        running, how many keyboards it has hold of, and where
                        to look if something is wrong.

    aq display scale N  Make EVERYTHING on the screen N times its normal size.
                        This is the setting GNOME calls "Scale". On a 4K
                        monitor, try 1.25 or 1.5. Applies straight away.

    aq display ui N     Make only the AQUARIUS BAR AND DOCK N times their
                        normal size, and leave your applications alone. This is
                        for tuning our own design; takes effect at the next
                        login.

    aq display auto     Forget both of the above and work the size out
                        automatically again.

    aq display status   What each screen is, what size it is set to, and where
                        that answer came from.

    aq resolve …        DaVinci Resolve: set it up, start it, check on it.
                        Run 'aq resolve --help' for the whole list. Resolve runs
                        inside its own protected environment on this computer,
                        that is the only way it works reliably on Linux — the
                        help text explains why in plain English.
    aq ingest FILE...   Make files from a camera, phone or drone open properly
                        in a video editor. Editor-friendly copies appear in an
                        "EditorReady" folder beside them; the originals are
                        never touched. Point it at a folder and it does the
                        whole folder.

                        This is the same thing as right-clicking a file in
                        Files and choosing "Make Editor-Ready".

    aq ingest watch on  Watch ~/Videos/Ingest and convert anything dropped in
                        there automatically. Off until you ask for it.
    aq ingest watch off Stop watching.
    aq ingest watch status
                        Is it watching, what, and what happened last.

    aq apps list        The creator apps AquariusOS suggests, and whether you
                        have each one. 'aq apps install <id>' adds one you
                        skipped; 'aq apps status' says how many you have.

    aq login status     Which login screen this computer starts with — GNOME's
                        (GDM) or the AquariusOS one (greetd) — and whether the
                        AquariusOS one is ready to be switched on.

    aq login use greetd Use the AquariusOS login screen: the Ice wallpaper, the
                        Aquarius mark, and a password box drawn by our own
                        desktop. Takes effect at the next restart.

    aq login use gdm    Go back to GNOME's login screen. This is the one the
                        computer starts with out of the box, and it is what to
                        type if the other one gives you trouble — it works from
                        a text console (Ctrl+Alt+F3) too.

    aq --help           This message.
    aq --version        Which AquariusOS this is.

NOTES
    Switching takes effect straight away. You do not have to log out.
    The setting is yours alone — another person on this computer keeps theirs.
    The full guide is at:
        https://github.com/stoneharborent/aquarius-os
        docs/restart/aquarius-keys.md
EOF
}

keys_usage() {
    cat << 'EOF'
aq keys — choose how keyboard shortcuts work

    aq keys mac         Mac-style. Copy is Command-C. (The AquariusOS default.)
    aq keys windows     The normal Linux ones. Copy is Control-C.
    aq keys status      What is switched on, and is it running?
EOF
}

# -----------------------------------------------------------------------------
# read_mode — what does the settings file say right now?
# -----------------------------------------------------------------------------
# A missing file means Mac, because Mac is the AquariusOS default. That rule is
# written in exactly one other place — /usr/libexec/aquarius-keys-run — and the
# two have to agree.
read_mode() {
    local mode=""
    if [ -r "${AQ_CONF}" ]; then
        mode="$(sed -n 's/^[[:space:]]*mode[[:space:]]*=[[:space:]]*\([a-zA-Z]*\).*/\1/p' "${AQ_CONF}" | tail -n 1)"
    fi
    case "${mode}" in
        mac | windows) printf '%s\n' "${mode}" ;;
        *) printf 'mac\n' ;;
    esac
}

# -----------------------------------------------------------------------------
# set_mode — write the file, then apply it
# -----------------------------------------------------------------------------
set_mode() {
    local mode="$1"

    if [ ! -r "${AQ_PROFILE_DIR}/${mode}.yaml" ]; then
        echo "aq: this copy of AquariusOS has no '${mode}' keyboard profile in" >&2
        echo "    ${AQ_PROFILE_DIR}. That is a fault in the operating system," >&2
        echo "    not in anything you typed." >&2
        return 1
    fi

    mkdir -p "${AQ_CONF_DIR}" || {
        echo "aq: could not create ${AQ_CONF_DIR}." >&2
        return 1
    }

    # The whole file is rewritten rather than edited, so that a file somebody
    # has half-edited by hand cannot end up with two mode= lines that disagree.
    cat > "${AQ_CONF}" << EOF
# Written by 'aq keys ${mode}'. Edit by hand if you like, or run 'aq keys' again.
#   mode=mac      Mac-style shortcuts. Copy is Command-C.  (the default)
#   mode=windows  The normal Linux ones. Copy is Control-C.
mode=${mode}
EOF

    echo "Keyboard shortcuts are now ${mode^} style."
    if [ "${mode}" = "mac" ]; then
        echo "  Copy is Command-C. Quit is Command-Q. Search is Command-Space."
        echo "  On a PC keyboard, Command is the key next to the space bar."
    else
        echo "  Copy is Control-C. Nothing is remapped; your keyboard is untouched."
    fi

    apply
}

# -----------------------------------------------------------------------------
# apply — restart the service so the new setting takes hold immediately
# -----------------------------------------------------------------------------
apply() {
    if ! command -v systemctl > /dev/null 2>&1; then
        echo "  (No systemctl here, so nothing was restarted. The new setting"
        echo "   takes effect the next time you log in.)"
        return 0
    fi

    # Clear any earlier failure first. A unit that has failed can carry a
    # "stop trying, you have failed too often" mark, and `restart` on a unit
    # wearing that mark does nothing at all — which would make this command
    # print "Applied" over the top of nothing happening. Resetting first is
    # harmless when there is nothing to reset.
    systemctl --user reset-failed "${AQ_SERVICE}" 2> /dev/null || true

    if systemctl --user restart "${AQ_SERVICE}" 2> /dev/null; then
        echo "  Applied. You do not need to log out."
        return 0
    fi

    echo "  Saved, but it could not be applied right now — which is normal if"
    echo "  you are not logged in at the screen (over SSH, for example)."
    echo "  It takes effect the next time you log in."
}

# -----------------------------------------------------------------------------
# status
# -----------------------------------------------------------------------------
status() {
    local mode
    mode="$(read_mode)"

    echo "Keyboard shortcuts"
    echo "  Style     : ${mode^}"
    if [ -r "${AQ_CONF}" ]; then
        echo "  Set in    : ${AQ_CONF}"
    else
        echo "  Set in    : nothing written yet, so the AquariusOS default (Mac) applies"
    fi
    echo "  Rules from: ${AQ_PROFILE_DIR}/${mode}.yaml"

    local desktop="${XDG_CURRENT_DESKTOP:-not set}"
    echo "  Desktop   : ${desktop}"

    if ! command -v systemctl > /dev/null 2>&1; then
        echo "  Running   : cannot tell — there is no systemctl here."
        return 0
    fi

    local state
    state="$(systemctl --user is-active "${AQ_SERVICE}" 2> /dev/null)"
    case "${state}" in
        active)
            echo "  Running   : yes"
            ;;
        inactive | "")
            if [ "${mode}" = "windows" ]; then
                echo "  Running   : no — and that is correct. Windows style means"
                echo "              nothing is remapped, so nothing needs to run."
            else
                echo "  Running   : no."
                echo "              If you are logged in at the screen, something is wrong."
                echo "              Start it again:    systemctl --user start aquarius-keys"
            fi
            ;;
        failed)
            echo "  Running   : NO — it tried to start and failed."
            ;;
        *)
            echo "  Running   : ${state}"
            ;;
    esac

    # -------------------------------------------------------------------------
    # ⚠️ "RUNNING" AND "WORKING" ARE DIFFERENT QUESTIONS. THIS IS THE 2026-09-03
    # LESSON AND IT IS WHY THE REST OF THIS FUNCTION EXISTS.
    # -------------------------------------------------------------------------
    # On the bench the service was running, `systemctl status` said active, and
    # not one shortcut worked — because another program had hold of both
    # keyboards and this one had ended up holding none. It looked exactly like
    # Windows mode. Royce had no way to tell the difference, and should never
    # have to guess again.
    #
    # So the two things that actually matter are printed here: how many
    # keyboards it has hold of, and the last thing that went wrong.
    if [ "${mode}" = "windows" ]; then
        return 0
    fi

    local log grabbed problem
    log="$(journalctl --user -u "${AQ_SERVICE}" -b --no-pager 2> /dev/null)"

    if [ -z "${log}" ]; then
        echo "  Keyboards : cannot tell — there is nothing in this boot's log."
        return 0
    fi

    grabbed="$(printf '%s\n' "${log}" | grep -o 'remapping [0-9]* keyboard(s): .*' | tail -n 1)"
    if [ -n "${grabbed}" ] && [ "${state}" = "active" ]; then
        echo "  Keyboards : ${grabbed#remapping }"
    elif [ "${state}" = "active" ]; then
        echo "  Keyboards : none reported yet. If it has only just started that is"
        echo "              normal; give it five seconds and ask again."
    fi

    problem="$(printf '%s\n' "${log}" | grep -E 'PROBLEM:|resource busy|No device was selected|ERROR:' | tail -n 1)"
    if [ -n "${problem}" ]; then
        echo "  Last issue: ${problem#*aquarius-keys: }"
    fi

    echo ""
    echo "  The last few lines it wrote:"
    printf '%s\n' "${log}" | tail -n 5 | sed 's/^/    /'
    echo ""
    echo "  All of it:  journalctl --user -u aquarius-keys -b"
}


# =============================================================================
# aq display — how big everything on the screen is
# =============================================================================
# TWO DIFFERENT SIZES, AND KEEPING THEM APART IS THE WHOLE POINT OF THIS HELP
# TEXT.
#
#   scale   makes EVERYTHING bigger: your applications, your web browser,
#           DaVinci Resolve, and our bar along with them. It is the same
#           setting GNOME calls "Scale" in its Displays panel, and it is what
#           a 4K monitor normally needs.
#
#   ui      makes ONLY the Aquarius bar, dock, search and panels bigger, and
#           leaves every application exactly as it was. It is a way of asking
#           "is our own design drawn too small?" without changing anything
#           else on the screen.
#
#           It is normally unset, and unset is right. That question was asked
#           and answered on the bench on 2026-09-03 — Royce judged the design
#           on a 55" 4K and the shell's own sizes were moved to match what he
#           approved. So 1 is the size he chose, not a size waiting to be
#           corrected. Set this only if YOU want it different from that.
#
# A person who says "everything is too small" wants `scale`. A person who says
# "the bar is too small but everything else is fine" wants `ui`.
# =============================================================================

display_usage() {
    cat << 'EOF'
aq display — how big things are drawn on your screen

    aq display scale 1.25   Everything on the screen at 125% size. This is the
                            same setting GNOME calls "Scale". Applies now.
    aq display ui 1.15      Only the Aquarius bar and dock at 115% size.
                            Applies at your next login.
    aq display auto         Forget both, and work the size out automatically.
    aq display status       What each screen is set to, and why.

    Sizes between 0.5 and 3 are accepted. The useful ones are 1, 1.25, 1.5,
    1.75 and 2 — the same list GNOME offers.
EOF
}

# Read one setting out of display.conf.
display_get() {
    local key="$1"
    [ -r "${AQ_DISPLAY_CONF}" ] || return 0
    sed -n "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*\([0-9.]*\).*/\1/p" \
        "${AQ_DISPLAY_CONF}" | tail -n 1
}

# Write one setting into display.conf, leaving any other setting alone.
display_set() {
    local key="$1" value="$2" tmp

    mkdir -p "${AQ_CONF_DIR}" || {
        echo "aq: could not create ${AQ_CONF_DIR}." >&2
        return 1
    }

    tmp="${AQ_DISPLAY_CONF}.new.$$"
    {
        cat << 'EOF'
# How big things are drawn on this screen. Written by 'aq display'.
#
#   scale=1.25   everything on the screen at 125% — applications and all
#   ui=1.15      only the Aquarius bar and dock at 115%
#
# Delete a line to go back to working it out automatically, or run
#   aq display auto
EOF
        if [ -r "${AQ_DISPLAY_CONF}" ]; then
            grep -E '^[[:space:]]*(scale|ui|scale\.[^=]*)[[:space:]]*=' "${AQ_DISPLAY_CONF}" \
                | grep -vE "^[[:space:]]*${key}[[:space:]]*=" || true
        fi
        if [ -n "${value}" ]; then
            echo "${key}=${value}"
        fi
    } > "${tmp}" || return 1
    mv -f "${tmp}" "${AQ_DISPLAY_CONF}"
}

# Is this a number we are willing to use?
display_check_number() {
    local value="$1"
    case "${value}" in
        "" | *[!0-9.]* | *.*.*)
            echo "aq: '${value}' is not a number. Try:  aq display ${2} 1.25" >&2
            return 1
            ;;
    esac
    # `awk` rather than bash, because bash cannot compare 1.25 with 0.5.
    if ! awk -v v="${value}" 'BEGIN { exit !(v >= 0.5 && v <= 3.0) }'; then
        echo "aq: ${value} is outside the range this accepts (0.5 to 3)." >&2
        echo "    Below 0.5 nothing is readable; above 3 the bar is taller than" >&2
        echo "    most screens and you could not reach this command to undo it." >&2
        return 1
    fi
}

display_apply_now() {
    if [ ! -x "${AQ_DISPLAY_HELPER}" ]; then
        echo "  (${AQ_DISPLAY_HELPER} is missing from this image, so nothing was"
        echo "   applied. It takes effect at your next login.)"
        return 0
    fi
    if "${AQ_DISPLAY_HELPER}"; then
        return 0
    fi
    echo "  Saved, but it could not be applied right now — which is normal if you"
    echo "  are not in the Aquarius Desktop (over SSH, or in GNOME, where GNOME's"
    echo "  own Displays panel is in charge). It applies at your next login."
}

display_status() {
    echo "Screen size"
    local scale ui
    scale="$(display_get scale)"
    ui="$(display_get ui)"

    if [ -n "${scale}" ]; then
        echo "  Everything: ${scale} — your own setting, from ${AQ_DISPLAY_CONF}"
    else
        echo "  Everything: worked out automatically (no setting of your own)."
        if [ -r "${HOME:-/root}/.config/monitors.xml" ]; then
            echo "              Your GNOME display setting is read first, if it fits."
        fi
    fi

    if [ -n "${ui}" ]; then
        echo "  Aquarius  : ${ui} — the bar and dock only, from ${AQ_DISPLAY_CONF}"
    else
        echo "  Aquarius  : 1 — the bar and dock at the size they were designed."
    fi

    echo ""
    if [ ! -x "${AQ_DISPLAY_HELPER}" ]; then
        return 0
    fi

    local screens
    screens="$("${AQ_DISPLAY_HELPER}" --status 2>&1)"

    # Outside the Aquarius Desktop — over SSH, or in GNOME — there is nothing to
    # ask, and the helper says so. Printing its explanation of a decision it did
    # not make would just be the same sentence twice.
    if [ -z "${screens}" ] || printf '%s' "${screens}" | grep -q "no screens were found"; then
        echo "  No screens to report on. Screen sizes can only be read from"
        echo "  inside the Aquarius Desktop, not over SSH and not from GNOME."
        return 0
    fi

    printf '%s\n' "${screens}"
    echo ""
    echo "  Where each answer comes from:"
    "${AQ_DISPLAY_HELPER}" --explain 2>&1 | sed 's/^/  /' || true
}

display() {
    case "${1:-}" in
        scale)
            display_check_number "${2:-}" scale || return 1
            display_set scale "$2" || return 1
            echo "Everything on the screen is now drawn at ${2} times normal size."
            display_apply_now
            ;;
        ui)
            display_check_number "${2:-}" ui || return 1
            display_set ui "$2" || return 1
            echo "The Aquarius bar and dock are now set to ${2} times normal size."
            echo "  This one takes effect the next time you log in — the bar reads the"
            echo "  setting once, when it starts."
            ;;
        auto)
            display_set scale "" || return 1
            display_set ui "" || return 1
            echo "Both settings are cleared. The size is worked out automatically again."
            display_apply_now
            ;;
        status | "")
            display_status
            ;;
        -h | --help | help)
            display_usage
            ;;
        *)
            echo "aq: '${1}' is not something 'aq display' knows how to do." >&2
            echo >&2
            display_usage >&2
            return 1
            ;;
    esac
}

# =============================================================================
# aq resolve — DaVinci Resolve
# =============================================================================
# WHY THERE IS A WHOLE SUBCOMMAND FOR ONE APPLICATION
#
# Because Resolve is the reason AquariusOS exists, and because it is the one
# application on this computer that does not simply install.
#
# Blackmagic's licence does not let anybody else hand out their installer, so it
# cannot be in the image. And Resolve carries its own copy of a library called
# GLib from 2021 which clashes with any modern Linux's own — the crash that
# makes people give up on Resolve on Linux. AquariusOS answers both at once: it
# runs Resolve inside a small Rocky Linux, the same family Blackmagic build
# against, where the clash cannot happen, and installs the user's own download
# into it.
#
# These commands are the front door to that. The work itself is done by two
# scripts in /usr/libexec, which have the long explanations in their headers:
#
#   aquarius-resolve-install   builds the container, installs Resolve
#   aquarius-resolve-launch    starts it, with the desktop's settings carried in
#
# The plain-language guide is docs/restart/resolve.md.
# =============================================================================

AQ_RESOLVE_ENV=/usr/share/aquarius/resolve/runtime.env
AQ_RESOLVE_INSTALLER=/usr/libexec/aquarius-resolve-install
AQ_RESOLVE_INSTALLER_GUI=/usr/libexec/aquarius-resolve-installer
AQ_RESOLVE_UNINSTALLER_GUI=/usr/libexec/aquarius-resolve-uninstaller
AQ_RESOLVE_LAUNCHER=/usr/libexec/aquarius-resolve-launch

resolve_usage() {
    cat << 'EOF'
aq resolve — DaVinci Resolve on AquariusOS

    aq resolve install [file]
                    Set Resolve up. Give it Blackmagic's download if you have
                    it; leave the file off and it will look in Downloads, and
                    open Blackmagic's page and wait if there is nothing there.

    aq resolve install --gui [file]
                    The same thing in a window instead of this terminal —
                    which is what clicking "Install DaVinci Resolve" in your
                    apps does.

    aq resolve install --dry-run
                    A rehearsal. Walks through all six steps and installs
                    nothing at all. Add --gui to look at the window.

    aq resolve run  Start Resolve. (You can also just click it in your apps.)

    aq resolve status
                    Is it installed, what is it running in, and can it see
                    the graphics card. Start here when something is wrong.

    aq resolve update [file]
                    Install a newer Resolve over the top of the old one, from a
                    new download. Your projects and settings are untouched.

    aq resolve shell
                    A terminal INSIDE the environment Resolve lives in. For
                    poking about; you do not need this in normal use.

    aq resolve remove [--gui] [--purge]
                    Remove Resolve and the environment it ran in. YOUR PROJECTS
                    AND MEDIA ARE NOT IN THERE — they are in your ordinary
                    folders, which that environment only borrows — so this is
                    safe, and it is the right first move when a setup has gone
                    wrong. --gui does it in a window instead of here, which is
                    what "Remove DaVinci Resolve" in your apps opens. --purge
                    also deletes your Resolve settings and project database,
                    which is never the default.

    aq resolve scale [N]
                    How big Resolve's own interface is drawn. With no number it
                    says what it is set to. A number between 0.5 and 3 fixes it
                    there; 'auto' goes back to following your desktop.

WHY A SEPARATE ENVIRONMENT
    Resolve ships its own copy of a library from 2021 that clashes with any
    modern Linux's own, and dies before its window opens. It is the single most
    common reason people give up on Resolve on Linux. Inside its own
    environment the clash cannot happen, and AquariusOS updating cannot break
    it either.

    You will not notice it. Resolve appears in your apps like any other program
    and reads and writes your ordinary folders.

TWO THINGS ABOUT RESOLVE ON LINUX THAT NO OPERATING SYSTEM CAN FIX
    The FREE version cannot open phone or camera MP4 files at all on Linux.
    Even STUDIO opens them with silent audio.
    Both are Blackmagic's licensing, inside their app.

    AquariusOS fixes both from the OUTSIDE: right-click your footage and choose
    "Make Editor-Ready", or run `aq-ingest --help`. Nothing else does this.
EOF
}

# Read the container's name out of the one file that names it.
resolve_container() {
    local name="aquarius-resolve"
    if [ -r "${AQ_RESOLVE_ENV}" ]; then
        # shellcheck source=/dev/null
        . "${AQ_RESOLVE_ENV}"
        name="${AQ_RESOLVE_CONTAINER:-aquarius-resolve}"
    fi
    printf '%s' "${name}"
}

resolve_installed() {
    command -v podman > /dev/null 2>&1 \
        && podman container exists "$(resolve_container)" 2> /dev/null
}

resolve_status() {
    local container record
    container="$(resolve_container)"
    record="${XDG_DATA_HOME:-${HOME}/.local/share}/aquarius/resolve/installed.env"

    echo "DaVinci Resolve"

    if [ ! -r "${AQ_RESOLVE_ENV}" ]; then
        echo "  This copy of AquariusOS has no Resolve support files. That is a"
        echo "  fault in the operating system, not in anything you did."
        return 1
    fi
    # shellcheck source=/dev/null
    . "${AQ_RESOLVE_ENV}"

    echo "  Runs in  : its own environment, called '${container}'"
    echo "  Built from: ${AQ_RESOLVE_RUNTIME_IMAGE}:${AQ_RESOLVE_RUNTIME_TAG}"

    if ! resolve_installed; then
        echo "  Installed: NO — the container does not exist yet."
        echo ""
        echo "  To set it up, open your apps and click \"Install DaVinci Resolve\","
        echo "  or run:   aq resolve install"
        return 0
    fi

    echo "  Installed: yes"

    if [ -r "${record}" ]; then
        # shellcheck source=/dev/null
        . "${record}"
        echo "  Set up on: ${AQ_RESOLVE_INSTALLED_AT:-unknown}"
        echo "  From     : ${AQ_RESOLVE_SOURCE:-unknown}"
        echo "  Runtime  : ${AQ_RESOLVE_DIGEST:-unknown}"
        echo "  Graphics : ${AQ_RESOLVE_GPU_METHOD:-unknown}"
    fi

    # --------------------------------------------------------------------------
    # ⚠️ "INSTALLED" AND "WORKING" ARE DIFFERENT QUESTIONS.
    # --------------------------------------------------------------------------
    # This is the same lesson `aq keys status` learned on 2026-09-03: a thing can
    # be present, and reported present, and do nothing. For Resolve the question
    # that actually matters is whether the container can see the graphics card,
    # because a container that cannot produces "GPU processing mode is
    # unsupported" — a message that sounds like a broken graphics card and is
    # not one.
    echo ""
    echo "  Can it see the graphics card?"

    if [ -e /proc/driver/nvidia/version ]; then
        local nvv
        nvv="$(sed -n 's/^NVRM version: NVIDIA UNIX.* Kernel Module *\([0-9.]*\).*/\1/p' \
            /proc/driver/nvidia/version 2> /dev/null | head -1)"
        echo "    This computer : NVIDIA${nvv:+, driver ${nvv}}"
        local spec=""
        for f in /var/run/cdi/nvidia.yaml /run/cdi/nvidia.yaml /etc/cdi/nvidia.yaml; do
            [ -r "${f}" ] && {
                spec="${f}"
                break
            }
        done
        if [ -n "${spec}" ]; then
            echo "    Description   : ${spec}"
        else
            echo "    Description   : none written on this machine."
            echo "                    Resolve may say its GPU mode is unsupported. Fix:"
            echo "                      sudo systemctl start nvidia-cdi-refresh.service"
            echo "                    or, if there is no such service on this machine:"
            echo "                      sudo systemctl start aquarius-resolve-cdi.service"
            echo "                    then:  aq resolve remove  and set it up again."
        fi
    elif [ -e /dev/dri ]; then
        echo "    This computer : AMD or Intel."
        echo "                    Resolve on Linux needs NVIDIA for its GPU work."
        echo "                    On AMD it needs ROCm, which is not set up in the"
        echo "                    container yet; on Intel Blackmagic support it at all."
        echo "                    Expect 'GPU processing mode is unsupported'."
    else
        echo "    This computer : no graphics card could be found at all."
    fi

    # The real answer: ask INSIDE the container. Anything else is a guess about
    # what the container can see, made from outside it.
    echo ""
    echo "    Asking inside the container..."
    if distrobox enter --name "${container}" -- \
        bash -lc 'command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi --query-gpu=name,driver_version --format=csv,noheader 2>/dev/null || echo "(no nvidia-smi in there — normal on AMD/Intel)"' \
        2> /dev/null | sed 's/^/      /'; then
        :
    else
        echo "      Could not enter the container. Try:  aq resolve remove"
        echo "      and set it up again."
    fi

    echo ""
    echo "    If Resolve is running, the answer that counts is its own:"
    echo "      Preferences → System → Memory and GPU → GPU processing mode"
    echo "      It should say CUDA, with your card listed underneath."
}

# =============================================================================
# aq resolve scale — how big Resolve's own interface is drawn
# =============================================================================
# WHY THIS EXISTS AND `aq display` DOES NOT COVER IT
#
# Resolve is an X11 application, and X11 has no idea what a screen scale is. On
# a Wayland desktop it runs through XWayland, which tells every X11 program the
# screen is at 100% no matter what the screen is really at. So a desktop at 125%
# draws everything correctly except Resolve, which comes out small — exactly
# what Royce saw on the 4K bench on 2026-09-04.
#
# The launcher fixes it by reading the session's scale and handing it to Resolve
# on the way in, so normally there is nothing to do here. This command is for the
# cases where the automatic answer is not the one you want:
#
#   aq resolve scale        what is it set to, and where that answer came from
#   aq resolve scale 1.5    fix it there, whatever the rest of the desktop does
#   aq resolve scale auto   go back to following the desktop
#
# It takes effect the next time Resolve starts. Nothing is asked of a running
# Resolve, because Qt reads its scale once, when it starts, and nothing can
# change it afterwards.
# =============================================================================

AQ_RESOLVE_CONF="${AQ_CONF_DIR}/resolve.conf"

resolve_scale_get() {
    [ -r "${AQ_RESOLVE_CONF}" ] || return 0
    sed -n 's/^[[:space:]]*scale[[:space:]]*=[[:space:]]*\([0-9.]*\).*/\1/p' \
        "${AQ_RESOLVE_CONF}" | tail -n 1
}

resolve_scale_set() {
    local value="$1" tmp
    mkdir -p "${AQ_CONF_DIR}" || {
        echo "aq: could not create ${AQ_CONF_DIR}." >&2
        return 1
    }
    tmp="${AQ_RESOLVE_CONF}.new.$$"
    {
        cat << 'EOF'
# How DaVinci Resolve is started. Written by 'aq resolve scale'.
#
#   scale=1.5                    Resolve's interface at 150%, whatever the rest
#                                of the desktop is at. Delete the line, or run
#                                'aq resolve scale auto', to follow the desktop.
#
#   qt_variable=device-pixel-ratio
#                                Use Resolve's OTHER scaling variable instead of
#                                the default one. Only worth trying if the
#                                default makes the interface look wrong — see
#                                docs/restart/resolve.md.
EOF
        if [ -r "${AQ_RESOLVE_CONF}" ]; then
            grep -E '^[[:space:]]*(qt_variable)[[:space:]]*=' "${AQ_RESOLVE_CONF}" || true
        fi
        if [ -n "${value}" ]; then
            echo "scale=${value}"
        fi
    } > "${tmp}" || return 1
    mv -f "${tmp}" "${AQ_RESOLVE_CONF}"
}

resolve_scale_status() {
    local mine session
    mine="$(resolve_scale_get)"
    echo "DaVinci Resolve's interface size"
    if [ -n "${mine}" ]; then
        echo "  ${mine} — your own setting, from ${AQ_RESOLVE_CONF}"
        echo "  It stays there whatever the rest of the desktop is set to."
    else
        session="$(display_effective_scale)"
        echo "  ${session} — following the rest of the desktop (no setting of your own)."
        echo "  Change the desktop with 'aq display scale', or fix Resolve on its"
        echo "  own with 'aq resolve scale 1.5'."
    fi
    echo ""
    echo "  Resolve reads this when it starts, so it applies to the NEXT time you"
    echo "  open it. Resolve's own Preferences → User → UI Settings → Interface"
    echo "  Scale still works too, and is the better tool for fine adjustment."
}

# The one number the launcher will use. Asked of the same helper, so this and
# Resolve can never give different answers.
display_effective_scale() {
    local n=""
    if [ -x "${AQ_DISPLAY_HELPER}" ]; then
        n="$("${AQ_DISPLAY_HELPER}" --effective-scale 2> /dev/null)"
    fi
    case "${n}" in
        '' | *[!0-9.]* | *.*.*) printf '1' ;;
        *) printf '%s' "${n}" ;;
    esac
}

resolve_scale() {
    case "${1:-}" in
        "" | status) resolve_scale_status ;;
        auto)
            resolve_scale_set "" || return 1
            echo "Resolve now follows the rest of the desktop, which is at $(display_effective_scale)."
            echo "  It applies the next time you open Resolve."
            ;;
        *)
            display_check_number "$1" scale || return 1
            resolve_scale_set "$1" || return 1
            echo "Resolve's interface is now set to ${1} times normal size."
            echo "  It applies the next time you open Resolve. If it is already"
            echo "  running, close it and open it again."
            ;;
    esac
}

resolve_shell() {
    local container
    container="$(resolve_container)"
    if ! resolve_installed; then
        echo "aq: DaVinci Resolve is not set up on this computer yet." >&2
        echo "    Run:  aq resolve install" >&2
        return 1
    fi
    echo "You are about to be inside the environment Resolve lives in."
    echo "Your home folder is the same folder in there. 'exit' brings you back."
    echo ""
    exec distrobox enter --name "${container}"
}

resolve_remove() {
    # ⚠️ THE REMOVING ITSELF IS NOT HERE ANY MORE. It moved into
    # /usr/libexec/aquarius-resolve-install --remove on 2026-09-04, when the
    # "Remove DaVinci Resolve" window was added, for the same reason installing
    # lives there: one place owns the container, and a window and a terminal
    # doing the same job must not be two implementations of it.
    #
    #   aq resolve remove              ask here, then remove
    #   aq resolve remove --gui        the window instead of this terminal
    #   aq resolve remove --purge      also delete your Resolve settings and
    #                                  project database. Never the default.
    #   aq resolve remove --dry-run    a rehearsal; removes nothing.
    local want_gui=0 arg
    local -a passthrough=()
    for arg in "$@"; do
        if [ "${arg}" = "--gui" ]; then
            want_gui=1
        else
            passthrough+=("${arg}")
        fi
    done

    if [ "${want_gui}" = "1" ]; then
        [ -x "${AQ_RESOLVE_UNINSTALLER_GUI}" ] || {
            echo "aq: ${AQ_RESOLVE_UNINSTALLER_GUI} is missing from this system." >&2
            return 1
        }
        exec "${AQ_RESOLVE_UNINSTALLER_GUI}" ${passthrough[@]+"${passthrough[@]}"}
    fi

    [ -x "${AQ_RESOLVE_INSTALLER}" ] || {
        echo "aq: ${AQ_RESOLVE_INSTALLER} is missing from this system." >&2
        return 1
    }
    "${AQ_RESOLVE_INSTALLER}" --remove ${passthrough[@]+"${passthrough[@]}"}
}

resolve() {
    case "${1:-}" in
        install)
            shift
            # --gui is the only argument `aq` itself acts on. Everything else is
            # handed straight to whichever installer runs, so there is one place
            # arguments are understood and it is not this file.
            local want_gui=0 arg
            local -a passthrough=()
            for arg in "$@"; do
                if [ "${arg}" = "--gui" ]; then
                    want_gui=1
                else
                    passthrough+=("${arg}")
                fi
            done

            if [ "${want_gui}" = "1" ]; then
                [ -x "${AQ_RESOLVE_INSTALLER_GUI}" ] || {
                    echo "aq: ${AQ_RESOLVE_INSTALLER_GUI} is missing from this system." >&2
                    return 1
                }
                exec "${AQ_RESOLVE_INSTALLER_GUI}" ${passthrough[@]+"${passthrough[@]}"}
            fi

            [ -x "${AQ_RESOLVE_INSTALLER}" ] || {
                echo "aq: ${AQ_RESOLVE_INSTALLER} is missing from this system." >&2
                return 1
            }
            "${AQ_RESOLVE_INSTALLER}" ${passthrough[@]+"${passthrough[@]}"}
            ;;
        update)
            shift
            [ -x "${AQ_RESOLVE_INSTALLER}" ] || {
                echo "aq: ${AQ_RESOLVE_INSTALLER} is missing from this system." >&2
                return 1
            }
            # Updating is installing again over the top: Blackmagic's installer
            # replaces what is in /opt/resolve and leaves your settings and
            # projects, which live in your home folder, alone. There is nothing
            # for a separate update path to do that this does not.
            "${AQ_RESOLVE_INSTALLER}" --update "$@"
            ;;
        run)
            shift
            [ -x "${AQ_RESOLVE_LAUNCHER}" ] || {
                echo "aq: ${AQ_RESOLVE_LAUNCHER} is missing from this system." >&2
                return 1
            }
            exec "${AQ_RESOLVE_LAUNCHER}" "$@"
            ;;
        status | "") resolve_status ;;
        scale)
            shift
            resolve_scale "${1:-}"
            ;;
        shell) resolve_shell ;;
        remove | uninstall)
            shift
            resolve_remove "$@"
            ;;
        -h | --help | help) resolve_usage ;;
        *)
            echo "aq: '${1}' is not something 'aq resolve' knows how to do." >&2
            echo >&2
            resolve_usage >&2
            return 1
            ;;
    esac
}

# aq ingest — make camera files open in a video editor
# =============================================================================
# WHY THIS EXISTS AT ALL, IN ONE PARAGRAPH
#
# The free DaVinci Resolve on Linux cannot open a file from a camera or a
# phone. Not "opens it badly" — cannot. H.264 and H.265 decoding is Studio-only
# and NVIDIA-only, and AAC audio is not supported in any version, at all. Every
# person who tries Resolve on Linux hits this on their first import, and most
# of them conclude Linux is not for editing. `aq-ingest` fixes it at the
# operating-system level: it rewraps the sound to a format Resolve understands
# and makes an edit-friendly copy of the picture, so the file simply opens.
#
# THIS SUBCOMMAND IS A FRONT DOOR, NOT A SECOND IMPLEMENTATION. All the work is
# in /usr/bin/aq-ingest, which is the same program the right-click menu in
# Files runs. Everything you can pass to that, you can pass here — including
# --dry-run, which prints the plan and writes nothing.
# =============================================================================

AQ_INGEST_CMD="/usr/bin/aq-ingest"
AQ_INGEST_WATCH="/usr/libexec/aquarius-ingest-watch"

ingest_usage() {
    cat << 'EOF'
aq ingest — make camera files open in a video editor

    aq ingest FILE...          Convert files or whole folders. Editor-friendly
                               copies appear in an "EditorReady" folder beside
                               the originals, which are never changed.
    aq ingest --dry-run FILE   Say what would happen. Write nothing.

    aq ingest watch on [FOLDER]
                               Watch a folder (~/Videos/Ingest by default) and
                               convert anything dropped into it automatically.
                               Off until you ask for it.
    aq ingest watch off        Stop watching.
    aq ingest watch status     Is it watching, what, and what happened last.

    The same job is on the right-click menu in Files, as "Make Editor-Ready".
    For everything aq-ingest can do:  aq-ingest --help
EOF
}

ingest_watch() {
    if [ ! -x "${AQ_INGEST_WATCH}" ]; then
        echo "aq: ${AQ_INGEST_WATCH} is missing from this copy of AquariusOS." >&2
        echo "    That is a fault in the operating system, not in anything you typed." >&2
        return 1
    fi
    case "${1:-}" in
        on)
            # `aq ingest watch on` with no folder means the default one, and
            # --enable takes an optional argument, so the two cases are written
            # out rather than smuggled through an unquoted expansion.
            if [ -n "${2:-}" ]; then
                "${AQ_INGEST_WATCH}" --enable "$2"
            else
                "${AQ_INGEST_WATCH}" --enable
            fi
            ;;
        off) "${AQ_INGEST_WATCH}" --disable ;;
        status | "") "${AQ_INGEST_WATCH}" --status ;;
        -h | --help | help) ingest_usage ;;
        *)
            echo "aq: '${1}' is not something 'aq ingest watch' knows how to do." >&2
            echo "    It understands: on, off, status." >&2
            return 1
            ;;
    esac
}

ingest() {
    if [ ! -x "${AQ_INGEST_CMD}" ]; then
        echo "aq: ${AQ_INGEST_CMD} is missing from this copy of AquariusOS." >&2
        echo "    That is a fault in the operating system, not in anything you typed." >&2
        return 1
    fi

    case "${1:-}" in
        "" | -h | --help | help)
            ingest_usage
            return 0
            ;;
        watch)
            shift
            ingest_watch "$@"
            return
            ;;
    esac

    # Everything else is handed straight through, flags and all, so that
    # aq-ingest's own options keep working without this file having to know
    # what they are.
    "${AQ_INGEST_CMD}" "$@"
}

# =============================================================================
# aq apps — the creator apps from Flathub
# =============================================================================
# WHAT THIS IS FOR
#
# AquariusOS suggests sixteen things from Flathub: eleven apps and five OBS
# plug-ins that come with OBS Studio. The chooser window at the first login is
# how most people will pick from them. This is the same job in a terminal, for
# afterwards: what did I end up with, and give me the one I skipped.
#
# IT DOES NOT KEEP ITS OWN LIST. Every answer here comes from asking
# /usr/libexec/aquarius-flatpak-preinstall --catalog, which reads the one list
# the operating system ships. There is no second copy to fall out of step.
#
# WHY IT NEVER SAYS sudo. Installing for the whole computer is a thing Flatpak
# already knows how to ask permission for: it hands the job to a small system
# service, and the desktop asks you for your password the same way the app
# store does. So `aq apps install` is an ordinary command run as an ordinary
# person. Whole-computer rather than just-for-me matters, and it is not a
# detail: the permissions that let OBS reach your camera and capture card only
# apply to whole-computer installs.
# =============================================================================

AQ_APPS_HELPER="/usr/libexec/aquarius-flatpak-preinstall"
AQ_APPS_SERVICE="aquarius-flatpak-preinstall.service"
AQ_APPS_STAMP="/etc/aquarius/flatpak-preinstall-done"

apps_usage() {
    cat << 'EOF'
aq apps — the creator apps that come from Flathub

    aq apps list        Every app AquariusOS suggests, and whether you have it.
    aq apps status      How many you have, and what to do if some are missing.
    aq apps install ID [ID...]
                        Install one or more of them. Use the ID from the left
                        of 'aq apps list'. Any plug-ins an app needs come with
                        it. You will be asked for your password once.
    aq apps install --all
                        Install everything on the list. This is the big one —
                        roughly ten gigabytes.

    Nothing here is compulsory. An app you never install costs you nothing, and
    an app you uninstall stays uninstalled — AquariusOS will not put it back.
EOF
}

# The one source of truth, asked once per command.
apps_catalog() {
    if [ ! -x "${AQ_APPS_HELPER}" ]; then
        echo "aq: ${AQ_APPS_HELPER} is missing from this copy of AquariusOS." >&2
        echo "    That is a fault in the operating system, not in anything you typed." >&2
        return 1
    fi
    "${AQ_APPS_HELPER}" --catalog
}

# What is on this computer right now. Asked of Flatpak, never remembered.
apps_have() { flatpak list --system --columns=application 2> /dev/null || true; }

apps_list() {
    local cat have
    cat="$(apps_catalog)" || return 1
    have="$(apps_have)"
    # The two lists are fed to awk as one stream with a marker between them,
    # rather than through -v, because an awk variable cannot hold newlines.
    printf '%s\n===\n%s\n' "${have}" "${cat}" | awk -F'\t' '
        !seen && $0 == "===" { seen = 1; next }
        !seen { if ($0 != "") got[$0] = 1; next }
        # Plug-ins are not choices — they arrive with the app they belong to.
        $6 == "runtime:no" {
            printf "  %-11s %-38s %s\n", (got[$1] ? "installed" : "-"), $1, $2
            printf "  %-11s %-38s %s\n", "", "", $3
        }
    '
    echo
    echo "  To install one:  aq apps install <the middle column>"
}

apps_status() {
    local cat have total got id
    cat="$(apps_catalog)" || return 1
    have="$(apps_have)"
    total=0
    got=0
    while IFS=$'\t' read -r id _; do
        [ -n "${id}" ] || continue
        total=$((total + 1))
        printf '%s\n' "${have}" | grep -qx "${id}" && got=$((got + 1))
    done <<< "${cat}"

    echo "Creator apps"
    echo "  ${got} of the ${total} apps and plug-ins AquariusOS suggests are installed."

    # Did the "install the lot" service ever run, and how did it end? On a
    # normal machine the answer is "no", because the chooser does the job.
    if systemctl is-failed --quiet "${AQ_APPS_SERVICE}" 2> /dev/null; then
        echo "  The bulk installer FAILED. What it said:"
        systemctl status --no-pager --lines=5 "${AQ_APPS_SERVICE}" 2> /dev/null \
            | sed 's/^/    /'
    elif [ -r "${AQ_APPS_STAMP}" ]; then
        echo "  The bulk installer has run and finished."
    else
        echo "  The bulk installer has not run (normal — the chooser installs what you pick)."
    fi

    if [ "${got}" -lt "${total}" ]; then
        echo
        echo "  Missing something you wanted? Either:"
        echo "      aq apps install <id>              just that one"
        echo "      sudo flatpak preinstall -y --system   everything on the list"
    fi
}

apps_install() {
    local cat have refs=() id line want ok_id
    [ "$#" -gt 0 ] || { apps_usage; return 1; }

    if [ "$1" = "--all" ]; then
        # Flatpak's own command, because it is the one that honours "an app you
        # removed on purpose stays removed". Ours never would.
        echo "Installing everything AquariusOS suggests. This is a large download."
        flatpak preinstall -y --system
        return $?
    fi

    cat="$(apps_catalog)" || return 1

    for want in "$@"; do
        ok_id=0
        while IFS=$'\t' read -r id _ _ _ _ rt req branch; do
            [ -n "${id}" ] || continue
            # The app itself, named exactly.
            if [ "${id}" = "${want}" ]; then
                if [ "${rt}" = "runtime:yes" ]; then
                    echo "aq: ${want} is a plug-in, not an app. It is installed" >&2
                    echo "    automatically with ${req#requires:}." >&2
                    return 1
                fi
                refs+=("${id}")
                ok_id=1
            fi
            # And any plug-in that belongs to it, with the exact version line
            # the list names — a plug-in on the wrong branch installs nothing
            # and says nothing.
            if [ "${req}" = "requires:${want}" ]; then
                refs+=("${id}//${branch#branch:}")
            fi
        done <<< "${cat}"

        if [ "${ok_id}" -eq 0 ]; then
            echo "aq: '${want}' is not one of the apps AquariusOS suggests." >&2
            echo "    'aq apps list' shows the ones it does." >&2
            return 1
        fi
    done

    # Already here? Leave it alone and say so, rather than making Flatpak say it.
    have="$(apps_have)"
    line=()
    for id in "${refs[@]}"; do
        if printf '%s\n' "${have}" | grep -qx "${id%%//*}"; then
            echo "  ${id%%//*} is already installed."
        else
            line+=("${id}")
        fi
    done
    if [ "${#line[@]}" -eq 0 ]; then
        echo "Nothing to do — everything you asked for is already here."
        return 0
    fi

    echo "Installing: ${line[*]}"
    echo "You will be asked for your password once, by the desktop itself."
    flatpak install -y --system flathub "${line[@]}"
}

# -----------------------------------------------------------------------------
# aq login — which of the two login screens this computer starts with
# -----------------------------------------------------------------------------
# WHAT A "LOGIN SCREEN" IS HERE, because the word covers two different things:
#
#   THE LOGIN SCREEN   what you see straight after the computer starts, before
#                      anybody has logged in. There are two on this machine and
#                      exactly one may be switched on.
#
#   THE LOCK SCREEN    what you see when you walk away and come back. That is
#                      drawn by your desktop, inside your session, and this
#                      command has nothing to do with it.
#
# The two login screens:
#
#   gdm      GNOME's. What AquariusOS starts with. Plain, and completely
#            reliable. It has an accessibility menu, which the other one does
#            not yet.
#   greetd   Ours. The Ice wallpaper, the Aquarius mark, a clock, a password
#            box, and a choice of desktop — drawn by the Aquarius Shell itself.
#
# ⚠️ EXACTLY ONE MAY BE SWITCHED ON. systemd enforces that through a link called
# display-manager.service, and two login managers both claiming it is one of the
# classic ways to end up at a black screen with no way in. So this command turns
# one off and the other on, in that order, and refuses to do half the job.
#
# THE WAY BACK IS ALWAYS THERE. If the AquariusOS login screen misbehaves:
#   1. press Ctrl+Alt+F3 for a text login, log in there
#   2. sudo aq login use gdm
#   3. sudo systemctl reboot
# And if the graphical screen fails to start at all, it falls through to a plain
# text login by itself rather than leaving you stuck — see
# /usr/libexec/aquarius-greeter.
AQ_GREETER_LAUNCHER="/usr/libexec/aquarius-greeter"
AQ_GREETD_CONF="/etc/greetd/config.toml"

login_usage() {
    cat << 'EOF'
aq login — which login screen this computer starts with

USAGE
    aq login status        Which one is switched on, and is the other ready.
    aq login use greetd    Switch to the AquariusOS login screen.
    aq login use gdm       Switch back to GNOME's.

Either 'use' command needs an administrator, so put 'sudo' in front of it, and
neither takes effect until you restart.

IF SOMETHING GOES WRONG
    Press Ctrl+Alt+F3 for a plain text login. Log in there and run:
        sudo aq login use gdm
        sudo systemctl reboot
EOF
}

login_which() {
    # `systemctl is-enabled` is asked twice rather than reading the
    # display-manager.service link, because the link is systemd's business and
    # the question we are actually asking is "which one is switched on".
    if systemctl is-enabled greetd.service > /dev/null 2>&1; then
        echo greetd
    elif systemctl is-enabled gdm.service > /dev/null 2>&1; then
        echo gdm
    else
        echo none
    fi
}

login_status() {
    local now
    now="$(login_which)"

    case "${now}" in
        greetd)
            echo "This computer starts with the AQUARIUS login screen (greetd)."
            echo "To go back to GNOME's:  sudo aq login use gdm"
            ;;
        gdm)
            echo "This computer starts with GNOME's login screen (GDM)."
            echo "To try the AquariusOS one:  sudo aq login use greetd"
            ;;
        *)
            echo "NO login screen is switched on. That is not normal — this"
            echo "computer would start to a text prompt."
            echo "To fix it:  sudo aq login use gdm"
            ;;
    esac

    echo
    echo "Is the AquariusOS login screen ready to switch on?"
    local ready=1
    if [ -x "${AQ_GREETER_LAUNCHER}" ]; then
        echo "  yes  ${AQ_GREETER_LAUNCHER} is here"
    else
        echo "  NO   ${AQ_GREETER_LAUNCHER} is missing"
        ready=0
    fi
    if [ -r "${AQ_GREETD_CONF}" ]; then
        echo "  yes  ${AQ_GREETD_CONF} is here"
    else
        echo "  NO   ${AQ_GREETD_CONF} is missing"
        ready=0
    fi
    if [ -r /usr/share/aquarius/shell/greeter/greeter.qml ]; then
        echo "  yes  the login screen itself is installed"
    else
        echo "  NO   /usr/share/aquarius/shell/greeter/greeter.qml is missing."
        echo "       Switching to greetd would give the plain text login screen."
        ready=0
    fi

    if [ "${ready}" -eq 1 ]; then
        echo
        echo "Everything it needs is here."
    fi
}

login_use() {
    local wanted="${1:-}"
    local turn_off

    case "${wanted}" in
        greetd) turn_off="gdm" ;;
        gdm)    turn_off="greetd" ;;
        *)
            echo "aq: 'aq login use' takes either 'greetd' or 'gdm'." >&2
            echo "    greetd is the AquariusOS login screen; gdm is GNOME's." >&2
            return 1
            ;;
    esac

    if [ "$(id -u)" -ne 0 ]; then
        echo "aq: changing the login screen needs an administrator." >&2
        echo "    Try:  sudo aq login use ${wanted}" >&2
        return 1
    fi

    if [ "${wanted}" = "greetd" ] && [ ! -x "${AQ_GREETER_LAUNCHER}" ]; then
        echo "aq: ${AQ_GREETER_LAUNCHER} is not on this computer, so there is" >&2
        echo "    no AquariusOS login screen to switch to. Nothing changed." >&2
        return 1
    fi

    # Off first, then on. The other order would leave both switched on for a
    # moment, and if the second command failed it would leave both switched on
    # for good — which is the black-screen case.
    systemctl disable "${turn_off}.service" > /dev/null 2>&1 || true
    if ! systemctl enable "${wanted}.service"; then
        echo "aq: could not switch ${wanted} on. Putting ${turn_off} back." >&2
        systemctl enable "${turn_off}.service" > /dev/null 2>&1 || true
        return 1
    fi

    echo "Done. This computer will start with ${wanted} from now on."
    echo
    if [ "${wanted}" = "greetd" ]; then
        echo "Restart to see it:  sudo systemctl reboot"
        echo
        echo "WHAT TO EXPECT"
        echo "  The Ice wallpaper, a clock, and a card with your name and a"
        echo "  password box. Enter signs in. The pill underneath says which"
        echo "  desktop is about to start; the left and right arrow keys change"
        echo "  it, so GNOME is one keypress away."
        echo
        echo "IF IT MISBEHAVES"
        echo "  It falls back to a plain text login screen on its own rather"
        echo "  than leaving you stuck. From there, or from Ctrl+Alt+F3:"
        echo "      sudo aq login use gdm"
        echo "      sudo systemctl reboot"
    else
        echo "Restart to see it:  sudo systemctl reboot"
    fi
}

login() {
    case "${1:-}" in
        "" | -h | --help | help) login_usage ;;
        status) login_status ;;
        use)
            shift
            login_use "${1:-}"
            ;;
        *)
            echo "aq: '${1}' is not something 'aq login' knows how to do." >&2
            echo "    It understands: status, use." >&2
            return 1
            ;;
    esac
}

apps() {
    case "${1:-}" in
        "" | -h | --help | help) apps_usage ;;
        list) apps_list ;;
        status) apps_status ;;
        catalog) apps_catalog ;;
        install)
            shift
            apps_install "$@"
            ;;
        *)
            echo "aq: '${1}' is not something 'aq apps' knows how to do." >&2
            echo "    It understands: list, status, install." >&2
            return 1
            ;;
    esac
}

# -----------------------------------------------------------------------------
# Which subcommand?
# -----------------------------------------------------------------------------
case "${1:-}" in
    "" | -h | --help | help)
        usage
        ;;
    --version | -V)
        if [ -r /usr/share/aquarius/image-info.json ]; then
            sed -n 's/.*"version-pretty"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
                /usr/share/aquarius/image-info.json
        else
            echo "AquariusOS (version unknown — /usr/share/aquarius/image-info.json is missing)"
        fi
        ;;
    display)
        display "${2:-}" "${3:-}"
        ;;
    resolve)
        shift
        resolve "$@"
        ;;
    ingest)
        shift
        ingest "$@"
        ;;
    apps)
        shift
        apps "$@"
        ;;
    login)
        shift
        login "$@"
        ;;
    keys)
        case "${2:-}" in
            mac | windows) set_mode "$2" ;;
            status | "") status ;;
            -h | --help | help) keys_usage ;;
            *)
                echo "aq: '${2}' is not something 'aq keys' knows how to do." >&2
                echo >&2
                keys_usage >&2
                exit 1
                ;;
        esac
        ;;
    *)
        echo "aq: '${1}' is not an aq command." >&2
        echo >&2
        usage >&2
        exit 1
        ;;
esac
