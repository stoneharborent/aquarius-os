# =============================================================================
# nautilus.portal — tells the desktop that the Files app can BE the file picker
# =============================================================================
# WHAT THIS FILE IS FOR, IN ONE SENTENCE
#   It is the note that says "the Files app knows how to answer Open and Save
#   dialogs", so the rest of the desktop is allowed to send them to it.
#
# WHY WE HAVE TO WRITE IT OURSELVES
#   Every program that can answer a portal request ships a small file like this
#   one, in /usr/share/xdg-desktop-portal/portals/. Nautilus — the Files app —
#   is the exception. Since version 49 it really does answer Open and Save
#   requests (verified in its source, src/nautilus-portal.c), but its
#   developers never shipped a .portal file for it, because on GNOME nobody
#   needs one: GNOME's own portal back end has Nautilus's address written into
#   its code and calls it directly.
#
#   We are not GNOME, so nothing calls Nautilus for us. Without this file,
#   xdg-desktop-portal has no idea the Files app can do the job, and there is
#   no way to ask for it. Writing this file is how we ask.
#
#   Checked against the Fedora 44 packages on 2026-09-14:
#     nautilus 50.3   ships NO .portal file of its own — confirmed
#     nautilus 50.3   DOES answer org.freedesktop.impl.portal.FileChooser
#
# -----------------------------------------------------------------------------
# THE THREE LINES, AND WHAT EACH ONE MEANS
# -----------------------------------------------------------------------------
# DBusName    Where to find the Files app on the desktop's internal message
#             bus. If Files is not running when a dialog is needed, the bus
#             starts it automatically, using the instructions in
#             /usr/share/dbus-1/services/org.gnome.Nautilus.service. That file
#             comes from the nautilus package; build step 55 checks it is there,
#             because without it the picker would never open.
#
# Interfaces  The list of jobs Files is offering to do. It is exactly one job:
#             the file chooser. Files is NOT offering to record the screen,
#             print, or show notifications, and listing only one job here is
#             what stops anything else being sent to it by mistake.
#
#             ⚠️ This list is not decoration. xdg-desktop-portal reads it and
#             SKIPS any back end that does not name the job being asked for —
#             silently. Getting this line wrong means dialogs stop appearing
#             with no error anywhere.
#
# UseIn       Which desktop this offer applies to. "aquarius" is the first name
#             in XDG_CURRENT_DESKTOP, which /usr/bin/aquarius-session sets to
#             Aquarius:wlroots. Naming it keeps this file from volunteering
#             itself inside the GNOME session, which has its own arrangement
#             and must not be disturbed.
#
# The line that actually chooses Files is not here — it is the FileChooser line
# in ../aquarius-portals.conf. This file only says what is possible; that one
# says what we want.
# =============================================================================

[portal]
DBusName=org.gnome.Nautilus
Interfaces=org.freedesktop.impl.portal.FileChooser;
UseIn=aquarius
