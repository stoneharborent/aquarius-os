# ==============================================================================
# Aquarius Dark — the AquariusOS colour scheme for KDE Plasma
# ==============================================================================
# Installed to /usr/share/color-schemes/AquariusDark.colors, which is where KDE
# looks for system-wide colour schemes. Users see it in
# System Settings > Colors as "Aquarius Dark".
#
# Every number below comes from ../../../../branding/tokens.md. KDE writes
# colours as "red,green,blue" in plain decimal 0-255 instead of hex, so the
# token #8AB4FF is written here as 138,180,255. If you change a colour, change
# it in tokens.md FIRST and then convert it here.
#
# Token cheat sheet (hex -> what KDE wants):
#   void            #06070C -> 6,7,12          text-1   #EDEFF7 -> 237,239,247
#   surface-1       #10121C -> 16,18,28        text-2   #8A90A6 -> 138,144,166
#   surface-2       #161A29 -> 22,26,41        text-3   #565C72 -> 86,92,114
#   surface-3       #1D2236 -> 29,34,54        success  #55D6A5 -> 85,214,165
#   starlight       #8AB4FF -> 138,180,255     warning  #E6C069 -> 230,192,105
#   on-accent       #080B14 -> 8,11,20         danger   #FF7A85 -> 255,122,133
#
# Format reference: KDE's own BreezeDark.colors (KDE/breeze, colors/).
# SPDX-License-Identifier: LGPL-2.0-or-later  (format inherited from Breeze)
# ==============================================================================

[ColorEffects:Disabled]
Color=56,56,56
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color=112,111,110
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

# Buttons sit one layer up from the window: surface-2.
[Colors:Button]
BackgroundAlternate=47,59,85
BackgroundNormal=22,26,41
DecorationFocus=138,180,255
DecorationHover=138,180,255
ForegroundActive=138,180,255
ForegroundInactive=138,144,166
ForegroundLink=138,180,255
ForegroundNegative=255,122,133
ForegroundNeutral=230,192,105
ForegroundNormal=237,239,247
ForegroundPositive=85,214,165
ForegroundVisited=142,132,232

# "Complementary" is used for full-bleed areas like the lock screen. Deepest.
[Colors:Complementary]
BackgroundAlternate=16,18,28
BackgroundNormal=6,7,12
DecorationFocus=138,180,255
DecorationHover=138,180,255
ForegroundActive=138,180,255
ForegroundInactive=138,144,166
ForegroundLink=138,180,255
ForegroundNegative=255,122,133
ForegroundNeutral=230,192,105
ForegroundNormal=237,239,247
ForegroundPositive=85,214,165
ForegroundVisited=142,132,232

# Headers and toolbars — one step brighter than the window they sit on.
[Colors:Header]
BackgroundAlternate=16,18,28
BackgroundNormal=22,26,41
DecorationFocus=138,180,255
DecorationHover=138,180,255
ForegroundActive=138,180,255
ForegroundInactive=138,144,166
ForegroundLink=138,180,255
ForegroundNegative=255,122,133
ForegroundNeutral=230,192,105
ForegroundNormal=237,239,247
ForegroundPositive=85,214,165
ForegroundVisited=142,132,232

[Colors:Header][Inactive]
BackgroundAlternate=22,26,41
BackgroundNormal=16,18,28
DecorationFocus=138,180,255
DecorationHover=138,180,255
ForegroundActive=138,180,255
ForegroundInactive=138,144,166
ForegroundLink=138,180,255
ForegroundNegative=255,122,133
ForegroundNeutral=230,192,105
ForegroundNormal=237,239,247
ForegroundPositive=85,214,165
ForegroundVisited=142,132,232

# Selection = solid starlight, with near-black text on top of it (on-accent).
# The foreground colours here are deliberately DARK, because the background
# they land on is a bright blue.
[Colors:Selection]
BackgroundAlternate=110,155,242
BackgroundNormal=138,180,255
DecorationFocus=138,180,255
DecorationHover=168,198,255
ForegroundActive=8,11,20
ForegroundInactive=45,58,90
ForegroundLink=35,48,107
ForegroundNegative=122,31,39
ForegroundNeutral=107,78,16
ForegroundNormal=8,11,20
ForegroundPositive=20,80,60
ForegroundVisited=58,42,110

# Tooltips are the top-most layer in the design: surface-3.
[Colors:Tooltip]
BackgroundAlternate=22,26,41
BackgroundNormal=29,34,54
DecorationFocus=138,180,255
DecorationHover=138,180,255
ForegroundActive=138,180,255
ForegroundInactive=138,144,166
ForegroundLink=138,180,255
ForegroundNegative=255,122,133
ForegroundNeutral=230,192,105
ForegroundNormal=237,239,247
ForegroundPositive=85,214,165
ForegroundVisited=142,132,232

# Views are content areas — file lists, text editors, the inside of things.
# These are the DEEPEST surface (void), so content floats on true darkness.
[Colors:View]
BackgroundAlternate=16,18,28
BackgroundNormal=6,7,12
DecorationFocus=138,180,255
DecorationHover=138,180,255
ForegroundActive=138,180,255
ForegroundInactive=138,144,166
ForegroundLink=138,180,255
ForegroundNegative=255,122,133
ForegroundNeutral=230,192,105
ForegroundNormal=237,239,247
ForegroundPositive=85,214,165
ForegroundVisited=142,132,232

# Windows are the app chrome around the content: surface-1.
[Colors:Window]
BackgroundAlternate=22,26,41
BackgroundNormal=16,18,28
DecorationFocus=138,180,255
DecorationHover=138,180,255
ForegroundActive=138,180,255
ForegroundInactive=138,144,166
ForegroundLink=138,180,255
ForegroundNegative=255,122,133
ForegroundNeutral=230,192,105
ForegroundNormal=237,239,247
ForegroundPositive=85,214,165
ForegroundVisited=142,132,232

[General]
ColorScheme=AquariusDark
Name=Aquarius Dark
shadeSortColumn=true

[KDE]
contrast=4

# Titlebars. Active windows get surface-2 so the focused window reads as
# "lifted"; unfocused windows fall back to surface-1 and dimmer text.
[WM]
activeBackground=22,26,41
activeBlend=237,239,247
activeForeground=237,239,247
inactiveBackground=16,18,28
inactiveBlend=138,144,166
inactiveForeground=138,144,166
