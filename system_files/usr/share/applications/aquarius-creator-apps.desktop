[Desktop Entry]
Type=Application
Version=1.0
Name=Aquarius Apps
GenericName=Creator App Chooser
Comment=Choose which creator apps you want, and install or remove them
Exec=/usr/libexec/aquarius-creator-apps
TryExec=/usr/libexec/aquarius-creator-apps
Icon=aquarius-logo
Terminal=false
StartupNotify=true
StartupWMClass=org.aquariusos.CreatorApps
Categories=System;PackageManager;
Keywords=apps;creator;install;add;remove;software;flatpak;obs;blender;kdenlive;krita;gimp;studio;
