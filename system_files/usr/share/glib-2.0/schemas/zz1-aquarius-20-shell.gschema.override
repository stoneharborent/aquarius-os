# ==============================================================================
# AquariusOS on GNOME — the dock's apps, and which extensions are switched on
# ==============================================================================
# Read the header of zz1-aquarius-10-look.gschema.override first. It explains
# what an override file is, why these are only DEFAULTS that a user always
# beats, and why the name has to start with "zz1".
#
# This file holds the two GNOME Shell settings that decide what the desktop is
# actually made of.
# ==============================================================================

[org.gnome.shell]

# ------------------------------------------------------------------------------
# The apps pinned to the dock on a brand-new account
# ------------------------------------------------------------------------------
# Each entry is the file name of an app's "desktop entry" — the little file that
# tells Linux an app exists. To find one, run:
#     ls /usr/share/applications | grep -i <the app>
# and use the file name exactly as it appears, .desktop and all.
#
# ⚠️ A TYPO HERE IS SILENT. The icon simply does not appear and nothing says
# why. build_files/50-aquarius-desktop.sh checks that every name on this line
# is a file that really exists in the image, so a typo fails the build instead
# of shipping a dock with a hole in it.
#
# The eight, and why each earns a permanent slot:
#
#   Files           every job on this computer starts with footage on a card
#   Aquarius Editor the flagship. Ours.
#                   ⚠️ IT IS NOT IN THE IMAGE, AND IT IS PINNED HERE ANYWAY.
#                   Since 2026-09-04 it is a four-gigabyte download offered in
#                   the app chooser, installed into each person's own home
#                   folder — so its menu entry lives in
#                   ~/.local/share/applications/ and not in
#                   /usr/share/applications/ where the rest of this line lives.
#                   GNOME simply does not draw a name it cannot resolve: no
#                   gap, no dead square, no error. The moment somebody installs
#                   the app, the same name resolves in their own folder and the
#                   icon appears in the seat it has always had. Taking it off
#                   this line would mean the flagship app arriving with nowhere
#                   to sit. build_files/50-aquarius-desktop.sh names this one
#                   exception explicitly, so a real typo still fails the build.
#   Aquarius Writer the other one of ours, and this one IS built in — it is
#                   about 260 MB, small enough not to be worth a question.
#   Firefox         the browser the OS ships, as an ordinary system package
#   Terminal        Ptyxis, Fedora's terminal — and this machine is built
#                   around containers, which is where a terminal earns its place
#   Text Editor     the thing you reach for to look at a config file or a script
#   Software        where the rest of the creator apps come from, and where you
#                   go to remove one. A new user has to be able to find it.
#   Settings        GNOME buries it, and a new user needs it on day one
#
# ⚠️ WHY OBS, KDENLIVE, BLENDER AND THE REST ARE NOT PINNED HERE, EVEN THOUGH
#    AQUARIUSOS INSTALLS THEM.
#
# They are Flatpaks. They are not inside the image — they arrive over the
# internet on the first boot (see /usr/share/flatpak/preinstall.d/), and their
# menu entries land in /var/lib/flatpak/exports/share/applications/, which does
# not exist while this image is being built. Pinning them would mean:
#
#   * a dock full of dead squares for the first ten minutes of a new machine's
#     life, and forever on a machine that is never online, and
#   * a failed build, because 50-aquarius-desktop.sh checks that every name on
#     this line is a real file in /usr/share/applications — which is exactly
#     the check that keeps this list honest, and it is right.
#
# So the rule is: THIS LINE NAMES ONLY THINGS THAT ARE INSIDE THE IMAGE. The
# Flatpak creator apps appear in the app grid the moment they finish
# installing, and anybody can drag one to the dock.
#
# ⚠️ ALSO NOT HERE: Steam. It arrives in Phase R4.
#
# The Aquarius Desktop — our own session — has its own dock and its own list,
# which is /etc/skel/.config/aquarius-shell/dock.json. That one CAN name the
# Flatpak apps, because the Aquarius dock simply skips a name it cannot find
# rather than drawing a dead square. The two lists are deliberately allowed to
# differ for that reason, and both are explained in docs/restart/creator-apps.md.
favorite-apps=['org.gnome.Nautilus.desktop', 'aquarius-editor.desktop', 'aquarius-writer.desktop', 'org.mozilla.firefox.desktop', 'org.gnome.Ptyxis.desktop', 'org.gnome.TextEditor.desktop', 'org.gnome.Software.desktop', 'org.gnome.Settings.desktop']

# ------------------------------------------------------------------------------
# The GNOME Shell extensions that are switched on
# ------------------------------------------------------------------------------
# ⚠️ READ THIS BEFORE EDITING THE LINE BELOW.
#
# This setting is a complete list, not an addition. Whatever is written here
# REPLACES whatever came before it entirely — there is no "inherit and add". So
# the list has to be written out deliberately every time, and every name on it
# has to be spelled exactly right (each one is the extension's own id, which
# always looks like an email address).
#
# THE FOUR, AND WHY
#
#   dash-to-dock          The dock itself: always visible, along the bottom, in
#                         the middle. GNOME's own dash only exists inside the
#                         Activities overview, and Royce wants a dock on the
#                         desktop the way macOS does. Its own settings are in
#                         the next file, zz1-aquarius-30-dash-to-dock.
#   appindicatorsupport   Lets older-style apps put an icon in the top bar.
#                         Without it several creator tools lose their tray icon
#                         completely and there is no way to get at them.
#   caffeine              Stops the screen sleeping. On a machine that renders
#                         and exports video for an hour at a time, this is not
#                         a nicety.
#   gsconnect             Phone pairing: notifications, file send, clipboard.
#                         Genuinely useful and hard to replace.
#
# All four are packaged by Fedora and installed in
# build_files/40-gnome-desktop.sh. Nothing here is downloaded at build time.
#
# ------------------------------------------------------------------------------
# WHAT THE PREVIOUS LINE HAD THAT THIS ONE DOES NOT
# ------------------------------------------------------------------------------
# Written down so nobody spends an afternoon looking for a bug that is really a
# missing package. These five were packaged by Universal Blue, not by Fedora,
# and they do not exist on a bare Fedora image at all:
#
#   hotedge               moved GNOME's hot corner to the bottom edge
#   logomenu              the distro logo button in the top-left corner
#   add-to-steam          right-click an app, add it to Steam
#   restartto             reboot straight into another OS or the BIOS
#   bazaar-integration    wiring for that base's own app store
#
# The one that is a real loss is **logomenu** — that button is where the
# AquariusOS mark lived in the top bar. Getting it back means packaging the
# extension ourselves, which is a Phase R2 job. Until then the OS carries its
# identity on the About page, the login screen, the wallpaper and in os-release.
#
# ------------------------------------------------------------------------------
# WHAT WE DELIBERATELY LEAVE OFF
# ------------------------------------------------------------------------------
#   blur-my-shell         Frosted-glass panels. Off for two reasons. First, the
#                         posture: AquariusOS works WITH GNOME's grain, and
#                         heavy compositing effects are the opposite of that.
#                         Second, history — we spent days on window blur on the
#                         KDE line, it never rendered correctly, and the whole
#                         design's transparency was removed on 2026-08-30
#                         because of it. We are not walking back into that.
#   user-theme            This is the switch that allows a custom GNOME SHELL
#                         theme. We ship no shell theme and do not intend to: a
#                         shell theme breaks on every GNOME release and has to
#                         be chased forever. With this off the shell is stock
#                         Adwaita wearing our accent and our wallpaper, which is
#                         exactly the look we want. Anyone who disagrees can
#                         switch it on in the Extensions app.
#
# Neither is even installed here — they are listed so that "why is there no
# blur?" has an answer in the same file as the decision.
enabled-extensions=['dash-to-dock@micxgx.gmail.com', 'appindicatorsupport@rgcjonas.gmail.com', 'caffeine@patapon.info', 'gsconnect@andyholmes.github.io']
