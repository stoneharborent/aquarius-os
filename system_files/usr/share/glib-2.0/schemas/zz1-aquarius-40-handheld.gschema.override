# ==============================================================================
# AquariusOS on GNOME — the one extra setting a gaming handheld needs
# ==============================================================================
# Read the header of zz1-aquarius-10-look.gschema.override first.
#
# ⚠️ THIS FILE ONLY EXISTS ON ONE IMAGE: aquarius-os-gnome-deck.
#
# It is copied onto EVERY image like everything else in system_files/, and then
# deleted again from the five images that are not the GNOME handheld. Shipping
# and un-shipping is deliberately the wrong way round from how it sounds,
# because it is the way that cannot fail quietly: the file is always in the
# repo, always reviewed, always in one place, and the only image-specific thing
# in the whole arrangement is one `rm -f` in build_files/gnome-desktop.sh. The
# KDE line already does exactly this with /usr/share/aquarius/xdg-handheld.
#
# WHY THE HANDHELD NEEDS ITS OWN FILE AT ALL
#
# The list of switched-on extensions is a COMPLETE list, not an addition (see
# the long warning in zz1-aquarius-20-shell.gschema.override). So a handheld
# cannot simply "also have" one more extension — the whole list has to be
# written out again with the extra name in it. That is what this file does, and
# it works because it sorts AFTER the -20- file and the last mention of a
# setting wins.
#
# ⚠️ SO THESE TWO LISTS MUST BE KEPT IN STEP. If you add or remove an extension
# in zz1-aquarius-20-shell.gschema.override, make the same change here. The
# GNOME verify step in .github/workflows/build.yml compares them and fails the
# build if they have drifted apart, which is the only reliable way to stop this
# going stale.
# ==============================================================================

[org.gnome.shell]

# The same nine as the desktop images, plus:
#
#   block-caribou-36   Stops GNOME's own on-screen keyboard ("Caribou") popping
#                      up on a handheld. It is not that the keyboard is
#                      unwanted — it is that Steam's Game Mode brings its own,
#                      and two on-screen keyboards fighting over the same text
#                      box is worse than either alone. Bazzite enables this on
#                      their GNOME handheld image for exactly this reason, and
#                      it is the one thing from their handheld list we keep.
enabled-extensions=['appindicatorsupport@rgcjonas.gmail.com', 'gsconnect@andyholmes.github.io', 'caffeine@patapon.info', 'hotedge@jonathan.jdoda.ca', 'logomenu@aryan_k', 'add-to-steam@pupper.space', 'restartto@tiagoporsch.github.io', 'bazaar-integration@kolunmi.github.io', 'dash-to-dock@micxgx.gmail.com', 'block-caribou-36@lxylxy123456.ercli.dev']
