# ==============================================================================
# AquariusOS on GNOME — how the dock behaves
# ==============================================================================
# Read the header of zz1-aquarius-10-look.gschema.override first. It explains
# what an override file is and why these are only defaults a user always beats.
#
# The dock is the Dash to Dock extension, installed from Fedora's own package
# (gnome-shell-extension-dash-to-dock, version 105 on Fedora 44) in
# build_files/40-gnome-desktop.sh. It is switched on in the file before this
# one.
#
# ⚠️ EVERY KEY NAME BELOW WAS READ OUT OF THE EXTENSION'S OWN SETTINGS FILE
# (/usr/share/glib-2.0/schemas/org.gnome.shell.extensions.dash-to-dock.gschema.xml,
# as installed by that package), NOT guessed and NOT copied off a forum. That matters more here than
# almost anywhere else in the repo: a misspelled key in an override file is not
# an error, it is silence. glib-compile-schemas would reject an unknown key with
# --strict, but the setting would simply never apply, the dock would come up
# with stock behaviour, and nothing anywhere would say why.
#
# To check a name yourself on a booted machine:
#     gsettings list-recursively org.gnome.shell.extensions.dash-to-dock
# ==============================================================================

[org.gnome.shell.extensions.dash-to-dock]

# ------------------------------------------------------------------------------
# Where it lives: along the bottom, in the middle, always there
# ------------------------------------------------------------------------------
# This is the macOS-shaped dock Royce asked for, and the same shape the KDE line
# already has.
#
# It takes FOUR settings together to get "always visible", and leaving any one
# of them out gives a dock that hides at the wrong moment:
#
#   dock-fixed=true     the dock is part of the desktop, not a thing that
#                       appears when you reach for it
#   autohide=false      do not slide away when the pointer leaves
#   intellihide=false   do not slide away when a window comes near it. This is
#                       the one people forget: with dock-fixed on but
#                       intellihide left at its default (true), the dock still
#                       vanishes the moment a window is maximised.
#   autohide-in-fullscreen=false
#                       ...but a full-screen game or a full-screen video does
#                       get the whole screen. This is the one place hiding is
#                       right, and false here means "do not ALSO hide in
#                       fullscreen" — the dock is simply below the fullscreen
#                       window, which is the correct behaviour.
dock-position='BOTTOM'
dock-fixed=true
autohide=false
intellihide=false
autohide-in-fullscreen=false

# ------------------------------------------------------------------------------
# Its shape: a floating island, not a full-width bar
# ------------------------------------------------------------------------------
# extend-height=false is what makes the dock only as wide as its icons, sitting
# centred in the middle of the bottom edge — the floating pill, rather than a
# bar stretched from one side of the screen to the other.
#
# always-center-icons is set too. With extend-height off it changes nothing
# today, because a dock sized to its icons is centred by definition. It is here
# so that if anyone ever turns extend-height on, the icons stay in the middle
# instead of jumping to the left-hand end — which is what a full-width dock does
# by default, and it looks like a mistake.
extend-height=false
always-center-icons=true

# Icon size in pixels. 48 is the extension's own default and it is a sensible
# one: large enough to read at a glance on a 4K monitor, small enough not to eat
# a 7-inch handheld screen. Written down rather than inherited so that a future
# upstream change of heart does not silently change our dock.
#
# icon-size-fixed=false lets the dock shrink its icons when there are too many
# to fit rather than running off the edge of the screen.
dash-max-icon-size=48
icon-size-fixed=false

# ------------------------------------------------------------------------------
# What is in it
# ------------------------------------------------------------------------------
# show-show-apps-button is the grid button at the end of the dock — the one that
# opens the full list of applications. Keep it: it is how a beginner finds
# anything that is not pinned.
#
show-show-apps-button=true
show-apps-at-top=false

# ------------------------------------------------------------------------------
# Drives in the dock — every one that is open
# ------------------------------------------------------------------------------
# ⚠️ WRITTEN OUT ON 2026-10-19. Royce: "Remove verification for all internal and
# external drives. Just mount them from login and show in dock." Since that day
# /usr/libexec/aquarius-automount opens every drive inside the computer at
# login, as well as every drive you plug in, and each one gets a tile here.
# Until then these keys were left at the extension's defaults; they are written
# down now so that a future upstream default cannot quietly take the drives out
# of the dock. Every name was checked against the extension's own settings file
# (dash-to-dock 105).
#
#   show-mounts=true               a tile for every open drive: a camera card,
#                                  an external SSD, the second SSD inside the
#                                  computer. Click it to open it in Files;
#                                  right-click it to eject it. GNOME has no
#                                  desktop icons at all, so the dock is the
#                                  only place a drive shows up without opening
#                                  Files.
#   show-mounts-only-mounted=true  ONLY drives that are open. Turned off, the
#                                  dock would also show a tile for every
#                                  partition that is NOT open — including the
#                                  ones the automount agent deliberately leaves
#                                  alone (an encrypted drive, a recovery
#                                  partition) — which is noise at best.
#   show-mounts-network=true       a network share you opened in Files (a NAS,
#                                  a shared folder on another computer) gets a
#                                  tile too. The extension leaves these out by
#                                  default; on a machine that pulls footage off
#                                  a NAS, the share is a drive like any other.
#   show-trash=true                the bin, at the end of the dock — where you
#                                  drag a file to delete it, like on a Mac.
#                                  Its default, written down for the same
#                                  reason as the rest.
show-mounts=true
show-mounts-only-mounted=true
show-mounts-network=true
show-trash=true

# ------------------------------------------------------------------------------
# The dock's own colour
# ------------------------------------------------------------------------------
# transparency-mode='DYNAMIC' means the dock is see-through over the wallpaper
# and turns solid when a window is pushed up against it. That is GNOME's own
# instinct and it reads well on a light desktop.
#
# ⚠️ Note what this is NOT. It is plain transparency — the wallpaper showing
# through — and not blur. There is no frosted glass anywhere in AquariusOS and
# there is not going to be; see the blur-my-shell note in
# zz1-aquarius-20-shell.gschema.override and docs/blur-known-issue.md.
#
# apply-custom-theme=false leaves the dock looking like the rest of GNOME
# instead of like the extension author's idea of a dock. Same posture as
# everywhere else on this line: work with the grain.
transparency-mode='DYNAMIC'
apply-custom-theme=false
custom-theme-shrink=false

# One dock, on the main screen. multi-monitor=true puts a copy on every monitor,
# which on a two-screen editing desk is two docks and a lot of noise.
multi-monitor=false
