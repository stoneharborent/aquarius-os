# ==============================================================================
# AquariusOS Plasma Style — the theme's own settings
# ==============================================================================
# The SVG files next to this one say what the glass LOOKS like. This file says
# how the glass should BEHAVE — mainly, what it asks the compositor (KWin) to
# do behind it.
#
# Format: a section name in [brackets], then key=value lines under it. KDE reads
# a fixed list of sections here; anything else is ignored.
# ==============================================================================

# --- Where to borrow missing artwork from --------------------------------------
# We only draw the handful of shapes the design actually changes: the panel, the
# dock, popups, tooltips, cards and heading strips. KDE's Plasma styles contain
# about forty more SVGs (sliders, checkmarks, progress bars, the analogue clock
# face...). Rather than redraw all of them, anything we do not ship falls back to
# KDE's own Breeze artwork, which already follows our AquariusDark colours.
#
# "default" IS Breeze — that is the id KDE ships it under. Plasma would fall back
# to it anyway; naming it here just makes the arrangement visible instead of
# implied.
[Settings]
FallbackTheme=default

# --- Blur behind the glass ------------------------------------------------------
# This is the setting that makes the theme a GLASS theme rather than just a
# see-through one. When it is on, Plasma tells KWin "blur the wallpaper behind
# this panel/popup", handing it the black mask-* shapes out of our SVGs so the
# blur stops exactly at our rounded corners.
#
# KDE's default for this is already "on", so writing it out changes nothing
# today. It is written anyway because it is the single most load-bearing
# behaviour in the whole theme, and a future KDE that flipped the default would
# quietly turn our desktop into flat grey rectangles.
[BlurBehindEffect]
enabled=true

# --- Colour punch behind the glass ----------------------------------------------
# The design asks for `saturate(1.3)` behind the panels: colours behind the glass
# stay lively instead of going muddy when they are blurred.
#
# ⚠️ HONEST NOTE, VERIFIED 2026-08-30 AGAINST KDE SOURCE — THIS SECTION CURRENTLY
# DOES NOTHING ON PLASMA 6.7, AND THAT IS FINE.
#   KDE used to have a separate "background contrast" effect that read these
#   numbers per theme. In Plasma 6.5 it was folded into the blur effect, and by
#   6.7 the separate effect is gone: there is no `contrast` plugin left in KWin,
#   and the Wayland protocol that carried it (ext-background-effect-v1) only
#   advertises blur. Saturation is now ONE system-wide KWin setting instead:
#       kwinrc  [Effect-blur]  Saturation=130     (130 means 1.3)
#   That line is the KWin effects track's job (T2-B), not this file's.
#
#   These keys are kept because Plasma still reads them without complaint, they
#   cost nothing, and they are the correct values if KDE ever restores per-theme
#   control. If you are wondering why the desktop does not look more saturated:
#   the answer is in kwinrc, not here.
#
# The numbers, for the record: 1.0 means "leave this alone". We deliberately set
# contrast and intensity to 1.0 rather than leaving them blank, because blank
# makes KDE substitute its own Breeze-tuned darkening (0.45 / 0.6) on top of the
# darkness we already baked into the SVG fills — the panels would come out much
# heavier than the design.
[ContrastEffect]
enabled=true
contrast=1.0
intensity=1.0
saturation=1.3

# --- Let the transparency slider actually work ----------------------------------
# Panel settings offer three choices: Adaptive, Translucent, Opaque. "Adaptive"
# means the panel goes solid on its own when a window is maximised behind it, so
# text stays readable.
#
# Plasma only offers that behaviour if the theme opts in here. Leave this out and
# the panel is permanently see-through: the setting still appears in the menu,
# the person still clicks it, and nothing happens. Our house rule is that we set
# good defaults but never take a choice away — a setting that silently does
# nothing breaks that rule just as badly as forcing a value would.
#
# The other half of the promise is the solid/ folder beside this file. When
# somebody picks Opaque, Plasma loads the panel and popup artwork from there
# instead. We ship our own opaque artwork so the design survives that choice;
# without it, their panel would abruptly turn into stock KDE Breeze.
[AdaptiveTransparency]
enabled=true
