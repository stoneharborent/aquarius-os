# ==============================================================================
# AquariusOS — the desktop's default settings
# ==============================================================================
# This file is what makes a brand-new user's desktop look like AquariusOS
# instead of like stock Bazzite: our colours, our fonts, our wallpaper.
#
# HOW IT WORKS, in plain English:
#   KDE calls a bundle like this a "global theme". When somebody logs in for the
#   first time, KDE reads this file and writes everything in it into that user's
#   settings as DEFAULTS — not as forced values. That distinction is the whole
#   point: anyone who later picks their own colour scheme or wallpaper keeps it,
#   and a future OS update will not stamp over their choice.
#
# THE FORMAT:
#   [settings-file][SectionInThatFile]
#   key=value
#
#   So "[kdeglobals][General] ColorScheme=..." means "in the settings file
#   called kdeglobals, in its General section, set ColorScheme".
#
# ⚠️ KDE only reads a FIXED LIST of keys from this file. Adding a key that is
# not on that list does nothing at all — it is silently ignored. The list is:
# ColorScheme, widgetStyle, Icons/Theme, the five font keys below, WM/activeFont,
# Wallpaper/Image, the plasmarc theme, the cursor theme, the window decoration,
# and the splash screen. Do not invent keys here and expect them to work.
#
# The values themselves come from ../../../../../../../branding/tokens.md.
# ==============================================================================

# --- Colours ------------------------------------------------------------------
# Points at /usr/share/color-schemes/AquariusDark.colors.
[kdeglobals][General]
ColorScheme=AquariusDark

# --- Fonts --------------------------------------------------------------------
# The design calls for Inter for interface text and JetBrains Mono for code.
#
# That long string of numbers after the font name is Qt's standard way of
# describing a font, and every one of them matters:
#
#   Inter , 10 , -1 , 5 , 50 , 0 , 0 , 0 , 0 , 0
#     |      |    |    |    |   |   |   |   |   `- (unused)
#     |      |    |    |    |   |   |   |   `----- fixed width? 0 = no
#     |      |    |    |    |   |   |   `--------- strikethrough? 0 = no
#     |      |    |    |    |   |   `------------- underline? 0 = no
#     |      |    |    |    |   `----------------- italic? 0 = no
#     |      |    |    |    `--------------------- weight, 50 = normal
#     |      |    |    `-------------------------- style hint, 5 = "any"
#     |      |    `------------------------------- pixel size, -1 = "use points"
#     |      `------------------------------------ size in POINTS
#     `------------------------------------------- the font family name
#
# Why 10 points: the design specifies 13.5px for interface text. KDE measures in
# points, and at a normal screen density 10pt is about 13.3px — the closest
# clean match. 11pt would be about 14.7px, noticeably looser.
#
# This is exactly the same shape of value Bazzite itself ships (it sets
# "Noto Sans,10,-1,5,50,0,0,0,0,0"), so we are not doing anything exotic here —
# just swapping the family names.
[kdeglobals][General]
font=Inter,10,-1,5,50,0,0,0,0,0
fixed=JetBrains Mono,10,-1,5,50,0,0,0,0,0
menuFont=Inter,10,-1,5,50,0,0,0,0,0
toolBarFont=Inter,10,-1,5,50,0,0,0,0,0
smallestReadableFont=Inter,8,-1,5,50,0,0,0,0,0

# The font used in window title bars.
[kdeglobals][WM]
activeFont=Inter,10,-1,5,50,0,0,0,0,0

# --- Wallpaper ----------------------------------------------------------------
# "AquariusThePour" is the folder name under /usr/share/wallpapers/.
[Wallpaper]
Image=AquariusThePour

# --- Everything else ----------------------------------------------------------
# Breeze is KDE's own widget style and it takes its colours from whatever colour
# scheme is active — so with AquariusDark selected above, Breeze renders in our
# palette automatically. We are not shipping a custom widget style.
[kdeglobals][KDE]
widgetStyle=Breeze

# Dark icons to match a dark desktop.
[kdeglobals][Icons]
Theme=breeze-dark

# The Plasma "style" is the look of the panels and popups. "default" is Breeze's,
# which — same as the widget style — follows our colour scheme.
[plasmarc][Theme]
name=default

# Deliberately NOT set here: the mouse cursor theme, the window decoration and
# the boot/login splash screen. Those are inherited from Bazzite untouched. If
# we ever want our own, they get added here — one line each.
