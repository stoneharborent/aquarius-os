# ==============================================================================
# AquariusOS — system-wide KDE defaults
# ==============================================================================
# WHAT THIS FILE IS
#   The desktop's factory settings. Everything in here is a DEFAULT, never a
#   forced value: if a user changes their colours or fonts in System Settings,
#   their choice is stored in their own home folder and wins over this file,
#   permanently. Nothing here can ever overwrite a decision a user has made.
#
# WHY IT LIVES IN THIS ODD PLACE
#   KDE reads settings from a *stack* of folders, top to bottom, first match
#   wins. On AquariusOS that stack is:
#
#     1. ~/.config/                     the user's own choices            ← wins
#     2. ~/.config/kdedefaults/         what the global theme set up
#     3. /usr/share/aquarius/xdg/       THIS FILE — AquariusOS defaults
#     4. /etc/xdg/                      Bazzite's defaults
#     5. /usr/share/kde-settings/...    Fedora's defaults
#
#   We deliberately do NOT edit Bazzite's file at level 4. We add a new level
#   above it instead. That means:
#     - nothing of Bazzite's is deleted or overwritten; anything we do not
#       mention here still comes through from their file underneath,
#     - our settings live in /usr, which is part of the OS image, so an OS
#       update reliably updates them,
#     - and a user's own settings still sit above ours and always win.
#
#   The one thing that makes level 3 exist is the tiny script at
#   /etc/xdg/plasma-workspace/env/zz-aquarius.sh. Without that script this file
#   is inert. They are a pair — never ship one without the other.
#
# All values come from ../../../../../branding/tokens.md.
# ==============================================================================

[KDE]
# The "global theme" bundle that defines the AquariusOS desktop: our colour
# scheme, our fonts, our wallpaper and the top-bar-plus-dock layout.
# It lives at /usr/share/plasma/look-and-feel/org.aquariusos.desktop/.
#
# Bazzite sets this to Valve's "com.valve.vapor.desktop" one level below us.
# Ours sits on top, so AquariusOS wins — but Bazzite's file is untouched.
LookAndFeelPackage=org.aquariusos.desktop

[General]
# Points at /usr/share/color-schemes/AquariusDark.colors.
# The global theme above also sets this; it is repeated here so the colours are
# already correct on the very first frame the desktop draws, before the theme
# has finished being applied.
ColorScheme=AquariusDark

# Fonts. The long number string is Qt's standard font description — the second
# number is the size in POINTS, and 50 is "normal weight". See the comments in
# the global theme's `defaults` file for a field-by-field breakdown.
#
# 10pt ≈ 13.5px at a normal screen density, which is the interface text size the
# design calls for.
font=Inter,10,-1,5,50,0,0,0,0,0
menuFont=Inter,10,-1,5,50,0,0,0,0,0
toolBarFont=Inter,10,-1,5,50,0,0,0,0,0

# The task bar / dock font. This one can ONLY be set here — the global theme
# format has no key for it — which is a large part of why this file exists.
taskbarFont=Inter,10,-1,5,50,0,0,0,0,0

# The smallest text the system will draw: timestamps, badges, fine print.
smallestReadableFont=Inter,8,-1,5,50,0,0,0,0,0

# Code and terminal.
fixed=JetBrains Mono,10,-1,5,50,0,0,0,0,0

[WM]
# Window title bars.
activeFont=Inter,10,-1,5,50,0,0,0,0,0

[Icons]
# Dark icons, to match a dark desktop.
Theme=breeze-dark

# ------------------------------------------------------------------------------
# Deliberately NOT set here
# ------------------------------------------------------------------------------
# AccentColor — the highlight colour on buttons, links and selections.
#   We leave it unset on purpose, because unset already gives us the right
#   answer twice over:
#     - with KDE's default "accent from the colour scheme", the accent is
#       whatever AquariusDark.colors calls DecorationFocus, which is starlight
#       #8AB4FF — exactly what the design asks for;
#     - and if a user switches on "accent colour from wallpaper", our wallpaper
#       package declares its own accent (also #8AB4FF), so they still get
#       starlight.
#   Writing AccentColor explicitly would additionally tint every surface in the
#   palette toward the accent, which is not what the design wants.
#
# ColorSchemeHash — machine-managed by Plasma. Never write it by hand.
#
# Panel and widget layout — cannot be set from a file like this at all. The
#   desktop layout is built by the global theme's layout script; see
#   /usr/share/plasma/look-and-feel/org.aquariusos.desktop/contents/layouts/.
