# =============================================================================
# generate-theme — build labwc's look out of the shell's own palette
# =============================================================================
# WHAT THIS PROGRAM IS FOR, IN ONE PARAGRAPH
#
#   Almost everything you see on an Aquarius desktop is drawn by the shell, in
#   QML, out of theme/Ice.qml or theme/Midnight.qml. Three things are not: the
#   menu that opens when you right-click the wallpaper, the title bar and border
#   around every window, and the little round buttons in that title bar. Those
#   belong to labwc, and labwc is a C program that reads flat text files. It
#   cannot import QML.
#
#   Until this program existed, somebody wrote the numbers out a second time by
#   hand, in a file called themerc-override, and that hand-written file could
#   only ever hold ONE theme (Ice) at ONE size. This program replaces it. It
#   reads the palette out of the QML, does the arithmetic, and writes every file
#   labwc needs. Nothing about the look of a window is typed twice any more.
#
# -----------------------------------------------------------------------------
# HOW TO CHANGE A COLOUR — the only answer, and it is short
# -----------------------------------------------------------------------------
#   Edit theme/Ice.qml (light) or theme/Midnight.qml (dark). Nowhere else.
#   Log out and back in — or just flip the desktop between light and dark, which
#   re-runs this program on the spot. There is no second place to keep in step,
#   because this program is what makes the second copy.
#
# -----------------------------------------------------------------------------
# WHEN IT RUNS
# -----------------------------------------------------------------------------
#   1. At login, from session/aquarius-session, BEFORE labwc starts.
#   2. Whenever the machine is switched between light and dark, from
#      services/SystemAppearance.qml, which then runs `labwc --reconfigure`
#      so the change lands without logging out.
#   3. From `aq keys mac` / `aq keys windows` on AquariusOS, which is the one
#      switch that decides whether the window buttons sit on the left (Mac) or
#      the right (Windows).
#
# -----------------------------------------------------------------------------
# WHAT IT WRITES, AND WHY EACH FILE IS WHERE IT IS
# -----------------------------------------------------------------------------
#   <config-out>/themerc-override    every colour and size labwc draws with
#   <config-out>/rc.xml              key bindings + the three settings that have
#                                    to change at runtime (see below)
#   <config-out>/menu.xml            copied, unchanged
#   <config-out>/autostart           copied, unchanged
#   <config-out>/shutdown            copied, unchanged
#   <config-out>/environment         copied, unchanged
#   <theme-out>/*.svg                the round window buttons, one file per
#                                    button per state
#   <gtk-out>/gtk-4.0/gtk.css        the window colours and the three window
#                                    buttons for GNOME's own applications, which
#                                    draw their own title bar — see "GTK" below.
#                                    Written in BOTH light and dark.
#   <gtk-out>/gtk-3.0/gtk.css        the same, for older applications
#
#   ⚠️ THE TWO OUTPUT FOLDERS ARE DIFFERENT FOLDERS, AND THAT IS labwc's RULE,
#   NOT OURS. labwc reads its settings from the folder it was started with
#   (`labwc -C <folder>`), but it looks for BUTTON PICTURES somewhere else
#   entirely: in a THEME folder, under themes/<name>/labwc/, searched in the
#   order XDG_DATA_HOME, ~/.themes, then XDG_DATA_DIRS. That is why rc.xml says
#   <theme><name>Aquarius</name> — that name is how labwc finds the pictures.
#   (labwc-theme(5), and src/common/dir.c in labwc 0.20.2.)
#
#   ⚠️ WHY rc.xml IS WRITTEN OUT RATHER THAN READ WHERE IT SITS. Three of the
#   things this design needs are rc.xml settings, not theme settings, and labwc
#   offers no other place to put them:
#
#       the corner radius   <theme><cornerRadius>
#       the title font size <theme><font place="ActiveWindow"><size>
#       which side the      <theme><titlebar><layout>
#       buttons sit on
#
#   The first two have to follow AQ_UI_SCALE like every other size, and the
#   third has to change when somebody runs `aq keys windows` — and on
#   AquariusOS the shipped rc.xml lives in /usr, which is read-only. So the
#   shipped rc.xml is a TEMPLATE: three regions in it are marked with
#   `AQ-GENERATED-BEGIN` / `AQ-GENERATED-END` comments, this program rewrites
#   what is between them, and the finished file is written to a folder in the
#   user's home that labwc is then started with. Everything else in rc.xml —
#   every key binding, every comment — is copied through untouched.
#
# -----------------------------------------------------------------------------
# WHAT labwc 0.20.2 CAN AND CANNOT DO — checked in its own source, not guessed
# -----------------------------------------------------------------------------
#   CAN   <theme><cornerRadius>            labwc-config(5), default 8
#   CAN   <theme><titlebar><layout>        labwc-config(5); ids are icon, menu,
#                                          iconify, max, close, shade, desk, and
#                                          exactly one colon splits left:right
#   CAN   SVG buttons                      searched png -> svg -> xbm; our labwc
#                                          is built +rsvg, and an SVG keeps its
#                                          OWN colours (only .xbm files are
#                                          re-coloured by the themerc)
#   CAN   a hover picture per button       close_hover-active.svg and friends,
#                                          which is what lets the close button
#                                          go red while the others do not
#
#   CANNOT  set the title bar height directly. `titlebar.height` was REMOVED —
#           labwc 0.20.2 prints "titlebar.height is no longer supported" and
#           works the height out itself:
#               height = max(font height, window.button.height)
#                        + 2 x window.titlebar.padding.height
#           So this program gets the 38px bar by setting the button height and
#           then solving for the padding. See titlebar_padding_height() below.
#
#   CANNOT  draw a PRESSED button. labwc's button states are default, hover,
#           toggled and rounded — there is no pressed state and no
#           `close_pressed-active.svg`. The design asks for a darker disc while
#           the mouse is held down; labwc cannot draw it, so a pressed button
#           looks like a hovered one. Nothing here fakes it.
#
#   CANNOT  give each button its own hover BACKGROUND COLOUR through the
#           themerc: window.button.hover.bg.color is one value for all buttons.
#           It does not matter, because we do not use it — the disc is drawn
#           INTO each picture, and labwc only paints its own hover wash when a
#           button has no hover picture of its own. We ship every hover picture.
# =============================================================================

import argparse
import math
import os
import re
import shutil
import subprocess
import sys

# =============================================================================
# THE PALETTE — read straight out of the QML, which is the only source
# =============================================================================
# Ice.qml and Midnight.qml are lists of lines shaped like this:
#
#     readonly property color ink: "#16273A"         // primary text
#     readonly property color line: "#1A16273A"      // ink at 10%
#
# so one regular expression reads either of them. Nothing else in this program
# is allowed to contain a colour. If a value below is not in one of those two
# files, that is a bug here and not a new design decision.

PALETTE_LINE = re.compile(
    r'readonly\s+property\s+color\s+(?P<name>\w+)\s*:\s*"(?P<value>#[0-9A-Fa-f]{6,8})"'
)

# The palette roles this program actually uses. Listed by name so that a typo,
# or a role somebody renames in the QML, is a clear error at start-up instead of
# a window frame that quietly comes out the wrong colour.
REQUIRED_ROLES = (
    "panel",        # the title bar of the window you are in
    "surface",      # the menu card
    "surfaceAlt",   # the title bar of a window you are not in; the menu title
    "ink",          # the title text, and the ink the buttons are drawn in
    "inkSoft",      # a menu title's label
    "inkMute",      # the title text of a window you are not in
    "inkOnAccent",  # the X on a red close button
    "line",         # the hairline around a window you are not in
    "lineStrong",   # the hairline around the window you are in
    "accentWash",   # the row of a menu the pointer is on
    "danger",       # the close button, while the pointer is on it
    "bg",           # Midnight's GTK window background
)


def read_palette(path):
    """Read one QML palette file into a plain dictionary of name -> value."""
    try:
        with open(path, "r", encoding="utf-8") as handle:
            text = handle.read()
    except OSError as problem:
        die("could not read the palette %s: %s" % (path, problem))

    palette = {}
    for match in PALETTE_LINE.finditer(text):
        palette[match.group("name")] = match.group("value")

    if not palette:
        die(
            "%s has no colours in it.\n"
            "This program looks for lines shaped\n"
            '    readonly property color ink: "#16273A"\n'
            "and found none, so either the file moved or its style changed."
            % path
        )

    missing = [role for role in REQUIRED_ROLES if role not in palette]
    if missing:
        die(
            "%s is missing %d colour(s) this design needs: %s.\n"
            "Every role has to exist in BOTH Ice.qml and Midnight.qml — a role\n"
            "in one and not the other breaks the desktop the moment somebody\n"
            "switches between light and dark." % (path, len(missing), ", ".join(missing))
        )

    return palette


# =============================================================================
# COLOURS — QML writes the opacity first, labwc writes it last
# =============================================================================
# QML:   #AARRGGBB   "#1A16273A" is the ink #16273A at 10%
# labwc: #RRGGBBAA   the same colour is written "#16273A1A"
#
# Same colour, same opacity, the alpha byte at the other end. Getting this
# backwards produces a colour that is not wrong in an obvious way — it is a
# plausible, slightly-off blue — which is exactly why it is done in one function
# and never by hand.


def qml_to_labwc(value):
    """Turn a QML colour into the way labwc spells the same colour."""
    digits = value.lstrip("#")
    if len(digits) == 6:
        return "#" + digits.upper()
    if len(digits) == 8:
        alpha, rgb = digits[:2], digits[2:]
        return "#" + rgb.upper() + alpha.upper()
    die("'%s' is not a colour this program knows how to read." % value)


def rgb_of(value):
    """Just the six colour digits of a QML colour, with no opacity."""
    digits = value.lstrip("#")
    return "#" + (digits[2:] if len(digits) == 8 else digits).upper()


def at_percent(value, percent):
    """
    The same colour, at a given opacity, written labwc's way.

    The design sheet asks for things like "ink at 16%" for which no ready-made
    token exists in the palette — the palette has ink at 8, 10, 13 and 18 per
    cent and no more. Rather than invent four new palette roles for four button
    states, the percentage is applied here, to the palette's OWN ink. The colour
    still comes from the QML; only the opacity is arithmetic.
    """
    alpha = int(round(percent / 100.0 * 255.0))
    return "%s%02X" % (rgb_of(value), max(0, min(255, alpha)))


def svg_opacity(percent):
    """The same idea, written the way an SVG wants it: 0.16 rather than 16%."""
    return "%.3f" % (percent / 100.0)


# =============================================================================
# SIZE — the same knob the shell uses, doing the same arithmetic
# =============================================================================
# theme/Theme.qml multiplies every size in the shell by AQ_UI_SCALE and rounds
# the result. labwc knows nothing about that variable, which is why the shell
# used to grow while the window frames did not. This function is a copy of
# Theme.px(), deliberately down to the rounding:
#
#   * QML's Math.round() rounds a half UP (0.5 becomes 1). Python's own round()
#     rounds a half to the nearest EVEN number (0.5 becomes 0), which would put
#     this program one pixel away from the shell at some scales. floor(n + 0.5)
#     is Math.round(), so that is what is written here.
#   * A visible thing never rounds away to nothing: a 1px hairline at 0.5x
#     stays 1px rather than becoming 0px.


def px(value, scale):
    if scale == 1.0:
        return int(value)
    scaled = int(math.floor(value * scale + 0.5))
    if value > 0 and scaled < 1:
        return 1
    return scaled


def pt(value, scale):
    """
    A font size in POINTS, from a design size in pixels.

    ⚠️ labwc's <font><size> is in POINTS, not pixels — src/common/font.c does
    `pango_font_description_set_size(desc, font->size * PANGO_SCALE)`, and that
    call reads points. An earlier version of this file wrote the design's PIXEL
    numbers straight into <size>, so every menu row and title came out about a
    third too big (19px asked for, 19pt = ~25px drawn). Found on the bench,
    2026-09-07: the right-click menu was visibly larger than the shell's own.
    Points at 96 dpi are pixels * 72 / 96 = pixels * 0.75, so a 19px row now
    matches the shell's 19px row. The scale is applied first, same as px().
    """
    return max(1, int(math.floor(px(value, scale) * 72.0 / 96.0 + 0.5)))


# =============================================================================
# THE DESIGN, WRITTEN DOWN ONCE
# =============================================================================
# Every number in this block is from the window-frame design sheet of
# 2026-09-06. They are design px — the size at AQ_UI_SCALE=1 — and px() above
# turns them into the size to actually draw.

TITLEBAR_HEIGHT = 38     # section 3: the whole title bar
TITLE_FONT_SIZE = 13     # section 3: Inter, design px; written as points via pt() (labwc <size> is pt)
# Section 3 asks for "Inter 500" — medium, a little heavier than body text, so a
# window's name reads as a label rather than as prose. labwc takes a WORD here,
# not a number: rcxml.c maps `medium` to Pango's PANGO_WEIGHT_MEDIUM, which is
# 500. (The menu keeps the normal weight; section 5 says leave it as it is.)
TITLE_FONT_WEIGHT = "medium"
CORNER_RADIUS = 12       # section 3: matches libadwaita's own fixed 12
BORDER_WIDTH = 1         # section 3

BUTTON_DISC = 20         # section 4: the round disc behind a button's glyph
BUTTON_GLYPH_BOX = 12    # section 4: the square the glyph is drawn inside
BUTTON_STROKE = 1.8      # section 4: how thick the glyph's lines are
BUTTON_SPACING = 8       # section 4: air between two discs
BUTTON_EDGE_PAD = 12     # section 4: air between the window edge and the first
                         #            disc. NOTE: section 3 of the same sheet
                         #            says "titlebar padding 8 (shipped)", which
                         #            is what the old hand-written file had.
                         #            Section 4 is the one that states a button
                         #            measurement on purpose and scales it, so
                         #            12 is what is built. Flagged for Royce.
MAX_SQUARE = 7           # section 4: the maximise glyph is a 7x7 square
MAX_SQUARE_RADIUS = 1.2  # section 4: with 1.2 rounded corners

# How thick the minimise line is when the STYLESHEET draws it rather than the
# icon theme (GNOME windows — see build_gtk_css). labwc's own picture strokes it
# at BUTTON_STROKE, which is 1.8; CSS wants a whole number of pixels for a rule
# this short, and 2 is what 1.8 rounds to. Nothing else uses it.
MINIMISE_LINE_WIDTH = 2

# The four button discs, as percentages of the theme's own ink.
DISC_IDLE = {"ice": 10, "midnight": 12}          # section 4
DISC_HOVER = {"ice": 16, "midnight": 18}         # section 4
INACTIVE_OPACITY = 45                            # section 4: a window you are
                                                 # not in draws its whole button
                                                 # at 45%

# Menu sizes. Section 5 says "keep the shipped Ice values", so these are the
# numbers the old hand-written themerc-override had, unchanged.
MENU_WIDTH = 240
MENU_PADDING_X = 16
MENU_PADDING_Y = 9
MENU_SEPARATOR_MARGIN = 8
MENU_FONT_SIZE = 19       # section 5: "row height = padding 9 + font 19"
MENU_HEADER_FONT_SIZE = 15

# The name labwc looks the button pictures up under. It appears here, in the
# folder this program writes them to, and in rc.xml's <theme><name>. Those three
# have to agree or the buttons simply do not appear.
THEME_NAME = "Aquarius"


def titlebar_padding_height(scale):
    """
    Work out the padding that gives us a 38px title bar.

    labwc 0.20.2 has no "make the title bar this tall" setting — the key that
    used to do it, titlebar.height, was removed, and the compositor now works
    the height out for itself:

        height = max(active font height, inactive font height,
                     window.button.height)
                 + 2 x window.titlebar.padding.height

    The button disc (20 design px) is always taller than the title font (13
    design px, so about 16px of line box), so the button height is what the
    MAX picks, and the padding is the only free number left. Solving for it:

        padding = (wanted height - button height) / 2

    Integer division, so at some scales the finished bar is one pixel short of
    the wanted number rather than one pixel over. The exact height this produces
    is written into the generated file as a comment, so nobody has to redo this
    arithmetic to find out what they got.
    """
    return max(0, (px(TITLEBAR_HEIGHT, scale) - px(BUTTON_DISC, scale)) // 2)


# =============================================================================
# themerc-override — every colour and size labwc draws with
# =============================================================================
# THE FILE FORMAT, IN THREE SENTENCES. One `key: value` per line. A line whose
# FIRST character is # is a comment, and there is no end-of-line comment syntax
# at all — labwc splits on the first colon and takes EVERYTHING after it as the
# value, so `menu.width.min: 240   # why` sets the width to that whole string,
# which is not a number, and labwc throws the setting away without a word.
# Every explanation this program writes therefore goes on a line of its own.


def build_themerc(palette, scheme, scale):
    disc_idle = DISC_IDLE[scheme]
    pad_y = titlebar_padding_height(scale)
    achieved = px(BUTTON_DISC, scale) + 2 * pad_y

    out = []

    def comment(*lines):
        for line in lines:
            out.append("# " + line if line else "#")

    def setting(key, value):
        out.append("%s: %s" % (key, value))

    def blank():
        out.append("")

    comment(
        "=" * 75,
        "GENERATED FILE — DO NOT EDIT. Your changes will be thrown away.",
        "=" * 75,
        "",
        "Written by %s" % os.path.abspath(__file__),
        "out of the shell's own palette.",
        "",
        "  theme      : %s" % scheme,
        "  palette    : theme/%s.qml" % scheme.capitalize(),
        "  AQ_UI_SCALE: %s" % ("%g" % scale),
        "",
        "TO CHANGE A COLOUR, edit theme/Ice.qml or theme/Midnight.qml and log",
        "back in. There is no second copy of the palette to keep in step any",
        "more; this file IS the second copy, and it is made, not typed.",
        "",
        "Colours are written labwc's way, #rrggbbaa, with the opacity LAST. The",
        "QML writes the same colour #aarrggbb, with the opacity first.",
        "=" * 75,
    )
    blank()

    # -- the desktop right-click menu -----------------------------------------
    comment(
        "-" * 75,
        "The menu that opens when you right-click the wallpaper",
        "-" * 75,
        "It should read as the same object as the shell's own menu under the",
        "Aquarius mark: one card, one hairline around it, and the row under the",
        "pointer lit with a wash of the accent.",
    )
    setting("menu.width.min", px(MENU_WIDTH, scale))
    setting("menu.width.max", px(MENU_WIDTH, scale))
    setting("menu.border.width", px(BORDER_WIDTH, scale))
    setting("menu.border.color", qml_to_labwc(palette["lineStrong"]))
    setting("menu.items.padding.x", px(MENU_PADDING_X, scale))
    setting("menu.items.padding.y", px(MENU_PADDING_Y, scale))
    setting("menu.items.bg.color", qml_to_labwc(palette["surface"]))
    setting("menu.items.text.color", qml_to_labwc(palette["ink"]))
    setting("menu.items.active.bg.color", qml_to_labwc(palette["accentWash"]))
    setting("menu.items.active.text.color", qml_to_labwc(palette["ink"]))
    setting("menu.separator.width", px(BORDER_WIDTH, scale))
    setting("menu.separator.color", qml_to_labwc(palette["line"]))
    setting("menu.separator.padding.width", px(MENU_SEPARATOR_MARGIN, scale))
    setting("menu.separator.padding.height", px(MENU_SEPARATOR_MARGIN, scale))
    setting("menu.title.bg.color", qml_to_labwc(palette["surfaceAlt"]))
    setting("menu.title.text.color", qml_to_labwc(palette["inkSoft"]))
    setting("menu.title.text.justify", "Left")
    blank()

    # -- the window frame ------------------------------------------------------
    comment(
        "-" * 75,
        "The title bar and the border around every window",
        "-" * 75,
        "A window frame is chrome, and chrome that draws attention to itself is",
        "chrome you end up looking at. So: the panel colour for the window you",
        "are in, one step down the surface ladder for the ones you are not, and",
        "no accent colour anywhere.",
        "",
        "The window switcher (the overlay while Super+Tab is held) is not given",
        "keys of its own: labwc already inherits its background, its border and",
        "its text colour from the four lines below.",
    )
    setting("border.width", px(BORDER_WIDTH, scale))
    setting("window.active.border.color", qml_to_labwc(palette["lineStrong"]))
    setting("window.inactive.border.color", qml_to_labwc(palette["line"]))
    setting("window.active.title.bg.color", qml_to_labwc(palette["panel"]))
    setting("window.inactive.title.bg.color", qml_to_labwc(palette["surfaceAlt"]))
    setting("window.active.label.text.color", qml_to_labwc(palette["ink"]))
    setting("window.inactive.label.text.color", qml_to_labwc(palette["inkMute"]))
    setting("window.label.text.justify", "Center")
    blank()

    # -- the buttons -----------------------------------------------------------
    comment(
        "-" * 75,
        "How much room the round window buttons get",
        "-" * 75,
        "The buttons themselves are PICTURES, not colours: this program draws",
        "one SVG per button per state into the theme folder, and each picture",
        "already contains its own disc and its own glyph. The four numbers here",
        "only say how much room labwc gives each picture and how far apart they",
        "sit.",
        "",
        "window.button.hover.bg.color is deliberately absent. labwc paints that",
        "wash only when a button has NO hover picture of its own, and we ship a",
        "hover picture for every button — so setting it would describe a thing",
        "that never happens.",
        "",
        "⚠️ THE TITLE BAR'S HEIGHT IS NOT A SETTING IN labwc 0.20. The key that",
        "used to do it, titlebar.height, was removed; labwc now works the height",
        "out as",
        "",
        "    max(font height, window.button.height) + 2 x padding.height",
        "",
        "so the padding below is chosen to land on the design's %d px." % TITLEBAR_HEIGHT,
        "At this scale that gives a title bar of %d px." % achieved,
    )
    setting("window.button.width", px(BUTTON_DISC, scale))
    setting("window.button.height", px(BUTTON_DISC, scale))
    setting("window.button.spacing", px(BUTTON_SPACING, scale))
    setting("window.titlebar.padding.width", px(BUTTON_EDGE_PAD, scale))
    setting("window.titlebar.padding.height", pad_y)
    blank()

    comment(
        "-" * 75,
        "The one thing below that is NOT about our own buttons",
        "-" * 75,
        "If a button picture ever fails to load, labwc falls back to a built-in",
        "one-colour glyph and paints its own hover wash behind it. These three",
        "lines make that fallback look like the rest of the design rather than",
        "like Openbox — a round wash in the theme's ink, and the glyph in the",
        "same two inks as the window's title.",
    )
    setting(
        "window.active.button.unpressed.image.color", qml_to_labwc(palette["ink"])
    )
    setting(
        "window.inactive.button.unpressed.image.color",
        qml_to_labwc(palette["inkMute"]),
    )
    setting("window.button.hover.bg.color", at_percent(palette["ink"], disc_idle))
    setting("window.button.hover.bg.corner-radius", px(BUTTON_DISC, scale) // 2)

    return "\n".join(out) + "\n"


# =============================================================================
# THE BUTTONS — one small SVG per button, per state
# =============================================================================
# labwc looks for these in a THEME folder rather than beside its settings, and
# it looks for them by exact name:
#
#   close-active.svg          the window you are in, pointer elsewhere
#   close_hover-active.svg    the window you are in, pointer on the button
#   close-inactive.svg        a window you are not in
#   close_hover-inactive.svg  a window you are not in, pointer on the button
#
# and the same four for `iconify` (minimise), `max` (maximise) and
# `max_toggled` (the maximise button while the window IS maximised).
#
# THE DESIGN CALLS FOR A THIRD STATE, PRESSED, AND labwc HAS NO SUCH STATE.
# There is no close_pressed-active.svg in labwc 0.20.2 — its button states are
# default, hover, toggled and rounded, and the source says a pressed state may
# be added "in future". So a button held down looks like a hovered one. Nothing
# here pretends otherwise.
#
# max_toggled is drawn with the SAME glyph as max, because the design sheet does
# not draw a "restore" glyph and inventing one would be a design decision. The
# alternative — leaving it out — is worse: labwc would fall back to its own
# built-in bare bitmap with no disc behind it, and one button would visibly not
# match the other two.
#
# The pictures are SVG rather than PNG on purpose. labwc looks for png first,
# then svg, then xbm; our labwc is built with rsvg (the build checks for
# "+rsvg"), and an SVG is re-drawn at whatever size the button is AND at the
# monitor's own scale, so one file is sharp on every screen. An SVG also keeps
# its own colours — only .xbm files get re-coloured by the themerc — which is
# what makes a red close button possible at all.

SVG_HEAD = (
    '<?xml version="1.0" encoding="UTF-8"?>\n'
    "<!-- GENERATED by generate-theme. Do not edit. -->\n"
    "<!-- {what} -->\n"
    '<svg xmlns="http://www.w3.org/2000/svg" width="{box}" height="{box}" '
    'viewBox="0 0 {box} {box}">\n'
)


def glyph_paths(kind, colour, stroke):
    """
    The lines that make one glyph, drawn inside a 20-unit square.

    The design gives the glyph a 12-unit box in the middle of the 20-unit disc,
    a stroke of 1.8, and three shapes:

        close     an X          two diagonals corner to corner of the box
        iconify   a dash        one horizontal line across the middle
        max       a square      7 x 7, corners rounded by 1.2
    """
    centre = BUTTON_DISC / 2.0
    half = BUTTON_GLYPH_BOX / 2.0
    common = (
        'stroke="%s" stroke-width="%s" stroke-linecap="round" '
        'stroke-linejoin="round" fill="none"' % (colour, stroke)
    )

    if kind == "close":
        a, b = centre - half, centre + half
        return [
            '  <line x1="%.2f" y1="%.2f" x2="%.2f" y2="%.2f" %s/>' % (a, a, b, b, common),
            '  <line x1="%.2f" y1="%.2f" x2="%.2f" y2="%.2f" %s/>' % (a, b, b, a, common),
        ]

    if kind == "iconify":
        a, b = centre - half, centre + half
        return [
            '  <line x1="%.2f" y1="%.2f" x2="%.2f" y2="%.2f" %s/>'
            % (a, centre, b, centre, common)
        ]

    # max, and max_toggled, which is deliberately the same picture
    side = float(MAX_SQUARE)
    origin = centre - side / 2.0
    return [
        '  <rect x="%.2f" y="%.2f" width="%.2f" height="%.2f" rx="%s" ry="%s" %s/>'
        % (origin, origin, side, side, MAX_SQUARE_RADIUS, MAX_SQUARE_RADIUS, common)
    ]


def build_button_svg(palette, scheme, kind, hovered, active):
    """One button picture, as SVG text."""
    ink = rgb_of(palette["ink"])

    if hovered and kind == "close":
        # The one button that changes colour rather than weight, because the one
        # button you can press by accident and not undo should say so.
        disc_fill = rgb_of(palette["danger"])
        disc_opacity = "1"
        glyph_colour = rgb_of(palette["inkOnAccent"])
        what = "close, pointer over it — the disc goes to the theme's danger colour"
    else:
        disc_fill = ink
        disc_opacity = svg_opacity(
            DISC_HOVER[scheme] if hovered else DISC_IDLE[scheme]
        )
        glyph_colour = ink
        what = "%s, %s" % (kind, "pointer over it" if hovered else "at rest")

    what += ", %s window, %s" % ("focused" if active else "unfocused", scheme)

    body = [SVG_HEAD.format(what=what, box=BUTTON_DISC)]

    # A window you are not in draws the WHOLE button faded, disc and glyph
    # together, rather than fading the two separately — one group, one opacity.
    if active:
        body.append("  <g>\n")
    else:
        body.append('  <g opacity="%s">\n' % svg_opacity(INACTIVE_OPACITY))

    radius = BUTTON_DISC / 2.0
    body.append(
        '  <circle cx="%.2f" cy="%.2f" r="%.2f" fill="%s" fill-opacity="%s"/>\n'
        % (radius, radius, radius, disc_fill, disc_opacity)
    )
    for line in glyph_paths(kind, glyph_colour, BUTTON_STROKE):
        body.append(line + "\n")

    body.append("  </g>\n</svg>\n")
    return "".join(body)


BUTTON_KINDS = ("close", "iconify", "max", "max_toggled")


def button_files(palette, scheme):
    """Every button picture for one theme: name -> SVG text."""
    files = {}
    for kind in BUTTON_KINDS:
        glyph = "max" if kind == "max_toggled" else kind
        for hovered in (False, True):
            for active in (True, False):
                name = "%s%s-%s.svg" % (
                    kind,
                    "_hover" if hovered else "",
                    "active" if active else "inactive",
                )
                files[name] = build_button_svg(
                    palette, scheme, glyph, hovered, active
                )
    return files


# =============================================================================
# rc.xml — the same file, with three regions filled in
# =============================================================================
# The shipped rc.xml is a template. Three regions in it are marked:
#
#   <!-- AQ-GENERATED-BEGIN corner-radius -->
#   ...anything...
#   <!-- AQ-GENERATED-END corner-radius -->
#
# and this program replaces what is between them. Everything else — every key
# binding, every comment, every blank line — is copied through byte for byte, so
# the file a person reads in the repository and the file labwc reads at runtime
# differ only in the three places that HAVE to differ.
#
# The markers are XML comments, so the template is valid XML on its own and the
# drift check (which parses both repositories' copies and compares them element
# by element) is unaffected by them.

# Which side the buttons sit on, and in which order.
#
# labwc's <layout> splits left from right with exactly one colon. The design
# says close is always the OUTERMOST button — furthest from the title — so on
# the left it comes first and on the right it comes last.
#
# The labwc names are not the English ones: minimise is `iconify` and maximise
# is `max`.
BUTTON_LAYOUTS = {
    "mac": "close,iconify,max:",
    "windows": ":iconify,max,close",
}

# The same decision said in GTK's language, for `gtk-decoration-layout` in
# settings.ini. GTK spells the buttons out in English — `minimize`, `maximize`,
# `close` — and splits the two sides with one colon, exactly as labwc does.
# A GNOME application draws its own title bar, so this is the only way it can be
# told which side Royce chose. See neutralise_gtk_settings() below.
GTK_DECORATION_LAYOUTS = {
    "mac": "close,minimize,maximize:",
    "windows": ":minimize,maximize,close",
}

# The icon theme that goes with each palette. Both ship in the AquariusOS image
# (/usr/share/icons); on a plain Fedora clone neither exists, which is why
# nothing below sets one without looking first.
ICON_THEMES = {"ice": "Aquarius-Ice", "midnight": "Aquarius-Midnight"}

# The cursor theme. AquariusOS has none of its own yet, and Adwaita's is what
# every Fedora machine has — it is named here so that a KDE-era
# `gtk-cursor-theme-name=breeze_cursors` left behind in somebody's settings.ini
# has something to be replaced BY. When an Aquarius cursor set exists, this is
# the one line that changes.
CURSOR_THEME = "Adwaita"


def generated_region(name, body, indent):
    lines = ["%s<!-- AQ-GENERATED-BEGIN %s -->" % (indent, name)]
    lines.extend("%s%s" % (indent, line) for line in body)
    lines.append("%s<!-- AQ-GENERATED-END %s -->" % (indent, name))
    return "\n".join(lines)


def fill_region(text, name, body):
    """Replace one AQ-GENERATED region, keeping the indentation it had."""
    pattern = re.compile(
        r"(?P<indent>[ \t]*)<!--\s*AQ-GENERATED-BEGIN\s+%s\s*-->.*?"
        r"[ \t]*<!--\s*AQ-GENERATED-END\s+%s\s*-->" % (re.escape(name), re.escape(name)),
        re.DOTALL,
    )
    match = pattern.search(text)
    if not match:
        die(
            "rc.xml has no region marked '%s'.\n"
            "This program fills in three regions of the shipped rc.xml, each\n"
            "marked with a pair of comments:\n"
            "    <!-- AQ-GENERATED-BEGIN %s -->\n"
            "    <!-- AQ-GENERATED-END %s -->\n"
            "One of them is missing, so the setting it carries would silently\n"
            "keep labwc's default." % (name, name, name)
        )
    return pattern.sub(
        lambda _: generated_region(name, body, match.group("indent")), text, count=1
    )


def build_rc_xml(template, scale, buttons):
    text = template

    text = fill_region(
        text,
        "corner-radius",
        ["<cornerRadius>%d</cornerRadius>" % px(CORNER_RADIUS, scale)],
    )

    text = fill_region(
        text,
        "titlebar-layout",
        [
            "<titlebar>",
            "  <layout>%s</layout>" % BUTTON_LAYOUTS[buttons],
            "</titlebar>",
        ],
    )

    text = fill_region(
        text,
        "fonts",
        [
            '<font place="MenuItem">',
            "  <name>Inter</name>",
            "  <size>%d</size>" % pt(MENU_FONT_SIZE, scale),
            "</font>",
            '<font place="MenuHeader">',
            "  <name>Inter</name>",
            "  <size>%d</size>" % pt(MENU_HEADER_FONT_SIZE, scale),
            "</font>",
            '<font place="ActiveWindow">',
            "  <name>Inter</name>",
            "  <size>%d</size>" % pt(TITLE_FONT_SIZE, scale),
            "  <weight>%s</weight>" % TITLE_FONT_WEIGHT,
            "</font>",
            '<font place="InactiveWindow">',
            "  <name>Inter</name>",
            "  <size>%d</size>" % pt(TITLE_FONT_SIZE, scale),
            "  <weight>%s</weight>" % TITLE_FONT_WEIGHT,
            "</font>",
        ],
    )

    return text


# =============================================================================
# GTK — the one place AquariusOS colours somebody else's windows
# =============================================================================
# WHY IT IS NEEDED — found on the bench, 7 September 2026
#
#   GNOME's own applications do not let labwc put a title bar on them. Files,
#   Settings, Ptyxis, Text Editor, Image Viewer and Document Viewer all draw
#   their own bar INSIDE the window and tell the compositor not to add one. So
#   the Aquarius window frame this program builds — the navy bar, the round
#   buttons, the 12px corners — appeared on nothing that came from GNOME. Those
#   windows sat on an Aquarius desktop wearing libadwaita's grey bar and
#   libadwaita's own flat buttons. Not broken; plainly from a different design.
#
#   There is exactly one way to reach a window that draws its own bar, and it is
#   GTK's own stylesheet. So this program writes one small stylesheet per user
#   and GTK reads it at start-up.
#
# WHAT IS IN IT, AND WHAT IS DELIBERATELY NOT
#
#   In it:   the window background colour, the header-bar background colour, and
#            the three window buttons redrawn as the design's "mix B" — a round
#            disc of ink behind a glyph, deepening under the pointer, with only
#            close taking colour, and the whole button faded on a window you are
#            not in. The same picture labwc draws on every other window.
#
#   Not in it: text colours, widget theming, borders, the header bar's HEIGHT,
#            and anything at all that is not window chrome. Everything else in a
#            GNOME window still comes from libadwaita and still follows it.
#
#   That is design rule 9, as Royce widened it on 7 September 2026. Before that
#   day this file was two colour properties, dark only, and was DELETED in light
#   mode. It is now written in both schemes.
#
# WHY IT IS WRITTEN INTO THE USER'S HOME RATHER THAN SHIPPED IN /usr
#
#   The colours are different in Ice and in Midnight, and GTK's CSS has no
#   "only when the desktop is dark" selector — a stylesheet is loaded or it is
#   not. So the file has to be REWRITTEN every time somebody flips between light
#   and dark, which means it has to live somewhere writable. On AquariusOS /usr
#   is read-only, so the only place left is the user's own configuration folder.
#
#   ⚠️ THE HONEST LIMIT OF THAT. ~/.config/gtk-4.0/gtk.css is not the Aquarius
#   session's private property — every GTK application this user runs reads it,
#   including one started from the GNOME fallback session on the login screen.
#   That is harmless (they are our palette's own quiet blues, and only chrome),
#   but it does NOT follow GNOME's own light/dark switch: it keeps whichever
#   scheme the Aquarius session wrote last. Somebody who logs into GNOME, in
#   light mode, after leaving Aquarius in Midnight, gets navy window chrome
#   until they visit the Aquarius session again. Fixing that properly needs a
#   file GTK reloads per session, which GTK does not offer.
#
# ⚠️ IT WILL NOT OVERWRITE A FILE IT DID NOT WRITE. If gtk.css already exists
# and does not carry one of the marker lines below, this program leaves it
# exactly where it is and says so. Somebody's own GTK customisation is theirs.
#
# -----------------------------------------------------------------------------
# THE SELECTORS, CHECKED AGAINST THE REAL LIBRARIES RATHER THAN REMEMBERED
# -----------------------------------------------------------------------------
# Every selector below was read out of the compiled stylesheet that ships inside
# libadwaita on a Fedora 44 AquariusOS machine — `gresource extract
# /usr/lib64/libadwaita-1.so.0 /org/gnome/Adwaita/styles/gtk.css` — and out of
# GTK 4.22.4's own theme. What that says, word for word:
#
#     windowcontrols > button          { min-width: 24px; padding: 5px; }
#     windowcontrols > button > image  { background-color: ...currentColor 10%;
#                                        border-radius: 100%; padding: 4px; }
#     windowcontrols > button:hover  > image  { ...currentColor 15% }
#     windowcontrols > button:active > image  { ...currentColor 30% }
#
# So libadwaita ALREADY draws a round disc, and it draws it on the picture
# (`image`) rather than on the button. That is the node this file colours, which
# is why nothing here has to switch libadwaita's own disc off first.
#
# The three buttons are told apart by a CSS class each. That was confirmed by
# reading the machine code of GTK 4.22.4's window-controls widget, where the
# calls are literally `gtk_widget_add_css_class(button, "close")`, `"minimize"`
# and `"maximize"`. There is no `titlebutton` class in GTK 4 any more — that one
# was GTK 3's, and the GTK 3 half of this file still uses it.
#
# ⚠️ WHY THE BUTTON PICTURES ARE NOT REUSED HERE. This program already draws the
# three buttons as SVG files for labwc, and pointing GTK at those very files
# would have been the tidiest possible answer: one picture, two window managers.
# It does not work. GTK's `-gtk-icon-source` property, the only way to hand a
# file to a widget from CSS, is honoured only by GTK's own BUILT-IN icon nodes
# (the check mark, the radio dot, the expander arrow, the sort indicator). A
# window button's picture is a GtkImage, which draws a paintable it was handed
# in C and never looks at the stylesheet for a source. Checked: in the whole of
# GTK 4.22.4's theme and the whole of libadwaita's, `-gtk-icon-source` is never
# once set on an `image` node. So the disc is rebuilt here in plain CSS and the
# glyph inside it stays libadwaita's own. The colours, the opacities and the
# sizes are the design; the exact stroke of the X is not.
#
# ⚠️ WHY THESE RULES WIN. GTK sorts stylesheets by PRIORITY before it looks at
# how specific a selector is, and a file in the user's configuration folder is
# loaded above the theme. So `windowcontrols > button > image` here beats
# libadwaita's longer selectors, and there is no need to write anything longer
# or to shout `!important`.

# The line that says "we wrote this, so we may overwrite it".
GTK_MARKER = "AquariusOS — generated by generate-theme"

# The marker this file carried before 7 September 2026, when it was Midnight
# only. Bench machines already have files stamped with it. Without this second
# name every one of those accounts would keep its old two-line file for ever,
# because the safety check above would decide the file was somebody else's.
GTK_MARKER_OLD = "AquariusOS Midnight — generated by generate-theme"

GTK_MARKERS = (GTK_MARKER, GTK_MARKER_OLD)


def css_rgba(value, percent=100):
    """
    One palette colour, written the way both GTK 3 and GTK 4 read it.

    `rgba(22, 39, 58, 0.100)` is chosen over `#16273A1A` and over GTK's own
    `alpha()` helper because plain rgba() is the one spelling that every version
    of GTK 3 and GTK 4 has always understood. There is no cleverness to go wrong
    here on a future Fedora.
    """
    digits = rgb_of(value).lstrip("#")
    red, green, blue = (int(digits[i:i + 2], 16) for i in (0, 2, 4))
    if percent >= 100:
        return "rgb(%d, %d, %d)" % (red, green, blue)
    return "rgba(%d, %d, %d, %.3f)" % (red, green, blue, percent / 100.0)


def build_gtk_css(palette, scheme):
    """
    The GTK 4 stylesheet: two window colours and three window buttons.

    Sizes here are written WITHOUT AQ_UI_SCALE on purpose. Everywhere else in
    this program a size is multiplied by the scale, because labwc counts in real
    screen pixels. GTK does its own scaling: a number in a GTK stylesheet is a
    logical pixel, and GTK multiplies it for the display. Multiplying it here as
    well would make the buttons grow twice.
    """
    ink = palette["ink"]
    idle = DISC_IDLE[scheme]
    hover = DISC_HOVER[scheme]

    return "\n".join(
        [
            "/* %s. Do not edit; it is rewritten on every light/dark flip. */"
            % GTK_MARKER,
            "/*",
            " * Scheme: %s. Colours from the shell's theme/%s.qml, which is the"
            % (scheme, scheme.capitalize()),
            " * only place any colour in this project is written down.",
            " *",
            " * This file styles WINDOW CHROME AND NOTHING ELSE: the window",
            " * background, the header-bar background, and the three window",
            " * buttons. It exists because GNOME applications draw their own",
            " * title bar, so the Aquarius window frame never appears on them.",
            " * No text colours, no widget theming, no header-bar height.",
            " */",
            "",
            "/* 1. The two window colours. */",
            "window { background-color: %s; }" % rgb_of(palette["bg"]),
            "headerbar { background-color: %s; }" % rgb_of(palette["panel"]),
            "",
            "/* 2. The three window buttons, drawn the way labwc draws them:",
            " *    a %dpx round disc of ink at %d%%, glyph in ink, disc deepening"
            % (BUTTON_DISC, idle),
            " *    to %d%% under the pointer. Only close takes colour." % hover,
            " *    libadwaita puts the disc on the picture, not on the button,",
            " *    so `> image` is the node these rules colour.",
            " */",
            "windowcontrols > button > image {",
            "  background-color: %s;" % css_rgba(ink, idle),
            "  color: %s;" % css_rgba(ink),
            "  border-radius: 100%;",
            "  min-width: %dpx;" % BUTTON_GLYPH_BOX,
            "  min-height: %dpx;" % BUTTON_GLYPH_BOX,
            "  -gtk-icon-size: %dpx;" % BUTTON_GLYPH_BOX,
            "  padding: %dpx;" % ((BUTTON_DISC - BUTTON_GLYPH_BOX) // 2),
            "}",
            "",
            "/* Pointer on any of the three: the disc deepens. */",
            "windowcontrols > button:hover > image {",
            "  background-color: %s;" % css_rgba(ink, hover),
            "}",
            "",
            "/* 2b. The minimise line, drawn HERE rather than by the icon theme.",
            " *",
            " * Design rule 9 says the minimise mark is a line across the MIDDLE",
            " * of the disc, and that is what labwc draws on every other window.",
            " * The glyph GNOME applications use is Adwaita's own",
            " * window-minimize-symbolic, which is a bar sitting LOW in its box:",
            " * `m 4 10.007812 h 8 v 1.988282 h -8 z` in a 16px square, so its",
            " * centre is at 11 of 16 where the middle is 8. Drawn inside our",
            " * %dpx disc that lands about %.2fpx below centre, and it is what"
            % (BUTTON_DISC, (11.0 / 16.0 - 0.5) * BUTTON_GLYPH_BOX),
            " * Royce saw on the bench on 8 September 2026: \"the line should be",
            " * in the middle of the circle, not at the bottom\".",
            " *",
            " * It cannot be swapped for our own picture — GTK's",
            " * -gtk-icon-source is honoured only by GTK's own built-in icon",
            " * nodes, never by the GtkImage a window button uses (checked",
            " * against the whole of GTK 4.22.4's theme and libadwaita's). So",
            " * the glyph is turned off and the line is drawn by the stylesheet.",
            " *",
            " * `color: transparent` is how it is turned off, and that is not a",
            " * trick: `color` IS how GTK tints a symbolic icon, and the rules",
            " * above already rely on it (that is what turns the X white on a",
            " * red close button). A colour with no opacity draws nothing.",
            " *",
            " * The line itself is a one-colour gradient — the ordinary CSS way",
            " * of asking for a solid block — sized, centred and not repeated.",
            " * It survives the hover rules above because they only change the",
            " * disc's background COLOUR, and this is a background IMAGE.",
            " */",
            "windowcontrols > button.minimize > image {",
            "  color: transparent;",
            "  background-image: linear-gradient(%s, %s);" % (css_rgba(ink), css_rgba(ink)),
            "  background-size: %dpx %dpx;" % (BUTTON_GLYPH_BOX, MINIMISE_LINE_WIDTH),
            "  background-position: center;",
            "  background-repeat: no-repeat;",
            "}",
            "",
            "/* Pointer on close, and close only: the disc takes the theme's",
            " * danger colour, because the one button you can press by accident",
            " * and not undo should say so.",
            " */",
            "windowcontrols > button.close:hover > image {",
            "  background-color: %s;" % rgb_of(palette["danger"]),
            "  color: %s;" % rgb_of(palette["inkOnAccent"]),
            "}",
            "",
            "/* A window you are not in: the whole button at %d%%, disc and"
            % INACTIVE_OPACITY,
            " * glyph together, exactly as the -inactive button pictures do.",
            " *",
            " * Honest limit: an application built the older way, without",
            " * AdwToolbarView, already fades its whole header bar to a half",
            " * when it loses focus, and the two fades multiply — its buttons",
            " * come out fainter than %d%%. The applications this was written" % INACTIVE_OPACITY,
            " * for (Files, Settings, Ptyxis, Text Editor) do not do that, so",
            " * they land exactly here.",
            " *",
            " * The fade is put on the BUTTON rather than on the disc, so a",
            " * pointer resting on an unfocused window still deepens the disc",
            " * and still turns close red, faded — which is exactly what the",
            " * *_hover-inactive button pictures show on every other window.",
            " */",
            "windowcontrols > button:backdrop {",
            "  opacity: %.2f;" % (INACTIVE_OPACITY / 100.0),
            "}",
            "",
        ]
    )


def build_gtk3_css(palette, scheme):
    """
    The same thing for GTK 3, which names everything differently.

    GTK 3 has no `windowcontrols` node at all. Its window buttons are plain
    buttons inside the header bar, marked `button.titlebutton`, plus one of
    `.close`, `.minimize` or `.maximize` — and GTK 3 draws its disc on the
    BUTTON, not on the picture inside it. So the same design is written out a
    second time against those names. It is a short file and the buttons are done
    properly rather than colours-only, because the shapes are the same three.

    Hardly any GTK 3 applications are left on an AquariusOS machine, so this
    half is deliberately not gold-plated: the disc, the hover, the red close and
    the faded unfocused state, and nothing more.
    """
    ink = palette["ink"]
    idle = DISC_IDLE[scheme]
    hover = DISC_HOVER[scheme]

    return "\n".join(
        [
            "/* %s. Do not edit; it is rewritten on every light/dark flip. */"
            % GTK_MARKER,
            "/*",
            " * The GTK 3 twin of ~/.config/gtk-4.0/gtk.css. Same scheme (%s),"
            % scheme,
            " * same palette, same rule: window chrome only.",
            " *",
            " * GTK 3 names the window buttons `button.titlebutton` and draws",
            " * their disc on the button itself, so these selectors do not look",
            " * like the GTK 4 ones even though the picture is the same.",
            " */",
            "",
            "window { background-color: %s; }" % rgb_of(palette["bg"]),
            "headerbar { background-color: %s; }" % rgb_of(palette["panel"]),
            "",
            "headerbar button.titlebutton {",
            "  background-image: none;",
            "  background-color: %s;" % css_rgba(ink, idle),
            "  color: %s;" % css_rgba(ink),
            "  border: none;",
            "  box-shadow: none;",
            "  border-radius: 100%;",
            "  min-width: %dpx;" % BUTTON_DISC,
            "  min-height: %dpx;" % BUTTON_DISC,
            "  padding: 0;",
            "}",
            "",
            "headerbar button.titlebutton:hover {",
            "  background-color: %s;" % css_rgba(ink, hover),
            "}",
            "",
            "/* The minimise line, centred. Same reasoning as the GTK 4 half —",
            " * the icon theme's own glyph is a bar low in its box, and the",
            " * design says the middle. GTK 3 draws the disc on the BUTTON, so",
            " * the line goes on the button too: a background IMAGE over the",
            " * background COLOUR that makes the disc.",
            " */",
            "headerbar button.titlebutton.minimize {",
            "  color: transparent;",
            "  background-image: linear-gradient(%s, %s);" % (css_rgba(ink), css_rgba(ink)),
            "  background-size: %dpx %dpx;" % (BUTTON_GLYPH_BOX, MINIMISE_LINE_WIDTH),
            "  background-position: center;",
            "  background-repeat: no-repeat;",
            "}",
            "",
            "headerbar button.titlebutton.close:hover {",
            "  background-color: %s;" % rgb_of(palette["danger"]),
            "  color: %s;" % rgb_of(palette["inkOnAccent"]),
            "}",
            "",
            "headerbar button.titlebutton:backdrop {",
            "  opacity: %.2f;" % (INACTIVE_OPACITY / 100.0),
            "}",
            "",
        ]
    )


# =============================================================================
# TELLING SOMEBODY'S OWN GTK FILE FROM A MACHINE'S
# =============================================================================
# ⚠️ THIS IS THE SECTION THAT COST A BENCH RUN. Read the whole note.
#
# WHAT HAPPENED. On 8 September 2026 Royce looked at a GNOME window on
# AquariusOS and saw libadwaita's stock buttons: the minimise line at the bottom
# of the disc, and no red on the close button under the pointer. The reason was
# not in the stylesheet this program builds. The stylesheet was never written.
#
# `~/.config/gtk-4.0/gtk.css` on that machine was two lines, dated 2026-08-30:
#
#     @import 'colors.css';
#     @import 'kde_window_geometry.css';
#
# left behind by a KDE Plasma desktop's GTK integration months earlier, with a Breeze
# `colors.css`, a `kde_window_geometry.css` and a `settings.ini` naming
# `breeze-dark` icons and `breeze_cursors`. The rule below — never overwrite a
# file we did not write — did exactly what it was told, and, because it said so
# only through `report()`, which the shell silences with `--quiet`, it said it
# to nobody. A refusal nobody hears is indistinguishable from a bug.
#
# TWO THINGS ARE FIXED HERE, AND THE SECOND MATTERS MORE THAN THE FIRST.
#
#   1. A file that is plainly a PROGRAM'S OUTPUT — not a person's — may be moved
#      aside once and replaced. What counts as "plainly a program's output" is
#      deliberately narrow; see is_machine_written() below.
#   2. THIS PROGRAM NOW ALWAYS SAYS WHAT IT DID, on stderr, in one sentence,
#      whether it wrote, moved something aside, or declined. --quiet silences
#      the running commentary and never silences this. The shell collects the
#      generator's stderr into the session log, so the answer to "why are my
#      window buttons wrong" is now one grep away.
#
# THE RULE THAT DOES NOT CHANGE: a gtk.css a PERSON wrote is theirs. It is left
# exactly where it is, and the Aquarius chrome is skipped for that toolkit. The
# test below is written so that it cannot possibly match a hand-written file —
# a person's stylesheet contains rules, and this only matches a file whose whole
# content is imports of other files that are themselves recognisably Breeze.

# What Plasma's GTK integration leaves behind. Each entry is (file it writes,
# a phrase that appears in that file and in nothing a person would type).
BREEZE_SIGNATURES = (
    ("colors.css", "_breeze"),                       # @define-color …_breeze
    ("kde_window_geometry.css", "Libadwaita-Breeze"),  # its own header comment
)

# The same question for settings.ini, which is a list of keys rather than a
# stylesheet. Any ONE of these means Plasma wrote the file: no person types
# `colorreload-gtk-module` by hand, and `breeze` is not a theme AquariusOS
# ships or offers.
BREEZE_SETTINGS_SIGNATURES = (
    "colorreload-gtk-module",
    "breeze",
    "Breeze",
)

# The keys the Aquarius session owns, because libadwaita reads them and they
# decide things the session has already decided somewhere else. Everything else
# in somebody's settings.ini — their font, their cursor blink, their animations
# — is left exactly as it is.
GTK_SETTINGS_WE_OWN = (
    "gtk-icon-theme-name",
    "gtk-cursor-theme-name",
    "gtk-decoration-layout",
    "gtk-application-prefer-dark-theme",
)

# The suffix a rescued file gets. Same word both times so that somebody who
# finds one knows immediately what it is and that there will be others.
RESCUE_SUFFIX = ".before-aquarius"


def announce(line):
    """
    One plain sentence about what happened to somebody's GTK configuration.

    ALWAYS printed, `--quiet` or not, and to stderr rather than stdout — the
    shell runs this program quietly on every light/dark flip and collects its
    stderr into the session log. This is the channel that did not exist on
    8 September 2026, which is why the generator's refusal was invisible.
    """
    sys.stderr.write("generate-theme: %s\n" % line)


def is_machine_written(path, text):
    """
    Is this file plainly a program's output rather than somebody's own work?

    Returns a short sentence saying WHY if it is, and None if it is not — so the
    caller can put the reason in the log rather than saying "because".

    THE TEST IS DELIBERATELY NARROW. A stylesheet counts only when everything in
    it, once comments and blank lines are gone, is an `@import` of a file that
    sits beside it AND carries a Breeze fingerprint of its own. That cannot
    match a file a person wrote, because a person's stylesheet has rules in it —
    and it cannot match an import of a file that is not there to be checked.
    """
    folder = os.path.dirname(path)

    # Strip /* … */ comments, then blank lines.
    stripped = re.sub(r"/\*.*?\*/", "", text, flags=re.DOTALL)
    lines = [line.strip() for line in stripped.splitlines() if line.strip()]
    if not lines:
        return None

    imported = []
    for line in lines:
        match = re.match(r"""^@import\s+(?:url\()?['"]?([^'")]+)['"]?\)?\s*;?$""", line)
        if not match:
            return None            # a real rule: somebody's own file. Stop.
        imported.append(os.path.basename(match.group(1).strip()))

    for name in imported:
        beside = os.path.join(folder, name)
        signature = dict(BREEZE_SIGNATURES).get(name)
        if signature is None:
            return None            # imports something we do not recognise
        try:
            with open(beside, "r", encoding="utf-8", errors="replace") as handle:
                if signature not in handle.read():
                    return None
        except OSError:
            return None            # cannot check it, so do not touch it

    return (
        "it is Plasma's own GTK stylesheet — nothing but imports of %s, which "
        "carry Breeze's fingerprints" % " and ".join(imported)
    )


def rescue_once(path):
    """
    Move a machine-written file aside, keeping the first one ever moved.

    Returns the path it was moved to, or None if there was already a rescued
    copy — in which case the original is simply removed, because the thing worth
    keeping is what was there BEFORE AquariusOS, not the second copy of it.
    """
    kept = path + RESCUE_SUFFIX
    if os.path.exists(kept):
        os.remove(path)
        return None
    os.rename(path, kept)
    return kept


def neutralise_gtk_settings(gtk_root, folder, scheme, buttons, icon_theme):
    """
    Stop a leftover settings.ini fighting the session over four keys.

    WHY THIS FILE AT ALL. `~/.config/gtk-*/settings.ini` is where GTK reads its
    defaults, and libadwaita reads it too. On the bench it still said
    `gtk-icon-theme-name=breeze-dark`, `gtk-cursor-theme-name=breeze_cursors`,
    `gtk-decoration-layout=icon:minimize,maximize,close` and
    `gtk-application-prefer-dark-theme=true` — a KDE desktop's answers, on a
    machine that has not had KDE on it since August.

    HOW MUCH OF IT THE SESSION OWNS, AND WHY NOT MORE.
      * GTK 4 on Wayland reads most of these live from the settings portal, and
        the portal answers from gsettings — so on a GNOME-portal machine, our
        gsettings values already win over this file. GTK **3** does not: it has
        no settings portal and reads settings.ini and nothing else. So the file
        matters to every GTK 3 application, and matters again to any GTK 4 one
        started before the portal is up.
      * Only the four keys in GTK_SETTINGS_WE_OWN are touched. The icon theme
        and the dark flag follow the light/dark decision; the cursor and the
        decoration layout follow decisions Royce already made once (`aq keys`
        puts the window buttons on the side he chose). Everything else in the
        file — font, cursor blink, animations, toolbar style — is somebody's
        own and is written back untouched.
      * A file with no Plasma fingerprint that already disagrees with us is
        LEFT ALONE, because at that point it is a person's preference. The one
        exception is a file we wrote ourselves, which we may rewrite.

    Returns a sentence for the log.
    """
    path = os.path.join(gtk_root, folder, "settings.ini")

    wanted = {
        "gtk-icon-theme-name": icon_theme,
        "gtk-cursor-theme-name": CURSOR_THEME,
        "gtk-decoration-layout": GTK_DECORATION_LAYOUTS[buttons],
        "gtk-application-prefer-dark-theme":
            "true" if scheme == "midnight" else "false",
    }
    if icon_theme is None:
        del wanted["gtk-icon-theme-name"]

    if not os.path.exists(path):
        # Nothing to fight with. Writing a file that was not there is not this
        # program's business: GTK's own defaults are fine, and the session sets
        # the same things through gsettings.
        return "%s does not exist, so there is nothing fighting us" % path

    try:
        with open(path, "r", encoding="utf-8") as handle:
            existing = handle.read()
    except OSError as problem:
        return "could not read %s (%s), so it is left alone" % (path, problem)

    disagrees = [
        key for key, value in wanted.items()
        if re.search(r"^\s*%s\s*=\s*(?!%s\s*$)" % (re.escape(key), re.escape(value)),
                     existing, re.MULTILINE)
    ]
    if not disagrees:
        return "%s already agrees with the session" % path

    plasma = any(sig in existing for sig in BREEZE_SETTINGS_SIGNATURES)
    ours = any(marker in existing for marker in GTK_MARKERS)
    if not plasma and not ours:
        return (
            "%s sets %s differently and looks hand-written, so it is left "
            "alone — the Aquarius session's answers are still in gsettings, "
            "which GTK 4 prefers" % (path, ", ".join(sorted(disagrees)))
        )

    # Keep the original once, then rewrite only our four keys in place.
    kept = None
    if plasma and not os.path.exists(path + RESCUE_SUFFIX):
        shutil.copyfile(path, path + RESCUE_SUFFIX)
        kept = path + RESCUE_SUFFIX

    out = []
    seen = set()
    for line in existing.splitlines():
        match = re.match(r"^\s*([a-zA-Z0-9-]+)\s*=", line)
        key = match.group(1) if match else None
        if key in wanted:
            out.append("%s=%s" % (key, wanted[key]))
            seen.add(key)
        else:
            out.append(line)

    missing = [k for k in wanted if k not in seen]
    if missing:
        # Put anything that was not there under [Settings], creating that
        # header if the file somehow has none.
        if not any(line.strip() == "[Settings]" for line in out):
            out.insert(0, "[Settings]")
        at = [i for i, line in enumerate(out) if line.strip() == "[Settings]"][0]
        for key in sorted(missing, reverse=True):
            out.insert(at + 1, "%s=%s" % (key, wanted[key]))

    write_file(path, "\n".join(out) + "\n")

    return "rewrote %s in %s%s" % (
        ", ".join(sorted(wanted)),
        path,
        " (the file it replaced is kept as %s)" % os.path.basename(kept) if kept else "",
    )


def icon_theme_for(scheme, report):
    """
    Which icon theme goes with this palette — IF it is on this machine.

    Design handoff, §5 item 4: "the icon theme should flip with the colour
    scheme: Aquarius-Midnight on dark, Aquarius-Ice on light (both ship). Today
    it is Ice always."

    NOTHING IS CHOSEN IF THE THEME IS NOT THERE. On a plain Fedora clone of this
    repository neither Aquarius icon theme exists, and pointing GTK at a theme
    that is not installed is how a desktop ends up with no icons at all. So the
    folder is looked for first, and a machine without it keeps whatever it had.

    Returns the theme name, or None.
    """
    wanted = ICON_THEMES[scheme]

    roots = [
        os.path.join(
            os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"),
            "icons"),
        "/usr/share/icons",
        "/usr/local/share/icons",
    ]
    if not any(os.path.isdir(os.path.join(r, wanted)) for r in roots):
        report("  note   %s is not installed; the icon theme is left as it is"
               % wanted)
        return None

    return wanted


def set_icon_theme(name, report):
    """
    Tell the machine to use it.

    This is done HERE rather than in the shell's QML for the same reason the
    window frames are: this program is the one place that already runs on every
    light/dark flip and already knows which scheme won. One program owning
    everything outside QML that has to follow the theme is what stops the halves
    getting out of step.

    ⚠️ THE SHELL'S OWN ICONS DO NOT FOLLOW THIS UNTIL THE NEXT LOGIN. Quickshell
    is told which icon theme to draw from by QS_ICON_THEME, read once when it
    starts, and there is no way to change it in a running instance. So a flip to
    dark gives GTK applications the Midnight icons immediately and the dock the
    Ice ones until you log in again. Said out loud rather than hidden: the
    alternative is restarting the shell under somebody, which is worse.
    """
    try:
        subprocess.run(
            ["gsettings", "set", "org.gnome.desktop.interface",
             "icon-theme", name],
            check=False, timeout=10, capture_output=True,
        )
    except (OSError, subprocess.SubprocessError) as problem:
        report("  note   could not set the icon theme (%s)" % problem)
        return

    report("  icons    : %s" % name)


def apply_gtk_css(gtk_root, palette, scheme, buttons, icon_theme, report):
    """
    Put the stylesheet in place for both GTK 4 and GTK 3.

    Since 7 September 2026 this writes in BOTH schemes. There is no longer a
    branch that removes the file in light mode — light has its own colours now,
    and removing the file would take the round window buttons away with it.

    Since 8 September 2026 it also rescues a file a PROGRAM wrote (read the long
    note above), and it always says out loud what it did.
    """
    builders = (
        ("gtk-4.0", build_gtk_css),
        ("gtk-3.0", build_gtk3_css),
    )

    for folder, builder in builders:
        path = os.path.join(gtk_root, folder, "gtk.css")

        if os.path.exists(path):
            try:
                with open(path, "r", encoding="utf-8") as handle:
                    existing = handle.read()
            except OSError as problem:
                announce("could not read %s (%s), so it is left alone. The "
                         "Aquarius window buttons will not appear on %s "
                         "applications." % (path, problem, folder))
                continue

            if not any(marker in existing for marker in GTK_MARKERS):
                reason = is_machine_written(path, existing)
                if reason is None:
                    announce(
                        "%s is not something we recognise as another "
                        "program's leftovers, so it is treated as yours and "
                        "left exactly where it is. The Aquarius window "
                        "buttons will not appear on %s applications until it "
                        "is moved or deleted."
                        % (path, folder)
                    )
                    continue

                kept = rescue_once(path)
                announce(
                    "%s was not yours — %s. It has been %s and replaced with "
                    "the Aquarius window chrome."
                    % (path, reason,
                       "kept as " + os.path.basename(kept) if kept
                       else "removed (an earlier copy is already kept beside it)")
                )

        write_file(path, builder(palette, scheme))
        report("  %-6s wrote %s" % (scheme, path))
        announce("wrote the %s window chrome into %s (%s)"
                 % (scheme, path, folder))

        announce(neutralise_gtk_settings(gtk_root, folder, scheme, buttons,
                                         icon_theme))


