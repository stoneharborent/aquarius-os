+/*
+ * ROG Xbox Ally X20 (board RC74XA): the two TAS2783 speaker amps (unique ids 8
+ * and B) are on SoundWire wire 0 and the RT721 headphone/mic chip is on wire 1.
+ * Linux 7.3's acp70_rt721_l1u0_tas2783x2_l1u8b (ASUS ProArt PX13) has the same
+ * parts but puts all three on wire 1, so it does not match this board.
+ */
+static const struct snd_soc_acpi_adr_device rc74xa_rt721_adr[] = {
+	{
+		.adr = 0x000130025D072101ull,
+		.num_endpoints = ARRAY_SIZE(jack_dmic_endpoints),
+		.endpoints = jack_dmic_endpoints,
+		.name_prefix = "rt721",
+	},
+};
+
+static const struct snd_soc_acpi_adr_device rc74xa_tas2783_adr[] = {
+	{
+		.adr = 0x0000380102000001ull,
+		.num_endpoints = 1,
+		.endpoints = &spk_l_endpoint,
+		.name_prefix = "tas2783-1",
+	},
+	{
+		.adr = 0x00003B0102000001ull,
+		.num_endpoints = 1,
+		.endpoints = &spk_r_endpoint,
+		.name_prefix = "tas2783-2",
+	},
+};
+
+static const struct snd_soc_acpi_link_adr acp70_rc74xa_links[] = {
+	{
+		.mask = BIT(0),
+		.num_adr = ARRAY_SIZE(rc74xa_tas2783_adr),
+		.adr_d = rc74xa_tas2783_adr,
+	},
+	{
+		.mask = BIT(1),
+		.num_adr = ARRAY_SIZE(rc74xa_rt721_adr),
+		.adr_d = rc74xa_rt721_adr,
+	},
+	{}
+};
