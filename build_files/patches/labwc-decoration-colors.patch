diff --git a/src/theme.c b/src/theme.c
index 71e577c..9fa2080 100644
--- a/src/theme.c
+++ b/src/theme.c
@@ -1879,3 +1879,36 @@ theme_finish(struct theme *theme)
 		zdrop(&theme->window[active].shadow_edge);
 	}
 }
+
+struct theme *
+theme_clone_decoration_colors(const struct theme *base, const float colors[6][4])
+{
+	struct theme *theme = znew(*theme);
+	*theme = *base;
+	enum ssd_active_state active;
+	FOR_EACH_ACTIVE_STATE(active) {
+		int i = active == SSD_ACTIVE ? 0 : 1;
+		theme->window[active].title_bg.gradient = LAB_GRADIENT_NONE;
+		memcpy(theme->window[active].title_bg.color, colors[i], sizeof(colors[i]));
+		memcpy(theme->window[active].border_color, colors[i + 2], sizeof(colors[i]));
+		memcpy(theme->window[active].label_text_color, colors[i + 4], sizeof(colors[i]));
+	}
+	/* Replace only these borrowed resources; the global theme keeps ownership. */
+	create_backgrounds(theme);
+	create_corners(theme);
+	return theme;
+}
+
+void
+theme_free_decoration_colors(struct theme *theme)
+{
+	enum ssd_active_state active;
+	FOR_EACH_ACTIVE_STATE(active) {
+		zfree_pattern(theme->window[active].titlebar_pattern);
+		zdrop(&theme->window[active].titlebar_fill);
+		zdrop(&theme->window[active].corner_top_left_normal);
+		zdrop(&theme->window[active].corner_top_right_normal);
+	}
+	/* Never theme_finish(): buttons and shadows still belong to the base. */
+	free(theme);
+}
diff --git a/src/window-rules.c b/src/window-rules.c
index 4118ae3..07bb404 100644
--- a/src/window-rules.c
+++ b/src/window-rules.c
@@ -2,6 +2,9 @@
 #define _POSIX_C_SOURCE 200809L
 #include "window-rules.h"
 #include <assert.h>
+#include <ctype.h>
+#include <stdlib.h>
+#include <string.h>
 #include <stdbool.h>
 #include <strings.h>
 #include "action.h"
@@ -118,3 +121,63 @@ window_rules_get_property(struct view *view, const char *property)
 	}
 	return LAB_PROP_UNSPECIFIED;
 }
+
+/*
+ * Keep this deliberately narrow: six opaque RGB colors or "default".
+ * Reject the entire palette on malformed input, never partially change it.
+ */
+bool
+window_rule_parse_decoration_colors(struct window_rule *rule, const char *value)
+{
+	if (!strcasecmp(value, "default")) {
+		rule->decoration_colors_set = true;
+		rule->decoration_colors_default = true;
+		return true;
+	}
+	float colors[6][4];
+	const char *s = value;
+	for (int i = 0; i < 6; i++) {
+		while (isspace((unsigned char)*s)) {
+			s++;
+		}
+		if (strlen(s) < 7 || *s++ != '#') {
+			return false;
+		}
+		for (int j = 0; j < 6; j++) {
+			if (!isxdigit((unsigned char)s[j])) {
+				return false;
+			}
+		}
+		for (int j = 0; j < 3; j++) {
+			char byte[3] = { s[j * 2], s[j * 2 + 1], 0 };
+			colors[i][j] = strtol(byte, NULL, 16) / 255.0f;
+		}
+		colors[i][3] = 1.0f;
+		s += 6;
+		if (*s && !isspace((unsigned char)*s)) {
+			return false;
+		}
+	}
+	while (isspace((unsigned char)*s)) {
+		s++;
+	}
+	if (*s) {
+		return false;
+	}
+	memcpy(rule->decoration_colors, colors, sizeof(colors));
+	rule->decoration_colors_set = true;
+	rule->decoration_colors_default = false;
+	return true;
+}
+
+const float (*
+window_rules_get_decoration_colors(struct view *view))[4]
+{
+	struct window_rule *rule;
+	wl_list_for_each_reverse(rule, &rc.window_rules, link) {
+		if (rule->decoration_colors_set && view_matches_rule(rule, view)) {
+			return rule->decoration_colors_default ? NULL : rule->decoration_colors;
+		}
+	}
+	return NULL;
+}
