+
+struct theme *
+theme_clone_decoration_colors(const struct theme *base, const float colors[6][4],
+	const char *button_subdir)
+{
+	assert(colors || button_subdir);
+	struct theme *theme = znew(*theme);
+	*theme = *base;
+	theme->owns_decoration_backgrounds = false;
+	theme->owns_button_imgs = false;
+
+	enum ssd_active_state active;
+	if (colors) {
+		FOR_EACH_ACTIVE_STATE(active) {
+			int i = active == SSD_ACTIVE ? 0 : 1;
+			theme->window[active].title_bg.gradient = LAB_GRADIENT_NONE;
+			memcpy(theme->window[active].title_bg.color, colors[i], sizeof(colors[i]));
+			memcpy(theme->window[active].border_color, colors[i + 2], sizeof(colors[i]));
+			memcpy(theme->window[active].label_text_color, colors[i + 4], sizeof(colors[i]));
+		}
+		/*
+		 * Replace only these borrowed resources; the global theme keeps
+		 * ownership of everything this clone did not allocate.
+		 */
+		create_backgrounds(theme);
+		create_corners(theme);
+		theme->owns_decoration_backgrounds = true;
+	}
+
+	if (button_subdir) {
+		/*
+		 * The copied pointers belong to the base theme. Drop them on the
+		 * floor FIRST — never free them — so load_buttons() sees the
+		 * empty array its assert() expects and every image this clone
+		 * ends up holding is one it allocated itself.
+		 *
+		 * Passing `base` in means load_button() falls back to the base
+		 * theme's own picture (as its own reference-counted copy) for
+		 * anything the folder does not provide. So a missing folder, an
+		 * unreadable file or a folder with only some of the buttons in
+		 * it leaves this window looking like every other window, and
+		 * never leaves a button with no picture at all.
+		 */
+		FOR_EACH_ACTIVE_STATE(active) {
+			memset(theme->window[active].button_imgs, 0,
+				sizeof(theme->window[active].button_imgs));
+		}
+		load_buttons(theme, base, button_subdir);
+		theme->owns_button_imgs = true;
+	}
+	return theme;
+}
+
+void
+theme_free_decoration_colors(struct theme *theme)
+{
+	enum ssd_active_state active;
+	if (theme->owns_decoration_backgrounds) {
+		FOR_EACH_ACTIVE_STATE(active) {
+			zfree_pattern(theme->window[active].titlebar_pattern);
+			zdrop(&theme->window[active].titlebar_fill);
+			zdrop(&theme->window[active].corner_top_left_normal);
+			zdrop(&theme->window[active].corner_top_right_normal);
+		}
+	}
+	if (theme->owns_button_imgs) {
+		for (enum lab_node_type type = LAB_NODE_BUTTON_FIRST;
+				type <= LAB_NODE_BUTTON_LAST; type++) {
+			for (uint8_t state_set = LAB_BS_DEFAULT;
+					state_set <= LAB_BS_ALL; state_set++) {
+				FOR_EACH_ACTIVE_STATE(active) {
+					destroy_img(&theme->window[active]
+						.button_imgs[type][state_set]);
+				}
+			}
+		}
+	}
+	/* Never theme_finish(): the shadows still belong to the base. */
+	free(theme);
+}
diff --git a/src/window-rules.c b/src/window-rules.c
index 4118ae3..c28e768 100644
--- a/src/window-rules.c
+++ b/src/window-rules.c
@@ -2,9 +2,13 @@
 #define _POSIX_C_SOURCE 200809L
 #include "window-rules.h"
 #include <assert.h>
+#include <ctype.h>
+#include <stdlib.h>
+#include <string.h>
 #include <stdbool.h>
 #include <strings.h>
 #include "action.h"
+#include "common/mem.h"
 #include "config/rcxml.h"
 #include "labwc.h"
 #include "view.h"
@@ -118,3 +122,126 @@ window_rules_get_property(struct view *view, const char *property)
 	}
 	return LAB_PROP_UNSPECIFIED;
 }
+
+/*
+ * Keep this deliberately narrow: six opaque RGB colors or "default".
+ * Reject the entire palette on malformed input, never partially change it.
+ *
+ * A rejected value is not the same as no value at all. The rule still said
+ * something about this window's frame colors, so it is pinned to the desktop
+ * theme rather than left to inherit the palette of some earlier, broader rule
+ * that happens to match the same window. A typo makes a window look ordinary;
+ * it never makes it wear somebody else's colors.
+ */
+static bool
+decoration_colors_use_theme(struct window_rule *rule, bool valid)
+{
+	rule->decoration_colors_set = true;
+	rule->decoration_colors_default = true;
+	return valid;
+}
+
+bool
+window_rule_parse_decoration_colors(struct window_rule *rule, const char *value)
+{
+	if (!strcasecmp(value, "default")) {
+		return decoration_colors_use_theme(rule, /* valid */ true);
+	}
+	float colors[6][4];
+	const char *s = value;
+	for (int i = 0; i < 6; i++) {
+		while (isspace((unsigned char)*s)) {
+			s++;
+		}
+		if (strlen(s) < 7 || *s++ != '#') {
+			return decoration_colors_use_theme(rule, /* valid */ false);
+		}
+		for (int j = 0; j < 6; j++) {
+			if (!isxdigit((unsigned char)s[j])) {
+				return decoration_colors_use_theme(rule, /* valid */ false);
+			}
+		}
+		for (int j = 0; j < 3; j++) {
+			char byte[3] = { s[j * 2], s[j * 2 + 1], 0 };
+			colors[i][j] = strtol(byte, NULL, 16) / 255.0f;
+		}
+		colors[i][3] = 1.0f;
+		s += 6;
+		if (*s && !isspace((unsigned char)*s)) {
+			return decoration_colors_use_theme(rule, /* valid */ false);
+		}
+	}
+	while (isspace((unsigned char)*s)) {
+		s++;
+	}
+	if (*s) {
+		return decoration_colors_use_theme(rule, /* valid */ false);
+	}
+	memcpy(rule->decoration_colors, colors, sizeof(colors));
+	rule->decoration_colors_set = true;
+	rule->decoration_colors_default = false;
+	return true;
+}
+
+/*
+ * A plain folder name, one path segment: no slash, no "..", nothing absolute.
+ * It is joined onto a theme path, so anything clever here would read files
+ * outside the theme, and there is no reason a theme folder needs it.
+ *
+ * As with the colors above, a rejected value still counts as this rule having
+ * decided: the window is pinned to the theme's own buttons and cannot inherit
+ * a folder named by an earlier, broader rule.
+ */
+static bool
+decoration_buttons_use_theme(struct window_rule *rule, bool valid)
+{
+	rule->decoration_buttons_set = true;
+	zfree(rule->decoration_buttons);
+	return valid;
+}
+
+bool
+window_rule_parse_decoration_buttons(struct window_rule *rule, const char *value)
+{
+	if (!strcasecmp(value, "default")) {
+		return decoration_buttons_use_theme(rule, /* valid */ true);
+	}
+	if (!*value || strchr(value, '/') || !strcmp(value, ".")
+			|| !strcmp(value, "..")) {
+		return decoration_buttons_use_theme(rule, /* valid */ false);
+	}
+	for (const char *c = value; *c; c++) {
+		if (!isalnum((unsigned char)*c) && *c != '-' && *c != '_'
+				&& *c != '.') {
+			return decoration_buttons_use_theme(rule,
+				/* valid */ false);
+		}
+	}
+	xstrdup_replace(rule->decoration_buttons, value);
+	rule->decoration_buttons_set = true;
+	return true;
+}
+
+const char *
+window_rules_get_decoration_buttons(struct view *view)
+{
+	struct window_rule *rule;
+	wl_list_for_each_reverse(rule, &rc.window_rules, link) {
+		if (rule->decoration_buttons_set && view_matches_rule(rule, view)) {
+			return rule->decoration_buttons;
+		}
+	}
+	return NULL;
+}
+
+const float (*
+window_rules_get_decoration_colors(struct view *view))[4]
+{
+	struct window_rule *rule;
+	wl_list_for_each_reverse(rule, &rc.window_rules, link) {
+		if (rule->decoration_colors_set && view_matches_rule(rule, view)) {
+			return rule->decoration_colors_default ? NULL : rule->decoration_colors;
+		}
+	}
+	return NULL;
+}
