# AquariusOS build settings
# These values are read by the Justfile, which is what the GitHub Actions build uses.
# Changing a value here changes it everywhere — this is the one place image names live.

# The name of the OS image. This must match the GitHub repo name.
# Final published image will be: ghcr.io/<your-github-username>/aquarius-os
IMAGE_NAME=aquarius-os

# The GitHub owner that publishes this image, exactly as it appears in the profile/org
# URL (github.com/THIS-PART). Used for documentation links baked into the image and for
# the published image path. Must never be empty — an empty value produces "ghcr.io//...".
REPO_ORGANIZATION="stoneharborent"

IMAGE_DESC="AquariusOS — the OS for gamers and creators."
IMAGE_KEYWORDS="bootc,oci,linux,bazzite,gaming,creator,video-editing"

# Optional: a logo shown if this image is ever listed on artifacthub.io.
# TODO (Phase 3): swap for the real AquariusOS logo URL once branding/ has one.
IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
