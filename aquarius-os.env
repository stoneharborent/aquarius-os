# ==============================================================================
# AquariusOS build settings — the one place image names and versions live
# ==============================================================================
# The Justfile reads this file, and GitHub Actions calls the Justfile. Change a
# value here and it changes everywhere. Nothing else should hard-code these.
# ==============================================================================

# ------------------------------------------------------------------------------
# The two images
# ------------------------------------------------------------------------------
# These are the real, permanent names. This is the AquariusOS people install.
#
# HISTORY, so nobody is confused by an old note or an old command:
# from 2 September 2026 until 4 September 2026 this line published under the
# temporary names `aquarius-os-next` and `aquarius-os-next-nvidia`. That was on
# purpose. The plain names were still being used by the older Bazzite-based
# build, which was installed on real machines, and publishing under them too
# early would have replaced a working operating system on somebody's PC without
# warning.
#
# On 4 September 2026 Royce made this line the real AquariusOS. The Bazzite
# images were copied to a `bazzite-final` tag first so nothing was lost, and
# these two names came home. The `-next` names are frozen at their last build
# and are not published to any more. See docs/restart/final-names.md and
# docs/restart/history.md.
#
# Published as: ghcr.io/stoneharborent/aquarius-os
IMAGE_NAME=aquarius-os

# The same recipe with the NVIDIA driver added.
# Published as: ghcr.io/stoneharborent/aquarius-os-nvidia
NVIDIA_IMAGE_NAME=aquarius-os-nvidia

# ------------------------------------------------------------------------------
# What it is built on
# ------------------------------------------------------------------------------
# Fedora's bare bootable image: a kernel, systemd and a package manager, and
# nothing else. Everything in AquariusOS is added by our own recipe.
#
# The version is pinned. Moving to Fedora 45 means changing this number, and it
# is meant to be a deliberate step with a test on the bench behind it, not
# something that happens to us overnight because a tag moved.
BASE_IMAGE="quay.io/fedora/fedora-bootc"
FEDORA_VERSION=44

# Where the pre-built, pre-signed NVIDIA kernel modules come from. See
# build_files/60-nvidia.sh and docs/restart/nvidia-notes.md — this is the one
# genuinely delicate part of the build, because a kernel module only works with
# the exact kernel it was compiled against.
AKMODS_NVIDIA_IMAGE="ghcr.io/ublue-os/akmods-nvidia-open"

# The same publisher's box of ORDINARY pre-built kernel modules. We take exactly
# one thing out of it: v4l2loopback, the fake webcam behind OBS Studio's "Start
# Virtual Camera" button. Fetched for both images, because a webcam is not a
# graphics-card feature. See build_files/62-virtual-camera.sh — and note that
# when this box's kernel and ours drift apart, that step leaves the virtual
# camera out and says so, rather than changing which kernel AquariusOS ships.
AKMODS_IMAGE="ghcr.io/ublue-os/akmods"

# ------------------------------------------------------------------------------
# The Aquarius Desktop — the three pieces Fedora does not give us
# ------------------------------------------------------------------------------
# Each of these is pinned to a TAG and to the exact COMMIT that tag points at.
# The tag is what the build asks git for; the commit is what it checks it got.
# A tag can be moved by whoever owns the repository — a commit hash cannot — so
# if either upstream ever re-points a tag at different code, the build stops and
# a person decides, instead of AquariusOS quietly shipping something else.
#
# Bumping any of these is a deliberate act: change the pair, push, and read the
# build.

# labwc — the window manager the Aquarius Desktop runs on.
# Fedora 44 packages 0.9.6; 0.20 is the release with HDR10 and colour
# management, which is the entire reason this project chose labwc. Fedora 45
# ships 0.20 in Rawhide today, so this compile-it-ourselves step is temporary.
# https://github.com/labwc/labwc/releases
LABWC_VERSION="0.20.2"
LABWC_COMMIT="97f28877a343e062f3178d201f0248cd9c2610cf"

# Quickshell — the runtime that draws our bar, dock, search and notifications.
# Fedora's package is a snapshot of 0.2.1, which does not have the Networking or
# Bluetooth modules our shell imports. Building it inside the image also makes
# the Qt version mismatch that broke the first bench boot impossible: the shell
# runtime and the Qt it runs on are compiled together and shipped together.
# https://github.com/quickshell-mirror/quickshell/releases
QUICKSHELL_VERSION="v0.3.1"
QUICKSHELL_COMMIT="1a4716cde794a59928d9d9fc15f2afc7a95de360"

# The Aquarius Shell itself — our own code, in its own repository. The live copy
# is on the Linux bench and on GitHub; the copy in the vault beside this repo is
# stale and must not be used.
#
# WHAT THIS COMMIT BRINGS (bumped 2026-09-06 — it was dd23a40 before):
#
#   THE LOCK SCREEN. A new lock/ folder in the shell. Super+L covers every
#   screen with a clock on a frosted picture of the wallpaper; start typing and
#   a card appears with your name and a password box. There is also a "Lock
#   Screen" row in the Aquarius menu, and the machine dims after five minutes,
#   locks after ten and turns the monitor off after fifteen — honouring the apps
#   that ask to be left alone, so a two-hour Resolve export is not interrupted.
#
#   ⚠️ THE SHELL DOES NOT CHECK THE PASSWORD, and this image has to hold up its
#   end. It asks PAM, using a set of rules named "aquarius-lock", and this image
#   installs that name at /etc/pam.d/aquarius-lock (build_files/57-lock-screen.sh
#   and system_files/etc/pam.d/aquarius-lock). If either side is renamed alone,
#   nobody can unlock the machine — so the build reads both and checks they
#   agree. That step also installs wlopm, for turning the monitor off, and the
#   service that locks the screen before the machine sleeps.
#
#   session/labwc/rc.xml gains the Super+L binding, so this image's own copy of
#   that file gains it too. Plain-language write-up: the shell's
#   docs/lock-screen.md.
#
# WHAT THE PREVIOUS PIN BROUGHT (dd23a40, the second pass over that day's bench
# test — it was db672bb before that):
#
#   "About This PC" opens the About page itself, rather than the front of the
#   System panel with About as one row on it. GNOME's Settings takes a page
#   inside a panel as a further word: `gnome-control-center system about`.
#
#   A new session/labwc/themerc-override — the Ice look for the desktop
#   right-click menu and for every window title bar. The bench note was "the
#   right click menu does not have a design yet", and it did not: labwc was
#   drawing both in its own default Openbox grey. This image now ships its own
#   copy of that file, at system_files/usr/share/aquarius/labwc/themerc-override.
#
#   session/labwc/rc.xml gains a <theme> section naming the FONT for those same
#   surfaces (Inter, sizes in pixels, taken from the shell's Theme.qml), because
#   labwc takes colours from a themerc and fonts from rc.xml. It also settles the
#   W-Return and W-Tab/W-S-Tab bindings, so the shell's copy is now the
#   deliberate superset and the two copies can be held content-identical. This
#   image's rc.xml has been brought up to match.
#
#   Every app in the dock has a right-click menu: Open (or New Window), Keep in
#   Dock or Remove from Dock, and Quit. Another four-word bench note — "right
#   click on the apps does nothing" — and it did nothing because the tile's
#   MouseArea took Left and Middle only.
#
# ⚠️ THE labwc FILES ARE NOW COMPARED, NOT REMEMBERED. Bumping this pin can
# change files that exist twice — once in the shell, once in system_files/ here.
# build_files/check-labwc-drift.sh compares all four of them against this exact
# commit and CI fails the push if they differ in anything but their comments. So
# a bump that needs a file copied across says so, in the shell_tests job, instead
# of shipping a desktop that quietly lost something.
AQUARIUS_SHELL_REPO="https://github.com/stoneharborent/aquarius-shell.git"
AQUARIUS_SHELL_REF="afd26b92830e79359ea6e1b8d13f24bbbdbbc628"

# ------------------------------------------------------------------------------
# Where it is published
# ------------------------------------------------------------------------------
# The GitHub owner, exactly as it appears in the profile URL
# (github.com/THIS-PART). Must never be empty — an empty value silently produces
# "ghcr.io//aquarius-os", which builds fine and installs nothing.
REPO_ORGANIZATION="stoneharborent"

# The GitHub repository. One repository publishes these two images (and, on the
# frozen `bazzite-archive` branch, the six older Bazzite ones, which no longer
# build because scheduled builds only run on the default branch).
REPO_NAME=aquarius-os

IMAGE_DESC="AquariusOS — a Linux desktop built for creators, on Fedora."
IMAGE_KEYWORDS="bootc,oci,linux,fedora,creator,video-editing,gnome"

# Shown if these images are ever listed on artifacthub.io.
# TODO: swap for a real AquariusOS logo URL.
IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"

DEFAULT_TAG="latest"

# The tool that turns a published image into an installer ISO or a virtual
# machine disk. bootc-image-builder was archived in June 2026 and merged into
# osbuild's image-builder; the old invocation still works through a
# compatibility wrapper, and it is what Universal Blue's own template still
# uses, so it is what we use.
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
