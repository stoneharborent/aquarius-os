# AquariusOS build settings
# These values are read by the Justfile, which is what the GitHub Actions build uses.
# Changing a value here changes it everywhere — this is the one place image names live.

# The name of the OS image. This must match the GitHub repo name.
# Final published image will be: ghcr.io/<your-github-username>/aquarius-os
IMAGE_NAME=aquarius-os

# What that image is built on top of: Bazzite stable, KDE desktop.
# This is the AMD / Intel graphics version — the default AquariusOS.
BASE_IMAGE="ghcr.io/ublue-os/bazzite:stable"

# ------------------------------------------------------------------------------
# The NVIDIA version of AquariusOS
# ------------------------------------------------------------------------------
# Same recipe, different starting point. Built by the same GitHub Actions run and
# published side by side with the one above, as:
#   ghcr.io/<your-github-username>/aquarius-os-nvidia
#
# "-nvidia-open" (open kernel modules) is the correct base for every RTX card,
# including the RTX 5090. Bazzite's older "-nvidia" image is for GTX 900/1000-era
# cards only and does not support RTX 50-series at all.
# Evidence and full reasoning: docs/nvidia-variant-research.md
NVIDIA_IMAGE_NAME=aquarius-os-nvidia
NVIDIA_BASE_IMAGE="ghcr.io/ublue-os/bazzite-nvidia-open:stable"

# ------------------------------------------------------------------------------
# The HANDHELD version of AquariusOS
# ------------------------------------------------------------------------------
# For gaming handhelds — the ROG Xbox Ally, ROG Ally X, Steam Deck, Legion Go.
# Same recipe again, built by the same GitHub Actions run, published as:
#   ghcr.io/<your-github-username>/aquarius-os-deck
#
# The difference is entirely in the base image. "bazzite-deck" is Bazzite's
# handheld edition: it boots straight into Game Mode (Valve's gamescope session)
# instead of a desktop, and carries the handheld hardware layer — the handheld
# daemon (HHD) for buttons/gyro/TDP, Valve's hardware support packages, and the
# controller-first Steam UI. Press the desktop-mode button and you land in the
# same Plasma desktop the other two images boot into, with the whole AquariusOS
# creator layer already installed.
#
# It is the KDE handheld image on purpose — "bazzite-deck-gnome" exists and is
# NOT what we want, for exactly the same reason we stayed on KDE everywhere else
# (CLAUDE.md, standing decision 1).
# Evidence and full reasoning: docs/deck-variant-research.md
DECK_IMAGE_NAME=aquarius-os-deck
DECK_BASE_IMAGE="ghcr.io/ublue-os/bazzite-deck:stable"

# The name of the GitHub REPO this all lives in — github.com/<owner>/aquarius-os.
# Not the same thing as an image name any more: one repo now publishes three
# images (aquarius-os, aquarius-os-nvidia and aquarius-os-deck), and all three
# link back to this one repo.
REPO_NAME=aquarius-os

# The GitHub owner that publishes this image, exactly as it appears in the profile/org
# URL (github.com/THIS-PART). Used for documentation links baked into the image and for
# the published image path. Must never be empty — an empty value produces "ghcr.io//...".
REPO_ORGANIZATION="stoneharborent"

IMAGE_DESC="AquariusOS — the OS for gamers and creators."
IMAGE_KEYWORDS="bootc,oci,linux,bazzite,gaming,creator,video-editing"

# Optional: a logo shown if this image is ever listed on artifacthub.io.
# TODO (Phase 3): swap for the real AquariusOS logo URL once branding/ has one.
IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
