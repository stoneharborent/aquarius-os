# ==============================================================================
# AquariusOS installer payload image
# ==============================================================================
# Plain English: this builds the *live environment* — the temporary desktop you
# get when you boot the USB stick, with the installer app on it. It is NOT the
# operating system you end up with; it is the thing that installs it.
#
# It starts from AquariusOS itself, then build.sh adds the parts a USB stick
# needs (live-boot support, the Anaconda installer) and tucks a copy of the real
# AquariusOS image inside it, so installing works with no internet connection.
#
# You never build this by hand. The "Build AquariusOS ISO" workflow does it, and
# it must be built with:
#     podman build --cap-add sys_admin --security-opt label=disable ...
# because build.sh runs podman inside the build.
#
# Adapted from ublue-os/bazzite installer/Containerfile (Apache-2.0),
# read at commit 0fb3abacb1135fbb50cbb575a18f53fea683ab0f (2026-08-23).
# Difference from Bazzite: no FLATPAK_DIR_SHORTNAME argument, because AquariusOS
# does not preinstall Flatpaks into the live environment (see build.sh).
# ==============================================================================

# run with --cap-add sys_admin --security-opt label=disable

# BASE_IMAGE          — what the live desktop is made of.
# INSTALL_IMAGE_PAYLOAD — the image that gets written to the target machine's
#                         disk.
#
# These two are the SAME image for the base and NVIDIA ISOs, and DIFFERENT for
# the handheld one:
#
#   deck ISO:  BASE_IMAGE = aquarius-os        (an ordinary desktop to install FROM)
#              INSTALL_…  = aquarius-os-deck   (the Game Mode image being installed)
#
# Because a live session made of the handheld image would boot into Steam's
# controller interface with the installer hidden behind it. Bazzite splits them
# for exactly this reason and we now do too — which is what these two arguments
# were here for all along. The long version is in the header of
# ../.github/workflows/build-iso.yml, which is what passes them in.
ARG BASE_IMAGE=${BASE_IMAGE:-ghcr.io/stoneharborent/aquarius-os:latest}
ARG INSTALL_IMAGE_PAYLOAD=${INSTALL_IMAGE_PAYLOAD:-ghcr.io/stoneharborent/aquarius-os:latest}

FROM $BASE_IMAGE
ARG BASE_IMAGE
ARG INSTALL_IMAGE_PAYLOAD
RUN --mount=type=bind,source=./.,target=/src \
    env \
    BASE_IMAGE="$BASE_IMAGE" \
    INSTALL_IMAGE_PAYLOAD="$INSTALL_IMAGE_PAYLOAD" \
    /src/build.sh
